          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste pela grade ou digite frações da tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по сетке или введите доли экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在网格上拖移，或键入屏幕占比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在網格上拖移，或輸入佔螢幕的比例。"
          }
        }
      }
    },
    "Drag files toward this corner to show the zone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien in Richtung dieser Ecke ziehen, um die Zone anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra archivos hacia esta esquina para mostrar la zona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser des fichiers vers ce coin pour afficher la zone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina i file verso questo angolo per mostrare la zona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをこの隅に向かってドラッグするとゾーンが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 이 모서리 쪽으로 드래그하면 영역이 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste arquivos em direção a este canto para mostrar a zona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетяните файлы к этому углу, чтобы появилась зона."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件拖向此角落即可显示投放区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將檔案拖向此角落即可顯示放置區。"
          }
        }
      }
    },
    "Drag icons past the %@ divider to keep them always hidden. %@-click the chevron to see those too.": {
      "comment": "Arrangement card step; the values are the double divider glyph and the Option key symbol",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbole über die Trennlinie %1$@ hinaus ziehen, um sie immer auszublenden. %2$@-Klick auf den Chevron zeigt auch diese."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Drag icons past the %1$@ divider to keep them always hidden. %2$@-click the chevron to see those too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra iconos más allá del divisor %1$@ para que estén siempre ocultos. Haz clic con %2$@ en la flecha para verlos también."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser des icônes au-delà du séparateur %1$@ pour qu’elles restent toujours masquées. Cliquez sur le chevron en maintenant %2$@ pour les voir aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le icone oltre il divisore %1$@ per tenerle sempre nascoste. Fai %2$@-clic sulla freccia per vedere anche quelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンを%1$@区切り線の先までドラッグすると、常に非表示になります。シェブロンを%2$@クリックするとそれらも表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘을 %1$@ 구분선 너머로 드래그하면 항상 숨겨집니다. 꺾쇠 아이콘을 %2$@-클릭하면 이 아이콘도 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste ícones além do divisor %1$@ para mantê-los sempre ocultos. Clique no chevron com %2$@ para vê-los também."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетяните значки за разделитель %1$@, чтобы они всегда были скрыты. Нажмите шеврон с %2$@, чтобы увидеть и их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将图标拖过 %1$@ 分隔线即可使其始终隐藏。按住 %2$@ 点按 V 形符号也可查看这些图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將圖像拖過 %1$@ 分隔線即可讓其永遠隱藏。按住 %2$@ 並按一下箭頭也可查看這些圖像。"
          }
        }
      }
    },
    "Drag images, videos or PDFs toward a corner of the screen and drop them on the zone that appears.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder, Videos oder PDFs in Richtung einer Bildschirmecke ziehen und auf der erscheinenden Zone ablegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra imágenes, vídeos o PDF hacia una esquina de la pantalla y suéltalos en la zona que aparece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser des images, des vidéos ou des PDF vers un coin de l’écran et déposez-les sur la zone qui apparaît."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina immagini, video o PDF verso un angolo dello schermo e rilasciali sulla zona che compare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像、ビデオ、PDFを画面の隅に向かってドラッグし、表示されるゾーンにドロップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지, 비디오 또는 PDF를 화면 모서리 쪽으로 드래그하고 나타나는 영역에 놓으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste imagens, vídeos ou PDFs em direção a um canto da tela e solte-os na zona que aparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетяните изображения, видео или PDF к углу экрана и бросьте их на появившуюся зону."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将图像、视频或 PDF 拖向屏幕角落，然后放到出现的投放区上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將影像、影片或 PDF 拖向螢幕角落，然後放到出現的放置區上。"
          }
        }
      }
    },
    "Drag items onto this pinboard’s chip, or press ⌘K and choose Add to Pinboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekte auf das Etikett dieser Pinnwand ziehen oder ⌘K drücken und „Zur Pinnwand hinzufügen“ wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra ítems a la etiqueta de este tablero o pulsa ⌘K y elige Añadir al tablero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser des éléments sur la pastille de ce tableau, ou appuyez sur ⌘K et choisissez Ajouter au tableau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina gli elementi sull'etichetta di questa bacheca, oppure premi ⌘K e scegli Aggiungi a bacheca."
          }
