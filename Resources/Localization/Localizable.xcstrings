    "The smaller number of a size applies to the smaller side of each picture.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kleinere Zahl einer Größe gilt für die kürzere Seite jedes Bildes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número menor de un tamaño se aplica al lado más corto de cada imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus petit nombre d’une taille s’applique au plus petit côté de chaque image."
