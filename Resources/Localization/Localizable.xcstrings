    "File Locksmith needs administrator access to end “%@”.": {
      "comment": "Password prompt; the value is a process name",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "File Locksmith benötigt Administratorzugriff, um „%@“ zu beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "File Locksmith necesita acceso de administrador para terminar “%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "File Locksmith a besoin d’un accès administrateur pour terminer « %@ »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File Locksmith richiede l'accesso come amministratore per terminare “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”を終了するには、File Locksmithに管理者のアクセス権が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 잠금 해제에서 “%@”을(를) 종료하려면 관리자 권한이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O File Locksmith precisa de acesso de administrador para encerrar “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы завершить «%@», File Locksmith нужен доступ администратора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "File Locksmith 需要管理员权限才能结束“%@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案佔用檢查器需要管理者權限才能結束「%@」。"
          }
        }
      }
    },
    "File Locksmith needs administrator access to see the processes of all users.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "File Locksmith benötigt Administratorzugriff, um die Prozesse aller Benutzer zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "File Locksmith necesita acceso de administrador para ver los procesos de todos los usuarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "File Locksmith a besoin d’un accès administrateur pour voir les processus de tous les utilisateurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File Locksmith richiede l'accesso come amministratore per vedere i processi di tutti gli utenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのユーザのプロセスを表示するには、File Locksmithに管理者のアクセス権が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 잠금 해제에서 모든 사용자의 프로세스를 보려면 관리자 권한이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O File Locksmith precisa de acesso de administrador para ver os processos de todos os usuários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы видеть процессы всех пользователей, File Locksmith нужен доступ администратора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "File Locksmith 需要管理员权限才能查看所有用户的进程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案佔用檢查器需要管理者權限才能查看所有使用者的程序。"
          }
        }
      }
    },
