    "When hidden, open MacToys again from Finder or Spotlight to reach Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ausgeblendet, MacToys erneut über den Finder oder Spotlight öffnen, um die Einstellungen zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está oculto, vuelve a abrir MacToys desde el Finder o Spotlight para acceder a Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand l’icône est masquée, rouvrez MacToys depuis le Finder ou Spotlight pour accéder aux Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se è nascosta, apri di nuovo MacToys dal Finder o da Spotlight per accedere a Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示の場合は、FinderまたはSpotlightからMacToysをもう一度開くと“設定”にアクセスできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨긴 경우 Finder나 Spotlight에서 MacToys를 다시 열면 설정에 접근할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando oculto, abra o MacToys novamente pelo Finder ou pelo Spotlight para acessar os Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если значок скрыт, снова откройте MacToys из Finder или Spotlight, чтобы перейти к Настройкам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏后，请从访达或聚焦再次打开 MacToys 以访问设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
