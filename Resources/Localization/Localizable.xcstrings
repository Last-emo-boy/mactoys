    "Turn every remap off without disabling Keyboard Manager.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Neubelegungen ausschalten, ohne den Tastatur-Manager zu deaktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva todas las reasignaciones sin desactivar el Administrador de teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver toutes les réaffectations sans désactiver Gestionnaire de clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva tutte le rimappature senza disattivare Gestione tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードマネージャを無効にせずに、すべてのリマップをオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 관리자를 비활성화하지 않고 모든 재매핑을 끕니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar todos os remapeamentos sem desativar o Gerenciador de Teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить все переназначения, не отключая «Диспетчер клавиатуры»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭所有重映射，但不停用键盘管理器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉所有重新對應，但不停用鍵盤管理員。"
          }
        }
      }
    },
    "Turn off the macOS screenshot shortcuts in System Settings › Keyboard › Keyboard Shortcuts › Screenshots, then record them above.": {
      "comment": "Screenshot settings: how to free the macOS screenshot keys",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die macOS-Kurzbefehle für Bildschirmfotos in „Systemeinstellungen › Tastatur › Tastaturkurzbefehle › Bildschirmfotos“ ausschalten und sie dann oben aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva los atajos de captura de pantalla de macOS en Ajustes del Sistema › Teclado › Funciones rápidas de teclado › Capturas de pantalla y luego grábalos arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez les raccourcis de capture d’écran de macOS dans Réglages Système › Clavier › Raccourcis clavier › Captures d’écran, puis enregistrez-les ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva le abbreviazioni per le istantanee di macOS in Impostazioni di Sistema › Tastiera › Abbreviazioni da tastiera › Istantanee schermo, poi registrale qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“システム設定” › “キーボード” › “キーボードショートカット” › “スクリーンショット”でmacOSのスクリーンショットのショートカットをオフにしてから、上で登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 › 키보드 › 키보드 단축키 › 스크린샷에서 macOS 스크린샷 단축키를 끈 다음 위에서 단축키를 기록하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative os atalhos de captura de tela do macOS em Ajustes do Sistema › Teclado › Atalhos de Teclado › Capturas de Tela e grave-os acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите сочетания клавиш macOS для снимков экрана в Системных настройках › Клавиатура › Сочетания клавиш › Снимки экрана, затем запишите их выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 › 键盘 › 键盘快捷键 › 截屏中关闭 macOS 截屏快捷键，然后在上方录制它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定」›「鍵盤」›「鍵盤快速鍵」›「截圖」中關閉 macOS 的截圖快速鍵，然後在上方錄製。"
          }
        }
      }
    },
    "Turn off to offer only the sets you choose below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschalten, um nur die unten gewählten Sätze anzubieten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo para ofrecer solo los conjuntos que elijas abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez pour ne proposer que les jeux choisis ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva per proporre solo i set che scegli qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、下で選択したセットのみが候補になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 아래에서 선택한 집합만 제공합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para oferecer apenas os conjuntos escolhidos abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите, чтобы предлагать только выбранные ниже наборы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后只提供你在下方选取的字符集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此選項即可只提供你在下方選擇的字元集。"
          }
        }
      }
    },
    "Turn off to use AI only through saved actions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschalten, um KI nur über gesicherte Aktionen zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo para usar la IA solo mediante acciones guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez pour n’utiliser l’IA que via les actions enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva per usare l'IA solo tramite le azioni salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、AIは保存したアクションからのみ使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 저장된 동작을 통해서만 AI를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para usar IA apenas por meio de ações salvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите, чтобы использовать ИИ только через сохраненные действия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后只能通过存储的操作使用 AI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此選項即可只透過已儲存的動作使用 AI。"
          }
        }
      }
    },
    "Turn off “Hold ⌥ key while dragging windows to tile” in Desktop & Dock settings, or choose another key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Option-Taste (⌥) während des Ziehens von Fenstern gedrückt halten, um Fenster als Kacheln anzuzeigen“ in den Einstellungen „Schreibtisch & Dock“ ausschalten oder eine andere Taste wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva “Mantener pulsada la tecla ⌥ al arrastrar ventanas para organizarlas en mosaico” en los ajustes de Escritorio y Dock, o elige otra tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez « Maintenir la touche ⌥ enfoncée lors du glissement des fenêtres pour les placer en mosaïque » dans les réglages Bureau et Dock, ou choisissez une autre touche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva “Tieni premuto il tasto ⌥ mentre trascini le finestre per disporle a mosaico” nelle impostazioni Scrivania e Dock, oppure scegli un altro tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“デスクトップとDock”設定で“⌥キーを押したままウインドウをドラッグしてタイル表示”をオフにするか、ほかのキーを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크탑 및 Dock 설정에서 “윈도우를 드래그하는 동안 ⌥ 키를 눌러 타일 정렬”을 끄거나 다른 키를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative “Manter a tecla ⌥ pressionada ao arrastar janelas para organizar lado a lado” nos ajustes de Mesa e Dock ou escolha outra tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите «Удерживать клавишу ⌥ при перетягивании окон для размещения мозаикой» в настройках «Рабочий стол и Dock» или выберите другую клавишу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“桌面与程序坞”设置中关闭“拖移窗口时按住 ⌥ 键以平铺”，或选取其他按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「桌面與 Dock」設定中關閉「拖移視窗時按住 ⌥ 鍵以並排」，或選擇其他按鍵。"
          }
        }
      }
    },
    "Turn off “Main search” to reach an extension only through its alias, the result filter or its page.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Hauptsuche“ ausschalten, um eine Erweiterung nur über ihren Alias, den Ergebnisfilter oder ihre Seite zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva “Búsqueda principal” para acceder a una extensión solo mediante su alias, el filtro de resultados o su página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez « Recherche principale » pour n’accéder à une extension que par son alias, le filtre de résultats ou sa page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva “Ricerca principale” per raggiungere un'estensione solo tramite il suo alias, il filtro dei risultati o la sua pagina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“メイン検索”をオフにすると、機能拡張にはエイリアス、結果のフィルタ、またはそのページからのみアクセスできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별칭, 결과 필터 또는 해당 페이지를 통해서만 확장 프로그램에 접근하려면 “기본 검색”을 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative “Busca principal” para acessar uma extensão apenas pelo alias, pelo filtro de resultados ou pela página dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите «Основной поиск», чтобы расширение было доступно только через псевдоним, фильтр результатов или свою страницу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭“主搜索”后，只能通过扩展的别名、结果过滤器或其页面访问该扩展。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉「主要搜尋」後，只能透過延伸功能的別名、結果篩選條件或其頁面使用該延伸功能。"
          }
        }
      }
    },
    "Turn on Auto Tiling and every window you open takes its place in the layout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisches Kacheln einschalten, damit jedes geöffnete Fenster seinen Platz im Layout einnimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Mosaico automático y cada ventana que abras ocupará su lugar en la distribución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Mosaïque automatique et chaque fenêtre que vous ouvrez prend sa place dans la disposition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Affiancamento automatico e ogni finestra che apri prende il suo posto nel layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動タイル表示をオンにすると、開いたすべてのウインドウがレイアウト内に配置されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 타일링을 켜면 여는 모든 윈도우가 레이아웃에 자리를 잡습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a Organização Automática e cada janela que você abrir ocupa seu lugar no layout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Автомозаику», и каждое открытое окно займет свое место в макете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开自动平铺后，你打开的每个窗口都会在布局中就位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟自動並排後，你打開的每個視窗都會在佈局中找到自己的位置。"
          }
        }
      }
    },
    "Turn on Menu Bar Manager to see your icons here, sorted by section.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüleisten-Manager einschalten, um die Symbole hier nach Bereichen sortiert zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Administrador de la barra de menús para ver aquí tus iconos, ordenados por sección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Gestionnaire de la barre des menus pour voir vos icônes ici, triées par section."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Gestione barra dei menu per vedere qui le tue icone, ordinate per sezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーマネージャをオンにすると、アイコンがセクションごとにここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 관리자를 켜면 아이콘이 섹션별로 정렬되어 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Gerenciador da Barra de Menus para ver seus ícones aqui, organizados por seção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Диспетчер строки меню», чтобы видеть здесь свои значки по разделам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开菜单栏管理器即可在此处查看按区域分类的图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟選單列管理員即可在此處查看你的圖像，並依區段排序。"
          }
        }
      }
    },
    "Turn on Smart zoom in Trackpad settings › Scroll & Zoom for the double-tap. Elsewhere it zooms as usual.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das Doppeltippen „Intelligentes Zoomen“ in den Trackpad-Einstellungen unter „Scrollen & Zoomen“ aktivieren. Anderswo zoomt es wie gewohnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Zoom inteligente en los ajustes de Trackpad › Desplazamiento y zoom para el doble toque. En otros lugares hace zoom como siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Zoom intelligent dans les réglages Trackpad › Défilement et zoom pour le toucher double. Ailleurs, il zoome comme d’habitude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Smart zoom in impostazioni Trackpad › Scorri e zoom per il doppio tocco. Altrove lo zoom funziona come al solito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップを使うには、“トラックパッド”設定 › “スクロールとズーム”で“スマートズーム”をオンにしてください。それ以外の場所では通常どおりズームします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이중 탭을 사용하려면 트랙패드 설정 › 스크롤 및 확대/축소에서 스마트 확대/축소를 켜세요. 다른 곳에서는 평소처럼 확대/축소됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Zoom inteligente nos ajustes de Trackpad › Rolar e Zoom para o toque duplo. Em outros lugares, ele amplia normalmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для двойного касания включите смарт-масштабирование в настройках трекпада › Прокрутка и масштаб. В остальных местах оно масштабирует как обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“触控板”设置 › 滚动缩放中打开“智能缩放”以使用连点两下。在其他位置，它会照常缩放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「觸控式軌跡板」設定 ›「捲動與縮放」中開啟「智慧型縮放」以使用點兩下。在其他地方則照常縮放。"
          }
        }
      }
    },
    "Turn on a light in front of you, or face a window.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Licht vor sich einschalten oder sich einem Fenster zuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende una luz delante de ti o ponte de cara a una ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allumez une lumière devant vous, ou placez-vous face à une fenêtre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前方の照明をつけるか、窓のほうを向いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞쪽의 조명을 켜거나 창문을 바라보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acenda uma luz à sua frente ou fique de frente para uma janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите свет перед собой или повернитесь к окну."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开你前方的灯，或面向窗户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請打開你前方的燈，或面向窗戶。"
          }
        }
      }
    },
    "Turn on a utility to see its actions here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Werkzeug einschalten, um hier seine Aktionen zu sehen."
