          }
        }
      }
    },
    "More windows float where they open and join when a tile frees up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitere Fenster schweben dort, wo sie sich öffnen, und werden aufgenommen, sobald eine Kachel frei wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas adicionales flotan donde se abren y se unen cuando queda libre una casilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres supplémentaires flottent là où elles s’ouvrent et rejoignent la mosaïque quand un emplacement se libère"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre in più restano sganciate dove si aprono ed entrano quando si libera un riquadro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以上のウインドウは開いた場所にフローティングし、タイルが空くと加わります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 윈도우는 열린 위치에 떠 있다가 타일이 비면 합류함"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janelas extras flutuam onde abrem e entram quando um bloco fica livre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лишние окна остаются плавающими там, где открылись, и встают в мозаику, когда освобождается плитка"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多窗口在打开的位置浮动，并在有平铺位置空出时加入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更多視窗會在打開的位置浮動，並在有並排位置空出時加入"
          }
        }
      }
    },
    "More windows share the tile you're working in; step through them with a shortcut": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitere Fenster teilen sich die verwendete Kachel; per Kurzbefehl durch sie blättern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas adicionales comparten la casilla en la que trabajas; recórrelas con un atajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres supplémentaires partagent l’emplacement dans lequel vous travaillez ; parcourez-les avec un raccourci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre in più condividono il riquadro in cui stai lavorando; scorrile con un'abbreviazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以上のウインドウは作業中のタイルを共有し、ショートカットで順に切り替えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 윈도우는 작업 중인 타일을 공유하며, 단축키로 차례로 전환함"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janelas extras compartilham o bloco em que você está trabalhando; percorra-as com um atalho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лишние окна делят плитку, в которой вы работаете; переключайтесь между ними сочетанием клавиш"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多窗口与当前平铺位置共用；用快捷键逐个切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更多視窗會共用你正在使用的並排位置；使用快速鍵逐一切換"
          }
        }
      }
    },
