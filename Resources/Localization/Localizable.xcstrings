        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le séparateur ‖ est à droite du séparateur |"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il divisore ‖ è a destra del divisore |"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "‖区切り線が|区切り線の右にあります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‖ 구분선이 | 구분선 오른쪽에 있음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O divisor ‖ está à direita do divisor |"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделитель ‖ находится правее разделителя |"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "‖ 分隔线位于 | 分隔线右侧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "‖ 分隔線位於 | 分隔線右側"
          }
        }
      }
    },
    "The ‖ divider must stay to the left of the | divider. Drag it back with ⌘.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Trennlinie ‖ muss links von der Trennlinie | bleiben. Mit ⌘ zurückziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El divisor ‖ debe quedar a la izquierda del divisor |. Arrástralo de vuelta con ⌘."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le séparateur ‖ doit rester à gauche du séparateur |. Faites-le glisser en arrière avec ⌘."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il divisore ‖ deve restare a sinistra del divisore |. Trascinalo indietro con ⌘."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "‖区切り線は|区切り線の左側に置く必要があります。⌘を押しながらドラッグして戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‖ 구분선은 | 구분선 왼쪽에 있어야 합니다. ⌘ 키를 누른 채 다시 드래그하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O divisor ‖ precisa ficar à esquerda do divisor |. Arraste-o de volta com ⌘."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделитель ‖ должен оставаться левее разделителя |. Перетяните его обратно с ⌘."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "‖ 分隔线必须位于 | 分隔线左侧。请按住 ⌘ 将其拖回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "‖ 分隔線必須保持在 | 分隔線左側。請按住 ⌘ 將其拖回。"
          }
        }
      }
    },
    "Their servers can tell when you preview a document": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deren Server können erkennen, wann ein Dokument in der Vorschau angezeigt wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus servidores pueden saber cuándo previsualizas un documento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leurs serveurs peuvent savoir quand vous prévisualisez un document"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I loro server possono sapere quando visualizzi l'anteprima di un documento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類をプレビューしたことがサーバに伝わります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서를 미리 볼 때 해당 서버에서 이를 알 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os servidores delas podem saber quando você pré-visualiza um documento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их серверы могут узнать, когда вы просматриваете документ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
