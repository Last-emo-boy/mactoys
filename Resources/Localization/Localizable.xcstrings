            "value": "Le istantanee che catturi compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影したスクリーンショットがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찍은 스크린샷이 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas de tela que você fizer aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появляются сделанные вами снимки экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你拍摄的截屏会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你拍攝的截圖會顯示在這裡。"
          }
        }
      }
    },
    "Screenshots you take appear here. Press %@ to capture an area.": {
      "comment": "Capture history: empty; %@ is a shortcut such as ⌃⌥A",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheinen aufgenommene Bildschirmfotos. %@ drücken, um einen Bereich aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla que hagas aparecen aquí. Pulsa %@ para capturar un área."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d’écran que vous prenez apparaissent ici. Appuyez sur %@ pour capturer une zone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le istantanee che catturi compaiono qui. Premi %@ per catturare un'area."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影したスクリーンショットがここに表示されます。%@を押すと範囲をキャプチャできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찍은 스크린샷이 여기에 표시됩니다. 영역을 캡처하려면 %@ 키를 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas de tela que você fizer aparecem aqui. Pressione %@ para capturar uma área."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появляются сделанные вами снимки экрана. Нажмите %@, чтобы сделать снимок области."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你拍摄的截屏会显示在这里。按 %@ 可截取区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你拍攝的截圖會顯示在這裡。按 %@ 即可擷取區域。"
          }
        }
      }
    },
