            "value": "永不"
          }
        }
      }
    },
    "Never dim while these apps are active": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie abdunkeln, solange diese Apps aktiv sind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No atenuar nunca mientras estas apps estén activas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais atténuer lorsque ces apps sont actives"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non attenuare mai mentre queste app sono attive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のAppがアクティブな間は暗くしない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 앱이 활성 상태일 때는 어둡게 하지 않음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca escurecer enquanto estes apps estiverem ativos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не затемнять, пока активны эти приложения"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 App 处于活跃状态时从不调暗"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些 App 為使用中時絕不調暗"
          }
        }
      }
    },
    "Never in password fields or while secure input is on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie in Passwortfeldern oder bei aktivierter sicherer Eingabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca en campos de contraseña ni con la entrada segura activada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais dans les champs de mot de passe ni lorsque la saisie sécurisée est activée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai nei campi password o mentre è attivo l'inserimento sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードフィールドや、セキュア入力がオンの間は表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 필드에서나 보안 입력이 켜져 있는 동안에는 표시하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca em campos de senha ou enquanto a entrada segura estiver ativada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда в полях пароля и при включенном защищенном вводе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在密码栏中或安全输入打开时从不显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不在密碼欄位中或安全輸入開啟時顯示。"
          }
        }
      }
    },
    "Never record copies from": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie Kopien aufzeichnen aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No registrar nunca lo copiado desde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais enregistrer les copies depuis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non registrare mai le copie da"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のAppのコピーは記録しない"
          }
        },
        "ko": {
