            "value": "關機"
          }
        }
      }
    },
    "Shutter speed, e.g. 1-250s": {
      "comment": "PowerRename photo variable; keep the sample value 1-250s",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belichtungszeit, z. B. 1-250s"
          }
        },
        "es": {
          "stringUnit": {
