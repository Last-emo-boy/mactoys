    "Click to capture this display": {
      "comment": "Screenshot: choosing which display to capture",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, um dieses Display aufzunehmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para capturar esta pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour capturer cet écran"
          }
        },
        "it": {
