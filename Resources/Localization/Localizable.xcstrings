    "↩ pastes into the app you came from, ⇧↩ as plain text, ⌘1…⌘9 the first nine. Tab switches to pinboards and snippets, ⌘K shows every action.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ setzt in die vorherige App ein, ⇧↩ als reinen Text, ⌘1…⌘9 die ersten neun. Tab wechselt zu Pinnwänden und Textbausteinen, ⌘K zeigt alle Aktionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ pega en la app de la que vienes, ⇧↩ como texto sin formato y ⌘1…⌘9 los nueve primeros. Tab cambia a tableros y fragmentos, ⌘K muestra todas las acciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ colle dans l’app d’origine, ⇧↩ en texte brut, ⌘1…⌘9 les neuf premiers. Tab bascule vers les tableaux et les extraits, ⌘K affiche toutes les actions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ incolla nell'app da cui provieni, ⇧↩ come testo semplice, ⌘1…⌘9 i primi nove. Tab passa a bacheche e frammenti, ⌘K mostra tutte le azioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "↩で元のAppにペースト、⇧↩でプレーンテキストとしてペースト、⌘1…⌘9で最初の9項目をペーストします。Tabキーでピンボードとスニペットに切り替え、⌘Kですべてのアクションを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "↩를 누르면 이전 앱에 붙여넣고, ⇧↩는 일반 텍스트로, ⌘1…⌘9는 처음 9개 항목을 붙여넣습니다. Tab으로 핀보드와 스니펫으로 전환하고, ⌘K로 모든 동작을 봅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ cola no app de onde você veio, ⇧↩ como texto simples, ⌘1…⌘9 os nove primeiros. Tab alterna para murais e trechos, ⌘K mostra todas as ações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ вставляет в приложение, из которого вы пришли, ⇧↩ — как простой текст, ⌘1…⌘9 — первые девять. Tab переключает на доски и фрагменты, ⌘K показывает все действия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ 粘贴到你之前所在的 App，⇧↩ 粘贴为纯文本，⌘1…⌘9 粘贴前九项。Tab 切换到固定板和片段，⌘K 显示所有操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ 會貼到你原本使用的 App，⇧↩ 貼上為純文字，⌘1⋯⌘9 貼上前九個項目。Tab 可切換到釘選板和片段，⌘K 會顯示所有動作。"
          }
        }
      }
    },
