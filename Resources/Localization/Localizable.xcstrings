    "⌥-arrows; with ⇧ the window moves 1 pt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥-Pfeiltasten; mit ⇧ bewegt sich das Fenster um 1 pt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ y las flechas; con ⇧ la ventana se mueve 1 pt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ + flèches ; avec ⇧, la fenêtre se déplace de 1 pt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥-frecce; con ⇧ la finestra si sposta di 1 pt"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥と矢印キー。⇧を加えるとウインドウが1 pt移動します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥-화살표, ⇧ 키와 함께 누르면 윈도우가 1 pt씩 이동"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ + setas; com ⇧, a janela se move 1 pt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ со стрелками; с ⇧ окно сдвигается на 1 pt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ 加方向键；加按 ⇧ 时窗口移动 1 pt"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ 加方向鍵；加按 ⇧ 時視窗一次移動 1 pt"
          }
        }
      }
