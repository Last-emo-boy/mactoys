    "Green at the limit, orange while charging or discharging toward it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grün beim Limit, orange beim Laden oder Entladen in Richtung Limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde en el límite, naranja mientras se carga o se descarga hacia él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vert à la limite, orange pendant la charge ou la décharge vers celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde al limite, arancione mentre carica o scarica verso di esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限では緑、上限に向かって充電中または放電中はオレンジ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도에 도달하면 초록색, 한도를 향해 충전 또는 방전하는 동안에는 주황색."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde no limite, laranja ao carregar ou descarregar em direção a ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зеленый на ограничении, оранжевый при зарядке или разрядке до него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到上限时显示绿色，朝上限充电或放电时显示橙色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到上限時為綠色，朝上限充電或放電時為橘色。"
          }
        }
      }
    },
