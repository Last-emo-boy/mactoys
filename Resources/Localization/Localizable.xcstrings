          }
        }
      }
    },
    "Drop an image or a PDF here to read its text.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bild oder PDF hier ablegen, um den Text zu lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta aquí una imagen o un PDF para leer su texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez une image ou un PDF ici pour en lire le texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia qui un'immagine o un PDF per leggerne il testo."
          }
        },
        "ja": {
          "stringUnit": {
