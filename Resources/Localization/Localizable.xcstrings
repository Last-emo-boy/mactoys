    },
    "Items appear here as apps add them to the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekte erscheinen hier, sobald Apps sie zur Menüleiste hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ítems aparecen aquí a medida que las apps los añaden a la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments apparaissent ici à mesure que les apps les ajoutent à la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi compaiono qui man mano che le app li aggiungono alla barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appがメニューバーに項目を追加すると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 메뉴 막대에 항목을 추가하면 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens aparecem aqui à medida que os apps os adicionam à barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты появляются здесь по мере того, как приложения добавляют их в строку меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 将项目添加到菜单栏时，它们会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 將項目加入選單列時，項目會顯示在這裡。"
          }
        }
      }
    },
    "Items shown by hovering always hide this way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Darüberfahren eingeblendete Objekte werden immer so ausgeblendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ítems mostrados al pasar el puntero siempre se ocultan así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments affichés par survol se masquent toujours de cette façon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi mostrati al passaggio del puntatore si nascondono sempre in questo modo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタを合わせて表示した項目は、常にこの方法で隠れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터를 올려 표시한 항목은 항상 이 방식으로 숨겨집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens exibidos ao passar o ponteiro sempre se ocultam assim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты, показанные наведением, всегда скрываются так."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过悬停显示的项目始终以这种方式隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過指標停留顯示的項目一律會以此方式隱藏。"
          }
        }
      }
    },
    "Its apps keep running; only the saved layout is removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apps laufen weiter; nur das gesicherte Layout wird entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus apps siguen abiertas; solo se elimina la distribución guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses apps restent ouvertes ; seule la disposition enregistrée est supprimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue app continuano a funzionare; viene rimosso solo il layout salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appは実行されたままで、保存したレイアウトだけが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 계속 실행되며, 저장된 레이아웃만 제거됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus apps continuam em execução; apenas o layout salvo é removido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения продолжат работать; удаляется только сохраненное расположение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其 App 会继续运行；只会移除已存储的布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其 App 會繼續執行；只會移除已儲存的佈局。"
          }
        }
      }
    },
    "Its firmware has none of the charging switches MacToys knows, so MacToys leaves charging alone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Firmware hat keinen der Ladeschalter, die MacToys kennt, daher greift MacToys nicht ins Laden ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su firmware no tiene ninguno de los interruptores de carga que conoce MacToys, así que MacToys no toca la carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son firmware ne dispose d’aucun des commutateurs de charge que MacToys connaît : MacToys ne touche donc pas à la charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo firmware non ha nessuno degli interruttori di carica noti a MacToys, quindi MacToys non interviene sulla carica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのファームウェアにはMacToysが認識している充電スイッチがないため、MacToysは充電を制御しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펌웨어에 MacToys가 아는 충전 스위치가 없으므로 MacToys는 충전을 변경하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O firmware dele não tem nenhum dos controles de carregamento que o MacToys conhece, então o MacToys não mexe no carregamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В его прошивке нет известных MacToys переключателей зарядки, поэтому MacToys не вмешивается в зарядку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其固件中没有 MacToys 已知的充电开关，因此 MacToys 不会干预充电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其韌體沒有任何 MacToys 認得的充電開關，因此 MacToys 不會更動充電。"
          }
        }
      }
    },
    "Its firmware reports %@ in a format MacToys doesn't know, so MacToys leaves charging alone.": {
      "comment": "The placeholder lists SMC keys with their formats",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Firmware meldet %@ in einem Format, das MacToys nicht kennt, daher greift MacToys nicht ins Laden ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su firmware indica %@ en un formato que MacToys no conoce, así que MacToys no toca la carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son firmware indique %@ dans un format que MacToys ne connaît pas : MacToys ne touche donc pas à la charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo firmware riporta %@ in un formato che MacToys non conosce, quindi MacToys non interviene sulla carica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファームウェアがMacToysの認識しない形式で%@を報告しているため、MacToysは充電を制御しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펌웨어가 MacToys가 모르는 형식으로 %@을(를) 보고하므로 MacToys는 충전을 변경하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O firmware dele informa %@ em um formato que o MacToys não conhece, então o MacToys não mexe no carregamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его прошивка сообщает %@ в неизвестном MacToys формате, поэтому MacToys не вмешивается в зарядку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其固件以 MacToys 无法识别的格式报告 %@，因此 MacToys 不会干预充电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其韌體以 MacToys 不認得的格式回報 %@，因此 MacToys 不會更動充電。"
          }
        }
      }
    },
    "Its limit is %@; the battery stops at whichever limit is lower. Turn one of them off.": {
      "comment": "The placeholder is the macOS charge limit",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das macOS-Limit liegt bei %@; die Batterie stoppt beim niedrigeren der beiden. Eines davon ausschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su límite es %@; la batería se detiene en el límite más bajo. Desactiva uno de los dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa limite est de %@ ; la batterie s’arrête à la limite la plus basse des deux. Désactivez l’une d’elles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo limite è %@; la batteria si ferma al limite più basso. Disattivane uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSの上限は%@です。バッテリーはどちらか低いほうの上限で停止します。どちらかをオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS의 한도는 %@이며, 배터리는 둘 중 더 낮은 한도에서 충전을 멈춥니다. 둘 중 하나를 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite dele é %@; a bateria para no limite que for menor. Desative um deles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничение macOS — %@; зарядка останавливается на меньшем из ограничений. Выключите одно из них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其上限为 %@；电池会在较低的上限处停止充电。请关闭其中一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其上限為 %@；電池會停在較低的上限。請關閉其中一個。"
          }
        }
      }
    },
    "Its modifiers stay held while you hop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sondertasten bleiben beim Wechseln gedrückt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus teclas modificadoras siguen pulsadas mientras saltas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses modificateurs restent maintenus pendant que vous passez d’une fenêtre à l’autre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modificatori restano premuti mentre passi tra le finestre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動中は修飾キーが押されたままになります"
