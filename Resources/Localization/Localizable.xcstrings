    "Some monitors don't wake up from software. You may need to press the monitor's power button or reconnect its cable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Monitore lassen sich nicht per Software wecken. Eventuell muss der Ein-/Ausschalter des Monitors gedrückt oder das Kabel neu angeschlossen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos monitores no se reactivan por software. Puede que tengas que pulsar el botón de encendido del monitor o volver a conectar su cable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains moniteurs ne se réveillent pas par logiciel. Vous devrez peut-être appuyer sur le bouton d’alimentation du moniteur ou rebrancher son câble."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni monitor non si riattivano via software. Potrebbe essere necessario premere il pulsante di accensione del monitor o ricollegarne il cavo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソフトウェアからスリープ解除しないモニタもあります。モニタの電源ボタンを押すか、ケーブルを接続し直す必要がある場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 모니터는 소프트웨어로 깨어나지 않습니다. 모니터의 전원 버튼을 누르거나 케이블을 다시 연결해야 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns monitores não acordam por software. Talvez seja preciso pressionar o botão liga/desliga do monitor ou reconectar o cabo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые мониторы не пробуждаются программно. Может понадобиться нажать кнопку питания монитора или переподключить кабель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分显示器无法通过软件唤醒。你可能需要按显示器的电源按钮或重新连接其线缆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些顯示器無法透過軟體喚醒。你可能需要按顯示器的電源按鈕或重新連接其連接線。"
          }
        }
      }
    },
    "Something went wrong": {
