          }
        }
      }
    },
    "The window closes once the ring fills — lift early to keep it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster wird geschlossen, sobald der Ring voll ist – früher loslassen, um es zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana se cierra cuando se llena el anillo — levanta los dedos antes para conservarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre se ferme une fois l’anneau rempli — relâchez avant pour la garder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra si chiude quando l'anello si riempie — solleva prima per mantenerla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リングが満ちるとウインドウが閉じます — 途中で指を離すと閉じません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링이 채워지면 윈도우가 닫힙니다 — 유지하려면 그 전에 손을 떼세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela fecha quando o anel se preenche — solte antes para mantê-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно закроется, когда кольцо заполнится, — поднимите пальцы раньше, чтобы оставить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆环填满后窗口会关闭 — 提早抬起手指可保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圓環填滿後視窗就會關閉 — 提早抬起即可保留。"
          }
        }
      }
    },
    "The window closes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster wird geschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana se cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre se ferme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra si chiude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 닫힙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela fecha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно закрывается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口会关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗會關閉。"
          }
        }
      }
    },
    "The window enters full screen. Swipe down on it to leave.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster wechselt in den Vollbildmodus. Zum Beenden darauf nach unten wischen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana pasa a pantalla completa. Desliza hacia abajo sobre ella para salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre passe en plein écran. Balayez vers le bas dessus pour en sortir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra passa a tutto schermo. Scorri verso il basso su di essa per uscire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウがフルスクリーンになります。ウインドウ上で下にスワイプすると解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 전체 화면으로 전환됩니다. 종료하려면 윈도우에서 아래로 쓸어넘기세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela entra em tela cheia. Deslize para baixo nela para sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно переходит в полноэкранный режим. Смахните по нему вниз, чтобы выйти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口进入全屏幕。在其上向下轻扫即可退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗會進入全螢幕。在其上向下滑動即可離開。"
          }
        }
      }
    },
    "The window fills the screen, menu bar and Dock left clear.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster füllt den Bildschirm, Menüleiste und Dock bleiben frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana llena la pantalla, dejando libres la barra de menús y el Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre remplit l’écran, en laissant la barre des menus et le Dock dégagés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra riempie lo schermo, lasciando libere la barra dei menu e il Dock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが画面いっぱいに表示されます。メニューバーとDockには重なりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대와 Dock을 가리지 않고 윈도우가 화면을 채웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela preenche a tela, deixando livres a barra de menus e o Dock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно заполняет экран, не заходя на строку меню и Dock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口填满屏幕，并避开菜单栏和程序坞。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗會填滿螢幕，避開選單列和 Dock。"
          }
        }
      }
    },
    "The window moves to the display that way, keeping its tile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster wechselt auf das Display in dieser Richtung und behält seine Kachel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana pasa a la pantalla en esa dirección y conserva su casilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre passe à l’écran situé dans cette direction, en gardant son emplacement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra si sposta sul monitor in quella direzione, mantenendo il suo riquadro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウがタイルを保ったまま、その方向のディスプレイに移動します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 타일 위치를 유지한 채 해당 방향의 디스플레이로 이동함"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela passa para o monitor naquela direção, mantendo o bloco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно переходит на дисплей в этом направлении, сохраняя свою плитку"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口会移到该方向的显示器，并保持其平铺位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗會移到該方向的顯示器，並保持其並排位置"
          }
        }
      }
    },
    "The window takes the left half of the screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster nimmt die linke Bildschirmhälfte ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana ocupa la mitad izquierda de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre occupe la moitié gauche de l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra occupa la metà sinistra dello schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが画面の左半分に配置されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 화면의 왼쪽 절반을 차지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela ocupa a metade esquerda da tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно занимает левую половину экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口占据屏幕左半部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗會佔據螢幕的左半部。"
          }
        }
      }
    },
    "The window takes the left half. Swipe again for a third, then two thirds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster nimmt die linke Hälfte ein. Erneut wischen für ein Drittel, dann zwei Drittel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana ocupa la mitad izquierda. Desliza otra vez para un tercio y luego dos tercios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre occupe la moitié gauche. Balayez de nouveau pour un tiers, puis deux tiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra occupa la metà sinistra. Scorri di nuovo per un terzo, poi due terzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが左半分に配置されます。もう一度スワイプすると1/3、さらに2/3になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 왼쪽 절반을 차지합니다. 다시 쓸어넘기면 1/3, 그다음 2/3이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela ocupa a metade esquerda. Deslize de novo para um terço e depois dois terços."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно занимает левую половину. Смахните еще раз — треть, затем две трети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口占据左半部分。再次轻扫变为三分之一，然后变为三分之二。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗會佔據左半部。再滑動一次可改為三分之一，接著三分之二。"
          }
        }
      }
    },
    "The window under the pointer comes forward after a short pause": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster unter dem Zeiger kommt nach einer kurzen Pause nach vorne"
          }
        },
