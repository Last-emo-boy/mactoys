    "Every display is hidden. Show them again in Power Display settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Displays sind ausgeblendet. In den Einstellungen von Power Display wieder einblenden."
          }
        },
        "es": {
          "stringUnit": {
