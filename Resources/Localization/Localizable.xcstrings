          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麦克风权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麥克風取用權限。"
          }
        }
      }
    },
    "Needs Screen Recording. Without it, windows are shown as app icons with their titles": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert „Bildschirmaufnahme“. Ohne diese Berechtigung werden Fenster als App-Symbole mit ihren Titeln angezeigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita Grabación de pantalla. Sin ella, las ventanas se muestran como iconos de app con sus títulos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite Enregistrement de l’écran. Sans cela, les fenêtres apparaissent sous forme d’icônes d’app avec leur titre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede Registrazione schermo. Senza, le finestre vengono mostrate come icone delle app con i loro titoli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録が必要です。許可しない場合、ウインドウはAppアイコンとタイトルで表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록 권한이 필요합니다. 권한이 없으면 윈도우가 앱 아이콘과 제목으로 표시됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer Gravação de Tela. Sem ela, as janelas são mostradas como ícones de apps com seus títulos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение «Запись экрана». Без него окна показываются как значки приложений с заголовками"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要屏幕录制权限。没有该权限时，窗口会显示为 App 图标及其标题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要螢幕錄製權限。若未授予，視窗會以 App 圖像加上標題顯示"
          }
        }
      }
    },
    "Needs ffmpeg or LAME (brew install lame); macOS has no MP3 encoder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert ffmpeg oder LAME (brew install lame); macOS hat keinen MP3-Encoder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita ffmpeg o LAME (brew install lame); macOS no incluye ningún codificador MP3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite ffmpeg ou LAME (brew install lame) ; macOS n’a pas d’encodeur MP3."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede ffmpeg o LAME (brew install lame); macOS non ha un codificatore MP3."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpegまたはLAME（brew install lame）が必要です。macOSにはMP3エンコーダがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg 또는 LAME(brew install lame)이 필요합니다. macOS에는 MP3 인코더가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer ffmpeg ou LAME (brew install lame); o macOS não tem codificador MP3."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется ffmpeg или LAME (brew install lame); в macOS нет кодировщика MP3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 ffmpeg 或 LAME（brew install lame）；macOS 没有 MP3 编码器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 ffmpeg 或 LAME（brew install lame）；macOS 沒有 MP3 編碼器。"
          }
        }
      }
    },
    "Negative values switch earlier.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Negative Werte schalten früher um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores negativos cambian antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs négatives basculent plus tôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori negativi anticipano il cambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負の値にすると早く切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음수 값이면 더 일찍 전환됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores negativos alternam mais cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отрицательные значения переключают раньше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负值会提前切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "負值會提早切換。"
          }
        }
      }
    },
