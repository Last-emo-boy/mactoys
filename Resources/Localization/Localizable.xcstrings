      }
    },
    "Lock, blur or hide — right where you are": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperren, weichzeichnen oder ausblenden – direkt vor Ort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea, desenfoca u oculta — justo donde estás"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillez, floutez ou masquez, sans bouger"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca, sfoca o nascondi — proprio dove sei"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック、ぼかし、非表示 — その場ですぐに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 있는 곳에서 바로 잠그기, 흐리게 하기, 가리기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueie, desfoque ou oculte — onde você estiver"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокируйте, размывайте или скрывайте — прямо там, где вы находитесь"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定、模糊或隐藏 — 就在原地"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定、模糊或隱藏 — 就在你所在的地方"
          }
        }
      }
    },
    "Lock, sleep, restart, shut down and more": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperren, Ruhezustand, Neustart, Ausschalten und mehr"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear, reposo, reiniciar, apagar y más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller, suspendre l’activité, redémarrer, éteindre et plus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca, metti in stop, riavvia, spegni e altro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック、スリープ、再起動、システム終了など"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠그기, 잠자기, 재시동, 시스템 종료 등"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear, colocar em repouso, reiniciar, desligar e mais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка, сон, перезагрузка, выключение и другое"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定、睡眠、重新启动、关机等"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定、睡眠、重新開機、關機等"
          }
        }
      }
    },
    "Lock, sleep, restart, shut down, log out, empty the Trash, toggle Dark Mode and more": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperren, Ruhezustand, Neustart, Ausschalten, Abmelden, Papierkorb entleeren, Dunkelmodus umschalten und mehr"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear, reposo, reiniciar, apagar, cerrar sesión, vaciar la Papelera, activar o desactivar el modo oscuro y más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller, suspendre l’activité, redémarrer, éteindre, fermer la session, vider la corbeille, activer le mode sombre et plus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca, metti in stop, riavvia, spegni, esegui il logout, svuota il Cestino, attiva/disattiva la modalità scura e altro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック、スリープ、再起動、システム終了、ログアウト、ゴミ箱を空にする、ダークモードの切り替えなど"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠그기, 잠자기, 재시동, 시스템 종료, 로그아웃, 휴지통 비우기, 다크 모드 전환 등"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear, colocar em repouso, reiniciar, desligar, encerrar sessão, esvaziar o Lixo, alternar o Modo Escuro e mais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка, сон, перезагрузка, выключение, завершение сеанса, очистка Корзины, переключение темного режима и другое"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定、睡眠、重新启动、关机、退出登录、清倒废纸篓、切换深色模式等"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定、睡眠、重新開機、關機、登出、清空垃圾桶、切換深色模式等"
          }
        }
      }
    },
