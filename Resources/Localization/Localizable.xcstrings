    "Switches back after 15 seconds unless you keep it, in case the display can't show it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt nach 15 Sekunden zurück, sofern sie nicht beibehalten wird – für den Fall, dass das Display sie nicht darstellen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a la anterior tras 15 segundos si no la mantienes, por si la pantalla no puede mostrarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revient en arrière après 15 secondes si vous ne la gardez pas, au cas où l’écran ne pourrait pas l’afficher."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイが表示できない場合に備え、維持しないと15秒後に元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이가 표시하지 못하는 경우에 대비해, 유지하지 않으면 15초 후 원래대로 돌아갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta após 15 segundos, a menos que você a mantenha, caso o monitor não consiga exibi-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если не сохранить разрешение, через 15 секунд вернется прежнее — на случай, если дисплей не может его показать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你不保留，15 秒后会切换回去，以防显示器无法显示该分辨率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你選擇保留，否則會在 15 秒後切換回來，以防顯示器無法顯示。"
          }
        }
      }
    },
    "Switches right away; the schedule resumes at its next change.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt sofort; der Zeitplan setzt bei seiner nächsten Änderung wieder ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de inmediato; la programación se reanuda en su siguiente cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bascule immédiatement ; la programmation reprend à son prochain changement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia subito; la programmazione riprende alla modifica successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに切り替わります。スケジュールは次の切り替え時刻から再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 전환되며, 다음 변경 시점부터 일정이 다시 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna imediatamente; a programação é retomada na próxima mudança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключает сразу; расписание продолжится со следующего изменения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即切换；时间表会在下一次变化时恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即切換；排程會在下次變更時恢復。"
          }
        }
      }
    },
    "Switches you don't pick stay one click away under More Switches.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht ausgewählte Schalter bleiben unter „Weitere Schalter“ einen Klick entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los interruptores que no elijas siguen a un clic en Más interruptores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les interrupteurs que vous ne choisissez pas restent à un clic, sous Plus d’interrupteurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択しなかったスイッチは、“そのほかのスイッチ”からクリックひとつで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택하지 않은 스위치는 추가 스위치 아래에서 클릭 한 번으로 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alternadores que você não escolher ficam a um clique, em Mais Alternadores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невыбранные переключатели доступны одним нажатием в разделе «Другие переключатели»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你未选取的开关可在“更多开关”下一键访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你未選擇的開關會收在「更多開關」下，按一下即可使用。"
          }
        }
      }
    },
    "Switching back in %lld seconds unless you keep it.": {
      "comment": "Resolution confirmation countdown; the placeholder is a number of seconds",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Wechselt in %lld Sekunde zurück, sofern sie nicht beibehalten wird."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Wechselt in %lld Sekunden zurück, sofern sie nicht beibehalten wird."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Switching back in %lld second unless you keep it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Switching back in %lld seconds unless you keep it."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
