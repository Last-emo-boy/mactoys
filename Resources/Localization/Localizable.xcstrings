    "The selected items are added to it.": {
      "comment": "New pinboard dialog",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Objekte werden hinzugefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ítems seleccionados se añaden a él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments sélectionnés y sont ajoutés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vengono aggiunti gli elementi selezionati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目が追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목이 여기에 추가됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens selecionados são adicionados a ele."
          }
        },
        "ru": {
