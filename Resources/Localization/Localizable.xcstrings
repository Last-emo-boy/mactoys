          }
        }
      }
    },
    "Charging resumes as soon as the battery drops below the limit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laden wird fortgesetzt, sobald die Batterie unter das Limit fällt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga se reanuda en cuanto la batería baja del límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge reprend dès que la batterie descend sous la limite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La carica riprende appena la batteria scende sotto il limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーが上限を下回るとすぐに充電が再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리가 한도 아래로 내려가면 바로 충전이 재개됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O carregamento é retomado assim que a bateria fica abaixo do limite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарядка возобновится, как только заряд опустится ниже ограничения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池电量一旦降到上限以下，就会恢复充电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電池電量一低於上限就會恢復充電。"
          }
        }
      }
    },
    "Charging resumes below %@.": {
      "comment": "The placeholder is a temperature",
      "localizations": {
        "de": {
