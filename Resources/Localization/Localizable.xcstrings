    "Drag the window anywhere; drag its corner grip to resize it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster beliebig ziehen; zum Ändern der Größe am Eckgriff ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la ventana a cualquier sitio; arrastra el tirador de su esquina para redimensionarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser la fenêtre n’importe où ; faites glisser la poignée de son coin pour la redimensionner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウは任意の場所にドラッグできます。サイズを変更するには隅のつまみをドラッグします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 아무 곳으로나 드래그하고, 모서리 손잡이를 드래그하여 크기를 조절하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a janela para qualquer lugar; arraste a alça do canto para redimensioná-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягивайте окно куда угодно; перетяните его угол, чтобы изменить размер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将窗口拖到任意位置；拖移其角落的手柄可调整大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可將視窗拖移到任何位置；拖移其角落的把手即可調整大小。"
          }
        }
      }
    },
