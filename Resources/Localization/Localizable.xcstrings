    "See which processes are using a file or folder, and end them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen, welche Prozesse eine Datei oder einen Ordner verwenden, und sie beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué procesos están usando un archivo o una carpeta y finalízalos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez quels processus utilisent un fichier ou un dossier, et terminez-les."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri quali processi stanno usando un file o una cartella e terminali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルやフォルダを使用しているプロセスを確認して、終了できます。"
