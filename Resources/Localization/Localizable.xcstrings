            "state": "translated",
            "value": "單獨點按時"
          }
        }
      }
    },
    "Where": {
      "comment": "Detail row: the folder that contains the item, like Finder's Get Info\nRemap sheet section: the apps the remap applies in",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置"
          }
        }
      }
    },
    "Which previewer macOS uses": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 使用哪个预览器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 使用的預覽程式"
          }
        }
      }
    },
    "While Auto Hide Cursor has hidden it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在自动隐藏指针将其隐藏期间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「自動隱藏游標」將其隱藏期間。"
          }
        }
      }
    },
    "While an app in the second list is in front, the modifier and clicks reach it as usual — useful for games and apps with their own modifier-drag gestures.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当第二个列表中的 App 位于前台时，修饰键和点按会照常传递给它 — 适用于游戏和自带修饰键拖移手势的 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當第二個列表中的 App 位於最前方時，修飾鍵和點按會照常傳給該 App — 適用於遊戲和具有自己修飾鍵拖移手勢的 App。"
          }
        }
      }
    },
    "While another window is in front, a pinned window shows a live mirror of itself. Point at it or click it to use the real window.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当其他窗口位于前面时，置顶窗口会显示其自身的实时镜像。指向或点按它即可使用真实窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當其他視窗位於前方時，釘選的視窗會顯示其本身的即時鏡像。指向或按一下即可使用真正的視窗。"
          }
        }
      }
    },
    "While dragging (mouse wheel) or with a quick layout key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移时（鼠标滚轮）或使用快速布局键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移時（滑鼠滾輪）或使用快速佈局鍵"
          }
        }
      }
    },
    "While holding ⇧": {
      "comment": "Activation: only while the Shift key is held",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⇧ 时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⇧ 時"
          }
        }
      }
    },
    "While holding ⌃": {
      "comment": "Activation: only while the Control key is held",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌃ 时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌃ 時"
          }
        }
      }
    },
    "While process %lld runs · %@": {
      "comment": "Awake status: first a process id, then the screen state, e.g. 'screen stays on'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "While process %1$lld runs · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进程 %1$lld 运行期间 · %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "程序 %1$lld 執行期間 · %2$@"
          }
        }
      }
    },
    "While the screen is locked only the Mac is kept awake; the displays follow your Lock Screen settings. Turning the screen back on resumes on unlock.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕锁定时只会让 Mac 保持唤醒；显示器遵循你的锁定屏幕设置。解锁后会恢复屏幕开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕鎖定期間只會讓 Mac 保持喚醒；顯示器則依照你的「鎖定畫面」設定。重新開啟螢幕會在解鎖時恢復。"
          }
        }
      }
    },
    "While you use any Mac of the group.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你使用该组中的任意一台 Mac 时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你使用群組中的任何 Mac 時。"
          }
        }
      }
    },
