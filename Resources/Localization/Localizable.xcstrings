          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「1. 報告」會顯示並建立為「報告」：使用數字即可排列範本的順序。"
          }
        }
      }
    },
    "“Report.docx” is shown as “Report”.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“报告.docx”会显示为“报告”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「報告.docx」會顯示為「報告」。"
          }
        }
      }
    },
    "“When held” must be a modifier key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“按住时”必须是修饰键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「按住時」必須是修飾鍵。"
          }
        }
      }
    },
    "← also starts at the first character instead of the last.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "← 也会从第一个字符而非最后一个字符开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "← 也會從第一個字元開始，而不是最後一個。"
          }
        }
      }
    },
    "← and → step through zone numbers; ↑ and ↓ stay with the app": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "← 和 → 按区域编号切换；↑ 和 ↓ 照常由 App 使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "← 和 → 依區域編號切換；↑ 和 ↓ 則保持在同一個 App"
          }
        }
      }
    },
    "↑ ↓ adjust · H hide · Esc to end": {
      "comment": "Break timer key hints; H is the letter key",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓ 调整 · H 隐藏 · Esc 结束"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓ 調整 · H 隱藏 · Esc 結束"
          }
        }
      }
    },
    "↵ pastes into the front app": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "↵ 粘贴到最前面的 App"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "↵ 貼到最前方的 App"
          }
        }
      }
    },
    "↵ runs the command": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "↵ 运行命令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "↵ 執行指令"
          }
        }
      }
    },
    "⌃ ⌥ C picks any pixel on screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ C 可选取屏幕上的任意像素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ C 可選取螢幕上的任何像素。"
          }
        }
      }
    },
    "⌃ ⌥ T copies text from anything with OCR.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ T 可通过 OCR 从任何内容中拷贝文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ T 可使用 OCR 從任何內容拷貝文字。"
          }
        }
      }
    },
    "⌃⌘  Control-Command": {
      "comment": "Modifier keys; keep the key symbols",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘  Control-Command"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘  Control-Command"
          }
        }
      }
    },
    "⌃⌥  Control-Option": {
      "comment": "Modifier keys; keep the key symbols",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥  Control-Option"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥  Control-Option"
          }
        }
      }
    },
    "⌥  Option": {
      "comment": "Modifier key; keep the key symbol",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥  Option"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥  Option"
          }
        }
      }
    },
    "⌥ Space finds apps, files, windows and commands.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ 空格键可查找 App、文件、窗口和命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ 空白鍵可尋找 App、檔案、視窗和指令。"
          }
        }
      }
    },
    "⌥⇧1…⌥⇧9 always selects": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⇧1…⌥⇧9 始终选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⇧1⋯⌥⇧9 一律會選取"
          }
        }
      }
    },
    "⌥⌘  Option-Command": {
      "comment": "Modifier keys; keep the key symbols",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⌘  Option-Command"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⌘  Option-Command"
          }
        }
      }
    },
    "⌫ moves the previewed file to the Trash; folders are never deleted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫ 会将预览的文件移到废纸篓；文件夹永远不会被删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫ 會將預覽中的檔案丟到垃圾桶；檔案夾絕不會被刪除"
          }
        }
      }
    }
  },
  "version": "1.0"
}
