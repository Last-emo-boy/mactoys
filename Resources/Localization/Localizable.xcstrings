        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 MacToys 사본은 Bluetooth를 사용할 수 없습니다. 제어 센터에서 기기를 연결하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia do MacToys não pode usar o Bluetooth. Conecte dispositivos pela Central de Controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта копия MacToys не может использовать Bluetooth. Подключайте устройства из Пункта управления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 MacToys 副本无法使用蓝牙。请从控制中心连接设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 MacToys 版本無法使用藍牙。請從控制中心連接裝置。"
          }
        }
      }
    },
