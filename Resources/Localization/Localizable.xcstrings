    "The panel opens on the display with the pointer; the paste bar runs along its bottom.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster öffnet sich auf dem Display mit dem Zeiger; die Einsetzleiste verläuft an dessen unterem Rand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel se abre en la pantalla con el puntero; la barra de pegado recorre su parte inferior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panneau s’ouvre sur l’écran où se trouve le pointeur ; la barre de collage longe son bord inférieur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pannello si apre sul monitor con il puntatore; la barra incolla corre lungo il suo bordo inferiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルはポインタがあるディスプレイに開き、ペーストバーはその下端に沿って表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널은 포인터가 있는 디스플레이에서 열리며, 붙여넣기 막대는 그 디스플레이 하단을 따라 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O painel abre no monitor com o ponteiro; a barra de colagem fica ao longo da parte inferior dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель открывается на дисплее с указателем; лента вставки проходит вдоль его нижнего края."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板会在指针所在的显示器上打开；粘贴栏沿该显示器底部显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板會在指標所在的顯示器上打開；貼上列則沿著其底部顯示。"
          }
        }
      }
    },
    "The pointer rests in empty menu bar space": {
