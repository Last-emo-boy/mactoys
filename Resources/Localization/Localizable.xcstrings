        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "间距工具会在边缘处停止；按住 ⇧ 点按可保留测量结果，滚动可更改容差。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
