            "value": "ロック、スリープ、再起動、システム終了、ログアウト、ゴミ箱を空にする、ダークモードの切り替えなど"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠그기, 잠자기, 재시동, 시스템 종료, 로그아웃, 휴지통 비우기, 다크 모드 전환 등"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear, colocar em repouso, reiniciar, desligar, encerrar sessão, esvaziar o Lixo, alternar o Modo Escuro e mais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка, сон, перезагрузка, выключение, завершение сеанса, очистка Корзины, переключение темного режима и другое"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定、睡眠、重新启动、关机、退出登录、清倒废纸篓、切换深色模式等"
          }
        },
        "zh-Hant": {
          "stringUnit": {
