    "Segments end at [end]. Also: [enter] [up] [down] [left] [right] [pause:n] [paste]…[/paste]. Clipboard text starting with [start] is used instead.": {
      "comment": "Keep the bracketed tags such as [end], [pause:n] and [paste] unchanged: they are DemoType script commands.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Segmente enden bei [end]. Außerdem: [enter] [up] [down] [left] [right] [pause:n] [paste]…[/paste]. Text in der Zwischenablage, der mit [start] beginnt, wird stattdessen verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los segmentos terminan en [end]. También: [enter] [up] [down] [left] [right] [pause:n] [paste]…[/paste]. Si el texto del portapapeles empieza por [start], se usa en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les segments se terminent à [end]. Aussi : [enter] [up] [down] [left] [right] [pause:n] [paste]…[/paste]. Le texte du presse-papiers commençant par [start] est utilisé à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segmenti terminano con [end]. Inoltre: [enter] [up] [down] [left] [right] [pause:n] [paste]…[/paste]. Viene usato invece il testo degli appunti che inizia con [start]."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セグメントは[end]で終わります。そのほか: [enter] [up] [down] [left] [right] [pause:n] [paste]…[/paste]。[start]で始まるクリップボードのテキストがある場合は、そちらが使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세그먼트는 [end]에서 끝납니다. 기타: [enter] [up] [down] [left] [right] [pause:n] [paste]…[/paste]. [start]로 시작하는 클립보드 텍스트가 있으면 대신 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os segmentos terminam em [end]. Também: [enter] [up] [down] [left] [right] [pause:n] [paste]…[/paste]. O texto da área de transferência que começa com [start] é usado no lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагменты заканчиваются на [end]. Также: [enter] [up] [down] [left] [right] [pause:n] [paste]…[/paste]. Если текст в буфере обмена начинается с [start], используется он."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每段以 [end] 结束。另有：[enter] [up] [down] [left] [right] [pause:n] [paste]…[/paste]。如果剪贴板文本以 [start] 开头，则改用剪贴板文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "段落在 [end] 結束。另有：[enter] [up] [down] [left] [right] [pause:n] [paste]…[/paste]。若剪貼板文字以 [start] 開頭，則改用該文字。"
          }
        }
      }
    },
