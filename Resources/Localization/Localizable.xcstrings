          "stringUnit": {
            "state": "translated",
            "value": "將疊加顯示的範例拖移到你想要的位置。"
          }
        }
      }
    },
    "Drag a window onto another to swap them": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fenster auf ein anderes ziehen, um sie zu tauschen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una ventana sobre otra para intercambiarlas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire glisser une fenêtre sur une autre pour les intervertir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina una finestra su un'altra per scambiarle"
          }
        },
        "ja": {
