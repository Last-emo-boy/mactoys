            "value": "Vuelve a pulsarlo, pulsa Esc o haz clic para quitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez de nouveau, sur Échap ou cliquez pour effacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi di nuovo l'abbreviazione, Esc o fai clic per rimuovere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
