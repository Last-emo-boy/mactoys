          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muovere il mouse intenzionalmente, fare clic o scorrere lo fa ricomparire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
