      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkel von Sonnenuntergang bis Sonnenaufgang am aktuellen Standort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscuro desde el atardecer hasta el amanecer donde estés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sombre du coucher au lever du soleil, selon votre position."
