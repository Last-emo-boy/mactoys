    "Keeps this Mac awake until the date and time set in Awake settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält diesen Mac bis zu dem in den Awake-Einstellungen festgelegten Zeitpunkt wach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene este Mac activo hasta la fecha y hora definidas en los ajustes de Awake."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient ce Mac éveillé jusqu’à la date et l’heure définies dans les réglages d’Awake."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene attivo questo Mac fino alla data e ora impostate nelle impostazioni di Awake."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Awakeの設定で指定した日時まで、このMacをスリープさせません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Awake 설정에서 지정한 날짜와 시간까지 이 Mac을 깨어 있게 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém este Mac ativo até a data e a hora definidas nos ajustes do Awake."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не будет засыпать до даты и времени, заданных в настройках Awake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让此 Mac 保持唤醒，直到 Awake 设置中设定的日期和时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
