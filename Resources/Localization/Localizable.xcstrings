            "value": "La zona en la que caerá una ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone où une fenêtre sera déposée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona in cui verrà rilasciata una finestra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウがドロップされるゾーン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 놓일 영역"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A zona em que a janela vai cair"
          }
