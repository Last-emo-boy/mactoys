    "${}, ${start=1}, ${increment=2}, ${padding=3} or combined: ${start=10,increment=2,padding=4}": {
      "comment": "PowerRename tooltip: keep the ${…} variables as they are",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "${}, ${start=1}, ${increment=2}, ${padding=3} oder kombiniert: ${start=10,increment=2,padding=4}"
          }
        },
        "es": {
          "stringUnit": {
