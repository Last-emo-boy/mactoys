        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scuro dal tramonto all'alba nella tua posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の日没から日の出までダーク。"
          }
