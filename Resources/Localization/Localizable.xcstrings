    "Pauses charging while the battery is too warm, at least five minutes at a time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert das Laden, solange die Batterie zu warm ist, jeweils mindestens fünf Minuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa la carga mientras la batería está demasiado caliente, al menos cinco minutos cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspend la charge lorsque la batterie est trop chaude, pendant au moins cinq minutes à chaque fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sospende la carica quando la batteria è troppo calda, per almeno cinque minuti alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーが温かくなりすぎた場合は、1回につき5分以上充電を一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 온도가 너무 높으면 충전을 한 번에 최소 5분 동안 일시 정지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa o carregamento enquanto a bateria estiver quente demais, por pelo menos cinco minutos de cada vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостанавливает зарядку, пока аккумулятор слишком теплый, каждый раз не менее чем на пять минут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池温度过高时暂停充电，每次至少五分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電池溫度過高時暫停充電，每次至少五分鐘。"
          }
        }
      }
    },
