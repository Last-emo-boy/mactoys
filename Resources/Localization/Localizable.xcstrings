    "Use letters, digits and underscores, not starting with a digit": {
      "comment": "Environment variable name problem",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchstaben, Ziffern und Unterstriche verwenden, nicht mit einer Ziffer beginnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa letras, dígitos y guiones bajos, sin empezar por un dígito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des lettres, des chiffres et des traits de soulignement, sans commencer par un chiffre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa lettere, cifre e trattini bassi, senza iniziare con una cifra"
