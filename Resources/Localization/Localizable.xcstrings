    "The tool that's selected when the toolbar opens.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo strumento selezionato all'apertura della barra strumenti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 막대가 열릴 때 선택되는 도구입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ferramenta selecionada quando a barra de ferramentas abre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具栏打开时选中的工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開工具列時選取的工具。"
          }
        }
      }
    },
    "The toolbar opens after you hold the letter alone; the letter is replaced only if you choose a character.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra strumenti si apre dopo aver tenuto premuta la sola lettera; la lettera viene sostituita solo se scegli un carattere."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자만 길게 누르면 도구 막대가 열리며, 문자를 선택한 경우에만 글자가 대체됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de ferramentas abre depois que você segura a letra sozinha; a letra só é substituída se você escolher um caractere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独按住字母后工具栏才会打开；只有选取字符时才会替换该字母。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單獨按住字母後工具列就會打開；只有在你選擇字元時才會取代該字母。"
          }
        }
      }
    },
    "The window under the pointer.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra sotto il puntatore."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터 아래에 있는 윈도우입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela sob o ponteiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针下方的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指標下方的視窗。"
          }
        }
      }
    },
    "The zone a window will drop into": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona in cui verrà rilasciata una finestra"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 놓일 영역"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A zona em que a janela vai cair"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口将要放入的区域"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗將放入的區域"
          }
        }
      }
    },
    "Their servers can tell when you preview a document": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I loro server possono sapere quando visualizzi l'anteprima di un documento"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서를 미리 볼 때 해당 서버에서 이를 알 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os servidores delas podem saber quando você pré-visualiza um documento"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像所在的服务器可以得知你何时预览了文稿"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影像的伺服器可以得知你何時預覽文件"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
