          }
        }
      }
    },
    "Windows": {
      "comment": "Provider name: open windows",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
