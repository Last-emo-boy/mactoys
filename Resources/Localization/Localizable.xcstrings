        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채우기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencher"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполнить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填充"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填滿"
          }
        }
      }
    },
    "Fill covers the size and crops the rest, Fit keeps the whole picture inside it, Stretch distorts it to the exact size. Leave width or height empty to keep the proportions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Füllen“ deckt die Größe ab und schneidet den Rest ab, „Einpassen“ behält das ganze Bild darin, „Strecken“ verzerrt es auf die exakte Größe. Breite oder Höhe leer lassen, um die Proportionen beizubehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellenar cubre el tamaño y recorta el resto, Ajustar mantiene toda la imagen dentro y Estirar la deforma hasta el tamaño exacto. Deja la anchura o la altura vacía para mantener las proporciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplir couvre la taille et rogne le reste, Ajuster garde toute l’image à l’intérieur, Étirer la déforme à la taille exacte. Laissez la largeur ou la hauteur vide pour conserver les proportions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riempi copre la dimensione e ritaglia il resto, Adatta mantiene l'intera immagine al suo interno, Allunga la deforma alla dimensione esatta. Lascia vuota la larghezza o l'altezza per mantenere le proporzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“フィル”はサイズ全体を覆って残りを切り取り、“フィット”は画像全体をサイズ内に収め、“ストレッチ”は正確なサイズに合わせて変形させます。縦横比を維持するには、幅または高さを空欄にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채우기는 지정한 크기를 덮고 나머지를 잘라내고, 맞추기는 전체 이미지를 크기 안에 유지하며, 늘리기는 정확한 크기에 맞게 왜곡합니다. 비율을 유지하려면 너비나 높이를 비워 두세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencher cobre o tamanho e recorta o resto, Ajustar mantém a imagem inteira dentro dele, Esticar a distorce para o tamanho exato. Deixe a largura ou a altura vazia para manter as proporções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Заполнить» покрывает размер и обрезает лишнее, «Вписать» помещает все изображение внутрь, «Растянуть» искажает его до точного размера. Оставьте ширину или высоту пустой, чтобы сохранить пропорции."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“填充”会铺满该尺寸并裁掉多余部分，“适应”会将整张图片保留在该尺寸内，“拉伸”会将其变形为精确尺寸。将宽度或高度留空即可保持比例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「填滿」會覆蓋整個大小並裁切多餘部分，「符合」會將整張圖片保留在範圍內，「延展」會將圖片變形成精確的大小。將寬度或高度留白即可維持比例。"
          }
        }
      }
    },
    "Fill the fields with the last search and replacement.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Felder mit der letzten Suche und Ersetzung füllen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena los campos con la última búsqueda y el último reemplazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplir les champs avec la dernière recherche et le dernier remplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compila i campi con l'ultima ricerca e sostituzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の検索文字列と置換文字列をフィールドに入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필드를 마지막 검색어와 바꿀 텍스트로 채웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencher os campos com a última busca e substituição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполнить поля последним поиском и заменой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用上一次的搜索和替换内容填充字段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用上次的搜尋和取代內容填入欄位。"
          }
        }
      }
