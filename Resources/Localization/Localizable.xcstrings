    "Drag Macs to arrange them · drop a file on a Mac to send it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macs zum Anordnen ziehen · Datei zum Senden auf einem Mac ablegen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los Mac para organizarlos · suelta un archivo en un Mac para enviarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les Mac pour les disposer · déposez un fichier sur un Mac pour l’envoyer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina i Mac per disporli · rilascia un file su un Mac per inviarlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macをドラッグして配置 · ファイルをMacにドロップして送信"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 드래그하여 배치 · Mac에 파일을 드롭하여 보내기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os Macs para organizá-los · solte um arquivo em um Mac para enviá-lo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягивайте Mac, чтобы расставить их · бросьте файл на Mac, чтобы отправить его"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移 Mac 以排列它们 · 将文件拖放到 Mac 上即可发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移 Mac 以排列 · 將檔案放到 Mac 上即可傳送"
          }
        }
      }
    },
    "Drag a Mac onto another slot to rearrange. Drop a file on a Mac to send it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Mac zum Umordnen auf einen anderen Platz ziehen. Eine Datei zum Senden auf einem Mac ablegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un Mac a otra posición para reorganizar. Suelta un archivo en un Mac para enviarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un Mac sur un autre emplacement pour réorganiser. Déposez un fichier sur un Mac pour l’envoyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un Mac su un'altra posizione per riordinare. Rilascia un file su un Mac per inviarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macをほかのスロットにドラッグして並べ替えます。ファイルをMacにドロップすると送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 다른 슬롯으로 드래그하여 재배치합니다. Mac에 파일을 드롭하면 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um Mac para outra posição para reorganizar. Solte um arquivo em um Mac para enviá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетяните Mac в другой слот, чтобы изменить порядок. Бросьте файл на Mac, чтобы отправить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Mac 拖到另一个位置以重新排列。将文件拖放到 Mac 上即可发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Mac 拖移到另一個位置即可重新排列。將檔案放到 Mac 上即可傳送。"
          }
        }
      }
    },
    "Drag a sample of the overlay to the spot you want.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Beispiel der Einblendung an die gewünschte Stelle ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una muestra de la superposición al lugar que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un exemple de la superposition à l’endroit voulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un esempio della sovrimpressione nel punto che preferisci."
          }
