    "Locks the app in front until Touch ID or your password unlock it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrt die vorderste App, bis Touch ID oder das Passwort sie entsperrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea la app del frente hasta que Touch ID o tu contraseña la desbloqueen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille l’app au premier plan jusqu’à son déverrouillage par Touch ID ou votre mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca l'app in primo piano finché Touch ID o la password non la sbloccano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch IDまたはパスワードでロックを解除するまで、前面のAppをロックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID 또는 암호로 잠금을 해제할 때까지 맨 앞의 앱을 잠급니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia o app em primeiro plano até que o Touch ID ou sua senha o desbloqueiem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует активное приложение, пока его не разблокируют Touch ID или пароль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定最前面的 App，直到用触控 ID 或密码解锁。"
          }
        },
        "zh-Hant": {
