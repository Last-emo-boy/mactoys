        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안 ⇧를 누르면 영역 활성화"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⇧ pressionada para ativar as zonas ao arrastar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
