    "Dims every window except the one you're using, for privacy on calls and in public.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelt alle Fenster außer dem verwendeten ab – für Privatsphäre bei Anrufen und in der Öffentlichkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenúa todas las ventanas salvo la que usas, para tener privacidad en llamadas y en público."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atténue toutes les fenêtres sauf celle que vous utilisez, pour plus de confidentialité en appel et en public."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenua tutte le finestre tranne quella che stai usando, per la privacy durante le chiamate e in pubblico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中のウインドウ以外をすべて暗くし、通話中や人前でのプライバシーを守ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 중이나 공공장소에서 개인정보를 보호할 수 있도록 사용 중인 윈도우를 제외한 모든 윈도우를 어둡게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurece todas as janelas, exceto a que você está usando, para ter privacidade em chamadas e em público."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемняет все окна, кроме того, с которым вы работаете, — для конфиденциальности во время звонков и в общественных местах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调暗当前窗口以外的所有窗口，在通话时和公共场所保护隐私。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調暗你正在使用的視窗以外的所有視窗，在通話和公共場所保護隱私。"
          }
        }
      }
    },
