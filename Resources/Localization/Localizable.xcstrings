    "This replaces every setting of the domain with this document (defaults import). Apps using it may need to be relaunched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ersetzt alle Einstellungen der Domain durch dieses Dokument (defaults import). Apps, die sie verwenden, müssen eventuell neu gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sustituye todos los ajustes del dominio por este documento (defaults import). Puede que haya que volver a abrir las apps que lo usan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action remplace tous les réglages du domaine par ce document (defaults import). Les apps qui l’utilisent devront peut-être être relancées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisce tutte le impostazioni del dominio con questo documento (defaults import). Le app che lo usano potrebbero dover essere riavviate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドメインのすべての設定がこの書類で置き換えられます（defaults import）。このドメインを使用しているAppは再起動が必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도메인의 모든 설정이 이 문서로 대체됩니다(defaults import). 이 도메인을 사용하는 앱은 다시 실행해야 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto substitui todos os ajustes do domínio por este documento (defaults import). Apps que o usam talvez precisem ser reabertos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все настройки домена будут заменены этим документом (defaults import). Использующие его приложения может понадобиться перезапустить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会用此文稿替换该域的所有设置（defaults import）。使用该域的 App 可能需要重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會以此文件取代該網域的所有設定（defaults import）。使用該網域的 App 可能需要重新啟動。"
          }
        }
      }
    },
    "This text is already in %@. Choose another language for Translate in Text Actions settings.": {
      "comment": "%@ is a language name",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Text ist bereits auf %@. In den Einstellungen für Textaktionen eine andere Sprache für „Übersetzen“ wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto ya está en %@. Elige otro idioma para Traducir en los ajustes de Acciones de texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce texte est déjà en %@. Choisissez une autre langue pour Traduire dans les réglages d’Actions de texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo testo è già in %@. Scegli un'altra lingua per Traduci nelle impostazioni di Azioni testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテキストはすでに%@です。“テキストアクション”設定で“翻訳”のほかの言語を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 텍스트는 이미 %@입니다. 텍스트 동작 설정에서 번역에 사용할 다른 언어를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto já está em %@. Escolha outro idioma para Traduzir nos ajustes das Ações de Texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст уже на этом языке: %@. Выберите другой язык для перевода в настройках «Действий с текстом»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文本已经是 %@。请在文本操作设置中为“翻译”选取其他语言。"
          }
        },
