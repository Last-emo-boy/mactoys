            "state": "translated",
            "value": "Mantén ⇧ para activar las zonas al arrastrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⇧ pour activer les zones pendant le glissement"
