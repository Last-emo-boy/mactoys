            "state": "translated",
            "value": "昨天"
          }
        }
      }
    },
    "“%@”": {
      "comment": "Launch progress title when done: the workspace name in quotes\nRemap action: types this text (quotes around it)"
    },
    "“%@” already exists, so a number is added": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已存在，因此加上編號"
          }
        }
      }
    },
    "“%@” instead of “%@”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@” instead of “%2$@”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」而非「%2$@」"
          }
        }
      }
    },
    "“%@” is already used in this dictionary.": {
      "comment": "The placeholder is a property list key",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已在此字典中使用。"
          }
        }
      }
    },
    "“%@” is not a folder": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是檔案夾"
          }
        }
      }
    },
    "“%@” is ready": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已就緒"
          }
        }
      }
    },
    "“%@” is reserved": {
      "comment": "PowerRename: the new name is . or .., which macOS reserves",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」為保留名稱"
          }
        }
      }
    },
    "“%@” isn't a valid %@ value.": {
      "comment": "First what the user typed, then a property list type such as 'String'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@” isn't a valid %2$@ value."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」不是有效的 %2$@ 值。"
          }
        }
      }
    },
    "“%@” isn't a valid boolean.": {
      "comment": "The placeholder is what the user typed",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是有效的布林值。"
          }
        }
      }
    },
    "“%@” isn't a valid date.": {
      "comment": "The placeholder is what the user typed",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是有效的日期。"
          }
        }
      }
    },
    "“%@” isn't a valid host name": {
      "comment": "Hosts entry problem; the placeholder is a host name",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是有效的主機名稱"
          }
        }
      }
    },
    "“%@” isn't a valid number.": {
      "comment": "The placeholder is what the user typed",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是有效的數字。"
          }
        }
      }
    },
    "“%@” isn't valid data.": {
      "comment": "The placeholder is what the user typed; data is raw bytes in hex",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是有效的資料。"
          }
        }
      }
    },
    "“%@” isn’t available": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用「%@」"
          }
        }
      }
    },
    "“%@” wasn’t found": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到「%@」"
          }
        }
      }
    },
    "“1. Report” is shown and created as “Report”: use numbers to order your templates.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「1. 報告」會顯示並建立為「報告」：使用數字即可排列範本的順序。"
          }
        }
      }
    },
    "“Report.docx” is shown as “Report”.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「報告.docx」會顯示為「報告」。"
          }
        }
      }
    },
    "“When held” must be a modifier key.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「按住時」必須是修飾鍵。"
          }
        }
      }
    },
    "← also starts at the first character instead of the last.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "← 也會從第一個字元開始，而不是最後一個。"
          }
        }
      }
    },
    "← and → step through zone numbers; ↑ and ↓ stay with the app": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "← 和 → 依區域編號切換；↑ 和 ↓ 則保持在同一個 App"
          }
        }
      }
    },
    "↑ ↓ adjust · H hide · Esc to end": {
      "comment": "Break timer key hints; H is the letter key",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓ 調整 · H 隱藏 · Esc 結束"
          }
        }
      }
    },
    "↵ pastes into the front app": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "↵ 貼到最前方的 App"
          }
        }
      }
    },
    "↵ runs the command": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "↵ 執行指令"
          }
        }
      }
    },
    "⌃ ⌥ C picks any pixel on screen.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ C 可選取螢幕上的任何像素。"
          }
        }
      }
    },
    "⌃ ⌥ T copies text from anything with OCR.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ T 可使用 OCR 從任何內容拷貝文字。"
          }
        }
      }
    },
    "⌃⌘  Control-Command": {
      "comment": "Modifier keys; keep the key symbols",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘  Control-Command"
          }
        }
      }
    },
    "⌃⌥  Control-Option": {
      "comment": "Modifier keys; keep the key symbols",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥  Control-Option"
          }
        }
      }
    },
    "⌥  Option": {
      "comment": "Modifier key; keep the key symbol",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥  Option"
          }
        }
      }
    },
    "⌥ Space finds apps, files, windows and commands.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ 空白鍵可尋找 App、檔案、視窗和指令。"
          }
        }
      }
    },
    "⌥⇧1…⌥⇧9 always selects": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⇧1⋯⌥⇧9 一律會選取"
          }
        }
      }
    },
    "⌥⌘  Option-Command": {
      "comment": "Modifier keys; keep the key symbols",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⌘  Option-Command"
          }
        }
      }
    },
    "⌫ moves the previewed file to the Trash; folders are never deleted": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫ 會將預覽中的檔案丟到垃圾桶；檔案夾絕不會被刪除"
          }
        }
      }
    }
  },
  "version": "1.0"
