          }
        }
      }
    },
    "The timers pause while another app keeps the display on, such as a video player or a video call.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Timer pausieren, solange eine andere App das Display eingeschaltet hält, etwa ein Videoplayer oder ein Videoanruf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temporizadores se pausan mientras otra app mantiene la pantalla encendida, como un reproductor de vídeo o una videollamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les minuteurs sont en pause tant qu’une autre app garde l’écran allumé, comme un lecteur vidéo ou un appel vidéo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I timer si sospendono mentre un'altra app tiene acceso il monitor, come un lettore video o una videochiamata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオプレーヤーやビデオ通話など、ほかのAppがディスプレイをオンのままにしている間は、タイマーが一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오 플레이어나 화상 통화처럼 다른 앱이 디스플레이를 켜 두는 동안에는 타이머가 일시 정지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os timers pausam enquanto outro app mantém a tela ligada, como um player de vídeo ou uma chamada de vídeo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймеры приостанавливаются, пока другое приложение не дает дисплею погаснуть, например видеоплеер или видеозвонок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他 App 让显示器保持开启时（如视频播放器或视频通话），计时器会暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他 App（例如影片播放程式或視訊通話）讓顯示器保持開啟時，計時器會暫停。"
          }
        }
      }
    },
    "The tool that's selected when the toolbar opens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Werkzeug, das beim Öffnen der Symbolleiste ausgewählt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La herramienta seleccionada al abrir la barra de herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’outil sélectionné à l’ouverture de la barre d’outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo strumento selezionato all'apertura della barra strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーを開いたときに選択されているツール。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 막대가 열릴 때 선택되는 도구입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ferramenta selecionada quando a barra de ferramentas abre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструмент, выбранный при открытии панели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具栏打开时选中的工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開工具列時選取的工具。"
          }
        }
      }
    },
    "The toolbar opens after you hold the letter alone; the letter is replaced only if you choose a character.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Symbolleiste erscheint, wenn der Buchstabe allein gehalten wird; der Buchstabe wird nur ersetzt, wenn ein Zeichen gewählt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de herramientas se abre cuando mantienes pulsada solo la letra; la letra solo se sustituye si eliges un carácter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d’outils s’ouvre quand vous maintenez la lettre seule ; la lettre n’est remplacée que si vous choisissez un caractère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra strumenti si apre dopo aver tenuto premuta la sola lettera; la lettera viene sostituita solo se scegli un carattere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字キーを単独で押したままにするとツールバーが開きます。文字は、別の文字を選択した場合にのみ置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자만 길게 누르면 도구 막대가 열리며, 문자를 선택한 경우에만 글자가 대체됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de ferramentas abre depois que você segura a letra sozinha; a letra só é substituída se você escolher um caractere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель открывается, если удерживать одну букву; буква заменяется, только если вы выберете символ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独按住字母后工具栏才会打开；只有选取字符时才会替换该字母。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單獨按住字母後工具列就會打開；只有在你選擇字元時才會取代該字母。"
          }
        }
      }
    },
