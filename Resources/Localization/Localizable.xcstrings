          }
        }
      }
    },
    "Scrolling in a window's content is never touched: only the title bar and toolbar take gestures.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrollen im Inhalt eines Fensters bleibt immer unberührt: Nur Titelleiste und Symbolleiste reagieren auf Gesten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desplazamiento en el contenido de una ventana nunca se ve afectado: solo la barra de título y la barra de herramientas aceptan gestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le défilement dans le contenu d’une fenêtre n’est jamais modifié : seules la barre de titre et la barre d’outils reçoivent les gestes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scorrimento nel contenuto di una finestra non viene mai toccato: solo la barra del titolo e la barra strumenti ricevono i gesti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウのコンテンツ内のスクロールには影響しません。ジェスチャを受け付けるのはタイトルバーとツールバーだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우 콘텐츠의 스크롤은 영향을 받지 않으며, 제목 막대와 도구 막대에서만 제스처가 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rolagem no conteúdo de uma janela nunca é afetada: somente a barra de título e a barra de ferramentas recebem gestos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутка содержимого окна не затрагивается: жесты принимают только строка заголовка и панель инструментов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不影响在窗口内容中滚动：只有标题栏和工具栏响应手势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不影響在視窗內容中捲動：只有標題列和工具列會接收手勢。"
          }
        }
      }
    },
