    "For apps that ignore text replaced through Accessibility. Your clipboard is put back afterwards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Apps, die über Bedienungshilfen ersetzten Text ignorieren. Die Zwischenablage wird danach wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para apps que ignoran el texto reemplazado mediante Accesibilidad. Después se restaura tu portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les apps qui ignorent le texte remplacé via Accessibilité. Votre presse-papiers est rétabli ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per le app che ignorano il testo sostituito tramite Accessibilità. Gli appunti vengono ripristinati subito dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティを通じて置き換えたテキストを無視するApp用。クリップボードはあとで元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용을 통해 바뀐 텍스트를 무시하는 앱용입니다. 이후에 클립보드 내용이 복원됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para apps que ignoram texto substituído pela Acessibilidade. Sua área de transferência é restaurada depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для приложений, которые игнорируют текст, замененный через универсальный доступ. Содержимое буфера обмена потом восстанавливается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于忽略通过辅助功能替换文本的 App。之后会恢复你的剪贴板内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於會忽略透過「輔助使用」取代之文字的 App。之後會回復你的剪貼板。"
          }
        }
      }
    },
