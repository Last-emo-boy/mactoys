    "Hide desktop icons, show hidden files, connect AirPods and more, from the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibtischsymbole ausblenden, versteckte Dateien anzeigen, AirPods verbinden und mehr – über die Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los iconos del escritorio, muestra los archivos ocultos, conecta los AirPods y más, desde la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez les icônes du bureau, affichez les fichiers cachés, connectez des AirPods et plus, depuis la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi le icone della scrivania, mostra i file nascosti, connetti gli AirPods e altro, dalla barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップアイコンを隠す、隠しファイルを表示する、AirPodsを接続するなどの操作をメニューバーから行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 데스크탑 아이콘 숨기기, 숨김 파일 보기, AirPods 연결 등을 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte ícones da mesa, mostre arquivos ocultos, conecte AirPods e mais, pela barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывайте значки рабочего стола, показывайте скрытые файлы, подключайте AirPods и не только — прямо из строки меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从菜单栏隐藏桌面图标、显示隐藏文件、连接 AirPods 等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從選單列隱藏桌面圖像、顯示隱藏的檔案、連接 AirPods 等。"
          }
        }
      }
    },
    "Hide files and folders on the desktop, for screen sharing or a clean look. Finder restarts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien und Ordner auf dem Schreibtisch ausblenden, für die Bildschirmfreigabe oder einen aufgeräumten Look. Der Finder wird neu gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los archivos y carpetas del escritorio, para compartir pantalla o tener un aspecto limpio. El Finder se reinicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez les fichiers et dossiers du bureau, pour un partage d’écran ou un aspect épuré. Le Finder est relancé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面共有時やすっきり見せたいときに、デスクトップ上のファイルとフォルダを隠します。Finderが再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 공유나 깔끔한 화면을 위해 데스크탑의 파일과 폴더를 숨깁니다. Finder가 재시동됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte arquivos e pastas da mesa, para compartilhar a tela ou ter um visual limpo. O Finder é reiniciado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает файлы и папки на рабочем столе — для демонстрации экрана или чистого вида. Finder перезапускается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏桌面上的文件和文件夹，适用于屏幕共享或保持整洁。访达会重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏桌面上的檔案和檔案夾，適用於螢幕共享或保持畫面整潔。Finder 會重新啟動。"
          }
        }
      }
    },
    "Hide leading digits, spaces and dots": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führende Ziffern, Leerzeichen und Punkte ausblenden"
