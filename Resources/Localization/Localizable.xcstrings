          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El negro atenúa; un color tiñe el fondo al atenuarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le noir assombrit ; une couleur teinte l’arrière-plan en l’atténuant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nero attenua; un colore tinge lo sfondo mentre lo attenua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黒では暗くなり、色を選ぶと背景が暗くなると同時にその色に染まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검은색은 어둡게만 하고, 다른 색상은 어둡게 하면서 배경에 색조를 입힙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
