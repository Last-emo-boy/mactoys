          }
        }
      }
    },
    "The chevron is left of the divider": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Chevron liegt links von der Trennlinie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La flecha está a la izquierda del divisor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chevron est à gauche du séparateur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La freccia è a sinistra del divisore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェブロンが区切り線の左にあります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺾쇠 아이콘이 구분선 왼쪽에 있음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chevron está à esquerda do divisor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шеврон находится левее разделителя"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "V 形符号位于分隔线左侧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "箭頭位於分隔線左側"
          }
        }
      }
    },
    "The chevron must stay to the right of the divider, or hiding would hide it too. Drag it back with ⌘.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Chevron muss rechts von der Trennlinie bleiben, sonst würde er beim Ausblenden mit ausgeblendet. Mit ⌘ zurückziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La flecha debe quedar a la derecha del divisor; si no, también se ocultaría. Arrástrala de vuelta con ⌘."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chevron doit rester à droite du séparateur, sinon le masquage le masquerait aussi. Faites-le glisser en arrière avec ⌘."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La freccia deve restare a destra del divisore, altrimenti verrebbe nascosta anch'essa. Trascinala indietro con ⌘."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェブロンは区切り線の右側に置く必要があります。そうしないと、シェブロンも隠れてしまいます。⌘を押しながらドラッグして戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺾쇠 아이콘은 구분선 오른쪽에 있어야 합니다. 그렇지 않으면 숨길 때 함께 숨겨집니다. ⌘ 키를 누른 채 다시 드래그하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chevron precisa ficar à direita do divisor; caso contrário, ele também seria ocultado. Arraste-o de volta com ⌘."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шеврон должен оставаться правее разделителя, иначе он тоже будет скрыт. Перетяните его обратно с ⌘."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "V 形符号必须位于分隔线右侧，否则隐藏时它也会被隐藏。请按住 ⌘ 将其拖回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "箭頭必須保持在分隔線右側，否則隱藏時也會將其隱藏。請按住 ⌘ 將其拖回。"
          }
        }
      }
    },
    "The chord’s second key can’t be a modifier.": {
