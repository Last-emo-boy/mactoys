          }
        }
      }
    },
    "Press again to hide or show it while it keeps running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut drücken, um es aus- oder einzublenden, während es weiterläuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa de nuevo para ocultarlo o mostrarlo mientras sigue en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
