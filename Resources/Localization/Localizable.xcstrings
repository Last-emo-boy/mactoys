          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 파일: 색상 없이 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivo grande: mostrado sem cores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большой файл: показан без подсветки."
          }
        },
