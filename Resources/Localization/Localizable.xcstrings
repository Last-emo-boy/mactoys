          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要輔助使用取用權限"
          }
        }
      }
    },
    "Needs Microphone access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert Mikrofonzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita acceso al micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite l’accès au micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede l'accesso al microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근 권한이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer acesso ao Microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
