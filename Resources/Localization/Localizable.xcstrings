          }
        }
      }
    },
    "Open a URL with the selection, run a shell script, AppleScript or Shortcut on it, or press keys. They join the list above.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine URL mit der Auswahl öffnen, ein Shell-Skript, AppleScript oder einen Kurzbefehl darauf ausführen oder Tasten drücken. Sie erscheinen in der Liste oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una URL con la selección, ejecuta sobre ella un script de shell, un AppleScript o un atajo de Atajos, o pulsa teclas. Se añaden a la lista de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une URL avec la sélection, exécutez dessus un script shell, un AppleScript ou un raccourci, ou appuyez sur des touches. Ces actions rejoignent la liste ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un URL con la selezione, esegui su di essa uno script shell, un AppleScript o un comando rapido, o premi dei tasti. Si aggiungono all'elenco qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択内容でURLを開く、選択内容に対してシェルスクリプト、AppleScript、ショートカットを実行する、キーを押すことができます。作成したアクションは上のリストに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 항목으로 URL을 열거나, 셸 스크립트, AppleScript 또는 단축어를 실행하거나, 키를 누릅니다. 추가한 동작은 위 목록에 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma URL com a seleção, execute nela um script de shell, um AppleScript ou um atalho do app Atalhos, ou pressione teclas. Elas entram na lista acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывайте URL с выделенным текстом, запускайте для него скрипт оболочки, AppleScript или быструю команду либо нажимайте клавиши. Такие действия добавляются в список выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用所选内容打开 URL，对其运行 shell 脚本、AppleScript 或快捷指令，或者模拟按键。它们会加入上方的列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用選取內容打開 URL、對其執行 Shell 工序指令、AppleScript 或捷徑，或按下按鍵。這些動作會加入上方的列表。"
          }
        }
      }
    },
    "Open a display in picture in picture from its Arrange tab in the flyout, or with `mactoys powerdisplay pip -n <n>`. Right-click the window for size and options.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Display über den Tab „Anordnen“ im Flyout oder mit `mactoys powerdisplay pip -n <n>` als Bild-in-Bild öffnen. Rechtsklick auf das Fenster für Größe und Optionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una pantalla en imagen dentro de imagen desde su pestaña Organizar en el panel, o con `mactoys powerdisplay pip -n <n>`. Haz clic con el botón derecho en la ventana para ver el tamaño y las opciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un écran en image dans l’image depuis son onglet Organiser dans le panneau, ou avec `mactoys powerdisplay pip -n <n>`. Cliquez sur la fenêtre avec le bouton droit pour la taille et les options."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルの“配置”タブ、または`mactoys powerdisplay pip -n <n>`で、ディスプレイをピクチャ・イン・ピクチャで開きます。ウインドウを右クリックすると、サイズとオプションを選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플라이아웃의 배열 탭이나 `mactoys powerdisplay pip -n <n>`으로 디스플레이를 화면 속 화면으로 여세요. 크기와 옵션을 보려면 윈도우를 오른쪽 클릭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um monitor em Picture in Picture pela aba Organizar do painel ou com `mactoys powerdisplay pip -n <n>`. Clique com o botão direito na janela para tamanho e opções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте дисплей в режиме «Картинка в картинке» на его вкладке «Упорядочить» в панели или командой `mactoys powerdisplay pip -n <n>`. Нажмите на окно правой кнопкой, чтобы выбрать размер и параметры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从浮动面板中显示器的“排列”标签页，或使用 `mactoys powerdisplay pip -n <n>`，以画中画方式打开显示器。右键点按窗口可设置大小和选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從浮出視窗中顯示器的「排列」標籤頁，或使用 `mactoys powerdisplay pip -n <n>`，以子母畫面打開顯示器。以右鍵按一下視窗即可調整大小和選項。"
          }
        }
      }
    },
