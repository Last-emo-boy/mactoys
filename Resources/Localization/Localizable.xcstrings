    "Like Windows’ extended context menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie das erweiterte Kontextmenü von Windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como el menú contextual extendido de Windows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme le menu contextuel étendu de Windows."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come il menu contestuale esteso di Windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windowsの拡張コンテキストメニューと同様。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows의 확장 단축 메뉴와 같습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o menu de contexto estendido do Windows."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как расширенное контекстное меню Windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "类似 Windows 的扩展上下文菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如同 Windows 的延伸快速選單。"
          }
        }
      }
    },
    "Like Windows’ extended context menu: keeps the menu short otherwise.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie das erweiterte Kontextmenü von Windows: hält das Menü sonst kurz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como el menú contextual extendido de Windows: si no, mantiene el menú corto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme le menu contextuel étendu de Windows : le menu reste court autrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come il menu contestuale esteso di Windows: altrimenti mantiene il menu breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windowsの拡張コンテキストメニューと同様: それ以外のときはメニューを短く保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows의 확장 단축 메뉴처럼, 평소에는 메뉴를 짧게 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o menu de contexto estendido do Windows: caso contrário, mantém o menu curto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как расширенное контекстное меню Windows: в остальное время меню остается коротким."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "类似 Windows 的扩展上下文菜单：其他情况下保持菜单简短。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如同 Windows 的延伸快速選單：其他情況下讓選單保持簡短。"
          }
        }
      }
    },
    "Like a thumbnail, but clicking it brings the original window forward with that area under the pointer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie eine Miniatur, aber ein Klick darauf holt das Originalfenster nach vorne, mit diesem Bereich unter dem Zeiger"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como una miniatura, pero al hacer clic en ella la ventana original pasa al frente con esa área bajo el puntero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme une vignette, mais un clic dessus met la fenêtre d’origine au premier plan avec cette zone sous le pointeur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come una miniatura, ma facendo clic porta in primo piano la finestra originale con quell'area sotto il puntatore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サムネールと同様ですが、クリックするとポインタの下にその範囲がくるように元のウインドウが前面に表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "썸네일과 비슷하지만, 클릭하면 해당 영역이 포인터 아래에 오도록 원래 윈도우를 앞으로 가져옵니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como uma miniatura, mas ao clicar nela a janela original vem para a frente com essa área sob o ponteiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как миниатюра, но щелчок по ней выводит исходное окно вперед так, что эта область оказывается под указателем"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "类似缩略图，但点按它会将原始窗口调到前面，并使该区域位于指针下方"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "類似縮覽圖，但按一下會將原始視窗移到前面，並讓該區域位於指標下方"
          }
        }
      }
    },
