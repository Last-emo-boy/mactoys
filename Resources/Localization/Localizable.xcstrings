    },
    "← also starts at the first character instead of the last.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "← inizia inoltre dal primo carattere invece che dall'ultimo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "←를 눌러도 마지막 문자 대신 첫 번째 문자부터 시작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "← também começa no primeiro caractere em vez do último."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "← 也会从第一个字符而非最后一个字符开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "← 也會從第一個字元開始，而不是最後一個。"
          }
        }
      }
    },
    "← and → step through zone numbers; ↑ and ↓ stay with the app": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "← e → scorrono i numeri delle zone; ↑ e ↓ restano nell'app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "←와 →로 영역 번호를 차례로 이동하고, ↑와 ↓는 앱에 그대로 전달됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "← e → percorrem os números das zonas; ↑ e ↓ ficam no app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "← 和 → 按区域编号切换；↑ 和 ↓ 照常由 App 使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "← 和 → 依區域編號切換；↑ 和 ↓ 則保持在同一個 App"
          }
        }
      }
    },
