            "value": "Un tasto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tecla"
          }
        },
        "ru": {
          "stringUnit": {
