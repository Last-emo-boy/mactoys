    "This device has no volume control. Use the volume on the device itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keine Lautstärkeregelung. Die Lautstärke am Gerät selbst einstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene control de volumen. Usa el volumen del propio dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce périphérique n’a pas de réglage du volume. Utilisez le volume de l’appareil lui-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha un controllo del volume. Usa il volume del dispositivo stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
