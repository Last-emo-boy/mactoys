{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "$1, $&, $` and $' in replacements; backslashes are literal.": {
      "comment": "PowerRename: keep the $… tokens as they are",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "$1, $&, $` e $' nelle sostituzioni; le barre rovesciate sono letterali."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체 문자열에서 $1, $&, $`, $'를 사용할 수 있으며, 백슬래시는 문자 그대로 처리됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "$1, $&, $` e $' nas substituições; barras invertidas são literais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换内容中可使用 $1、$&、$` 和 $'；反斜杠按字面处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代內容中可使用 $1、$&、$` 和 $'；反斜線會依字面處理。"
          }
        }
      }
    },
    "$YYYY-$MM-$DD Notes by %USERNAME%.md": {
      "comment": "New+ sample template name; keep $YYYY, $MM, $DD, %USERNAME% and .md as they are",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "$YYYY-$MM-$DD Note di %USERNAME%.md"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "$YYYY-$MM-$DD %USERNAME%의 메모.md"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "$YYYY-$MM-$DD Notas de %USERNAME%.md"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "$YYYY-$MM-$DD %USERNAME% 的笔记.md"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "$YYYY-$MM-$DD %USERNAME% 的筆記.md"
          }
        }
      }
    },
    "${}, ${start=1}, ${increment=2}, ${padding=3} or combined: ${start=10,increment=2,padding=4}": {
      "comment": "PowerRename tooltip: keep the ${…} variables as they are",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "${}, ${start=1}, ${increment=2}, ${padding=3} o combinati: ${start=10,increment=2,padding=4}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "${}, ${start=1}, ${increment=2}, ${padding=3} 또는 조합: ${start=10,increment=2,padding=4}"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "${}, ${start=1}, ${increment=2}, ${padding=3} ou combinados: ${start=10,increment=2,padding=4}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "${}、${start=1}、${increment=2}、${padding=3}，或组合使用：${start=10,increment=2,padding=4}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "${}、${start=1}、${increment=2}、${padding=3}，或組合使用：${start=10,increment=2,padding=4}"
          }
        }
      }
    },
