            "state": "translated",
            "value": "視窗"
          }
        }
      }
    },
    "Windows are tiled again as soon as you turn Stage Manager off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster werden wieder gekachelt, sobald Stage Manager ausgeschaltet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas vuelven a ponerse en mosaico en cuanto desactivas el Organizador visual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres sont de nouveau placées en mosaïque dès que vous désactivez Stage Manager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre vengono affiancate di nuovo appena disattivi Stage Manager."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージマネージャをオフにすると、すぐにウインドウが再びタイル表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이지 매니저를 끄면 바로 윈도우가 다시 타일링됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas são organizadas de novo assim que você desativa o Stage Manager."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна снова размещаются мозаикой, как только вы выключаете Stage Manager."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭台前调度后，窗口会立即重新平铺。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉幕前調度後，視窗會立即重新並排。"
          }
        }
      }
    },
    "Windows behind the one you're using fade under a tint. Menus, the Dock and notifications stay bright, and clicks go through as usual.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster hinter dem verwendeten treten unter einer Tönung zurück. Menüs, das Dock und Mitteilungen bleiben hell, und Klicks funktionieren wie gewohnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas detrás de la que usas se atenúan bajo un tinte. Los menús, el Dock y las notificaciones no se atenúan, y los clics funcionan como siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres derrière celle que vous utilisez s’estompent sous une teinte. Les menus, le Dock et les notifications restent lumineux, et les clics passent normalement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre dietro quella che stai usando sbiadiscono sotto una tinta. Menu, Dock e notifiche restano luminosi e i clic passano come al solito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中のウインドウの背後にあるウインドウは色が重なって薄暗くなります。メニュー、Dock、通知は明るいままで、クリックも通常どおり機能します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중인 윈도우 뒤의 윈도우가 색조 아래로 흐려집니다. 메뉴, Dock, 알림은 밝게 유지되며 클릭은 평소처럼 전달됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas por trás da que você está usando esmaecem sob uma tonalidade. Menus, o Dock e as notificações continuam iluminados e os cliques passam normalmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна позади того, с которым вы работаете, приглушаются оттенком. Меню, Dock и уведомления не затемняются, а нажатия проходят как обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前窗口后面的窗口会在着色层下变暗。菜单、程序坞和通知保持明亮，点按照常生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在使用的視窗後方的視窗會淡化在色調之下。選單、Dock 和通知會保持明亮，點按也會照常傳遞。"
          }
        }
      }
    },
    "Windows never cover the menu bar, the notch or the Dock": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster verdecken nie die Menüleiste, die Notch oder das Dock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas nunca tapan la barra de menús, la muesca ni el Dock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres ne recouvrent jamais la barre des menus, l’encoche ni le Dock"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre non coprono mai la barra dei menu, la tacca o il Dock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウがメニューバー、ノッチ、Dockに重なることはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 메뉴 막대, 노치 또는 Dock을 가리지 않음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas nunca cobrem a barra de menus, o entalhe ou o Dock"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна никогда не перекрывают строку меню, вырез и Dock"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口永远不会遮住菜单栏、刘海或程序坞"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗絕不會遮住選單列、瀏海或 Dock"
          }
        }
      }
    },
    "Windows of these apps can't be pinned. Partial names match too: “Note” excludes Notes and Notefile.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster dieser Apps können nicht angeheftet werden. Teilnamen passen ebenfalls: „Note“ schließt Notes und Notefile aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas de estas apps no se pueden fijar. También coinciden los nombres parciales: “Not” excluye Notas y Notefile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres de ces apps ne peuvent pas être épinglées. Les noms partiels fonctionnent aussi : « Note » exclut Notes et Notefile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre di queste app non possono essere fissate. Valgono anche nomi parziali: “Note” esclude Note e Notefile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのAppのウインドウはピン留めできません。名前の一部でも一致します: “Note”はNotesとNotefileを除外します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱들의 윈도우는 고정할 수 없습니다. 부분 이름도 일치합니다: “Note”는 Notes와 Notefile을 제외합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janelas destes apps não podem ser fixadas. Nomes parciais também correspondem: “Not” exclui Notas e Notefile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна этих приложений нельзя закрепить. Частичные имена тоже подходят: «Note» исключает Notes и Notefile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 App 的窗口无法置顶。部分名称也会匹配：“Note”会排除 Notes 和 Notefile。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法釘選這些 App 的視窗。部分名稱也會符合：「Note」會排除 Notes 和 Notefile。"
          }
        }
      }
    },
    "Windows per display": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster pro Display"
          }
        },
        "es": {
