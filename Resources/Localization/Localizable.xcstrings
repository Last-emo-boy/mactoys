          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Time zone identifiers listed with “%1$@”, e.g. %2$@; one per line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Identificadores de zona horaria listados con “%1$@”, p. ej., %2$@; uno por línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiants de fuseau horaire listés par « %1$@ », p. ex. %2$@ ; un par ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Identificatori dei fusi orari elencati con “%1$@”, ad es. %2$@; uno per riga."
