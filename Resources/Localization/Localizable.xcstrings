            "state": "translated",
            "value": "Pressione-o novamente, Esc ou clique para remover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы убрать, нажмите сочетание еще раз, Esc или щелкните мышью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
