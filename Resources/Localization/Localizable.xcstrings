    "Past the last Mac the pointer comes back on the first, and the other way round.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinter dem letzten Mac erscheint der Zeiger wieder auf dem ersten und umgekehrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasado el último Mac, el puntero vuelve al primero, y viceversa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-delà du dernier Mac, le pointeur revient sur le premier, et inversement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oltre l'ultimo Mac il puntatore torna sul primo, e viceversa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のMacを越えるとポインタは最初のMacに戻り、逆方向も同様です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 Mac을 지나면 포인터가 첫 번째 Mac으로 돌아오며, 반대 방향도 마찬가지입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois do último Mac, o ponteiro volta pelo primeiro, e vice-versa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После последнего Mac указатель возвращается на первый, и наоборот."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越过最后一台 Mac 时，指针会回到第一台，反之亦然。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過最後一台 Mac 時，指標會回到第一台，反之亦然。"
          }
        }
      }
    },
