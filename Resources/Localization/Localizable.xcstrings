        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이나 폴더를 사용 중인 프로세스를 확인하고 종료합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
