          }
        }
      }
    },
    "Select an area, a window or a whole screen. Each capture lands on a card you can copy, save, annotate, pin or drag into any app.": {
      "comment": "Screenshot settings hero text",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Bereich, ein Fenster oder einen ganzen Bildschirm auswählen. Jede Aufnahme landet auf einer Karte, die sich kopieren, sichern, anmerken, anheften oder in eine beliebige App ziehen lässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un área, una ventana o una pantalla entera. Cada captura aparece en una tarjeta que puedes copiar, guardar, anotar, fijar o arrastrar a cualquier app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une zone, une fenêtre ou un écran entier. Chaque capture arrive sur une carte que vous pouvez copier, enregistrer, annoter, épingler ou faire glisser vers n’importe quelle app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un'area, una finestra o un intero schermo. Ogni acquisizione finisce su una scheda che puoi copiare, salvare, annotare, fissare o trascinare in qualsiasi app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲、ウインドウ、または画面全体を選択します。キャプチャはそれぞれカードに表示され、コピー、保存、注釈、ピン留め、任意のAppへのドラッグができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역, 윈도우 또는 전체 화면을 선택하세요. 각 캡처는 카드로 표시되며, 복사, 저장, 주석 달기, 고정하거나 어떤 앱으로든 드래그할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma área, uma janela ou uma tela inteira. Cada captura vai para um cartão que você pode copiar, salvar, anotar, fixar ou arrastar para qualquer app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите область, окно или весь экран. Каждый снимок попадает на карточку, которую можно скопировать, сохранить, разметить, закрепить или перетянуть в любое приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择区域、窗口或整个屏幕。每张截图都会显示在一张卡片上，你可以拷贝、存储、标注、固定或将其拖到任意 App 中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取區域、視窗或整個螢幕。每次擷取都會出現在卡片上，你可以拷貝、儲存、加上註解、釘選或拖移到任何 App。"
          }
        }
      }
    },
