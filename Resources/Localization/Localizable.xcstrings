    "FancyZones leaves new windows, drags and keyboard moves there to it, and shows no zones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FancyZones überlässt dort neue Fenster, Ziehvorgänge und Tastaturbewegungen dem automatischen Kacheln und zeigt keine Zonen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FancyZones le deja allí las ventanas nuevas, los arrastres y los movimientos con el teclado, y no muestra zonas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FancyZones lui laisse les nouvelles fenêtres, les glissements et les déplacements au clavier vers cet écran, et n’y affiche aucune zone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lì FancyZones gli lascia le nuove finestre, i trascinamenti e gli spostamenti da tastiera, e non mostra zone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FancyZonesは、そこでの新しいウインドウ、ドラッグ、キーボードによる移動をそちらに任せ、ゾーンを表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FancyZones는 해당 디스플레이의 새 윈도우, 드래그 및 키보드 이동을 자동 타일링에 맡기며 영역을 표시하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FancyZones deixa novas janelas, arrastos e movimentos pelo teclado ali a cargo da Organização Automática e não mostra zonas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FancyZones оставляет новые окна, перетягивание и перемещение с клавиатуры там «Автомозаике» и не показывает зоны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FancyZones 会将那里的新窗口、拖移和键盘移动交给它处理，并且不显示区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "FancyZones 會將該處的新視窗、拖移和鍵盤移動交給它處理，且不顯示區域。"
          }
        }
      }
    },
