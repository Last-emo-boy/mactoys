          "stringUnit": {
            "state": "translated",
            "value": "Один щелчок и выводит окно вперед, и нажимает то, по чему вы щелкнули"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按一下即可将窗口调到前面，同时按下你所点按的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下即可將視窗移到前面，同時按下你所點按的項目"
          }
        }
      }
    },
    "One line of text per line on screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Textzeile pro Zeile auf dem Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea de texto por cada línea en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne de texte par ligne à l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga di testo per ogni riga sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上の1行をテキストの1行にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면의 한 줄당 텍스트 한 줄."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha de texto para cada linha na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая строка текста на экране — отдельная строка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上的每一行对应一行文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕上的每一行對應一行文字。"
          }
        }
      }
    },
    "One packet per address, one second timeout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Paket pro Adresse, eine Sekunde Zeitlimit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paquete por dirección, tiempo de espera de un segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paquet par adresse, délai d’une seconde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pacchetto per indirizzo, timeout di un secondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスごとに1パケット、タイムアウトは1秒。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소당 패킷 하나, 시간 제한 1초."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pacote por endereço, tempo limite de um segundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один пакет на адрес, тайм-аут одна секунда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个地址一个数据包，超时为一秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個位址一個封包，逾時為一秒。"
          }
        }
      }
    },
    "One per line: Name=pattern or Name=%@pattern (Unicode patterns plus %@).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine pro Zeile: Name=Muster oder Name=%1$@Muster (Unicode-Muster plus %2$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "One per line: Name=pattern or Name=%1$@pattern (Unicode patterns plus %2$@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno por línea: Nombre=patrón o Nombre=%1$@patrón (patrones Unicode más %2$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par ligne : Nom=motif ou Nom=%1$@motif (motifs Unicode plus %2$@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno per riga: Nome=modello o Nome=%1$@modello (modelli Unicode più %2$@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行に1つ: 名前=パターン または 名前=%1$@パターン（Unicodeパターンと%2$@）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 하나씩: 이름=패턴 또는 이름=%1$@패턴(유니코드 패턴 및 %2$@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um por linha: Nome=padrão ou Nome=%1$@padrão (padrões Unicode mais %2$@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одному в строке: Имя=шаблон или Имя=%1$@шаблон (шаблоны Unicode, а также %2$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个：名称=模式 或 名称=%1$@模式（Unicode 模式以及 %2$@）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一個：名稱=樣式 或 名稱=%1$@樣式（Unicode 樣式加上 %2$@）。"
          }
        }
      }
    },
    "Only a dictionary can be written to a defaults domain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In eine Defaults-Domain kann nur ein Dictionary geschrieben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un dominio de defaults solo se puede escribir un diccionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un dictionnaire peut être écrit dans un domaine defaults."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In un dominio defaults si può scrivere solo un dizionario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "defaultsドメインに書き込めるのは辞書だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "defaults 도메인에는 사전만 기록할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
