            "value": "Awake torna a Disattivato in questa data e ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日時になるとAwakeは“オフ”に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜와 시간이 되면 Awake가 끔으로 돌아갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Awake volta para Desativado nesta data e hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В эту дату и время Awake вернется в режим «Выключено»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
