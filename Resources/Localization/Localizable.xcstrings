    },
    "Pick a format, run an AI action or paste from history. ⌘1…⌘9 run an action directly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Format wählen, KI-Aktion ausführen oder aus dem Verlauf einsetzen. ⌘1…⌘9 führen eine Aktion direkt aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un formato, ejecuta una acción de IA o pega desde el historial. ⌘1…⌘9 ejecutan una acción directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un format, exécutez une action d’IA ou collez depuis l’historique. ⌘1…⌘9 exécutent directement une action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un formato, esegui un'azione IA o incolla dalla cronologia. ⌘1…⌘9 eseguono direttamente un'azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形式を選択するか、AIアクションを実行するか、履歴からペーストします。⌘1…⌘9でアクションを直接実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "형식을 선택하거나, AI 동작을 실행하거나, 기록에서 붙여넣으세요. ⌘1…⌘9로 동작을 바로 실행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um formato, execute uma ação de IA ou cole do histórico. ⌘1…⌘9 executam uma ação diretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите формат, запустите действие ИИ или вставьте из истории. ⌘1…⌘9 сразу запускают действие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选取格式、运行 AI 操作或从历史记录中粘贴。⌘1…⌘9 可直接运行操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇格式、執行 AI 動作或從歷史記錄貼上。⌘1⋯⌘9 可直接執行動作。"
          }
        }
      }
    },
    "Pick an action for a gesture below to start using it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten eine Aktion für eine Geste auswählen, um sie zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige abajo una acción para un gesto y empieza a usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une action pour un geste ci-dessous pour commencer à l’utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
