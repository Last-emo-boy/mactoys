    "Paste clipboard content as plain text, Markdown, JSON, files or through your own AI actions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhalt der Zwischenablage als reinen Text, Markdown, JSON, Dateien oder über eigene KI-Aktionen einsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el contenido del portapapeles como texto sin formato, Markdown, JSON, archivos o mediante tus propias acciones de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez le contenu du presse-papiers en texte brut, Markdown, JSON, fichiers ou via vos propres actions d’IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il contenuto degli appunti come testo semplice, Markdown, JSON, file o tramite le tue azioni IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードの内容を、プレーンテキスト、Markdown、JSON、ファイルとして、または独自のAIアクションを通じてペーストします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 내용을 일반 텍스트, Markdown, JSON, 파일 또는 사용자 설정 AI 동작으로 붙여넣습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o conteúdo da área de transferência como texto simples, Markdown, JSON, arquivos ou por meio das suas próprias ações de IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставляйте содержимое буфера обмена как простой текст, Markdown, JSON, файлы или через свои действия ИИ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将剪贴板内容粘贴为纯文本、Markdown、JSON、文件，或通过你自己的 AI 操作粘贴。"
