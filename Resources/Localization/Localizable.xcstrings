    "Drop a .plist on the window, or open one from Finder with MacToys.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine .plist auf das Fenster ziehen oder im Finder mit MacToys öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta un .plist en la ventana o ábrelo desde el Finder con MacToys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez un fichier .plist sur la fenêtre, ou ouvrez-en un depuis le Finder avec MacToys."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
