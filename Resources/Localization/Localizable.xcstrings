      "comment": "Separate menu bar caption without Accessibility access",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekt anklicken, um es in der Menüleiste anzuzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un ítem para mostrarlo en la barra de menús"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un élément pour l’afficher dans la barre des menus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un elemento per mostrarlo nella barra dei menu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目をクリックするとメニューバーに表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 클릭하면 메뉴 막대에 표시됨"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em um item para mostrá-lo na barra de menus"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на объект, чтобы показать его в строке меню"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按项目以在菜单栏中显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下項目即可在選單列中顯示"
          }
        }
      }
    },
    "Click it while dragging, like holding ⌘": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ziehen darauf klicken, wie beim Halten von ⌘"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic mientras arrastras, como si mantuvieras ⌘"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez dessus pendant le glissement, comme en maintenant ⌘"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic durante il trascinamento, come tenere premuto ⌘"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中にクリック（⌘を押したままにするのと同様）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그 중에 클릭하면 ⌘을 누른 것처럼 작동"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique nele enquanto arrasta, como se mantivesse ⌘ pressionada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щелкните во время перетаскивания — как при удержании ⌘"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在拖移时点按，与按住 ⌘ 效果相同"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在拖移時按一下，如同按住 ⌘"
          }
        }
      }
    },
    "Click the camera icon to open the mirror; right-click for more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf das Kamerasymbol klicken, um den Spiegel zu öffnen; Rechtsklick für mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el icono de la cámara para abrir el espejo; haz clic con el botón derecho para ver más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’icône de la caméra pour ouvrir le miroir ; cliquez avec le bouton droit pour plus d’options."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラアイコンをクリックするとミラーが開きます。右クリックするとほかの操作ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 아이콘을 클릭하면 미러가 열리고, 오른쪽 클릭하면 더 많은 옵션이 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no ícone da câmera para abrir o espelho; clique com o botão direito para mais opções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на значок камеры, чтобы открыть зеркало; другие действия — по нажатию правой кнопкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按相机图标即可打开镜像；右键点按可查看更多选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下相機圖像即可打開鏡像；按一下右鍵可查看更多選項。"
          }
        }
      }
    },
    "Click the camera in the menu bar, or use the shortcut. The camera turns on only while the mirror is open and stops when you close it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Kamera in der Menüleiste klicken oder den Kurzbefehl verwenden. Die Kamera ist nur eingeschaltet, solange der Spiegel geöffnet ist, und stoppt beim Schließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la cámara de la barra de menús o usa el atajo. La cámara solo se activa mientras el espejo está abierto y se detiene al cerrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur la caméra dans la barre des menus, ou utilisez le raccourci. La caméra ne s’allume que lorsque le miroir est ouvert et s’éteint quand vous le fermez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのカメラをクリックするか、ショートカットを使用します。カメラはミラーが開いている間だけオンになり、閉じると停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 카메라를 클릭하거나 단축키를 사용하세요. 카메라는 미러가 열려 있는 동안에만 켜지며 미러를 닫으면 꺼집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique na câmera na barra de menus ou use o atalho. A câmera só liga enquanto o espelho está aberto e para quando você o fecha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на камеру в строке меню или используйте сочетание клавиш. Камера включается, только пока зеркало открыто, и выключается, когда вы его закрываете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按菜单栏中的相机，或使用快捷键。相机仅在镜像打开时开启，关闭镜像后即停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下選單列中的相機，或使用快速鍵。相機只在鏡像打開時開啟，關閉鏡像時就會停止。"
          }
        }
      }
    },
    "Click the chevron to show or hide them, or turn on hover in Settings.": {
      "comment": "Arrangement card step",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den Chevron klicken, um sie ein- oder auszublenden, oder in den Einstellungen das Einblenden beim Darüberfahren aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la flecha para mostrarlos u ocultarlos, o activa la opción de pasar el puntero en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le chevron pour les afficher ou les masquer, ou activez le survol dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sulla freccia per mostrarle o nasconderle, oppure attiva il passaggio del puntatore in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェブロンをクリックして表示/非表示を切り替えるか、“設定”でポインタを合わせたときの表示をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺾쇠 아이콘을 클릭하여 표시하거나 숨기세요. 설정에서 포인터를 올리면 표시되도록 할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no chevron para mostrá-los ou ocultá-los, ou ative a opção de passar o ponteiro nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите шеврон, чтобы показать или скрыть их, или включите наведение в Настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 V 形符号可显示或隐藏它们，也可以在设置中打开悬停显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下箭頭即可顯示或隱藏，或在「設定」中開啟指標停留顯示。"
          }
        }
      }
    },
    "Click the float button in the mirror or press D. Double-click the window to put it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Spiegel auf die Taste zum Schweben klicken oder D drücken. Ein Doppelklick auf das Fenster setzt es zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el botón de flotar del espejo o pulsa D. Haz doble clic en la ventana para devolverla a su sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le bouton de détachement dans le miroir ou appuyez sur D. Double-cliquez sur la fenêtre pour la remettre en place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミラーのフローティングボタンをクリックするか、Dを押します。ウインドウをダブルクリックすると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미러의 띄우기 버튼을 클릭하거나 D를 누르세요. 원래대로 되돌리려면 윈도우를 이중 클릭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no botão de janela flutuante no espelho ou pressione D. Clique duas vezes na janela para devolvê-la ao lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку «Открепить» в зеркале или клавишу D. Дважды нажмите на окно, чтобы вернуть его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按镜像中的浮动按钮或按 D。连按两次窗口可将其放回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下鏡像中的浮動按鈕或按 D。按兩下視窗即可將其放回。"
          }
        }
      }
    },
    "Click the highlighted window. Space switches between area and window.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf das hervorgehobene Fenster klicken. Die Leertaste wechselt zwischen Bereich und Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la ventana resaltada. La barra espaciadora alterna entre área y ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur la fenêtre en surbrillance. Espace bascule entre zone et fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sulla finestra evidenziata. La barra spaziatrice passa da area a finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライトされたウインドウをクリックします。スペースバーで範囲とウインドウを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강조 표시된 윈도우를 클릭하세요. 스페이스 바로 영역과 윈도우 간에 전환합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique na janela destacada. Espaço alterna entre área e janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на выделенное окно. Пробел переключает между областью и окном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按高亮显示的窗口。空格键可在区域和窗口之间切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下醒目標示的視窗。空白鍵可在區域和視窗之間切換。"
          }
        }
      }
    },
    "Click the icon to open the App Volume flyout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf das Symbol klicken, um das Flyout von App-Lautstärke zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el icono para abrir el panel de Volumen por app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’icône pour ouvrir le panneau de Volume par app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sull'icona per aprire il pannello di Volume per app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンをクリックすると、App音量のパネルが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘을 클릭하면 앱 음량 플라이아웃이 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no ícone para abrir o painel do Volume por App."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на значок, чтобы открыть панель «Громкости приложений»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按图标可打开 App 音量浮动面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下圖像即可打開「App 音量」浮出視窗。"
          }
        }
      }
    },
    "Click the notch to open the mirror": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Notch klicken, um den Spiegel zu öffnen"
          }
        },
        "es": {
