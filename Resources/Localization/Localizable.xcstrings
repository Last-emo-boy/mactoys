        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite est en pause. Reprenez-la à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite è in pausa. Riprendilo in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限は一時停止中です。いつでも再開できます。"
