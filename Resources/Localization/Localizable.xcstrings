    "⌫ moves the previewed file to the Trash; folders are never deleted": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫ legt die angezeigte Datei in den Papierkorb; Ordner werden nie gelöscht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫ traslada el archivo previsualizado a la Papelera; las carpetas nunca se eliminan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫ place le fichier prévisualisé dans la corbeille ; les dossiers ne sont jamais supprimés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫ sposta nel Cestino il file in anteprima; le cartelle non vengono mai eliminate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫でプレビュー中のファイルをゴミ箱に入れます。フォルダは削除されません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫를 누르면 미리 보고 있는 파일이 휴지통으로 이동하며, 폴더는 절대 삭제되지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫ move o arquivo pré-visualizado para o Lixo; pastas nunca são apagadas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫ перемещает просматриваемый файл в Корзину; папки никогда не удаляются"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫ 会将预览的文件移到废纸篓；文件夹永远不会被删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌫ 會將預覽中的檔案丟到垃圾桶；檔案夾絕不會被刪除"
          }
        }
      }
