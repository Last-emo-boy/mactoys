    "The adapter is switched off until then.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Netzteil ist bis dahin ausgeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El adaptador permanece apagado hasta entonces."
          }
        },
