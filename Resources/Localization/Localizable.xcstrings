            "value": "視窗位置"
          }
        }
      }
    },
    "Window tiling": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗並排"
          }
        }
      }
    },
    "Windowing & Layouts": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗與佈局"
          }
        }
      }
    },
    "Windows": {
      "comment": "Provider name: open windows",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗"
          }
        }
      }
    },
    "Windows of these apps can't be pinned. Partial names match too: “Note” excludes Notes and Notefile.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法釘選這些 App 的視窗。部分名稱也會符合：「Note」會排除 Notes 和 Notefile。"
          }
        }
      }
    },
    "With one file selected in Finder, ← and → move through the other items of its folder. With several selected, Peek moves between those.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中選取一個檔案時，← 和 → 可在其檔案夾中的其他項目間移動。選取多個檔案時，Peek 會在這些檔案之間移動。"
          }
        }
      }
    },
    "Without $PATH this replaces the PATH zsh and apps inherit; add $PATH to keep the system folders.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若不含 $PATH，這會取代 zsh 和 App 繼承的 PATH；加入 $PATH 即可保留系統檔案夾。"
          }
        }
      }
    },
    "Without this the displays may still turn off while the Mac stays awake.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若未開啟此選項，Mac 保持喚醒時顯示器仍可能會關閉。"
          }
        }
      }
    },
    "Wi‑Fi": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fi"
          }
        }
      }
    },
    "Words": {
      "comment": "Detail row: word count",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "字數"
          }
        }
      }
    },
    "Works in zsh, macOS's default shell. The handler only prints suggestions when output goes to a terminal, so scripts see zsh's normal error. Uninstall removes the block; nothing else in .zshrc is touched, and a backup is kept from before the first change.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於 macOS 的預設 shell zsh。處理程式只會在輸出至終端機時顯示建議，因此工序指令會看到 zsh 的一般錯誤。解除安裝會移除該區塊；.zshrc 中的其他內容都不會更動，並會保留第一次變更前的備份。"
          }
        }
      }
    },
    "Workspace": {
      "comment": "Result row label: a VS Code workspace",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區"
          }
        }
      }
    },
    "Workspace %lld": {
      "comment": "Default name of a newly captured workspace; %lld is a number",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區 %lld"
          }
        }
      }
    },
    "Workspace name": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區名稱"
          }
        }
      }
    },
    "Workspaces": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區"
          }
        }
