          }
        }
      }
    },
    "The limit is paused. Resume it any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit ist pausiert. Es lässt sich jederzeit fortsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite está en pausa. Reanúdalo cuando quieras."
          }
