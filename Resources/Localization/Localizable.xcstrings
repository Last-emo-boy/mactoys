          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée de maintien de la lettre avant l’ouverture de la barre d’outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per quanto tempo tenere premuta la lettera prima che si apra la barra strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーが開くまでに文字キーを押し続ける時間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 막대가 열리기 전에 글자를 누르고 있어야 하는 시간입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por quanto tempo segurar a letra antes de a barra de ferramentas abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько удерживать букву, прежде чем откроется панель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住字母多久才会打开工具栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住字母多久才會打開工具列。"
          }
        }
      }
    },
    "How long to wait for a launched app's windows to appear": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange auf die Fenster einer gestarteten App gewartet wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de espera para que aparezcan las ventanas de una app abierta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai d’attente de l’apparition des fenêtres d’une app lancée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
