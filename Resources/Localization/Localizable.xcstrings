    "App Volume can't change sound sent to a multi-output or aggregate device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Lautstärke kann den Ton für ein Gerät mit mehreren Ausgängen oder ein kombiniertes Gerät nicht ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen por app no puede cambiar el sonido enviado a un dispositivo de salida múltiple o agregado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume par app ne peut pas modifier le son envoyé vers un périphérique à sortie multiple ou un périphérique agrégé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume per app non può modificare l'audio inviato a un dispositivo a uscita multipla o aggregato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App音量では、複数出力装置または機器セットに送られるサウンドは変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 음량은 다중 출력 기기나 통합 기기로 보내는 사운드를 변경할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Volume por App não pode alterar o som enviado a um dispositivo de saída múltipla ou agregado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Громкость приложений» не может менять звук, отправляемый на устройство с несколькими выходами или агрегатное устройство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 音量无法更改发送到多输出设备或聚集设备的声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 音量無法更改傳送到多重輸出裝置或聚集裝置的聲音。"
          }
        }
      }
    },
