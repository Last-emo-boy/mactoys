      }
    },
    "Hold ⇧ while dragging a window to snap it into zones.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⇧ mentre trascini una finestra per agganciarla alle zone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 드래그하는 동안 ⇧를 누르고 있으면 영역에 스냅됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⇧ pressionada ao arrastar uma janela para encaixá-la nas zonas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移窗口时按住 ⇧ 即可将其吸附到区域中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移視窗時按住 ⇧ 即可將其貼齊到區域中。"
          }
        }
      }
    },
    "Hold ⇧ while dragging to move the selection, click a single word to copy just that word, press esc to cancel.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⇧ durante il trascinamento per spostare la selezione, fai clic su una singola parola per copiare solo quella, premi esc per annullare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안 ⇧를 누르면 선택 영역이 이동하고, 단어 하나를 클릭하면 해당 단어만 복사되며, esc를 누르면 취소됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⇧ pressionada ao arrastar para mover a seleção, clique em uma única palavra para copiar apenas ela, pressione esc para cancelar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移时按住 ⇧ 可移动所选区域，点按单个单词可只拷贝该单词，按 esc 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移時按住 ⇧ 可移動選取範圍，按一下單一單字可只拷貝該單字，按 esc 取消。"
          }
        }
      }
    },
