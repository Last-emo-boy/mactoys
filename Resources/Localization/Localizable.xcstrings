    "Some apps draw their own menus, which Accessibility can’t read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Apps zeichnen eigene Menüs, die die Bedienungshilfen nicht lesen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas apps dibujan sus propios menús, que Accesibilidad no puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines apps dessinent leurs propres menus, qu’Accessibilité ne peut pas lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune app disegnano i propri menu, che Accessibilità non può leggere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のAppは独自のメニューを描画するため、アクセシビリティでは読み取れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 앱은 자체 메뉴를 그리므로 손쉬운 사용으로 읽을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns apps desenham os próprios menus, que a Acessibilidade não consegue ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые приложения рисуют собственные меню, которые универсальный доступ не может прочитать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些 App 自行绘制菜单，辅助功能无法读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某些 App 會自行繪製選單，「輔助使用」無法讀取。"
          }
        }
      }
    },
    "Some folders couldn't be read — counts are incomplete": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Ordner konnten nicht gelesen werden – Anzahlen sind unvollständig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido leer algunas carpetas — los recuentos están incompletos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains dossiers n’ont pas pu être lus — les nombres sont incomplets"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune cartelle non sono leggibili; i conteggi sono incompleti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のフォルダを読み込めませんでした — 数は不完全です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 폴더를 읽을 수 없음 — 개수가 정확하지 않음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas pastas não puderam ser lidas — as contagens estão incompletas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые папки не удалось прочитать — подсчет неполный"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分文件夹无法读取 — 计数不完整"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些檔案夾無法讀取 — 計數不完整"
          }
        }
      }
    },
    "Some icons are behind the notch — the separate bar can show them": {
      "localizations": {
        "de": {
