    "Near the text cursor": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahe der Einfügemarke"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca del cursor de texto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Près du curseur de texte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vicino al cursore di testo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストカーソルの近く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 커서 근처"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perto do cursor de texto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядом с текстовым курсором"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本光标附近"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字游標附近"
          }
        }
      }
    },
    "Near the text cursor falls back to top center in apps that don't report it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nahe der Einfügemarke“ weicht in Apps, die sie nicht melden, auf „Oben mittig“ aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca del cursor de texto pasa a arriba en el centro en las apps que no lo indican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Près du curseur de texte » revient à En haut au centre dans les apps qui ne l’indiquent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vicino al cursore di testo diventa In alto al centro nelle app che non lo comunicano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“テキストカーソルの近く”は、カーソル位置を報告しないAppでは上部中央になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 커서 근처는 커서 위치를 알려 주지 않는 앱에서는 상단 중앙으로 대체됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perto do cursor de texto volta para o centro superior em apps que não o informam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Рядом с текстовым курсором» заменяется на «Вверху по центру» в приложениях, которые не сообщают его положение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在不报告文本光标位置的 App 中，“文本光标附近”会改为顶部居中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在不回報文字游標的 App 中，「文字游標附近」會改用頂部中央。"
          }
        }
      }
    },
    "Needed for sunrise and sunset. Enter coordinates or use Location Services.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Sonnenauf- und -untergang erforderlich. Koordinaten eingeben oder Ortungsdienste verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para el amanecer y el atardecer. Introduce las coordenadas o usa los Servicios de localización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour le lever et le coucher du soleil. Saisissez des coordonnées ou utilisez le Service de localisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessario per alba e tramonto. Inserisci le coordinate o usa i Servizi di localizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日の出と日没に必要です。座標を入力するか、位置情報サービスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일출 및 일몰 시간에 필요합니다. 좌표를 입력하거나 위치 서비스를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para o nascer e o pôr do sol. Digite coordenadas ou use os Serviços de Localização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно для восхода и заката. Введите координаты или используйте службы геолокации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于计算日出和日落时间。请输入坐标或使用定位服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算日出和日落時需要。請輸入座標或使用定位服務。"
          }
        }
      }
    },
    "Needs Microphone access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert Mikrofonzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita acceso al micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite l’accès au micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede l'accesso al microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근 권한이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer acesso ao Microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется доступ к микрофону."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麦克风权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麥克風取用權限。"
          }
        }
      }
    },
    "Needs Screen Recording. Without it, windows are shown as app icons with their titles": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert „Bildschirmaufnahme“. Ohne diese Berechtigung werden Fenster als App-Symbole mit ihren Titeln angezeigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita Grabación de pantalla. Sin ella, las ventanas se muestran como iconos de app con sus títulos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite Enregistrement de l’écran. Sans cela, les fenêtres apparaissent sous forme d’icônes d’app avec leur titre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede Registrazione schermo. Senza, le finestre vengono mostrate come icone delle app con i loro titoli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録が必要です。許可しない場合、ウインドウはAppアイコンとタイトルで表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록 권한이 필요합니다. 권한이 없으면 윈도우가 앱 아이콘과 제목으로 표시됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer Gravação de Tela. Sem ela, as janelas são mostradas como ícones de apps com seus títulos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение «Запись экрана». Без него окна показываются как значки приложений с заголовками"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要屏幕录制权限。没有该权限时，窗口会显示为 App 图标及其标题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要螢幕錄製權限。若未授予，視窗會以 App 圖像加上標題顯示"
          }
        }
      }
    },
    "Needs ffmpeg or LAME (brew install lame); macOS has no MP3 encoder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert ffmpeg oder LAME (brew install lame); macOS hat keinen MP3-Encoder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita ffmpeg o LAME (brew install lame); macOS no incluye ningún codificador MP3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite ffmpeg ou LAME (brew install lame) ; macOS n’a pas d’encodeur MP3."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede ffmpeg o LAME (brew install lame); macOS non ha un codificatore MP3."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpegまたはLAME（brew install lame）が必要です。macOSにはMP3エンコーダがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg 또는 LAME(brew install lame)이 필요합니다. macOS에는 MP3 인코더가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer ffmpeg ou LAME (brew install lame); o macOS não tem codificador MP3."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется ffmpeg или LAME (brew install lame); в macOS нет кодировщика MP3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 ffmpeg 或 LAME（brew install lame）；macOS 没有 MP3 编码器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 ffmpeg 或 LAME（brew install lame）；macOS 沒有 MP3 編碼器。"
          }
        }
      }
    },
    "Negative values switch earlier.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Negative Werte schalten früher um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores negativos cambian antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs négatives basculent plus tôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori negativi anticipano il cambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負の値にすると早く切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음수 값이면 더 일찍 전환됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores negativos alternam mais cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отрицательные значения переключают раньше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负值会提前切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "負值會提早切換。"
          }
        }
      }
    },
