                  "state": "translated",
                  "value": "Voltando em %lld segundos, a menos que você a mantenha."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Возврат через %lld секунды, если не сохранить."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Возврат через %lld секунд, если не сохранить."
                }
              },
              "one": {
                "stringUnit": {
