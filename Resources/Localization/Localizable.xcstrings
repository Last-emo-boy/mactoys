    "Blur or lock your screen in place, keep private apps blurred and hide everything but the window you're using.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Bildschirm weichzeichnen oder sperren, private Apps weichgezeichnet halten und alles außer dem verwendeten Fenster ausblenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenfoca o bloquea la pantalla tal como está, mantén desenfocadas las apps privadas y oculta todo salvo la ventana que usas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Floutez ou verrouillez votre écran sur place, gardez les apps privées floutées et masquez tout sauf la fenêtre que vous utilisez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoca o blocca lo schermo così com'è, mantieni sfocate le app private e nascondi tutto tranne la finestra che stai usando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面をその場でぼかしたりロックしたりできます。プライベートなAppをぼかしたままにし、使用中のウインドウ以外をすべて隠すこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 그대로 흐리게 하거나 잠그고, 개인 앱을 흐리게 유지하며, 사용 중인 윈도우만 남기고 모두 가립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfoque ou bloqueie a tela onde estiver, mantenha apps privados desfocados e oculte tudo, exceto a janela que você está usando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размывайте или блокируйте экран на месте, держите личные приложения размытыми и скрывайте все, кроме окна, с которым работаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原地模糊或锁定屏幕，让私密 App 保持模糊，并隐藏当前窗口以外的所有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "就地模糊或鎖定螢幕、讓私人 App 保持模糊，並隱藏你正在使用的視窗以外的所有內容。"
          }
        }
      }
    },
