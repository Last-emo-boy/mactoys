    "Nothing was recorded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts aufgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha grabado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato registrato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も記録されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 내용이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi gravado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не записано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未录制任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未錄製任何內容。"
          }
        }
      }
    },
    "Nothing you copy is saved until you turn this off again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Kopiertes wird gesichert, bis dies wieder ausgeschaltet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guarda nada de lo que copies hasta que vuelvas a desactivar esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de ce que vous copiez n’est enregistré tant que vous ne désactivez pas cette option."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla di ciò che copi viene salvato finché non disattivi di nuovo questa opzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを再びオフにするまで、コピーしたものは保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 다시 끌 때까지 복사한 내용이 저장되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada do que você copia é salvo até você desativar isto novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего из скопированного не сохраняется, пока вы снова не выключите этот параметр."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你再次关闭此选项前，拷贝的任何内容都不会被存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你再次關閉此選項之前，拷貝的任何內容都不會儲存。"
          }
        }
      }
    },
