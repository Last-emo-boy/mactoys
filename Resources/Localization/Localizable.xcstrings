    "%@ suits most rooms; lower values may stop charging on warm days.": {
      "comment": "The placeholder is a temperature",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eignet sich für die meisten Räume; bei niedrigeren Werten kann das Laden an warmen Tagen aussetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ va bien en la mayoría de las estancias; con valores más bajos, la carga puede detenerse los días de calor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ convient à la plupart des pièces ; des valeurs plus basses peuvent interrompre la charge par temps chaud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ va bene per la maggior parte degli ambienti; valori inferiori possono interrompere la carica nelle giornate calde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどの室内では%@が適しています。値を低くすると、暖かい日に充電が止まることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 실내에서는 %@이(가) 적당하며, 값을 낮추면 더운 날에는 충전이 중단될 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ serve para a maioria dos ambientes; valores menores podem interromper o carregamento em dias quentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ подходит для большинства помещений; при более низком значении в теплые дни зарядка может останавливаться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 适合大多数室内环境；设得更低时，天热时可能会停止充电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 適合大多數室內環境；數值較低時，天氣較熱的日子可能會停止充電。"
          }
        }
      }
