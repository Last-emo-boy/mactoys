    "Collections for things you paste again and again. Items on a pinboard never expire. Drag items onto a pinboard in the panel, or use ⌘K.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammlungen für Dinge, die immer wieder eingesetzt werden. Objekte auf einer Pinnwand laufen nie ab. Objekte im Fenster auf eine Pinnwand ziehen oder ⌘K verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colecciones para lo que pegas una y otra vez. Los ítems de un tablero nunca caducan. Arrastra ítems a un tablero en el panel o usa ⌘K."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des collections pour ce que vous collez encore et encore. Les éléments d’un tableau n’expirent jamais. Faites glisser des éléments sur un tableau dans le panneau, ou utilisez ⌘K."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccolte per ciò che incolli più e più volte. Gli elementi di una bacheca non scadono mai. Trascina gli elementi su una bacheca nel pannello o usa ⌘K."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しペーストするもののコレクション。ピンボード上の項目は期限切れになりません。パネルで項目をピンボードにドラッグするか、⌘Kを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복해서 붙여넣는 항목을 위한 모음입니다. 핀보드의 항목은 만료되지 않습니다. 패널에서 항목을 핀보드로 드래그하거나 ⌘K를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coleções para coisas que você cola repetidamente. Itens em um mural nunca expiram. Arraste itens para um mural no painel ou use ⌘K."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подборки того, что вы вставляете снова и снова. Объекты на доске хранятся бессрочно. Перетяните объекты на доску в панели или нажмите ⌘K."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于收集你反复粘贴的内容。固定板上的项目永不过期。在面板中将项目拖到固定板上，或使用 ⌘K。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來收集經常重複貼上的內容。釘選板上的項目永遠不會過期。在面板中將項目拖移到釘選板上，或使用 ⌘K。"
          }
        }
      }
    },
