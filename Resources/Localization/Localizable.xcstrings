    "Hold a modifier and drag anywhere in a window to move it, or right-drag to resize.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sondertaste halten und irgendwo in einem Fenster ziehen, um es zu bewegen, oder mit der rechten Maustaste ziehen, um die Größe zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén una tecla modificadora y arrastra desde cualquier punto de una ventana para moverla, o arrastra con el botón derecho para cambiar su tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez un modificateur et faites glisser n’importe où dans une fenêtre pour la déplacer, ou faites glisser avec le bouton droit pour la redimensionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un modificatore e trascina ovunque in una finestra per spostarla, o trascina col tasto destro per ridimensionarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーを押したままウインドウ内のどこかをドラッグすると移動し、右ドラッグでサイズを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 키를 누른 채 윈도우의 아무 곳이나 드래그하여 이동하거나, 오른쪽 버튼으로 드래그하여 크기를 조절합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure um modificador e arraste em qualquer lugar de uma janela para movê-la, ou arraste com o botão direito para redimensioná-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте модификатор и перетягивайте окно за любое место, чтобы переместить его, или перетягивайте правой кнопкой, чтобы изменить размер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住修饰键并在窗口中任意位置拖移即可移动窗口，右键拖移可调整大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住修飾鍵並在視窗內任何位置拖移即可移動，或以右鍵拖移調整大小。"
          }
        }
      }
    },
    "Hold duration": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haltedauer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de pulsación mantenida"
          }
