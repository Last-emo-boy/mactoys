    "Zoom in, draw, time breaks, record and snip — each with its own shortcut.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrandisci, disegna, cronometra le pause, registra e ritaglia, ognuno con la propria abbreviazione."
          }
