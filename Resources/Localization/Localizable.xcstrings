    "Create window layouts and snap windows into zones by dragging with ⇧ held, or with the keyboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fensterlayouts erstellen und Fenster durch Ziehen mit gedrückter ⇧-Taste oder per Tastatur in Zonen einrasten lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea distribuciones de ventanas y ajusta las ventanas a zonas arrastrándolas con ⇧ pulsada o con el teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez des dispositions de fenêtres et ancrez les fenêtres dans des zones en les faisant glisser avec ⇧ enfoncée, ou avec le clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea layout di finestre e aggancia le finestre alle zone trascinandole con ⇧ premuto, o con la tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウレイアウトを作成し、⇧を押したままドラッグするか、キーボードでウインドウをゾーンにスナップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우 레이아웃을 만들고 ⇧를 누른 채 드래그하거나 키보드를 사용하여 윈도우를 영역에 스냅합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie layouts de janelas e encaixe janelas em zonas arrastando com ⇧ pressionada ou pelo teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте макеты окон и привязывайте окна к зонам, перетягивая их с нажатой ⇧, или с помощью клавиатуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建窗口布局，按住 ⇧ 拖移窗口或使用键盘即可将窗口吸附到区域中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立視窗佈局，並在按住 ⇧ 時拖移或使用鍵盤，將視窗貼齊到區域中。"
          }
        }
      }
    },
