          }
        }
      }
    },
    "Copy and paste a single file, drag one across the screen edge, or drop it on a Mac above. Received files go to Downloads.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine einzelne Datei kopieren und einsetzen, über den Bildschirmrand ziehen oder auf einem Mac darüber ablegen. Empfangene Dateien landen in „Downloads“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia y pega un solo archivo, arrástralo por el borde de la pantalla o suéltalo en un Mac de arriba. Los archivos recibidos van a Descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez-collez un seul fichier, faites-en glisser un au-delà du bord de l’écran ou déposez-le sur un Mac ci-dessus. Les fichiers reçus vont dans Téléchargements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia e incolla un singolo file, trascinalo oltre il bordo dello schermo o rilascialo su un Mac qui sopra. I file ricevuti vanno in Download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのファイルをコピーしてペーストするか、画面の端を越えてドラッグするか、上にあるMacにドロップします。受信したファイルは“ダウンロード”に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단일 파일을 복사하여 붙여넣거나, 화면 가장자리 너머로 드래그하거나, 위쪽의 Mac에 드롭하세요. 받은 파일은 다운로드 폴더에 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie e cole um único arquivo, arraste-o pela borda da tela ou solte-o em um Mac acima. Os arquivos recebidos vão para Transferências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте и вставьте один файл, перетяните его через край экрана или бросьте на Mac выше. Полученные файлы сохраняются в папку «Загрузки»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝并粘贴单个文件、将文件拖过屏幕边缘，或拖放到上方的 Mac 上。收到的文件会存放在“下载”文件夹中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝並貼上單一檔案、將檔案拖移跨過螢幕邊緣，或將其放到上方的 Mac。收到的檔案會存放到「下載項目」。"
          }
        }
      }
    },
