    "Applied with %@. New shells and newly opened apps see the changes.": {
      "comment": "The placeholder is a profile name",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %@ angewendet. Neue Shells und neu geöffnete Apps übernehmen die Änderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado con %@. Los nuevos shells y las apps que se abran a partir de ahora verán los cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué avec %@. Les nouveaux shells et les apps ouvertes ensuite prennent en compte les modifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicato con %@. Le nuove shell e le app aperte da ora vedono le modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で適用しました。新しいシェルと新しく開いたAppに変更が反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 적용했습니다. 새 셸과 새로 연 앱에 변경 사항이 반영됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado com %@. Novos shells e apps abertos a partir de agora veem as alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применено с профилем %@. Изменения увидят новые оболочки и вновь открытые приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已使用 %@ 应用。新的 shell 和新打开的 App 会看到这些更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已使用 %@ 套用。新的 shell 和新打開的 App 會看到這些變更。"
          }
        }
      }
    },
