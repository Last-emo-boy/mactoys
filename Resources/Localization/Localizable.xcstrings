    "%lld key remaps and %lld shortcut remaps in “%@”. Tap-alone keys, chords, text, apps and URLs are all edited in the Keyboard Manager window.": {
      "comment": "Number of key remaps, number of shortcut remaps, then the profile name",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neubelegungen in „%3$@“ – Tasten: %1$lld, Kurzbefehle: %2$lld. Antipp-Tasten, Tastenfolgen, Text, Apps und URLs werden alle im Fenster „Tastatur-Manager“ bearbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld key remaps and %2$lld shortcut remaps in “%3$@”. Tap-alone keys, chords, text, apps and URLs are all edited in the Keyboard Manager window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld reasignaciones de teclas y %2$lld reasignaciones de atajos en “%3$@”. Las teclas de pulsación única, los acordes, el texto, las apps y las URL se editan en la ventana del Administrador de teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil « %3$@ » — touches réaffectées : %1$lld, raccourcis réaffectés : %2$lld. Les touches pressées seules, les accords, le texte, les apps et les URL se modifient dans la fenêtre Gestionnaire de clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld rimappature di tasti e %2$lld di abbreviazioni in “%3$@”. Pressioni singole, accordi, testo, app e URL si modificano tutti nella finestra Gestione tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%3$@”のキーのリマップ%1$lld件とショートカットのリマップ%2$lld件。単独押しキー、連続ショートカット、テキスト、App、URLはすべてキーボードマネージャのウインドウで編集します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%3$@”에 키 재매핑 %1$lld개와 단축키 재매핑 %2$lld개가 있습니다. 단독 탭 키, 연속 키, 텍스트, 앱, URL은 모두 키보드 관리자 윈도우에서 편집합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remapeamentos de teclas: %1$lld; de atalhos: %2$lld (perfil “%3$@”). Teclas tocadas sozinhas, acordes, textos, apps e URLs são editados na janela do Gerenciador de Teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В профиле «%3$@»: переназначений клавиш — %1$lld, сочетаний клавиш — %2$lld. Одиночные нажатия, аккорды, текст, приложения и URL настраиваются в окне «Диспетчер клавиатуры»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%3$@”中有 %1$lld 个按键重映射和 %2$lld 个快捷键重映射。单独轻按的按键、和弦、文本、App 和 URL 都在键盘管理器窗口中编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%3$@」中有 %1$lld 個按鍵重新對應和 %2$lld 個快速鍵重新對應。單獨點按的按鍵、連續組合鍵、文字、App 和 URL 都在「鍵盤管理員」視窗中編輯。"
          }
        }
      }
    },
