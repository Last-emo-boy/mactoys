    "⌘S shows as “⌘S Save”, read from the menus of the app you're in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S erscheint als „⌘S Sichern“, gelesen aus den Menüs der verwendeten App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S se muestra como “⌘S Guardar”, leído de los menús de la app en la que estás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S s’affiche sous la forme « ⌘S Enregistrer », lu dans les menus de l’app dans laquelle vous êtes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S compare come “⌘S Salva”, letto dai menu dell'app in cui ti trovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Sは、使用中のAppのメニューから読み取って“⌘S 保存”のように表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S는 사용 중인 앱의 메뉴에서 읽어 와 “⌘S 저장”으로 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S aparece como “⌘S Salvar”, lido dos menus do app em que você está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S показывается как «⌘S Сохранить» — название берется из меню текущего приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S 会显示为“⌘S 存储”，名称读取自当前 App 的菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S 會顯示為「⌘S 儲存」，從你正在使用的 App 的選單中讀取。"
          }
        }
      }
    },
