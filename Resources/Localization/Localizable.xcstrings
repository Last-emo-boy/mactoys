    "Picking a display's layout again, or pressing its shortcut again, evens out tiles you resized.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneutes Auswählen des Layouts eines Displays oder erneutes Drücken seines Kurzbefehls gleicht größenveränderte Kacheln aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a elegir la distribución de una pantalla, o volver a pulsar su atajo, iguala las casillas que hayas redimensionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir de nouveau la disposition d’un écran, ou appuyer de nouveau sur son raccourci, égalise les emplacements que vous avez redimensionnés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegliendo di nuovo il layout di un monitor, o premendo di nuovo la sua abbreviazione, i riquadri ridimensionati vengono uniformati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイのレイアウトをもう一度選択するか、そのショートカットをもう一度押すと、サイズ変更したタイルが均等になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이의 레이아웃을 다시 선택하거나 단축키를 다시 누르면 크기를 조절한 타일이 균등하게 조정됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher de novo o layout de um monitor, ou pressionar o atalho dele de novo, iguala os blocos que você redimensionou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторный выбор макета дисплея или повторное нажатие его сочетания клавиш выравнивает плитки, размер которых вы изменили."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次选取显示器的布局或再次按下其快捷键，会均分你调整过大小的平铺窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次選擇顯示器的佈局或再按一次其快速鍵，即可平均分配你調整過大小的並排視窗。"
          }
        }
      }
    },
