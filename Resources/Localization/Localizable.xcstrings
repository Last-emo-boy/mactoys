    },
    "MacToys can't talk to this display. DisplayLink, AirPlay and Sidecar displays, and some docks and adapters, don't support DDC/CI.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys 無法與此顯示器通訊。DisplayLink、AirPlay 和 Sidecar 顯示器，以及某些擴充基座和轉接器不支援 DDC/CI。"
          }
        }
      }
    },
    "MacToys doesn't open at login": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys 不會在登入時打開"
          }
        }
      }
    },
    "MacToys edits only your own variables. System-wide files (/etc/zshenv, /etc/paths, /etc/paths.d) are shown read-only in the editor's Effective view; changing them needs an administrator and is left to you. Turning this utility off keeps applied variables in place.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys 只會編輯你自己的變數。系統層級的檔案（/etc/zshenv、/etc/paths、/etc/paths.d）在編輯器的「有效」顯示方式中為唯讀；更改這些檔案需要管理者權限，請自行處理。關閉此工具程式時，已套用的變數會保留。"
          }
        }
      }
    },
    "MacToys isn't allowed to control System Events. Turn it on in System Settings › Privacy & Security › Automation › MacToys.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys 未獲准控制 System Events。請在「系統設定」›「隱私權與安全性」›「自動化」› MacToys 中開啟。"
          }
        }
      }
    },
