    "Scripts never run; when off, HTML is shown as text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skripte werden nie ausgeführt; wenn aus, wird HTML als Text angezeigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los scripts nunca se ejecutan; si está desactivado, el HTML se muestra como texto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les scripts ne sont jamais exécutés ; si l’option est désactivée, le HTML est affiché comme du texte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli script non vengono mai eseguiti; se disattivato, l'HTML appare come testo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトは実行されません。オフの場合、HTMLはテキストとして表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트는 실행되지 않으며, 끄면 HTML이 텍스트로 표시됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os scripts nunca são executados; quando desativado, o HTML é mostrado como texto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрипты никогда не запускаются; если выключено, HTML показывается как текст"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从不运行脚本；关闭时 HTML 显示为文本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不執行工序指令；關閉時 HTML 會以文字顯示"
          }
        }
      }
    },
    "Scroll or ↑ ↓ to change the level; click to draw; Esc or right-click to leave.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrollen oder ↑ ↓ ändert die Stufe; Klicken zeichnet; Esc oder Rechtsklick zum Verlassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate o usa ↑ ↓ para cambiar el nivel; haz clic para dibujar; Esc o clic derecho para salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler ou utilisez ↑ ↓ pour changer le niveau ; cliquez pour dessiner ; Échap ou clic droit pour quitter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri o usa ↑ ↓ per cambiare il livello; fai clic per disegnare; Esc o clic destro per uscire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールするか↑ ↓で倍率を変更、クリックで描画、escまたは右クリックで終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤하거나 ↑ ↓로 배율을 변경하고, 클릭하여 그리고, Esc 또는 오른쪽 클릭으로 나갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role ou use ↑ ↓ para alterar o nível; clique para desenhar; Esc ou clique com o botão direito para sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутка или ↑ ↓ меняют масштаб; щелчок — рисование; Esc или щелчок правой кнопкой — выход."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动或按 ↑ ↓ 可更改缩放级别；点按可绘图；按 Esc 或右键点按可离开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捲動或按 ↑ ↓ 可更改縮放程度；按一下即可繪圖；按 Esc 或按一下右鍵即可離開。"
          }
        }
      }
    },
    "Scroll over the icon to change brightness.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über dem Symbol scrollen, um die Helligkeit zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate sobre el icono para cambiar el brillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler sur l’icône pour changer la luminosité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri sull'icona per cambiare la luminosità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコン上でスクロールすると明るさを変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 위에서 스크롤하여 밝기를 변경합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role sobre o ícone para alterar o brilho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокручивайте над значком, чтобы менять яркость."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图标上滚动可更改亮度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在圖像上捲動即可更改亮度。"
          }
        }
      }
    },
    "Scroll to zoom the loupe, use the arrow keys to move one pixel, press Esc to cancel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrollen zoomt die Lupe, Pfeiltasten bewegen um ein Pixel, Esc bricht ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate para ampliar la lupa, usa las flechas para moverte un píxel o pulsa Esc para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler pour zoomer la loupe, utilisez les flèches pour vous déplacer d’un pixel, appuyez sur Échap pour annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per ingrandire la lente, usa i tasti freccia per spostarti di un pixel, premi Esc per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールでルーペを拡大縮小、矢印キーで1ピクセル移動、escでキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤하여 돋보기를 확대/축소하고, 화살표 키로 1픽셀씩 이동하며, Esc를 눌러 취소합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role para ampliar a lupa, use as teclas de seta para mover um pixel, pressione Esc para cancelar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокручивайте, чтобы менять масштаб лупы; клавиши со стрелками сдвигают на один пиксель; Esc — отмена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动可缩放放大镜，使用方向键移动一个像素，按 Esc 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捲動以縮放放大鏡，使用方向鍵一次移動一個像素，按 Esc 取消。"
          }
        }
      }
    },
    "Scroll while dragging to cycle layouts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ziehen scrollen, um Layouts zu wechseln"
          }
        },
        "es": {
