          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед каждым изменением резервная копия сохраняется в ~/Library/Application Support/MacToys/Hosts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次更改前都会将备份写入 ~/Library/Application Support/MacToys/Hosts。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次變更前都會將備份寫入 ~/Library/Application Support/MacToys/Hosts。"
          }
        }
      }
    },
    "A battery with the limit marked; click it for the limit, top up and pause.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Batterie mit markiertem Limit; ein Klick darauf zeigt Limit, Vollladen und Pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una batería con el límite marcado; haz clic en ella para ver el límite, cargar al máximo y pausar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une batterie avec la limite indiquée ; cliquez dessus pour la limite, la recharge complète et la pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una batteria con il limite indicato; fai clic per limite, ricarica completa e pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限が示されたバッテリー。クリックすると、上限、フル充電、一時停止を操作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도가 표시된 배터리입니다. 클릭하면 한도, 완전 충전, 일시 정지를 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma bateria com o limite marcado; clique nela para ajustar o limite, completar a carga e pausar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккумулятор с отметкой ограничения; нажмите на него, чтобы задать ограничение, дозарядить или поставить на паузу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标有上限的电池图标；点按它可设置上限、充满和暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標示上限的電池圖像；按一下即可設定上限、充飽電和暫停。"
          }
        }
      }
    },
    "A big canvas beside references, assets and chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
