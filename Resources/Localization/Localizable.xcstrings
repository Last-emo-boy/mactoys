    "{text} becomes the selection as an AppleScript string. The script’s result is the output.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} wird zur Auswahl als AppleScript-Zeichenfolge. Das Ergebnis des Skripts ist die Ausgabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} se convierte en la selección como cadena de AppleScript. El resultado del script es la salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} devient la sélection sous forme de chaîne AppleScript. Le résultat du script constitue la sortie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} diventa la selezione come stringa AppleScript. Il risultato dello script è l'output."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{text}は、選択内容をAppleScriptの文字列にしたものになります。スクリプトの結果が出力になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{text}는 AppleScript 문자열로 된 선택 항목이 됩니다. 스크립트의 결과가 출력이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} se torna a seleção como uma string AppleScript. O resultado do script é a saída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} заменяется выделенным текстом в виде строки AppleScript. Результат скрипта — вывод действия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} 会变为以 AppleScript 字符串表示的所选内容。脚本的结果即为输出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} 會以 AppleScript 字串的形式成為選取內容。工序指令的結果即為輸出。"
          }
        }
      }
    },
