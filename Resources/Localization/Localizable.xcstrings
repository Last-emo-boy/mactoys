          "stringUnit": {
            "state": "translated",
            "value": "Das kompakte Suchfeld erweitert sich beim Tippen oder beim Drücken von ↓ oder ⇥"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El campo de búsqueda compacto se amplía al escribir o al pulsar ↓ o ⇥"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le champ de recherche compact s’agrandit quand vous tapez, appuyez sur ↓ ou ⇥"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il campo di ricerca compatto si espande quando digiti, premi ↓ o ⇥"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパクトな検索ボックスは、入力するか↓または⇥を押すと展開されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간결한 검색 상자는 입력하거나 ↓ 또는 ⇥를 누르면 확장됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O campo de busca compacto se expande quando você digita ou pressiona ↓ ou ⇥"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компактное поле поиска раскрывается, когда вы вводите текст или нажимаете ↓ или ⇥"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键入、按 ↓ 或 ⇥ 时，紧凑搜索框会展开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入、按 ↓ 或 ⇥ 時，精簡搜尋框會展開"
          }
        }
      }
    },
    "The context menu that opens is closed when the button locks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sich öffnende Kontextmenü wird geschlossen, wenn die Taste gesperrt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El menú contextual que se abre se cierra cuando se bloquea el botón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le menu contextuel qui s’ouvre est fermé quand le bouton se verrouille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il menu contestuale che si apre viene chiuso quando il pulsante si blocca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンがロックされると、開いたコンテキストメニューは閉じられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼이 잠기면 열린 단축 메뉴가 닫힙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O menu de contexto que se abre é fechado quando o botão trava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывшееся контекстное меню закрывается, когда кнопка фиксируется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按钮锁定时，弹出的快捷菜单会被关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鈕鎖定時，打開的快速選單會關閉。"
          }
        }
      }
    },
    "The countdown waits while the pointer is on the menu bar or a menu from it is open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Countdown wartet, solange der Zeiger auf der Menüleiste ist oder eines ihrer Menüs geöffnet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta atrás espera mientras el puntero está en la barra de menús o hay abierto uno de sus menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte à rebours attend tant que le pointeur est sur la barre des menus ou qu’un de ses menus est ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto alla rovescia attende mentre il puntatore è sulla barra dei menu o è aperto uno dei suoi menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタがメニューバー上にある間や、メニューバーのメニューが開いている間は、カウントダウンが止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터가 메뉴 막대에 있거나 메뉴 막대의 메뉴가 열려 있는 동안에는 카운트다운이 대기합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A contagem regressiva espera enquanto o ponteiro estiver na barra de menus ou um menu dela estiver aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсчет приостанавливается, пока указатель находится на строке меню или открыто одно из ее меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针位于菜单栏上或打开了菜单栏中的菜单时，倒计时会暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指標在選單列上或其選單打開時，倒數會暫停。"
          }
        }
      }
    },
    "The current time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Uhrzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure actuelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ora attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の時刻。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 시간."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A hora atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущее время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前時間。"
          }
        }
      }
    },
    "The date in the menu bar opens a month with week numbers, the day’s events with Join buttons, and clocks for the places you work with.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum in der Menüleiste öffnet einen Monat mit Kalenderwochen, die Ereignisse des Tages mit Tasten zum Beitreten und Uhren für die Orte, mit denen gearbeitet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de la barra de menús abre un mes con los números de semana, los eventos del día con botones Unirse y relojes de los lugares con los que trabajas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date dans la barre des menus ouvre un mois avec les numéros de semaine, les événements du jour avec des boutons Rejoindre, et des horloges pour les lieux avec lesquels vous travaillez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの日付をクリックすると、週番号付きの月表示、“参加”ボタン付きのその日のイベント、仕事で関わる場所の時計が開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 날짜를 클릭하면 주 번호가 있는 월간 달력, 참여 버튼이 있는 그날의 이벤트, 함께 일하는 지역의 시계가 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data na barra de menus abre um mês com números das semanas, os eventos do dia com botões Entrar e relógios dos lugares com que você trabalha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата в строке меню открывает месяц с номерами недель, события дня с кнопками «Присоединиться» и часы для мест, с которыми вы работаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏中的日期会打开带周数的月历、当天带“加入”按钮的日程，以及你工作相关地点的时钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下選單列中的日期，即可打開附有週數的月曆、附有「加入」按鈕的當日行程，以及你工作往來地點的時鐘。"
          }
        }
      }
    },
    "The dimmed area around the spotlight (50 % black when transparent).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der abgedunkelte Bereich um das Spotlight (bei Transparenz zu 50 Prozent schwarz)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El área atenuada alrededor del foco (si es transparente, negro al 50 %)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone assombrie autour du projecteur (si transparent : noir à 50 %)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'area scurita intorno allo spotlight (nero al 50%, se trasparente)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スポットライトの周囲の暗くなる領域（透明時は50 %の黒）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스포트라이트 주변의 어두운 영역입니다(투명일 때 50% 검정)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A área escurecida ao redor do holofote (preto a 50%, quando transparente)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемненная область вокруг прожектора (50 % черного, если прозрачно)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聚焦区域周围变暗的部分（透明时为 50% 黑色）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聚光燈周圍變暗的區域（透明時為 50 % 黑色）。"
          }
        }
      }
    },
    "The display or window is no longer available.": {
