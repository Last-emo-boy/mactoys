        }
      }
    },
    "Larger files; plays everywhere, including old PCs and browsers.": {
      "comment": "Optimizer: H.264 codec description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größere Dateien; läuft überall, auch auf alten PCs und in Browsern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos más grandes; se reproduce en todas partes, incluso en PC y navegadores antiguos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers plus volumineux ; lecture partout, y compris sur les anciens PC et navigateurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File più grandi; si riproduce ovunque, anche su PC e browser datati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは大きくなりますが、古いPCやブラウザを含め、どこでも再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 더 크지만 오래된 PC와 브라우저를 포함한 모든 곳에서 재생됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos maiores; reproduz em qualquer lugar, inclusive em PCs e navegadores antigos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы больше; воспроизводится везде, включая старые ПК и браузеры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件较大；可在任何地方播放，包括旧电脑和浏览器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案較大；可在任何地方播放，包括舊型 PC 和瀏覽器。"
          }
        }
      }
    },
    "Larger is faster.": {
