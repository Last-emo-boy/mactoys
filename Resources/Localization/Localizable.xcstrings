    "Drag over the screen. ⇧ square, ⌥ from the center, hold Space to move, arrows nudge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über den Bildschirm ziehen. ⇧ quadratisch, ⌥ von der Mitte aus, Leertaste halten zum Bewegen, Pfeiltasten zum Verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra sobre la pantalla. ⇧ cuadrado, ⌥ desde el centro, mantén la barra espaciadora para mover, las flechas desplazan poco a poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser sur l’écran. ⇧ carré, ⌥ depuis le centre, maintenez Espace pour déplacer, les flèches ajustent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina sullo schermo. ⇧ quadrato, ⌥ dal centro, tieni premuta la barra spaziatrice per spostare, le frecce spostano di poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上をドラッグします。⇧で正方形、⌥で中心から、スペースバーを押したままで移動、矢印キーで微調整。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 위로 드래그하세요. ⇧ 정사각형, ⌥ 중앙에서, 스페이스 바를 누른 채로 이동, 화살표로 미세 조정."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste sobre a tela. ⇧ quadrado, ⌥ a partir do centro, segure Espaço para mover, as setas ajustam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обведите область на экране. ⇧ — квадрат, ⌥ — от центра, удерживайте пробел, чтобы переместить, стрелки — сдвиг."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在屏幕上拖移。⇧ 正方形，⌥ 从中心开始，按住空格键移动，方向键微调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在螢幕上拖移。⇧ 正方形，⌥ 從中心，按住空白鍵移動，方向鍵微調。"
          }
        }
      }
    },
