    "Put what you copied back on the clipboard after pasting a converted version.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Einsetzen einer konvertierten Version das Kopierte wieder in die Zwischenablage legen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a poner lo que copiaste en el portapapeles tras pegar una versión convertida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remettre ce que vous avez copié dans le presse-papiers après avoir collé une version convertie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimetti negli appunti ciò che hai copiato dopo aver incollato una versione convertita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換したものをペーストしたあと、コピーした内容をクリップボードに戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환된 버전을 붙여넣은 후 복사한 원본을 클립보드에 되돌려 놓습니다."
          }
        },
        "pt-BR": {
