          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите указатель на сочетание клавиш в руководстве и нажмите булавку, чтобы закрепить его вверху для этого приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针悬停在指南中的快捷键上，然后点按图钉，即可将其固定在该 App 的顶部。"
