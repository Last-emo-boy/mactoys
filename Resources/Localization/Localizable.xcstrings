            "value": "每行一個：名稱=樣式 或 名稱=%1$@樣式（Unicode 樣式加上 %2$@）。"
          }
        }
      }
    },
    "One step per use, in turn": {
      "comment": "Window Controls chain mode: each use runs the next step",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schritt pro Verwendung, nacheinander"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paso por uso, por turnos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étape par utilisation, tour à tour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passaggio per volta, a turno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使うたびに1ステップずつ順番に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 때마다 한 단계씩 차례로"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma etapa por uso, em sequência"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один шаг за раз, по очереди"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次使用执行一个步骤，依次进行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次使用依序執行一個步驟"
          }
        }
      }
    },
    "Only a dictionary can be written to a defaults domain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In eine Defaults-Domain kann nur ein Dictionary geschrieben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un dominio de defaults solo se puede escribir un diccionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un dictionnaire peut être écrit dans un domaine defaults."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In un dominio defaults si può scrivere solo un dizionario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "defaultsドメインに書き込めるのは辞書だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "defaults 도메인에는 사전만 기록할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente um dicionário pode ser gravado em um domínio de defaults."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В домен defaults можно записать только словарь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有字典可以写入 defaults 域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有字典可以寫入 defaults 網域。"
          }
        }
      }
    },
    "Only actions that fit appear: links open, words are looked up, sums are calculated, JSON is formatted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur passende Aktionen erscheinen: Links werden geöffnet, Wörter nachgeschlagen, Summen berechnet, JSON formatiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo aparecen las acciones que encajan: los enlaces se abren, las palabras se consultan, las sumas se calculan y el JSON se formatea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les actions adaptées apparaissent : les liens s’ouvrent, les mots sont définis, les sommes calculées, le JSON mis en forme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compaiono solo le azioni adatte: i link si aprono, le parole si cercano, le somme si calcolano, il JSON si formatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合うアクションだけが表示されます: リンクを開く、単語を調べる、計算する、JSONを整形するなど。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알맞은 동작만 나타납니다. 링크는 열고, 단어는 찾아보고, 수식은 계산하고, JSON은 서식을 지정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só aparecem as ações que combinam: links são abertos, palavras são pesquisadas, contas são calculadas, JSON é formatado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Появляются только подходящие действия: ссылки открываются, слова ищутся в словаре, суммы вычисляются, JSON форматируется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只显示适用的操作：打开链接、查询单词、计算算式、格式化 JSON。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會顯示適用的動作：打開連結、查詢字詞、計算算式、格式化 JSON。"
          }
        }
      }
    },
    "Only embedded images are re-encoded: text and drawings stay sharp and selectable. Password-protected PDFs are left as they are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eingebettete Bilder werden neu kodiert: Text und Zeichnungen bleiben scharf und auswählbar. Passwortgeschützte PDFs bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se recodifican las imágenes incrustadas: el texto y los dibujos siguen nítidos y seleccionables. Los PDF protegidos con contraseña se dejan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les images incorporées sont réencodées : le texte et les dessins restent nets et sélectionnables. Les PDF protégés par mot de passe ne sont pas modifiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono ricodificate solo le immagini incorporate: testo e disegni restano nitidi e selezionabili. I PDF protetti da password restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "埋め込まれた画像だけが再エンコードされるため、テキストと図形は鮮明で選択可能なままです。パスワードで保護されたPDFはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포함된 이미지만 다시 인코딩되므로 텍스트와 그림은 선명하고 선택 가능한 상태로 유지됩니다. 암호로 보호된 PDF는 그대로 둡니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente as imagens incorporadas são recodificadas: textos e desenhos continuam nítidos e selecionáveis. PDFs protegidos por senha permanecem como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекодируются только встроенные изображения: текст и графика остаются четкими и выделяемыми. PDF с паролем не изменяются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只重新编码嵌入的图像：文本和绘图保持清晰且可选择。受密码保护的 PDF 保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會重新編碼內嵌的影像：文字和繪圖會保持清晰且可選取。受密碼保護的 PDF 會保持不變。"
          }
        }
      }
    },
    "Only for meetings with a video call link": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
