    "Record a single key (a modifier on its own works too) or a shortcut. Use the list for media keys.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine einzelne Taste (auch eine Sondertaste allein) oder einen Kurzbefehl aufnehmen. Für Medientasten die Liste verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba una sola tecla (también sirve una tecla modificadora sola) o un atajo. Usa la lista para las teclas multimedia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une seule touche (une touche de modification seule fonctionne aussi) ou un raccourci. Utilisez la liste pour les touches multimédias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un singolo tasto (funziona anche un modificatore da solo) o un'abbreviazione. Usa l'elenco per i tasti multimediali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単一のキー（修飾キー単独も可）またはショートカットを記録します。メディアキーはリストから選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단일 키(보조 키 단독도 가능) 또는 단축키를 기록하세요. 미디어 키는 목록을 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma única tecla (um modificador sozinho também funciona) ou um atalho. Use a lista para teclas de mídia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите одну клавишу (подойдет и отдельный модификатор) или сочетание клавиш. Для клавиш мультимедиа используйте список."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制单个按键（单独的修饰键也可以）或快捷键。媒体键请从列表中选取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製單一按鍵（單獨的修飾鍵也可以）或快速鍵。媒體鍵請使用列表選擇。"
          }
        }
      }
    },
