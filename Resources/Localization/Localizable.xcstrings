          }
        }
      }
    },
    "Hold ⇧ to move the selection, ⌥ to add to the clipboard, click a word to copy just that word. Images and PDFs work too: drop them on the card or use Finder’s Services menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧ halten, um die Auswahl zu bewegen, ⌥, um zur Zwischenablage hinzuzufügen; ein Wort anklicken, um nur dieses zu kopieren. Bilder und PDFs funktionieren auch: auf der Karte ablegen oder das Menü „Dienste“ im Finder verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⇧ para mover la selección y ⌥ para añadir al portapapeles; haz clic en una palabra para copiar solo esa palabra. También funciona con imágenes y PDF: suéltalos en la tarjeta o usa el menú Servicios del Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⇧ pour déplacer la sélection, ⌥ pour ajouter au presse-papiers, cliquez sur un mot pour ne copier que ce mot. Les images et les PDF fonctionnent aussi : déposez-les sur la carte ou utilisez le menu Services du Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⇧ per spostare la selezione, ⌥ per aggiungere agli appunti, fai clic su una parola per copiare solo quella. Funziona anche con immagini e PDF: rilasciali sulla scheda o usa il menu Servizi del Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧を押したままで選択範囲を移動、⌥でクリップボードに追加、単語をクリックするとその単語だけをコピーします。画像やPDFにも使えます: カードにドロップするか、Finderの“サービス”メニューを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧ 키를 누르고 있으면 선택 영역이 이동하고, ⌥ 키를 누르고 있으면 클립보드에 추가되며, 단어를 클릭하면 그 단어만 복사됩니다. 이미지와 PDF도 사용할 수 있습니다. 카드에 놓거나 Finder의 서비스 메뉴를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⇧ para mover a seleção, ⌥ para adicionar à área de transferência, clique em uma palavra para copiar só ela. Imagens e PDFs também funcionam: solte-os no cartão ou use o menu Serviços do Finder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⇧, чтобы переместить выделение, ⌥ — чтобы добавить в буфер обмена; нажмите на слово, чтобы скопировать только его. Изображения и PDF тоже подходят: бросьте их на карточку или используйте меню «Службы» в Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⇧ 可移动选区，按住 ⌥ 可添加到剪贴板，点按某个词可仅拷贝该词。也支持图像和 PDF：将其拖放到卡片上，或使用访达的“服务”菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⇧ 可移動選取範圍，按住 ⌥ 可加入剪貼板，按一下單字即可只拷貝該單字。影像和 PDF 也適用：將其放到卡片上，或使用 Finder 的「服務」選單。"
          }
        }
      }
    },
    "Hold ⇧ when you release to save instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Loslassen ⇧ halten, um stattdessen zu sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⇧ al soltar para guardar en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⇧ en relâchant pour enregistrer à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⇧ al rilascio per salvare invece."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりに保存するには、離すときに⇧を押したままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 저장하려면 손을 뗄 때 ⇧를 누르고 있으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⇧ pressionada ao soltar para salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⇧ при отпускании, чтобы вместо этого сохранить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开时按住 ⇧ 则改为存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放開時按住 ⇧ 即可改為儲存。"
          }
        }
      }
    },
    "Hold ⇧ while dragging a window to snap it into zones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ziehen eines Fensters ⇧ halten, um es in Zonen einrasten zu lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⇧ mientras arrastras una ventana para ajustarla a las zonas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⇧ en faisant glisser une fenêtre pour l’ancrer dans les zones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⇧ mentre trascini una finestra per agganciarla alle zone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウをドラッグ中に⇧を押したままにすると、ゾーンにスナップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 드래그하는 동안 ⇧를 누르고 있으면 영역에 스냅됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⇧ pressionada ao arrastar uma janela para encaixá-la nas zonas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⇧ при перетягивании окна, чтобы привязать его к зонам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移窗口时按住 ⇧ 即可将其吸附到区域中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移視窗時按住 ⇧ 即可將其貼齊到區域中。"
          }
        }
      }
    },
    "Hold ⇧ while you drop, or pin the shelf, to keep it open. Closed shelves can be reopened from Recent Shelves.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ablegen ⇧ halten oder die Ablage anheften, damit sie offen bleibt. Geschlossene Ablagen lassen sich unter „Letzte Ablagen“ wieder öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⇧ al soltar, o fija la bandeja, para que siga abierta. Las bandejas cerradas pueden volver a abrirse desde Bandejas recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⇧ en déposant, ou épinglez l’étagère, pour la garder ouverte. Les étagères fermées peuvent être rouvertes depuis Étagères récentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⇧ mentre rilasci, o fissa lo scaffale, per tenerlo aperto. Gli scaffali chiusi si possono riaprire da Scaffali recenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェルフを開いたままにするには、ドロップ時に⇧を押したままにするか、シェルフをピン留めします。閉じたシェルフは“最近のシェルフ”から再び開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선반을 열어 두려면 놓을 때 ⇧ 키를 누르고 있거나 선반을 고정하세요. 닫은 선반은 최근 선반에서 다시 열 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⇧ ao soltar, ou fixe a prateleira, para mantê-la aberta. Prateleiras fechadas podem ser reabertas em Prateleiras Recentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы полка оставалась открытой, удерживайте ⇧ при отпускании или закрепите ее. Закрытые полки можно снова открыть из раздела «Недавние полки»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放时按住 ⇧ 或固定文件架，可使其保持打开。关闭的文件架可从“最近的文件架”中重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放開時按住 ⇧，或釘選檔案架，即可讓它保持打開。關閉的檔案架可從「最近的檔案架」重新打開。"
          }
        }
      }
    },
    "Hold ⌘": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌘"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir ⌘"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌘"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘を押したまま"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ 누른 채"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segurar ⌘"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌘"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘"
          }
        }
      }
    },
    "Hold ⌘ and drag icons left of the divider to hide them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ halten und Symbole links neben die Trennlinie ziehen, um sie auszublenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌘ y arrastra iconos a la izquierda del divisor para ocultarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌘ et faites glisser des icônes à gauche du séparateur pour les masquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌘ e trascina le icone a sinistra del divisore per nasconderle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘を押したまま、アイコンを区切り線の左側にドラッグすると隠れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ 키를 누른 채 아이콘을 구분선 왼쪽으로 드래그하면 숨겨집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⌘ e arraste ícones para a esquerda do divisor para ocultá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌘ и перетяните значки левее разделителя, чтобы скрыть их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 并将图标拖到分隔线左侧即可隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 並將圖像拖移到分隔線左側即可隱藏。"
          }
        }
      }
    },
    "Hold ⌘ and drag icons to the left of the divider. Click the chevron, hover or press your shortcut to bring them back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ halten und Symbole links neben die Trennlinie ziehen. Zum Zurückholen auf den Chevron klicken, darüberfahren oder den Kurzbefehl drücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌘ y arrastra iconos a la izquierda del divisor. Haz clic en la flecha, pasa el puntero o pulsa tu atajo para recuperarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌘ et faites glisser des icônes à gauche du séparateur. Cliquez sur le chevron, survolez-le ou appuyez sur votre raccourci pour les faire revenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌘ e trascina le icone a sinistra del divisore. Fai clic sulla freccia, passaci sopra con il puntatore o premi l'abbreviazione per richiamarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘を押したまま、アイコンを区切り線の左側にドラッグします。再表示するには、シェブロンをクリックするか、ポインタを合わせるか、ショートカットを押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ 키를 누른 채 아이콘을 구분선 왼쪽으로 드래그하세요. 다시 표시하려면 꺾쇠 아이콘을 클릭하거나, 포인터를 올리거나, 단축키를 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⌘ e arraste ícones para a esquerda do divisor. Clique no chevron, passe o ponteiro ou pressione seu atalho para trazê-los de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌘ и перетяните значки левее разделителя. Чтобы вернуть их, нажмите шеврон, наведите указатель или нажмите сочетание клавиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 并将图标拖到分隔线左侧。点按 V 形符号、悬停或按下快捷键可让它们重新显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 並將圖像拖移到分隔線左側。按一下箭頭、將指標停在上面或按下你的快速鍵即可讓它們重新出現。"
          }
        }
      }
    },
    "Hold ⌘ or press the shortcut": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ halten oder den Kurzbefehl drücken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌘ o pulsa el atajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir ⌘ ou appuyer sur le raccourci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌘ o premi l'abbreviazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘を押したままにするか、ショートカットを押す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘을 누르고 있거나 단축키 누르기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segurar ⌘ ou pressionar o atalho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌘ или нажмите сочетание клавиш"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 或按快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 或按下快速鍵"
          }
        }
      }
    },
    "Hold ⌘ to see every shortcut of the frontmost app, plus macOS and MacToys shortcuts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ halten, um alle Kurzbefehle der vordersten App sowie von macOS und MacToys zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌘ para ver todos los atajos de la app en primer plano, además de los de macOS y MacToys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌘ pour voir tous les raccourcis de l’app au premier plan, ainsi que ceux de macOS et de MacToys."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌘ per vedere tutte le abbreviazioni dell'app in primo piano, oltre a quelle di macOS e MacToys."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘を押したままにすると、最前面のAppのすべてのショートカットと、macOSとMacToysのショートカットが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘을 누르고 있으면 맨 앞에 있는 앱의 모든 단축키와 macOS 및 MacToys 단축키가 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⌘ pressionada para ver todos os atalhos do app em primeiro plano, além dos atalhos do macOS e do MacToys."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌘, чтобы увидеть все сочетания клавиш активного приложения, а также сочетания macOS и MacToys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 即可查看最前面的 App 的所有快捷键，以及 macOS 和 MacToys 的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 即可查看最前方 App 的所有快速鍵，以及 macOS 和 MacToys 的快速鍵。"
          }
        }
      }
    },
    "Hold ⌘ to see the shortcuts of the frontmost app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ halten, um die Kurzbefehle der vordersten App zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌘ para ver los atajos de la app en primer plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌘ pour voir les raccourcis de l’app au premier plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌘ per vedere le abbreviazioni dell'app in primo piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘を押したままにすると、最前面のAppのショートカットが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘을 누르고 있으면 맨 앞에 있는 앱의 단축키가 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⌘ pressionada para ver os atalhos do app em primeiro plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌘, чтобы увидеть сочетания клавиш активного приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 即可查看最前面的 App 的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 即可查看最前方 App 的快速鍵。"
          }
        }
      }
    },
    "Hold ⌘ while selecting to skip the bar once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Auswählen ⌘ halten, um die Leiste einmal zu überspringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌘ al seleccionar para omitir la barra una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌘ pendant la sélection pour ignorer la barre une fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌘ durante la selezione per saltare la barra una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中に⌘を押したままにすると、1回だけバーを表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택할 때 ⌘ 키를 누르고 있으면 이번만 막대가 나타나지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⌘ ao selecionar para pular a barra uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌘ при выделении, чтобы один раз не показывать панель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
