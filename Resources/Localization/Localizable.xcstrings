    "Off saves them as others see you, so text reads the right way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aus“ sichert sie so, wie andere einen sehen, damit Text lesbar bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: se guardan como te ven los demás, para que el texto se lea bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, elles sont enregistrées telles que les autres vous voient, pour que le texte se lise dans le bon sens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、相手から見えるとおりに保存されるため、文字が正しい向きで読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 다른 사람에게 보이는 모습대로 저장되므로 텍스트가 올바른 방향으로 읽힙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado salva as fotos como os outros veem você, para que o texto fique legível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, фото сохраняются такими, какими вас видят другие, и текст читается правильно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，照片按他人看到你的样子存储，因此文字方向正确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時會以他人看到你的樣子儲存，因此文字方向正確。"
          }
        }
      }
    },
    "Off shows crisp pixels.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aus“ zeigt scharfe Pixel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado muestra píxeles nítidos."
          }
