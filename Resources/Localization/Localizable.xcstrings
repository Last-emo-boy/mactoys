          "stringUnit": {
            "state": "translated",
            "value": "Separa più nomi host con spazi. Disattiva “Attivo” per mantenere la voce commentata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のホスト名はスペースで区切ります。エントリをコメントアウトしたままにするには“有効”をオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 호스트 이름은 공백으로 구분하세요. 항목을 주석 처리된 상태로 유지하려면 활성을 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Separe vários nomes de host com espaços. Desative “Ativo” para manter a entrada comentada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделяйте несколько имен узлов пробелами. Выключите «Активно», чтобы запись оставалась закомментированной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个主机名以空格分隔。关闭“启用”可将该条目保持为注释状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以空格分隔多個主機名稱。關閉「啟用」即可讓項目保持註解狀態。"
          }
        }
      }
    },
