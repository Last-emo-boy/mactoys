    "Drag to reorder. Each action appears only when it fits the selection, so the bar stays short.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Neuordnen ziehen. Jede Aktion erscheint nur, wenn sie zur Auswahl passt, damit die Leiste kurz bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Cada acción solo aparece cuando encaja con la selección, así la barra se mantiene corta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Chaque action n’apparaît que si elle convient à la sélection, pour que la barre reste courte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Ogni azione compare solo quando è adatta alla selezione, così la barra resta corta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。各アクションは選択内容に合う場合にのみ表示されるため、バーは短いままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서를 변경하세요. 각 동작은 선택 항목에 맞을 때만 나타나므로 막대가 짧게 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Cada ação só aparece quando combina com a seleção, para que a barra continue curta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягивайте, чтобы изменить порядок. Каждое действие появляется, только если подходит к выделенному тексту, поэтому панель остается короткой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排序。每个操作仅在适用于所选内容时显示，因此操作栏会保持简短。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移即可重新排序。每個動作只會在適用於選取內容時出現，因此工具列會保持簡短。"
          }
        }
      }
    },
