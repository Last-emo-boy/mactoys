    "Copy several things, then each ⌘V pastes the next one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Dinge kopieren; jedes ⌘V setzt dann das nächste ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
