    "After %@: b byte (default), h/H hex digit, x/X two hex digits, f float 0.##, F float .## — e.g. %@. After other values: i integer, p percent (%@).": {
      "comment": "Color format reference. Each %@ is one or more parameter codes. Keep the letters b, h/H, x/X, f, F, i, p and the patterns 0.## and .## unchanged: they are format codes.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "After %1$@: b byte (default), h/H hex digit, x/X two hex digits, f float 0.##, F float .## — e.g. %2$@. After other values: i integer, p percent (%3$@)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %1$@ 之後：b 位元組（預設）、h/H 一位十六進位數字、x/X 兩位十六進位數字、f 浮點數 0.##、F 浮點數 .## — 例如 %2$@。在其他值之後：i 整數、p 百分比（%3$@）。"
          }
        }
      }
    },
    "After %lld seconds": {
      "localizations": {
