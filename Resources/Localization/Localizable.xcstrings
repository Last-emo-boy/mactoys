            "value": "Letzte Aufnahmen bleiben in „Application Support“, bereit zum erneuten Anmerken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas recientes se quedan en Application Support, listas para volver a anotarlas."
          }
