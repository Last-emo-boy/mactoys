    },
    "What the shortcut does.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵的作用。"
          }
        }
      }
    },
    "What you ran rises in the results": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你執行過的項目會在結果中排名上升"
          }
        }
      }
    },
    "What’s Using These Items?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些程序正在使用這些項目？"
