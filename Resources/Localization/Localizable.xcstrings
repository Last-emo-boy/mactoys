    "Restore puts an original back while it’s kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wiederherstellen“ setzt ein Original zurück, solange es aufbewahrt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar recupera un original mientras se conserve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer remet en place un original tant qu’il est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina rimette a posto un originale finché viene conservato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジナルが保持されている間は、“復元”でオリジナルに戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본이 보관되어 있는 동안에는 복원으로 되돌릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar recoloca um original enquanto ele estiver guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка «Восстановить» возвращает оригинал, пока он хранится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
