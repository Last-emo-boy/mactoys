    "Time zone identifiers listed with “%@”, e.g. %@; one per line.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitzonen-IDs, wie von „%1$@“ aufgelistet, z. B. %2$@; eine pro Zeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Time zone identifiers listed with “%1$@”, e.g. %2$@; one per line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Identificadores de zona horaria listados con “%1$@”, p. ej., %2$@; uno por línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiants de fuseau horaire listés par « %1$@ », p. ex. %2$@ ; un par ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Identificatori dei fusi orari elencati con “%1$@”, ad es. %2$@; uno per riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”で表示される時間帯識別子（例: %2$@）。1行に1つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”(으)로 나열되는 시간대 식별자(예: %2$@). 한 줄에 하나씩 입력합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Identificadores de fuso horário listados com “%1$@”, ex.: %2$@; um por linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификаторы часовых поясов из списка «%1$@», например %2$@; по одному в строке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“%1$@”列出的时区标识符，例如 %2$@；每行一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以「%1$@」列出的時區識別碼，例如 %2$@；每行一個。"
          }
        }
      }
    },
