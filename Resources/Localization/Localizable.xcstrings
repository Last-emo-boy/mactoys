    "Find running processes and quit or kill them": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufende Prozesse finden und beenden oder sofort beenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar procesos en ejecución y salir de ellos o forzar su salida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouver les processus en cours et les quitter ou les forcer à quitter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova i processi in esecuzione e chiudili o terminali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のプロセスを探して、終了または強制終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 프로세스를 찾아 종료하거나 강제 종료"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre processos em execução e encerre-os ou force o encerramento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
