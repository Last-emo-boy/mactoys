    "Window captures have transparent corners. With a background frame (below), shadow and padding come from the frame instead.": {
      "comment": "Screenshot settings: window capture footer",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fensteraufnahmen haben transparente Ecken. Mit einem Hintergrundrahmen (unten) kommen Schatten und Rand stattdessen vom Rahmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de ventana tienen esquinas transparentes. Con un marco de fondo (abajo), la sombra y el margen los aporta el marco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures de fenêtre ont des coins transparents. Avec un cadre d’arrière-plan (ci-dessous), l’ombre et la marge intérieure proviennent du cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le acquisizioni di finestre hanno angoli trasparenti. Con una cornice di sfondo (qui sotto), ombra e margine vengono invece dalla cornice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウのキャプチャは角が透明になります。背景フレーム（下記）を使用する場合は、影と余白はフレームのものになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우 캡처는 모서리가 투명합니다. 배경 프레임(아래)을 사용하면 그림자와 패딩은 프레임에서 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas de janela têm cantos transparentes. Com uma moldura de fundo (abaixo), a sombra e a margem vêm da moldura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У снимков окон прозрачные углы. С фоновой рамкой (ниже) тень и поля задаются рамкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口截图带有透明圆角。使用背景框（见下方）时，阴影和边距改由背景框提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗擷取的角落是透明的。使用背景外框（下方）時，陰影和填補會改由外框提供。"
          }
        }
      }
    },
