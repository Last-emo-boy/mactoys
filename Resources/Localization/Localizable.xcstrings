    "What it does": {
      "comment": "Subtitle of a new script command, until the user edits it",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用途說明"
          }
        }
      }
    },
    "What shows through transparent areas": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透明區域中顯示的內容"
