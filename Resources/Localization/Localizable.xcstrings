          "stringUnit": {
            "state": "translated",
            "value": "Legt Milchglas über jedes Display. Esc, ein Klick oder der Kurzbefehl entfernt es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esmerila todas las pantallas. Esc, un clic o el atajo lo quitan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Givre chaque écran. Échap, un clic ou le raccourci le retire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smeriglia ogni monitor. Esc, un clic o l'abbreviazione lo rimuovono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのディスプレイをすりガラスにします。esc、クリック、またはショートカットで解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 디스플레이를 젖빛 유리처럼 흐리게 합니다. Esc, 클릭 또는 단축키로 해제합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa todos os monitores foscos. Esc, um clique ou o atalho removem o efeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размывает все дисплеи. Убрать размытие можно клавишей Esc, нажатием или сочетанием клавиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为所有显示器蒙上磨砂效果。按 Esc、点按或使用快捷键可清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓每台顯示器呈現毛玻璃效果。按 Esc、按一下或快速鍵即可清除。"
          }
        }
      }
    },
