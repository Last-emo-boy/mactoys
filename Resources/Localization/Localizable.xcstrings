    "Processes of other users weren’t checked. Restart as administrator to include them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozesse anderer Benutzer wurden nicht geprüft. Zum Einbeziehen als Administrator neu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han comprobado los procesos de otros usuarios. Reinicia como administrador para incluirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les processus des autres utilisateurs n’ont pas été vérifiés. Redémarrez en tant qu’administrateur pour les inclure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I processi di altri utenti non sono stati controllati. Riavvia come amministratore per includerli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのユーザのプロセスは確認されていません。含めるには管理者として再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사용자의 프로세스는 확인하지 않았습니다. 포함하려면 관리자로 다시 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os processos de outros usuários não foram verificados. Reinicie como administrador para incluí-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процессы других пользователей не проверены. Перезапустите от имени администратора, чтобы включить их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检查其他用户的进程。以管理员身份重新启动即可包括这些进程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未檢查其他使用者的程序。請以管理者身分重新啟動以將其納入。"
          }
        }
      }
    },
