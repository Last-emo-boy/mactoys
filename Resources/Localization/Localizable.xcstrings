    "Lock, sleep, restart, shut down, log out, empty the Trash, toggle Dark Mode and more": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperren, Ruhezustand, Neustart, Ausschalten, Abmelden, Papierkorb entleeren, Dunkelmodus umschalten und mehr"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear, reposo, reiniciar, apagar, cerrar sesión, vaciar la Papelera, activar o desactivar el modo oscuro y más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller, suspendre l’activité, redémarrer, éteindre, fermer la session, vider la corbeille, activer le mode sombre et plus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca, metti in stop, riavvia, spegni, esegui il logout, svuota il Cestino, attiva/disattiva la modalità scura e altro"
          }
        },
        "ja": {
          "stringUnit": {
