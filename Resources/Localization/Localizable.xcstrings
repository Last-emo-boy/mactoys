          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает или скрывает «Палитру команд»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示或隐藏命令面板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示或隱藏指令面板"
          }
        }
      }
    },
    "Shows or hides Run": {
      "localizations": {
