          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "形狀增加空間時擷取內容的位置。"
          }
        }
      }
    },
    "Which previewer macOS uses": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
