          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案本身絕不會變更"
          }
        }
      }
    },
    "The files may have been moved, or the folder can’t be written to.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien wurden möglicherweise bewegt, oder in den Ordner kann nicht geschrieben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que los archivos se hayan movido o que no se pueda escribir en la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers ont peut-être été déplacés, ou le dossier n’est pas accessible en écriture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file potrebbero essere stati spostati o la cartella non è scrivibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが移動されたか、フォルダに書き込めない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 이동되었거나 폴더에 쓸 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos podem ter sido movidos ou não é possível gravar na pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, файлы были перемещены или в папку нельзя записывать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件可能已被移动，或者无法写入该文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案可能已被移動，或無法寫入此檔案夾。"
          }
        }
      }
    },
    "The format of the drop zone’s Convert target.": {
