    "Adds ${name}, $+{name}, backslash escapes and \\U \\L \\E \\u \\l case conversion.": {
      "comment": "PowerRename: keep the ${…} tokens and the backslash sequences as they are",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt ${name}, $+{name}, Backslash-Escapes und \\U \\L \\E \\u \\l zur Umwandlung der Groß-/Kleinschreibung hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade ${name}, $+{name}, secuencias de escape con barra invertida y conversión de mayúsculas y minúsculas con \\U \\L \\E \\u \\l."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ${name}, $+{name}, les échappements par barre oblique inversée et la conversion de casse \\U \\L \\E \\u \\l."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge ${name}, $+{name}, sequenze di escape con barra rovesciata e la conversione di maiuscole/minuscole \\U \\L \\E \\u \\l."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "${name}、$+{name}、バックスラッシュエスケープ、\\U \\L \\E \\u \\lによる大文字/小文字変換が使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "${name}, $+{name}, 백슬래시 이스케이프, \\U \\L \\E \\u \\l 대소문자 변환을 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona ${name}, $+{name}, escapes com barra invertida e conversão de maiúsculas/minúsculas \\U \\L \\E \\u \\l."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
