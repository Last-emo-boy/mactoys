    "Select text in any app to get a bar of actions: copy, search, translate, transform and your own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text in einer beliebigen App auswählen, um eine Leiste mit Aktionen zu erhalten: kopieren, suchen, übersetzen, umwandeln und eigene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona texto en cualquier app para obtener una barra de acciones: copiar, buscar, traducir, transformar y las tuyas propias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez du texte dans n’importe quelle app pour obtenir une barre d’actions : copier, rechercher, traduire, transformer et les vôtres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona del testo in qualsiasi app per avere una barra di azioni: copia, cerca, traduci, trasforma e le tue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のAppでテキストを選択すると、コピー、検索、翻訳、変換、独自のアクションを含むバーが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 앱에서나 텍스트를 선택하면 복사, 검색, 번역, 변환 및 직접 만든 동작이 있는 막대가 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione texto em qualquer app para ver uma barra de ações: copiar, buscar, traduzir, transformar e as suas próprias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите текст в любом приложении, чтобы увидеть панель действий: копирование, поиск, перевод, преобразование и ваши собственные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
