    "System-wide settings (/etc/zshenv, /etc/paths, /etc/paths.d) are read-only here. Variables only reach shells and apps started after Apply.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemweite Einstellungen (/etc/zshenv, /etc/paths, /etc/paths.d) sind hier schreibgeschützt. Variablen erreichen nur Shells und Apps, die nach „Anwenden“ gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de todo el sistema (/etc/zshenv, /etc/paths, /etc/paths.d) son de solo lectura aquí. Las variables solo llegan a los shells y las apps que se abran después de Aplicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages système (/etc/zshenv, /etc/paths, /etc/paths.d) sont ici en lecture seule. Les variables n’atteignent que les shells et les apps démarrés après Appliquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni di sistema (/etc/zshenv, /etc/paths, /etc/paths.d) qui sono in sola lettura. Le variabili raggiungono solo le shell e le app avviate dopo Applica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム全体の設定（/etc/zshenv、/etc/paths、/etc/paths.d）はここでは読み出し専用です。変数は“適用”後に起動したシェルとAppにのみ反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 전체 설정(/etc/zshenv, /etc/paths, /etc/paths.d)은 여기에서 읽기 전용입니다. 변수는 적용 이후에 시작된 셸과 앱에만 반영됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes de todo o sistema (/etc/zshenv, /etc/paths, /etc/paths.d) são somente leitura aqui. As variáveis só chegam a shells e apps iniciados após Aplicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общесистемные настройки (/etc/zshenv, /etc/paths, /etc/paths.d) здесь доступны только для чтения. Переменные попадают только в оболочки и приложения, запущенные после «Применить»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处的系统范围设置（/etc/zshenv、/etc/paths、/etc/paths.d）为只读。变量只会作用于点按“应用”后启动的 shell 和 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統層級的設定（/etc/zshenv、/etc/paths、/etc/paths.d）在此處為唯讀。變數只會影響「套用」後啟動的 shell 和 App。"
          }
        }
      }
    },
