    "MacToys wants to install its charge helper, which switches charging on and off.": {
      "comment": "Administrator prompt for installing the charge helper",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys möchte sein Ladehilfsprogramm installieren, das das Laden ein- und ausschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys quiere instalar su asistente de carga, que activa y desactiva la carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys souhaite installer son outil d’assistance de charge, qui active et désactive la charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys vuole installare l'helper di carica, che attiva e disattiva la carica."
          }
