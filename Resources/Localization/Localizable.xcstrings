          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivare la modalità massima compatibilità?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大互換モードをオンにしますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 호환성 모드를 켜겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar o modo de compatibilidade máxima?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить режим максимальной совместимости?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要打开最大兼容模式吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要開啟最大相容性模式嗎？"
          }
        }
      }
    },
    "Turn on switches below to see them here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten Schalter einschalten, um sie hier zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa interruptores abajo para verlos aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez des interrupteurs ci-dessous pour les voir ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下でスイッチをオンにすると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에서 스위치를 켜면 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative alternadores abaixo para vê-los aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите переключатели ниже, чтобы видеть их здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开下方的开关即可在此处看到它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟下方的開關即可在此處查看。"
          }
        }
      }
    },
    "Turn one app down, boost another, send music to the speakers and calls to your headphones. Apps you don't change play as they are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App leiser stellen, eine andere verstärken, Musik an die Lautsprecher und Anrufe an die Kopfhörer senden. Unveränderte Apps spielen wie gewohnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el volumen de una app, sube el de otra, envía la música a los altavoces y las llamadas a los auriculares. Las apps que no cambies suenan como siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baissez une app, montez-en une autre, envoyez la musique vers les haut-parleurs et les appels vers votre casque. Les apps que vous ne modifiez pas sont lues telles quelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa un'app, alzane un'altra, invia la musica agli altoparlanti e le chiamate alle cuffie. Le app che non modifichi suonano come sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あるAppの音量を下げ、別のAppを上げ、音楽はスピーカーに、通話はヘッドフォンに送ることができます。変更しないAppはそのまま再生されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 앱의 음량은 줄이고 다른 앱은 키우며, 음악은 스피커로, 통화는 헤드폰으로 보냅니다. 변경하지 않은 앱은 그대로 재생됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixe o volume de um app, aumente o de outro, envie a música para os alto-falantes e as chamadas para os fones de ouvido. Os apps que você não alterar tocam como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте одно приложение тише, другое громче, отправьте музыку на динамики, а звонки — в наушники. Приложения, которые вы не меняете, звучат как обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调低一个 App 的音量、调高另一个，将音乐发送到扬声器、通话发送到耳机。你未更改的 App 照常播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調低一個 App 的音量、調高另一個，將音樂傳送到揚聲器、通話傳送到耳機。你未更改的 App 會照常播放。"
          }
        }
      }
    },
    "Turn the displays off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays ausschalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar las pantallas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éteindre les écrans"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spegni i monitor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイをオフにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 끄기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligar os monitores"
          }
        },
        "ru": {
