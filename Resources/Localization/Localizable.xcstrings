    "Enter it on your other Macs. Only Macs with the key can connect; everything is encrypted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den anderen Macs eingeben. Nur Macs mit dem Schlüssel können sich verbinden; alles ist verschlüsselt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdúcela en tus otros Mac. Solo los Mac con la clave pueden conectarse; todo está cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez-la sur vos autres Mac. Seuls les Mac qui possèdent la clé peuvent se connecter ; tout est chiffré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inseriscila sugli altri Mac. Solo i Mac con la chiave possono connettersi; tutto è crittografato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのMacでこれを入力してください。このキーを持つMacだけが接続でき、通信はすべて暗号化されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Mac에 이 키를 입력하세요. 키가 있는 Mac만 연결할 수 있으며 모든 내용이 암호화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite-a nos seus outros Macs. Somente Macs com a chave podem se conectar; tudo é criptografado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите его на других Mac. Подключиться могут только Mac с этим ключом; все данные шифруются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的其他 Mac 上输入此密钥。只有拥有该密钥的 Mac 才能连接；所有内容都经过加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在你的其他 Mac 上輸入此密鑰。只有具備此密鑰的 Mac 才能連線；所有內容都會加密。"
          }
        }
      }
    },
