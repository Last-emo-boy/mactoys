    "Allow MacToys to control Finder to empty the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys erlauben, den Finder zu steuern, um den Papierkorb zu entleeren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que MacToys controle el Finder para vaciar la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacToys à contrôler le Finder pour vider la corbeille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にするには、MacToysによるFinderの制御を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
