    "Turned-off formats are hidden in the editor. Sample values show %@.": {
      "comment": "%@ is a hex color value, e.g. #FF5F4A",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivierte Formate werden im Editor ausgeblendet. Beispielwerte zeigen %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los formatos desactivados se ocultan en el editor. Los valores de ejemplo muestran %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les formats désactivés sont masqués dans l’éditeur. Les valeurs d’exemple affichent %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I formati disattivati sono nascosti nell'editor. I valori di esempio mostrano %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにした形式はエディタに表示されません。サンプル値には%@が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끈 형식은 편집기에서 숨겨집니다. 샘플 값은 %@을(를) 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatos desativados ficam ocultos no editor. Os valores de exemplo mostram %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключенные форматы скрыты в редакторе. Примеры значений показывают %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭的格式在编辑器中隐藏。示例值显示 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉的格式會在編輯器中隱藏。範例值顯示 %@。"
          }
        }
      }
    },
    "Turning off the localhost entry can break apps that talk to this Mac": {
      "comment": "Hosts entry problem; localhost is a host name, keep it as is",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Deaktivieren des localhost-Eintrags kann Apps stören, die mit diesem Mac kommunizieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar la entrada localhost puede afectar a las apps que se comunican con este Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver l’entrée localhost peut perturber les apps qui communiquent avec ce Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivare la voce localhost può interrompere le app che comunicano con questo Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "localhostエントリをオフにすると、このMacと通信するAppが動作しなくなる場合があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "localhost 항목을 끄면 이 Mac과 통신하는 앱이 작동하지 않을 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar a entrada localhost pode quebrar apps que se comunicam com este Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключение записи localhost может нарушить работу приложений, взаимодействующих с этим Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 localhost 条目可能会导致与此 Mac 通信的 App 出现问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉 localhost 項目可能會導致與此 Mac 通訊的 App 無法正常運作"
          }
        }
      }
    },
    "Turns Focus Blur on or off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die Fokusunschärfe ein oder aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva Desenfoque de fondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive Flou d’arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva Sfocatura sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスぼかしのオン/オフを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스 흐림을 켜거나 끕니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa ou desativa o Desfoque de Foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает или выключает размытие вокруг окна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开或关闭聚焦模糊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟或關閉焦點模糊。"
          }
        }
      }
    },
    "Turns Private Apps on or off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet „Private Apps“ ein oder aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva Apps privadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive Apps privées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva App private."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“プライベートなApp”のオン/オフを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 앱을 켜거나 끕니다."
          }
