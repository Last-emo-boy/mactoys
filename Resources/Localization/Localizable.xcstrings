    "Processes of other users weren’t checked. Restart as administrator to include them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozesse anderer Benutzer wurden nicht geprüft. Zum Einbeziehen als Administrator neu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han comprobado los procesos de otros usuarios. Reinicia como administrador para incluirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les processus des autres utilisateurs n’ont pas été vérifiés. Redémarrez en tant qu’administrateur pour les inclure."
