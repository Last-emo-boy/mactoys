          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗與佈局"
          }
        }
      }
    },
    "Windows": {
      "comment": "Provider name: open windows\nTab View: title of the window map",
      "localizations": {
