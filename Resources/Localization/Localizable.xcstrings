    "Find any icon by its name or its app and open it from the keyboard, hidden or not. Reads item names through Accessibility.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Symbol nach Name oder App finden und per Tastatur öffnen, ausgeblendet oder nicht. Liest Objektnamen über die Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca cualquier icono por su nombre o su app y ábrelo desde el teclado, esté oculto o no. Lee los nombres de los ítems mediante Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez n’importe quelle icône par son nom ou son app et ouvrez-la au clavier, masquée ou non. Lit les noms des éléments via Accessibilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova qualsiasi icona per nome o per app e aprila dalla tastiera, nascosta o no. Legge i nomi degli elementi tramite Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示かどうかにかかわらず、名前やAppでアイコンを検索し、キーボードから開けます。項目名はアクセシビリティを通じて読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨겨져 있든 아니든 아이콘을 이름이나 앱으로 찾아 키보드로 엽니다. 손쉬운 사용을 통해 항목 이름을 읽습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre qualquer ícone pelo nome ou pelo app e abra-o pelo teclado, oculto ou não. Lê os nomes dos itens pela Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находите любой значок по названию или приложению и открывайте его с клавиатуры — скрытый или нет. Названия объектов читаются через универсальный доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按名称或所属 App 查找任意图标，并通过键盘打开它，无论是否隐藏。通过辅助功能读取项目名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依名稱或所屬 App 尋找任何圖像，並從鍵盤打開，無論是否隱藏。透過「輔助使用」讀取項目名稱。"
          }
        }
      }
    },
