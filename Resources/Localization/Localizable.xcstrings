    "Ends the process immediately. Unsaved work is lost.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina subito il processo. Il lavoro non salvato andrà perso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스를 즉시 종료합니다. 저장하지 않은 작업은 손실됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra o processo imediatamente. Trabalhos não salvos são perdidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即结束进程。未存储的工作将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即結束程序。未儲存的工作將會遺失。"
          }
        }
      }
    },
    "Energy": {
      "comment": "Unit category",
      "localizations": {
