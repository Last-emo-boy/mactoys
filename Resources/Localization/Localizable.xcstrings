    "Zoom, annotate, time breaks and record the screen for presentations.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Präsentationen zoomen, kommentieren, Pausen timen und den Bildschirm aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplía, anota, cronometra descansos y graba la pantalla para presentaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomez, annotez, chronométrez les pauses et enregistrez l’écran pour vos présentations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrandisci, annota, cronometra le pause e registra lo schermo per le presentazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレゼンテーション用に、画面のズーム、注釈、休憩タイマー、収録を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레젠테이션을 위해 화면을 확대하고, 주석을 달고, 휴식 시간을 재고, 화면을 기록합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplie, faça anotações, cronometre pausas e grave a tela para apresentações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличивайте, комментируйте, отсчитывайте перерывы и записывайте экран для презентаций."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为演示缩放屏幕、添加标注、计时休息和录制屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為簡報放大、加上註解、計時休息和錄製螢幕。"
          }
        }
      }
    },
