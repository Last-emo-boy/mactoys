              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Retour en arrière dans %lld seconde si vous ne la gardez pas."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Retour en arrière dans %lld secondes si vous ne la gardez pas."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "維持しない場合、%lld秒後に元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지하지 않으면 %lld초 후 원래대로 돌아갑니다."
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
