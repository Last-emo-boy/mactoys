            "state": "translated",
            "value": "其他使用方式"
          }
        }
      }
    },
    "Otherwise a 2×2 grid: slots 1 2 on top, 3 4 below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andernfalls ein 2×2-Raster: Plätze 1 2 oben, 3 4 unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, una cuadrícula de 2×2: posiciones 1 2 arriba, 3 4 abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, une grille 2×2 : emplacements 1 2 en haut, 3 4 en bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti una griglia 2×2: posizioni 1 2 in alto, 3 4 in basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以外の場合は2×2のグリッド: 上にスロット1 2、下に3 4。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그렇지 않으면 2×2 격자: 위쪽에 슬롯 1 2, 아래쪽에 3 4."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, uma grade 2×2: posições 1 2 em cima, 3 4 embaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Иначе сетка 2×2: слоты 1 2 сверху, 3 4 снизу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则为 2×2 网格：位置 1 2 在上，3 4 在下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "否則為 2×2 格狀：上方為位置 1 2，下方為 3 4。"
          }
        }
      }
    },
    "Otherwise a shelf stays on the desktop where it opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andernfalls bleibt eine Ablage auf dem Schreibtisch, wo sie geöffnet wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, la bandeja se queda en el escritorio donde se abrió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, une étagère reste sur le bureau là où elle s’est ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti uno scaffale resta sulla scrivania dove si è aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以外の場合、シェルフは開いたデスクトップにとどまります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그렇지 않으면 선반은 열렸던 데스크탑에 남아 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, a prateleira fica na mesa onde foi aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Иначе полка остается на том рабочем столе, где открылась."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则文件架会停留在其打开时所在的桌面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "否則檔案架會留在桌面上打開的位置。"
          }
        }
      }
    },
    "Otherwise dropping on a folder of the same disk moves the file, as in Finder. Shelves only point to your files; they never copy them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andernfalls bewegt das Ablegen auf einen Ordner desselben Volumes die Datei, wie im Finder. Ablagen verweisen nur auf die Dateien; sie kopieren sie nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, soltar en una carpeta del mismo disco mueve el archivo, como en el Finder. Las bandejas solo apuntan a tus archivos; nunca los copian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, déposer sur un dossier du même disque déplace le fichier, comme dans le Finder. Les étagères ne font que pointer vers vos fichiers ; elles ne les copient jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti il rilascio su una cartella dello stesso disco sposta il file, come nel Finder. Gli scaffali puntano solo ai tuoi file; non li copiano mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以外の場合、Finderと同様に、同じディスク上のフォルダにドロップするとファイルが移動します。シェルフはファイルを参照するだけで、コピーすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그렇지 않으면 Finder에서처럼 같은 디스크의 폴더에 놓을 때 파일이 이동됩니다. 선반은 파일을 가리키기만 하며 복사하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, soltar em uma pasta do mesmo disco move o arquivo, como no Finder. As prateleiras apenas apontam para seus arquivos; nunca os copiam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Иначе при перетягивании в папку на том же диске файл перемещается, как в Finder. Полки только ссылаются на ваши файлы и никогда не копируют их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则，拖放到同一磁盘上的文件夹会移动文件，与访达中一样。文件架只指向你的文件，从不拷贝它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "否則放到同一磁碟的檔案夾時會移動檔案，與 Finder 相同。檔案架只會指向你的檔案，絕不會拷貝它們。"
          }
        }
      }
    },
    "Otherwise it waits at the edge where it left.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andernfalls wartet er an dem Rand, über den er den Bildschirm verlassen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, espera en el borde por el que salió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, il attend au bord par lequel il est sorti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti attende sul bordo da cui è uscito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以外の場合は、離れた端で待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그렇지 않으면 떠난 가장자리에서 대기합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, ele espera na borda por onde saiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Иначе он ждет у края, через который ушел."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则它会停在离开时的边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "否則它會在離開的邊緣等待。"
          }
        }
      }
    },
    "Otherwise resized files are dated now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andernfalls erhalten skalierte Dateien das aktuelle Datum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, los archivos redimensionados llevan la fecha actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, les fichiers redimensionnés sont datés de maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti i file ridimensionati hanno la data attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以外の場合、サイズ変更したファイルの日付は現在の日時になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그렇지 않으면 크기가 조정된 파일의 날짜가 현재로 설정됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, os arquivos redimensionados recebem a data atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Иначе у файлов с измененным размером будет текущая дата."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则调整大小后的文件日期为当前时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "否則調整大小後的檔案會以現在的時間為日期。"
          }
        }
      }
    },
    "Otherwise the window fits each file. Also with the pin button in the title bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andernfalls passt sich das Fenster jeder Datei an. Auch über die Stecknadel in der Titelleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, la ventana se adapta a cada archivo. También con el botón de la chincheta en la barra de título."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, la fenêtre s’adapte à chaque fichier. Également avec le bouton d’épingle dans la barre de titre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti la finestra si adatta a ogni file. Anche con il pulsante puntina nella barra del titolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以外の場合、ウインドウは各ファイルに合わせたサイズになります。タイトルバーのピンボタンでも設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그렇지 않으면 윈도우가 각 파일에 맞춰집니다. 제목 막대의 핀 버튼으로도 설정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, a janela se ajusta a cada arquivo. Também com o botão de alfinete na barra de título."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Иначе окно подстраивается под каждый файл. Также кнопкой булавки в заголовке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则窗口会适应每个文件。也可以使用标题栏中的图钉按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "否則視窗會配合每個檔案調整。也可使用標題列中的圖釘按鈕。"
          }
        }
      }
    },
