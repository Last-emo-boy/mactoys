    "Preferences are shown read-only. Open one as a document to edit and write it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen werden schreibgeschützt angezeigt. Zum Bearbeiten und Zurückschreiben eine als Dokument öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preferencias se muestran en solo lectura. Abre una como documento para editarla y volver a escribirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les préférences sont affichées en lecture seule. Ouvrez-en une comme document pour la modifier et la réécrire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le preferenze sono mostrate in sola lettura. Aprine una come documento per modificarla e riscriverla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定は読み出し専用で表示されます。編集して書き戻すには、書類として開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경설정은 읽기 전용으로 표시됩니다. 편집하고 다시 기록하려면 문서로 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As preferências são mostradas somente para leitura. Abra uma como documento para editá-la e gravá-la de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки показаны только для чтения. Откройте домен как документ, чтобы изменить и записать его обратно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏好设置以只读方式显示。将其作为文稿打开即可编辑并写回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偏好設定以唯讀方式顯示。請以文件形式打開才能編輯並寫回。"
          }
        }
      }
    },
