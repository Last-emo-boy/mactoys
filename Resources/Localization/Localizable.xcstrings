            "value": "寬度（像素）"
          }
        }
      }
    },
    "Window": {
      "comment": "Label: the saved size and position of the window\nResult row label: an open window",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗"
          }
        }
      }
    },
