    "Off: the guide stays open until esc or a click outside it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Die Übersicht bleibt geöffnet bis esc oder ein Klick außerhalb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: la guía permanece abierta hasta pulsar esc o hacer clic fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : le guide reste ouvert jusqu’à Échap ou un clic à l’extérieur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: la guida resta aperta fino a esc o a un clic all'esterno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ: escを押すか外側をクリックするまで、ガイドは開いたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끔: esc를 누르거나 바깥쪽을 클릭할 때까지 가이드가 열려 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: o guia fica aberto até você pressionar esc ou clicar fora dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл.: руководство остается открытым до нажатия esc или щелчка за его пределами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：指南会一直打开，直到按 esc 或点按其外部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉：指南會保持打開，直到按 esc 或按一下外部。"
          }
        }
      }
    },
    "Off: ↵ copies, ⇧⌘V pastes. Pasting needs Accessibility.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: ↵ kopiert, ⇧⌘V setzt ein. Einsetzen erfordert Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: ↵ copia y ⇧⌘V pega. Pegar requiere Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : ↵ copie, ⇧⌘V colle. Le collage nécessite Accessibilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: ↵ copia, ⇧⌘V incolla. Per incollare serve Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ: ↵でコピー、⇧⌘Vでペースト。ペーストにはアクセシビリティが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끔: ↵로 복사, ⇧⌘V로 붙여넣기. 붙여넣으려면 손쉬운 사용 권한이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: ↵ copia, ⇧⌘V cola. Colar requer Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл.: ↵ копирует, ⇧⌘V вставляет. Для вставки нужно разрешение «Универсальный доступ»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：↵ 拷贝，⇧⌘V 粘贴。粘贴需要辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉：↵ 拷貝，⇧⌘V 貼上。貼上需要輔助使用權限。"
          }
        }
      }
    },
