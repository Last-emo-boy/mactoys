    "Downloads images from the internet when you preview a document, which tells their servers you opened it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt beim Anzeigen einer Dokumentvorschau Bilder aus dem Internet; deren Server erfahren dadurch, dass das Dokument geöffnet wurde"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
