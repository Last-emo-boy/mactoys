    "Capture an area, window or screen, then annotate, frame, pin or share it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Bereich, ein Fenster oder den Bildschirm aufnehmen, dann anmerken, einrahmen, anheften oder teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura un área, una ventana o la pantalla y luego anótala, enmárcala, fíjala o compártela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturez une zone, une fenêtre ou l’écran, puis annotez, encadrez, épinglez ou partagez la capture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cattura un'area, una finestra o lo schermo, poi annota, incornicia, fissa o condividi l'acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲、ウインドウ、画面をキャプチャし、注釈、フレーム、ピン留め、共有ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역, 윈도우 또는 화면을 캡처한 다음 주석을 달거나, 프레임을 씌우거나, 고정하거나, 공유합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture uma área, janela ou tela e depois faça anotações, adicione uma moldura, fixe ou compartilhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимайте область, окно или экран, затем размечайте, добавляйте рамку, закрепляйте или отправляйте снимок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截取区域、窗口或屏幕，然后进行标注、添加背景框、固定或共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取區域、視窗或螢幕，然後加上註解、外框、釘選或分享。"
          }
        }
      }
    },
