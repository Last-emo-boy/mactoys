    },
    "Drag across the grid, or type shares of the screen.": {
      "comment": "Window Controls editor hint",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über das Raster ziehen oder Bildschirmanteile eingeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra sobre la cuadrícula o escribe fracciones de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser sur la grille ou saisissez des fractions de l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina sulla griglia o digita le porzioni dello schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッドをドラッグするか、画面に対する割合を入力します。"
