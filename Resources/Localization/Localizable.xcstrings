          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza la ventana activa con las flechas, la barra espaciadora, Retorno y las teclas numéricas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
