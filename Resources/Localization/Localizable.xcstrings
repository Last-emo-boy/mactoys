          }
        }
      }
    },
    "The slicer's embedded image when there is one, otherwise the toolpath": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das eingebettete Bild des Slicers, falls vorhanden, sonst der Werkzeugpfad"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen incrustada del laminador si la hay; si no, la trayectoria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image intégrée du slicer s’il y en a une, sinon le parcours d’outil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'immagine incorporata dallo slicer, se presente, altrimenti il percorso utensile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライサーの埋め込み画像（ある場合）、それ以外はツールパス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이서에 포함된 이미지가 있으면 해당 이미지, 없으면 툴패스"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem incorporada do fatiador, quando houver; caso contrário, o percurso da ferramenta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенное изображение слайсера, если оно есть, иначе траектория"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如有切片软件内嵌的图像则使用该图像，否则使用刀具路径"
          }
        },
        "zh-Hant": {
          "stringUnit": {
