    "Copy text, QR codes and barcodes from anywhere on screen or in images and PDFs, on device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, QR-Codes und Barcodes von überall auf dem Bildschirm oder aus Bildern und PDFs kopieren, direkt auf dem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia texto, códigos QR y códigos de barras de cualquier parte de la pantalla o de imágenes y PDF, en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez du texte, des codes QR et des codes-barres n’importe où à l’écran ou dans des images et des PDF, sur l’appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia testo, codici QR e codici a barre da qualsiasi punto dello schermo o da immagini e PDF, sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上のあらゆる場所や画像、PDFから、テキスト、QRコード、バーコードをデバイス上でコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 어디서나 또는 이미지와 PDF에서 텍스트, QR 코드 및 바코드를 온디바이스로 복사합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie texto, códigos QR e códigos de barras de qualquer lugar da tela ou de imagens e PDFs, no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копируйте текст, QR-коды и штрихкоды из любого места экрана, изображений и PDF — прямо на устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备端从屏幕任意位置或图像和 PDF 中拷贝文本、二维码和条形码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在裝置上從螢幕任何位置或影像和 PDF 中拷貝文字、QR 碼和條碼。"
          }
        }
      }
    },
    "Copy text, links, images or files and they show up here, newest first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, Links, Bilder oder Dateien kopieren – sie erscheinen hier, das Neueste zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia texto, enlaces, imágenes o archivos y aparecerán aquí, del más reciente al más antiguo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez du texte, des liens, des images ou des fichiers et ils apparaissent ici, du plus récent au plus ancien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia testo, link, immagini o file e compariranno qui, dal più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト、リンク、画像、ファイルをコピーすると、新しい順にここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트, 링크, 이미지 또는 파일을 복사하면 최신 항목부터 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie textos, links, imagens ou arquivos e eles aparecem aqui, dos mais recentes aos mais antigos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте текст, ссылки, изображения или файлы, и они появятся здесь — сначала новые."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝的文本、链接、图像或文件会显示在这里，最新的在前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝的文字、連結、影像或檔案會顯示在這裡，最新的在最前面。"
          }
        }
      }
    },
    "Copy the current selection before running a shortcut; falls back to the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Ausführen eines Kurzbefehls die aktuelle Auswahl kopieren; andernfalls wird die Zwischenablage verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar la selección actual antes de ejecutar un atajo; si no, usa el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier la sélection actuelle avant d’exécuter un raccourci ; utilise sinon le presse-papiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia la selezione attuale prima di eseguire un'abbreviazione; altrimenti usa gli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを実行する前に現在の選択範囲をコピーします。選択範囲がない場合はクリップボードを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 실행하기 전에 현재 선택 항목을 복사하고, 선택 항목이 없으면 클립보드를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar a seleção atual antes de executar um atalho; usa a área de transferência como alternativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копировать текущее выделение перед выполнением сочетания клавиш; иначе используется буфер обмена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
