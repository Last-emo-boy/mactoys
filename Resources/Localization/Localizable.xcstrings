          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'ampia area di lavoro accanto a riferimenti, risorse e chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参考資料、素材、チャットの横に大きなキャンバス。"
          }
        },
        "ko": {
