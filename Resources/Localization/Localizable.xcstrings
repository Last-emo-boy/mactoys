            "value": "先頭の数字、スペース、ドットを非表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞쪽의 숫자, 공백, 점 숨기기"
          }
        },
        "pt-BR": {
