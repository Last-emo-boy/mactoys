    "This monitor didn't report a capabilities string; its controls were found by probing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Monitor hat keine Fähigkeitsangabe gemeldet; seine Steuerelemente wurden durch Abfragen ermittelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este monitor no ha indicado una cadena de capacidades; sus controles se han encontrado mediante sondeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce moniteur n’a pas fourni de chaîne de capacités ; ses commandes ont été trouvées par sondage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo monitor non ha comunicato una stringa di funzionalità; i suoi controlli sono stati trovati sondandolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモニタは機能文字列を報告しなかったため、コントロールは調査によって検出されました。"
          }
        },
        "ko": {
