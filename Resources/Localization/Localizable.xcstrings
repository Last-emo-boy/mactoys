    "Mouse Jump shows desktop pictures instead of live previews.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maussprung zeigt Hintergrundbilder statt Live-Vorschauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto del ratón muestra fondos de pantalla en lugar de vistas previas en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saut de souris affiche les fonds d’écran au lieu des aperçus en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto mouse mostra le immagini della scrivania invece delle anteprime in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスジャンプはライブプレビューの代わりに壁紙を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 점프는 실시간 미리보기 대신 배경화면을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mouse Jump mostra papéis de parede em vez de prévias ao vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Прыжок мыши» показывает обои вместо живых превью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标跳转会显示墙纸而非实时预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑鼠跳躍會顯示桌面圖片，而非即時預覽。"
          }
        }
      }
    },
