    "Allow Accessibility access in System Settings so Shortcut Guide can read %@’s menus.": {
      "comment": "%@ is the name of the frontmost app",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf Bedienungshilfen in den Systemeinstellungen erlauben, damit die Kurzbefehlübersicht die Menüs von %@ lesen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede acceso de Accesibilidad en Ajustes del Sistema para que la Guía de atajos pueda leer los menús de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès Accessibilité dans Réglages Système pour que Guide des raccourcis puisse lire les menus de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso Accessibilità in Impostazioni di Sistema affinché Guida alle abbreviazioni possa leggere i menu di %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットガイドが%@のメニューを読み取れるように、“システム設定”でアクセシビリティへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키 가이드가 %@의 메뉴를 읽을 수 있도록 시스템 설정에서 손쉬운 사용 접근을 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso de Acessibilidade nos Ajustes do Sistema para que o Guia de Atalhos possa ler os menus de %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите универсальный доступ в Системных настройках, чтобы «Руководство по сочетаниям клавиш» могло читать меню приложения «%@»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许辅助功能权限，以便快捷键指南读取 %@ 的菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定」中允許「輔助使用」取用權限，讓快速鍵指南可以讀取 %@ 的選單。"
          }
        }
      }
    },
    "Allow Accessibility so ⌘V moves to the next item.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen erlauben, damit ⌘V zum nächsten Objekt wechselt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Accesibilidad para que ⌘V pase al siguiente ítem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Accessibilité pour que ⌘V passe à l’élément suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Accessibilità affinché ⌘V passi all'elemento successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Vで次の項目に進むには、アクセシビリティを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘V로 다음 항목으로 넘어가려면 손쉬운 사용을 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso de Acessibilidade para que ⌘V passe ao próximo item."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите универсальный доступ, чтобы ⌘V переходило к следующему объекту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许辅助功能权限，以便 ⌘V 移到下一个项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許「輔助使用」，讓 ⌘V 移至下一個項目。"
          }
        }
      }
    },
