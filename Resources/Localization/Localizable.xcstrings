        }
      }
    },
    "Press Space while dragging and speak. Transcribed on this Mac; the text is pasted with the image.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi la barra spaziatrice durante il trascinamento e parla. La trascrizione avviene su questo Mac; il testo viene incollato con l'immagine."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안 스페이스 바를 누르고 말하세요. 이 Mac에서 텍스트로 변환되며, 텍스트가 이미지와 함께 붙여넣어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione a barra de espaço enquanto arrasta e fale. Transcrito neste Mac; o texto é colado com a imagem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移时按空格键并说话。在此 Mac 上转写；文本会与图像一起粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移時按空白鍵並說話。會在此 Mac 上轉寫，文字會與影像一起貼上。"
          }
        }
      }
    },
    "Press a second key after the shortcut, like ⌃⇧V then U.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi un secondo tasto dopo l'abbreviazione, ad esempio ⌃⇧V e poi U."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키 다음에 두 번째 키를 누르세요(예: ⌃⇧V 다음에 U)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione uma segunda tecla após o atalho, como ⌃⇧V e depois U."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在快捷键之后再按第二个键，例如 ⌃⇧V 然后按 U。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在快速鍵之後按下第二個按鍵，例如 ⌃⇧V 再按 U。"
          }
        }
      }
    },
    "Press again or esc to close.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi di nuovo o esc per chiudere."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 누르거나 esc를 누르면 닫힙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione novamente ou esc para fechar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一次或按 esc 关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一次或按 esc 即可關閉。"
          }
        }
      }
    },
    "Press again to hide or show it while it keeps running.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi di nuovo per nasconderlo o mostrarlo mentre continua a funzionare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 누르면 계속 실행되는 상태로 숨기거나 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
