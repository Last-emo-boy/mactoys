            "value": "Hacia un lado y luego hacia arriba o abajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le côté, puis vers le haut ou le bas"
          }
        },
        "it": {
          "stringUnit": {
