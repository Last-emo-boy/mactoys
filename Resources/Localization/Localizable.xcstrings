          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти вспомогательную программу командной строки MacToys.app. Переместите MacToys в /Applications или ~/Applications и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
