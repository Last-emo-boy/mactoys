        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS用の%lld種類のパワーユーザ向けユーティリティ。Microsoft PowerToysのすべてのユーティリティに加え、さらに多くを備えています。すべてメニューバーから使え、各ユーティリティは“設定”でオン/オフを切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
