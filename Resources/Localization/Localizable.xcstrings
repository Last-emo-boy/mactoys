            "value": "Añade las variables que define este perfil. Tienen prioridad sobre las variables de usuario con el mismo nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les variables définies par ce profil. Elles priment sur les variables utilisateur du même nom."
          }
