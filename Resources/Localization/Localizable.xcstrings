    "Camera Mirror shows your camera only while the mirror is open. Nothing is recorded or sent anywhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kameraspiegel zeigt die Kamera nur, solange der Spiegel geöffnet ist. Nichts wird aufgezeichnet oder irgendwohin gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espejo de cámara solo muestra tu cámara mientras el espejo está abierto. No se graba ni se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miroir de caméra n’affiche votre caméra que lorsque le miroir est ouvert. Rien n’est enregistré ni envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラミラーは、ミラーが開いている間だけカメラの映像を表示します。記録や送信は一切行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 미러는 미러가 열려 있는 동안에만 카메라를 표시합니다. 아무것도 녹화되거나 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Espelho da Câmera mostra sua câmera somente enquanto o espelho está aberto. Nada é gravado nem enviado para lugar nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Зеркало камеры» показывает изображение с камеры, только пока зеркало открыто. Ничего не записывается и никуда не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机镜像仅在镜像打开时显示你的相机画面。不会录制或向任何地方发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機鏡像只在鏡像打開時顯示你的相機畫面。不會錄製或傳送任何內容。"
          }
        }
      }
    },
