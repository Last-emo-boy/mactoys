    "The tool that's selected when the toolbar opens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Werkzeug, das beim Öffnen der Symbolleiste ausgewählt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La herramienta seleccionada al abrir la barra de herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’outil sélectionné à l’ouverture de la barre d’outils."
          }
        },
