    "Everything joined into one line; hyphenated line breaks are rejoined.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in einer Zeile zusammengefügt; getrennte Wörter am Zeilenende werden wieder verbunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo unido en una línea; los saltos de línea con guion se vuelven a unir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est réuni sur une seule ligne ; les mots coupés par un trait d’union en fin de ligne sont recollés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto unito in una riga; le parole spezzate con trattino a fine riga vengono ricongiunte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてを1行に連結します。ハイフンで区切られた改行は結合されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 내용을 한 줄로 합치며, 하이픈으로 나뉜 줄바꿈은 다시 연결합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo unido em uma só linha; quebras de linha hifenizadas são reunidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все объединено в одну строку; переносы с дефисом убраны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容合并为一行；带连字符的换行会重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部合併成一行；以連字號斷開的行會重新接合。"
          }
        }
      }
