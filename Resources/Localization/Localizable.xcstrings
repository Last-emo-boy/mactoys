        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 즉시 종료되며, 저장하지 않은 변경 사항은 손실됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app é encerrado imediatamente; alterações não salvas são perdidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение завершится немедленно; несохраненные изменения будут потеряны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 会立即退出；未存储的更改将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 會立即結束；未儲存的變更將會遺失。"
          }
        }
      }
    },
    "The app quits once the ring fills — lift early to keep it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wird beendet, sobald der Ring voll ist – früher loslassen, um sie zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se cierra cuando se llena el anillo — levanta los dedos antes para conservarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app se ferme une fois l’anneau rempli — relâchez avant pour la garder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app si chiude quando l'anello si riempie — solleva prima per mantenerla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リングが満ちるとAppが終了します — 途中で指を離すと終了しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링이 채워지면 앱이 종료됩니다 — 유지하려면 그 전에 손을 떼세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app é encerrado quando o anel se preenche — solte antes para mantê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение завершится, когда кольцо заполнится, — поднимите пальцы раньше, чтобы оставить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆环填满后 App 会退出 — 提早抬起手指可保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圓環填滿後 App 就會結束 — 提早抬起即可保留。"
