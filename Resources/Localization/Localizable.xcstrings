    "Charging paused while the battery is warm": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden pausiert, solange die Batterie warm ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga en pausa mientras la batería está caliente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge suspendue tant que la batterie est chaude"
          }
        },
        "it": {
