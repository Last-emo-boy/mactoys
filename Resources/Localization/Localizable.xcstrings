          "stringUnit": {
            "state": "translated",
            "value": "Usato quando un colore selezionato viene copiato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 색상을 복사할 때 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado quando uma cor escolhida é copiada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝选取的颜色时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝選取的顏色時使用。"
          }
        }
      }
    },
    "Used when a picture’s own format can’t be written (RAW, PDF, ICNS…). Not a converter.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato quando il formato originale di un'immagine non può essere scritto (RAW, PDF, ICNS…). Non è un convertitore."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 자체의 형식으로 기록할 수 없을 때(RAW, PDF, ICNS…) 사용됩니다. 변환기가 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado quando o formato original de uma imagem não pode ser gravado (RAW, PDF, ICNS…). Não é um conversor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当无法写入图片自身的格式（RAW、PDF、ICNS…）时使用。并非格式转换器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在無法寫入圖片原本的格式時使用（RAW、PDF、ICNS⋯）。並非轉換工具。"
          }
        }
      }
    },
    "Used when connecting by address (default 15101). Bonjour finds Macs on any port.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usata per la connessione tramite indirizzo (predefinita 15101). Bonjour trova i Mac su qualsiasi porta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소로 연결할 때 사용됩니다(기본값 15101). Bonjour는 모든 포트에서 Mac을 찾습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usada ao conectar pelo endereço (padrão 15101). O Bonjour encontra Macs em qualquer porta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过地址连接时使用（默认为 15101）。Bonjour 可以在任意端口上找到 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依位址連線時使用（預設為 15101）。Bonjour 可在任何埠上找到 Mac。"
          }
        }
      }
    },
