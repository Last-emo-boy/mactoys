            "state": "translated",
            "value": "Girar la cuadrícula en pantallas en vertical"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire pivoter la grille sur les écrans en orientation portrait"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruota la griglia sui monitor verticali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦置きのディスプレイではグリッドを回転"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세로 디스플레이에서 격자 회전"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Girar a grade em monitores na vertical"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поворачивать сетку на вертикальных дисплеях"
          }
        },
