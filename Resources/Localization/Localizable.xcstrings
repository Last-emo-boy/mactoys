    },
    "Show zones on all displays while dragging": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ziehen Zonen auf allen Displays anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar zonas en todas las pantallas al arrastrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les zones sur tous les écrans pendant le glissement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le zone su tutti i monitor durante il trascinamento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中はすべてのディスプレイにゾーンを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안 모든 디스플레이에 영역 표시"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar zonas em todos os monitores ao arrastar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать зоны на всех дисплеях при перетягивании"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移时在所有显示器上显示区域"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移時在所有顯示器上顯示區域"
          }
        }
      }
    },
    "Showing the processes of every user": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozesse aller Benutzer werden angezeigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando los procesos de todos los usuarios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Processus de tous les utilisateurs affichés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Processi di tutti gli utenti visualizzati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのユーザのプロセスを表示中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사용자의 프로세스 표시 중"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
