        }
      }
    },
    "Also in the names of files inside folder templates. Characters a name can’t hold become spaces.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch in den Namen von Dateien in Ordnervorlagen. Zeichen, die in Namen nicht erlaubt sind, werden zu Leerzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También en los nombres de los archivos de las plantillas de carpeta. Los caracteres que un nombre no admite se convierten en espacios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aussi aux noms des fichiers dans les modèles de dossier. Les caractères interdits dans un nom deviennent des espaces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche nei nomi dei file all'interno dei modelli di cartella. I caratteri non ammessi in un nome diventano spazi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダテンプレート内のファイル名にも適用されます。名前に使用できない文字はスペースになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 템플릿 안에 있는 파일의 이름에도 적용됩니다. 이름에 사용할 수 없는 문자는 공백으로 바뀝니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também nos nomes de arquivos dentro de modelos de pasta. Caracteres que um nome não pode conter se tornam espaços."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также в именах файлов внутри шаблонов папок. Недопустимые в имени символы заменяются пробелами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也适用于文件夹模板内的文件名。名称中不能包含的字符会变为空格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也適用於檔案夾範本內的檔案名稱。名稱中不允許的字元會變成空格。"
          }
        }
      }
    },
    "Also kept along the display edges": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch entlang der Displayränder beibehalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También a lo largo de los bordes de la pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aussi appliqué le long des bords de l’écran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche lungo i bordi del monitor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイの端にも同じ間隔を確保"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 가장자리에도 유지"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também mantido nas bordas do monitor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также соблюдается у краев дисплея"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器边缘也保留此间距"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示器邊緣也會保留間距"
          }
        }
      }
    },
    "Also lock macOS after": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zusätzlich sperren nach"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear también macOS tras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller aussi macOS après"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca anche macOS dopo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の時間後にmacOSもロック"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
