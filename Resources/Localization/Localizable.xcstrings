    "Moving farther than this while holding makes it a normal drag.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Halten weiter als dieser Wert bewegt, wird es zu einem normalen Ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si te mueves más allá de esta distancia mientras mantienes pulsado, se convierte en un arrastre normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mouvement plus long que cette distance pendant le maintien en fait un glissement normal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ti sposti oltre questa distanza mentre tieni premuto, diventa un normale trascinamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したままこれ以上移動すると、通常のドラッグになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누른 채로 이보다 멀리 움직이면 일반 드래그로 처리됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover além disso enquanto segura transforma o gesto em um arrasto normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если при удержании сместиться дальше, начнется обычное перетягивание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住时移动超过此距离会变为普通拖移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住時移動超過此距離就會變成一般拖移。"
          }
        }
      }
    },
    "Moving the mouse on purpose, clicking or scrolling brings it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezieltes Bewegen der Maus, Klicken oder Scrollen holt ihn zurück."
