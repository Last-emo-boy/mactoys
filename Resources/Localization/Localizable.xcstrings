    "Blur Screen starts when the Mac has had no input for this long.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bildschirm weichzeichnen“ startet, wenn der Mac so lange keine Eingabe erhalten hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenfocar pantalla se activa cuando el Mac lleva este tiempo sin actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flou d’écran démarre lorsque le Mac n’a reçu aucune saisie pendant cette durée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoca schermo si avvia quando il Mac non riceve input per questo tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macにこの時間入力がないと、“画面をぼかす”が開始されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 이 시간 동안 입력이 없으면 화면 흐림이 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Desfocar Tela começa quando o Mac fica inativo por esse tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размытие экрана начинается, если Mac столько времени не получал ввода."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 无输入达到此时长后，开始模糊屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 在這段時間內沒有任何輸入時，就會開始「模糊螢幕」。"
          }
        }
      }
    },
    "Blur Screen strength": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stärke für „Bildschirm weichzeichnen“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensidad de Desenfocar pantalla"
          }
