    },
    "Zones show whenever you drag a window. Hold ⇧ to drag freely; Esc cancels.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonen erscheinen bei jedem Ziehen eines Fensters. ⇧ halten, um frei zu ziehen; esc bricht ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zonas aparecen siempre que arrastras una ventana. Mantén ⇧ para arrastrar libremente; Esc cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les zones s’affichent chaque fois que vous faites glisser une fenêtre. Maintenez ⇧ pour la faire glisser librement ; Échap annule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le zone compaiono ogni volta che trascini una finestra. Tieni premuto ⇧ per trascinare liberamente; Esc annulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウをドラッグするたびにゾーンが表示されます。⇧を押したままにすると自由にドラッグでき、escでキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 드래그할 때마다 영역이 나타납니다. 자유롭게 드래그하려면 ⇧ 키를 누르고 있으세요. Esc를 누르면 취소됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As zonas aparecem sempre que você arrasta uma janela. Segure ⇧ para arrastar livremente; Esc cancela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зоны появляются при каждом перетягивании окна. Удерживайте ⇧, чтобы перетягивать свободно; Esc — отмена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次拖移窗口时都会显示区域。按住 ⇧ 可自由拖移；按 Esc 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次拖移視窗時都會顯示區域。按住 ⇧ 即可自由拖移；按 Esc 取消。"
          }
        }
      }
    },
