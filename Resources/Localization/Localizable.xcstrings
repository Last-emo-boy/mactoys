    "Find, highlight, lock, hide, jump, wrap and crosshair your pointer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Zeiger finden, hervorheben, sperren, ausblenden, springen lassen, am Rand umlaufen lassen oder mit einem Fadenkreuz versehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca, resalta, bloquea y oculta el puntero, hazlo saltar o pasar de un borde a otro y márcalo con una cruz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Localisez, surlignez, verrouillez, masquez, déplacez et faites boucler votre pointeur, ou affichez un réticule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova, evidenzia, blocca, nascondi, sposta, avvolgi e inquadra con un mirino il puntatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタの検索、ハイライト、ロック、非表示、ジャンプ、折り返し、十字線表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터를 찾고, 강조하고, 잠그고, 숨기고, 이동하고, 순환하고, 십자선을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Localize, realce, trave, oculte, faça saltar, dê a volta e mostre a mira no seu ponteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск, подсветка, фиксация, скрытие, перемещение, перенос и перекрестие для указателя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找、高亮、锁定、隐藏、跳转和环绕指针，还可显示指针十字线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找、醒目標示、鎖定、隱藏、跳躍、環繞你的指標，或為其加上十字線。"
          }
        }
      }
    },
