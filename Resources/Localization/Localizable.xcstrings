    "JSON can't hold dates, data or non-finite numbers. Save as XML or binary instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON kann keine Datumsangaben, Daten oder nicht endlichen Zahlen speichern. Stattdessen als XML oder binär sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON no admite fechas, datos ni números no finitos. Guarda como XML o binario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le JSON ne peut pas contenir de dates, de données ni de nombres non finis. Enregistrez plutôt en XML ou en binaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON non può contenere date, dati o numeri non finiti. Salva invece come XML o binario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JSONでは日付、データ、有限でない数値を保持できません。代わりにXMLまたはバイナリで保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON에는 날짜, 데이터 또는 유한하지 않은 숫자를 저장할 수 없습니다. 대신 XML 또는 이진 형식으로 저장하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON não comporta datas, dados ou números não finitos. Salve como XML ou binário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON не может хранить даты, данные и бесконечные числа. Сохраните в XML или двоичном формате."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 无法存储日期、数据或非有限数值。请改为存储为 XML 或二进制格式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 無法儲存日期、資料或非有限數值。請改存為 XML 或二進位格式。"
          }
        }
      }
    },
