    "Hold the pinch to confirm closing or quitting": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenziehen halten, um das Schließen oder Beenden zu bestätigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el pellizco para confirmar el cierre o la salida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir le pincement pour confirmer la fermeture ou la sortie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni il pizzico per confermare la chiusura o l'uscita"
          }
        },
        "ja": {
