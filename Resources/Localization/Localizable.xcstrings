          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenla pulsada mientras arrastras una ventana y suelta sobre una zona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez-la pendant que vous faites glisser une fenêtre, puis relâchez au-dessus d’une zone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto mentre trascini una finestra, poi rilascia su una zona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウをドラッグする間押したままにし、ゾーンの上で離します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 드래그하는 동안 누르고 있다가 영역 위에서 놓으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
