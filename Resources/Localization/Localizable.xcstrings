    "Saving asks for an administrator password once and flushes the DNS cache.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Sichern wird einmal nach einem Administratorpasswort gefragt und der DNS-Cache geleert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar se pide una vez la contraseña de administrador y se vacía la caché de DNS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement demande une fois un mot de passe administrateur et vide le cache DNS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio chiede una volta la password di amministratore e svuota la cache DNS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存時に一度だけ管理者パスワードを求められ、DNSキャッシュがフラッシュされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장할 때 관리자 암호를 한 번 묻고 DNS 캐시를 비웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar pede uma senha de administrador uma vez e limpa o cache de DNS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сохранении один раз запрашивается пароль администратора и очищается кэш DNS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储时会要求输入一次管理员密码，并刷新 DNS 缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存時會要求輸入一次管理者密碼，並清除 DNS 快取。"
          }
        }
      }
    },
