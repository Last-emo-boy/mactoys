    "Restores a tiled window; swipe down again to minimize it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt ein gekacheltes Fenster wieder her; erneut nach unten wischen, um es zu minimieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura una ventana en mosaico; vuelve a deslizar hacia abajo para minimizarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure une fenêtre en mosaïque ; balayez de nouveau vers le bas pour la placer dans le Dock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina una finestra affiancata; scorri di nuovo verso il basso per contrarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイル表示されたウインドウを元に戻します。もう一度下にスワイプするとしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일링된 윈도우를 복원하며, 다시 아래로 쓸어넘기면 최소화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura uma janela organizada; deslize para baixo de novo para minimizá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает окно из мозаики; смахните вниз еще раз, чтобы свернуть его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复平铺的窗口；再次向下轻扫可将其最小化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復並排視窗的大小；再往下滑動一次即可最小化。"
          }
        }
      }
    },
    "Restores the newest layout saved for the displays connected now": {
