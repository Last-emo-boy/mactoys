    "Snippets paste through the clipboard; this puts your copy back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textbausteine werden über die Zwischenablage eingesetzt; dies stellt die eigene Kopie wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fragmentos se pegan a través del portapapeles; esto restaura lo que habías copiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extraits sont collés via le presse-papiers ; cette option rétablit votre copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I frammenti vengono incollati tramite gli appunti; questa opzione ripristina ciò che avevi copiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スニペットはクリップボードを経由してペーストされます。この設定では、コピーしていた内容を元に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스니펫은 클립보드를 통해 붙여넣어지며, 이 옵션은 복사한 내용을 복원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os trechos são colados pela área de transferência; isto restaura o que você tinha copiado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагменты вставляются через буфер обмена; этот параметр возвращает скопированное вами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "片段通过剪贴板粘贴；此选项会恢复你拷贝的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "片段會透過剪貼板貼上；此選項會回復你拷貝的內容。"
          }
        }
      }
    },
    "So you can still reach an app that paused.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit eine pausierte App weiterhin erreichbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que sigas teniendo a mano una app que ha pausado la reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que vous puissiez encore atteindre une app mise en pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così puoi ancora raggiungere un'app in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止したAppにも引き続きアクセスできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 정지된 앱에도 계속 접근할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que você ainda possa acessar um app que pausou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы можно было вернуться к приложению, поставленному на паузу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样你仍可以访问已暂停播放的 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓你仍可存取已暫停的 App。"
          }
        }
      }
    },
    "So ⌘1 pastes what you used last.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit ⌘1 das zuletzt Verwendete einsetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que ⌘1 pegue lo último que usaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que ⌘1 colle ce que vous avez utilisé en dernier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così ⌘1 incolla ciò che hai usato per ultimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1で最後に使ったものをペーストできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1로 마지막에 사용한 항목을 붙여넣을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que ⌘1 cole o que você usou por último."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы ⌘1 вставляло последнее использованное."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样 ⌘1 就会粘贴你上次使用的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 ⌘1 貼上你最後使用的內容。"
          }
        }
      }
    },
