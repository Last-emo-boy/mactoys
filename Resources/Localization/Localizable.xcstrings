    "Snap zones to a grid while you draw, move and resize them. Hold ⌘ to place freely.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonen beim Zeichnen, Bewegen und Ändern der Größe am Raster ausrichten. ⌘ halten, um frei zu platzieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta las zonas a una cuadrícula mientras las dibujas, mueves y redimensionas. Mantén ⌘ para colocarlas libremente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alignez les zones sur une grille pendant que vous les tracez, déplacez et redimensionnez. Maintenez ⌘ pour les placer librement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggancia le zone a una griglia mentre le disegni, sposti e ridimensioni. Tieni premuto ⌘ per posizionarle liberamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゾーンの描画、移動、サイズ変更時にグリッドにスナップします。⌘を押したままにすると自由に配置できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역을 그리거나 이동하거나 크기를 조절할 때 격자에 스냅합니다. 자유롭게 배치하려면 ⌘ 키를 누르고 있으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaixe as zonas em uma grade enquanto as desenha, move e redimensiona. Segure ⌘ para posicionar livremente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привязывайте зоны к сетке при рисовании, перемещении и изменении размера. Удерживайте ⌘, чтобы размещать свободно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制、移动和调整区域大小时将其吸附到网格。按住 ⌘ 可自由放置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪製、移動和調整區域大小時將其貼齊格線。按住 ⌘ 即可自由放置。"
          }
        }
      }
    },
