          }
        }
      }
    },
    "Type “%@ ” to jump there": {
      "comment": "%@ is the alias; keep the space before the closing quote",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入「%@ 」即可跳到該處"
          }
        }
      }
    },
    "Types into the frontmost app. Esc stops.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在最前方的 App 中輸入。按 Esc 停止。"
          }
        }
      }
    },
    "Types macOS renders itself — PDF, images, plain text, HTML, and on recent versions SVG and 3D models such as STL — usually keep the system previewer. MacToys fills in where macOS shows only an icon.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 本身可轉譯的類型（PDF、影像、純文字、HTML，以及在較新版本中的 SVG 和 STL 等 3D 模型）通常會保留系統預覽程式。MacToys 會補足 macOS 只顯示圖像的部分。"
          }
        }
      }
    },
    "Typing an alias opens its page right away: “%@” shows clipboard history, “%@” the calculator. Symbol aliases are direct, so “%@” works.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Typing an alias opens its page right away: “%1$@” shows clipboard history, “%2$@” the calculator. Symbol aliases are direct, so “%3$@” works."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入別名會立即打開其頁面：「%1$@」顯示剪貼板歷史記錄，「%2$@」顯示計算機。符號別名為直接別名，因此「%3$@」可直接使用。"
          }
        }
      }
    },
    "Typing it in the palette jumps to “%@”": {
      "comment": "%@ is a command",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在面板中輸入即可跳到「%@」"
          }
        }
      }
