    "Find, highlight, lock, hide, jump, wrap and crosshair your pointer.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova, evidenzia, blocca, nascondi, sposta, avvolgi e inquadra con un mirino il puntatore."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터를 찾고, 강조하고, 잠그고, 숨기고, 이동하고, 순환하고, 십자선을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Localize, realce, trave, oculte, faça saltar, dê a volta e mostre a mira no seu ponteiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找、高亮、锁定、隐藏、跳转和环绕指针，还可显示指针十字线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找、醒目標示、鎖定、隱藏、跳躍、環繞你的指標，或為其加上十字線。"
          }
        }
      }
    },
