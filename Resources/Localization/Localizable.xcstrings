        }
      }
    },
    "MacToys: any limit from %@, a sailing range, discharge while plugged in and heat protection. Needs a small helper.": {
      "comment": "The placeholder is the lowest limit",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys: beliebiges Limit ab %@, ein Segelbereich, Entladen bei angeschlossenem Netzteil und Hitzeschutz. Benötigt ein kleines Hilfsprogramm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys: cualquier límite a partir del %@, un rango de mantenimiento, descarga con el adaptador conectado y protección contra el calor. Necesita un pequeño asistente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys : n’importe quelle limite à partir de %@, une plage de roue libre, la décharge sur secteur et la protection contre la chaleur. Nécessite un petit outil d’assistance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys: qualsiasi limite da %@, un intervallo di mantenimento, scarica con l'alimentatore collegato e protezione dal calore. Richiede un piccolo helper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys: %@以上の任意の上限、セーリング範囲、電源接続中の放電、高温保護。小さなヘルパーが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys: %@부터 원하는 한도, 유지 범위, 전원 연결 중 방전, 과열 방지. 작은 도우미가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys: qualquer limite a partir de %@, faixa de oscilação, descarga enquanto conectado e proteção contra calor. Requer um pequeno auxiliar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys: любое ограничение от %@, диапазон удержания, разрядка при подключенном питании и защита от перегрева. Нужна небольшая вспомогательная программа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys：可设置 %@ 起的任意上限、浮动区间、接通电源时放电以及高温保护。需要一个小型辅助程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys：可設定 %@ 起的任何上限、浮動區間、接上電源時放電和高溫保護。需要一個小型輔助程式。"
          }
        }
      }
    },
