    },
    "One packet per address, one second timeout.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個位址一個封包，逾時為一秒。"
          }
        }
      }
    },
    "One per line: Name=pattern or Name=%@pattern (Unicode patterns plus %@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "One per line: Name=pattern or Name=%1$@pattern (Unicode patterns plus %2$@)."
