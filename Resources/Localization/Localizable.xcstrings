    "Show files whose names start with a dot, in Finder and Open dialogs. Finder restarts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, deren Namen mit einem Punkt beginnen, im Finder und in Öffnen-Dialogen anzeigen. Der Finder wird neu gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los archivos cuyo nombre empieza por un punto, en el Finder y en los cuadros de diálogo Abrir. El Finder se reinicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez les fichiers dont le nom commence par un point, dans le Finder et les zones de dialogue d’ouverture. Le Finder est relancé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前がドットで始まるファイルを、Finderと“開く”ダイアログに表示します。Finderが再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 점으로 시작하는 파일을 Finder와 열기 대화상자에 표시합니다. Finder가 재시동됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre arquivos cujos nomes começam com ponto, no Finder e nas caixas de diálogo Abrir. O Finder é reiniciado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает файлы, имена которых начинаются с точки, в Finder и диалоговых окнах открытия. Finder перезапускается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达和“打开”对话框中显示名称以句点开头的文件。访达会重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 和「打開」對話框中顯示名稱以句點開頭的檔案。Finder 會重新啟動。"
          }
        }
      }
    },
