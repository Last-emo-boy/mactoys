    "The app quits immediately; unsaved changes are lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wird sofort beendet; nicht gesicherte Änderungen gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se cierra de inmediato; se pierden los cambios no guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app quitte immédiatement ; les modifications non enregistrées sont perdues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app si chiude subito; le modifiche non salvate andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appはただちに終了します。保存されていない変更は失われます。"
