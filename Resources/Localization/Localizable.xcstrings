    "Hold %@ and drag icons to the left of the %@ divider to hide them.": {
      "comment": "Arrangement card step; the values are the Command key symbol and the divider glyph",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ halten und Symbole links neben die Trennlinie %2$@ ziehen, um sie auszublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Hold %1$@ and drag icons to the left of the %2$@ divider to hide them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la tecla %1$@ y arrastra iconos a la izquierda del divisor %2$@ para ocultarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %1$@ et faites glisser des icônes à gauche du séparateur %2$@ pour les masquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %1$@ e trascina le icone a sinistra del divisore %2$@ per nasconderle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を押したまま、アイコンを%2$@区切り線の左側にドラッグすると隠れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 키를 누른 채 아이콘을 %2$@ 구분선 왼쪽으로 드래그하면 숨겨집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure %1$@ e arraste ícones para a esquerda do divisor %2$@ para ocultá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %1$@ и перетяните значки левее разделителя %2$@, чтобы скрыть их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %1$@ 并将图标拖到 %2$@ 分隔线左侧即可隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %1$@ 並將圖像拖移到 %2$@ 分隔線左側即可隱藏。"
          }
        }
      }
    },
    "Hold %@ and press %@ to hop between the windows of the app you're using": {
      "comment": "Window Hopper; the first %@ is the modifier keys (such as ⌥), the second the key (such as `)",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ halten und %2$@ drücken, um zwischen den Fenstern der aktuellen App zu wechseln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Hold %1$@ and press %2$@ to hop between the windows of the app you're using"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %1$@ y pulsa %2$@ para saltar entre las ventanas de la app que estás usando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %1$@ et appuyez sur %2$@ pour passer d’une fenêtre à l’autre de l’app que vous utilisez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %1$@ e premi %2$@ per passare tra le finestre dell'app che stai usando"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を押したまま%2$@を押すと、使用中のAppのウインドウ間を移動できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 누른 채 %2$@을(를) 눌러 사용 중인 앱의 윈도우 사이를 이동"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure %1$@ e pressione %2$@ para pular entre as janelas do app em uso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %1$@ и нажимайте %2$@, чтобы переключаться между окнами текущего приложения"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %1$@ 并按 %2$@，即可在当前 App 的窗口之间跳转"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %1$@ 並按下 %2$@，即可在你正在使用的 App 的視窗之間跳躍切換"
          }
        }
      }
    },
    "Hold %@ while dropping for smaller files": {
      "comment": "Optimizer drop zone hint; the value is the Option key symbol ⌥",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ablegen %@ halten für kleinere Dateien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ al soltar para obtener archivos más pequeños"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %@ en déposant pour des fichiers plus légers"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %@ mentre rilasci per file più piccoli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドロップ時に%@を押したままにすると、ファイルがさらに小さくなります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 작은 파일을 원하면 놓을 때 %@ 키를 누르세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure %@ ao soltar para obter arquivos menores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %@ при отпускании, чтобы файлы были меньше"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放时按住 %@ 可获得更小的文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放開時按住 %@ 可得到更小的檔案"
          }
        }
      }
    },
    "Hold Option with the pointer over a blurred app to see it without switching to it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahltaste mit dem Zeiger über einer weichgezeichneten App halten, um sie zu sehen, ohne zu ihr zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la tecla Opción con el puntero sobre una app desenfocada para verla sin cambiar a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez Option avec le pointeur sur une app floutée pour la voir sans y basculer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto Opzione con il puntatore su un'app sfocata per vederla senza passarvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぼかしたAppの上にポインタを置いてOptionキーを押したままにすると、切り替えずに内容を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흐려진 앱 위에 포인터를 놓고 Option 키를 누르고 있으면 전환하지 않고도 앱을 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure Option com o ponteiro sobre um app desfocado para vê-lo sem alternar para ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте Option, наведя указатель на размытое приложение, чтобы увидеть его, не переключаясь на него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针放在模糊的 App 上并按住 Option 键，即可在不切换的情况下查看它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將指標停在模糊的 App 上並按住 Option 鍵，即可在不切換的情況下查看該 App。"
          }
        }
      }
    },
    "Hold a button still to keep it held after you let go; drag, then click any button to release.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Maustaste ruhig gedrückt halten, damit sie nach dem Loslassen gehalten bleibt; ziehen, dann zum Lösen eine beliebige Maustaste klicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un botón quieto para que siga pulsado al soltarlo; arrastra y haz clic en cualquier botón para liberarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez un bouton immobile pour le maintenir enfoncé après l’avoir relâché ; faites glisser, puis cliquez sur n’importe quel bouton pour le relâcher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni fermo un pulsante per mantenerlo premuto dopo averlo rilasciato; trascina, poi fai clic su un pulsante qualsiasi per rilasciarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンを動かさずに押し続けると、離したあとも押された状態が保たれます。ドラッグしてから、いずれかのボタンをクリックすると解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼을 움직이지 않고 누르고 있으면 손을 뗀 후에도 눌린 상태가 유지됩니다. 드래그한 다음 아무 버튼이나 클릭하면 해제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um botão parado para que ele continue pressionado depois de soltá-lo; arraste e clique em qualquer botão para soltar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подержите кнопку неподвижно, чтобы она оставалась нажатой после отпускания; перетяните, затем нажмите любую кнопку, чтобы отпустить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将按钮按住不动，松开后它会保持按下；拖移，然后点按任意按钮即可释放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住按鈕不動，放開後仍會保持按住；拖移後按一下任一按鈕即可放開。"
          }
        }
      }
    },
    "Hold a letter and tap Space or an arrow key to type accented characters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Buchstaben halten und die Leertaste oder eine Pfeiltaste drücken, um Zeichen mit Akzent einzugeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una letra y pulsa la barra espaciadora o una tecla de flecha para escribir caracteres acentuados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une lettre enfoncée et appuyez sur Espace ou sur une touche fléchée pour saisir des caractères accentués."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta una lettera e premi la barra spaziatrice o un tasto freccia per digitare caratteri accentati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字キーを押したままスペースバーか矢印キーを押すと、アクセント付き文字を入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자를 누른 채 스페이스 바나 화살표 키를 탭하면 악센트 문자를 입력할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure uma letra e toque na barra de espaço ou em uma tecla de seta para digitar caracteres acentuados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте букву и нажмите пробел или клавишу со стрелкой, чтобы ввести символ с диакритикой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住字母键并轻按空格键或方向键，即可输入带重音的字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住字母並點按空白鍵或方向鍵，即可輸入重音字元。"
          }
        }
      }
    },
