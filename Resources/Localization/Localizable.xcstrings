    "Use a transparent color to see through the spotlight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine transparente Farbe verwenden, um durch das Spotlight zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un color transparente para ver a través del foco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une couleur transparente pour voir à travers le projecteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un colore trasparente per vedere attraverso lo spotlight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明な色を使うと、スポットライトを透かして見ることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스포트라이트 안쪽이 비쳐 보이게 하려면 투명한 색상을 사용하세요."
          }
        },
        "pt-BR": {
