        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 클릭으로 윈도우를 앞으로 가져오는 동시에 클릭한 항목을 누름"
          }
        },
        "pt-BR": {
          "stringUnit": {
