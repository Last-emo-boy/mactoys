          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtres"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finestre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
