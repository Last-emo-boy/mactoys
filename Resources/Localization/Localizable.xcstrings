          }
        }
      }
    },
    "Also in the MacToys menu bar menu. Click one to flip it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch im MacToys-Menü in der Menüleiste. Ein Klick schaltet um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También en el menú de MacToys de la barra de menús. Haz clic en uno para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Également dans le menu de MacToys de la barre des menus. Cliquez sur un interrupteur pour le basculer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToysのメニューバーメニューにも表示されます。クリックするとオン/オフが切り替わります。"
