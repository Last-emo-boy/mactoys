    "Briefly shows each display's number on it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt kurz die Nummer jedes Displays darauf an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra brevemente el número de cada pantalla en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche brièvement le numéro de chaque écran sur celui-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra brevemente il numero di ogni monitor su di esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ディスプレイに番号を短時間表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 디스플레이에 번호를 잠시 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra brevemente o número de cada monitor nele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ненадолго показывает на каждом дисплее его номер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每台显示器上短暂显示其编号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每台顯示器上短暫顯示其編號。"
          }
        }
      }
    },
