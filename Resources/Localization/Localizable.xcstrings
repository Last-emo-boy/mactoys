    "Enter the key shown on that Mac. The address is optional: Macs on the same network find each other.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den auf dem anderen Mac angezeigten Schlüssel eingeben. Die Adresse ist optional: Macs im selben Netzwerk finden sich gegenseitig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la clave que aparece en ese Mac. La dirección es opcional: los Mac de la misma red se encuentran entre sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez la clé affichée sur ce Mac. L’adresse est facultative : les Mac d’un même réseau se trouvent mutuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la chiave mostrata su quel Mac. L'indirizzo è facoltativo: i Mac sulla stessa rete si trovano a vicenda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのMacに表示されているキーを入力してください。アドレスは省略可能です: 同じネットワーク上のMacは互いを検出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 Mac에 표시된 키를 입력하세요. 주소는 선택 사항이며, 같은 네트워크의 Mac은 서로를 자동으로 찾습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a chave mostrada naquele Mac. O endereço é opcional: Macs na mesma rede se encontram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ключ, показанный на том Mac. Адрес необязателен: Mac в одной сети находят друг друга."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入那台 Mac 上显示的密钥。地址是可选的：同一网络中的 Mac 会自动发现彼此。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入該 Mac 上顯示的密鑰。位址為選填：同一網路上的 Mac 會自動找到彼此。"
          }
        }
      }
    },
