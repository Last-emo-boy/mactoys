        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Hopper"
          }
        }
      }
    },
    "Window Hopper is off": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Hopper 已關閉"
          }
