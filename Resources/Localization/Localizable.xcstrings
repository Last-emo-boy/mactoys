          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 macOS 檢查你的密碼"
          }
        }
      }
    },
    "macOS didn't let MacToys take this app's sound (error %lld).": {
      "comment": "App Volume error; the number is a Core Audio status code",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "macOS hat MacToys den Ton dieser App nicht übernehmen lassen (Fehler %lld)."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "macOS hat MacToys den Ton dieser App nicht übernehmen lassen (Fehler %lld)."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
