            "state": "translated",
            "value": "macOS comprueba tu contraseña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS vérifie votre mot de passe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS verifica la password"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードはmacOSが確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 암호를 확인함"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS verifica sua senha"
          }
        },
        "ru": {
          "stringUnit": {
