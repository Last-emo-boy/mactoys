      }
    },
    "The handler points at %@. Update it to use this copy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Handler verweist auf %@. Aktualisieren, um diese Kopie zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gestor apunta a %@. Actualízalo para usar esta copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le gestionnaire pointe vers %@. Mettez-le à jour pour utiliser cette copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gestore punta a %@. Aggiornalo per usare questa copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドラは%@を指しています。このコピーを使うように更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들러가 %@을(를) 가리키고 있습니다. 이 사본을 사용하도록 업데이트하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O manipulador aponta para %@. Atualize-o para usar esta cópia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработчик указывает на %@. Обновите его, чтобы использовать эту копию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理程序指向 %@。请将其更新为使用此副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "處理程式指向 %@。請更新以使用此副本。"
          }
        }
      }
    },
    "The helper could not be installed: %@": {
