          }
        }
      }
    },
    "Charging resumes only at %@, so the battery isn't topped up every few minutes.": {
      "comment": "The placeholder is the lower bound",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laden wird erst bei %@ fortgesetzt, damit die Batterie nicht alle paar Minuten nachgeladen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga solo se reanuda al %@, para que la batería no se recargue cada pocos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge ne reprend qu’à %@, pour que la batterie ne soit pas rechargée toutes les quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La carica riprende solo a %@, così la batteria non viene ricaricata ogni pochi minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電は%@で再開されるため、数分おきに継ぎ足し充電されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 도달해야 충전이 재개되므로 배터리가 몇 분마다 충전되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O carregamento só é retomado em %@, para que a bateria não seja recarregada a cada poucos minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарядка возобновится только при %@, чтобы аккумулятор не подзаряжался каждые несколько минут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在降到 %@ 时才恢复充电，以免电池每隔几分钟就被充一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電量降到 %@ 才會恢復充電，避免每隔幾分鐘就補充一次電量。"
          }
        }
      }
    },
    "Charging stops at the limit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laden stoppt beim Limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga se detiene en el límite."
          }
        },
        "fr": {
