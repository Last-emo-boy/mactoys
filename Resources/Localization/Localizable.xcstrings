          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещайте окна и меняйте их размер с помощью зеленой кнопки, клавиатуры или сохраненных макетов, которые восстанавливаются одним нажатием."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过绿色按钮、键盘或一键恢复的已存储布局来移动窗口和调整窗口大小。"
          }
        },
        "zh-Hant": {
