          }
        }
      }
    },
    "Grab a window anywhere — no need to aim for the title bar or a thin border.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fenster an beliebiger Stelle greifen – ohne auf die Titelleiste oder einen schmalen Rand zielen zu müssen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agarra una ventana desde cualquier punto — no hace falta apuntar a la barra de título ni a un borde fino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une fenêtre n’importe où — inutile de viser la barre de titre ou une fine bordure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Afferra una finestra in qualsiasi punto, senza dover mirare alla barra del titolo o a un bordo sottile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウのどこでもつかめます — タイトルバーや細い枠を狙う必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 막대나 얇은 테두리를 겨냥할 필요 없이 윈도우의 아무 곳이나 잡으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue uma janela em qualquer lugar — sem precisar mirar na barra de título ou em uma borda fina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захватывайте окно в любом месте — не нужно целиться в строку заголовка или тонкую рамку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在窗口任意位置抓取 — 无需瞄准标题栏或细窄的边框。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何位置抓取視窗 — 不必瞄準標題列或細窄的邊框。"
          }
        }
      }
    },
