    "Takes a few hours. Keep your Mac plugged in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauert einige Stunden. Den Mac am Netzteil lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarda unas horas. Mantén el Mac conectado a la corriente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend quelques heures. Gardez votre Mac branché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede alcune ore. Tieni il Mac collegato all'alimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数時間かかります。Macを電源に接続したままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 시간이 걸립니다. Mac의 전원을 연결해 두세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva algumas horas. Mantenha o Mac conectado à energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занимает несколько часов. Не отключайте Mac от питания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要几个小时。请让 Mac 保持接通电源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要幾個小時。請讓 Mac 保持接上電源。"
          }
        }
      }
    },
    "Takes the last area again, without selecting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt den letzten Bereich erneut auf, ohne Auswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a capturar la última área, sin seleccionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprend la dernière zone, sans sélection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprende l'ultima area, senza selezionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択せずに、前回の範囲をもう一度キャプチャします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택하지 않고 마지막 영역을 다시 캡처합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura a última área de novo, sem selecionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова снимает последнюю область без выделения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需选择，直接再次截取上一个区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不需選取，直接再次擷取上一個區域。"
          }
        }
      }
    },
