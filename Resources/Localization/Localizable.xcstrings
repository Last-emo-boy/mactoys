    "The quick brown fox jumps over the lazy dog": {
      "comment": "Sample text for trying a custom text action",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Franz jagt im komplett verwahrlosten Taxi quer durch Bayern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El veloz murciélago hindú comía feliz cardillo y kiwi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portez ce vieux whisky au juge blond qui fume"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma la volpe col suo balzo ha raggiunto il quieto Fido"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あのイーハトーヴォのすきとおった風"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다람쥐 헌 쳇바퀴에 타고파"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pequeno jabuti xereta viu dez cegonhas felizes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Съешь же еще этих мягких французских булок, да выпей чаю"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏捷的棕色狐狸跳过了懒狗"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏捷的棕色狐狸跳過了懶惰的狗"
          }
        }
      }
    },
    "The recording couldn’t be saved": {
      "localizations": {
        "de": {
          "stringUnit": {
