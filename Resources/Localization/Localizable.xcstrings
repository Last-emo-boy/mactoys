          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示所有用户的进程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在顯示所有使用者的程序"
          }
        }
      }
    },
    "Shown as a table": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Tabelle angezeigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra como tabla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché sous forme de tableau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrato come tabella"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表として表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표로 표시됨"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrado como tabela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано в виде таблицы"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以表格显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以表格顯示"
          }
        }
      }
    },
    "Shown under pixels. Points follow each display's scaling; inches and centimeters use its physical size.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter den Pixeln angezeigt. Punkte folgen der Skalierung jedes Displays; Zoll und Zentimeter nutzen seine physische Größe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra bajo los píxeles. Los puntos siguen el escalado de cada pantalla; las pulgadas y los centímetros usan su tamaño físico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché sous les pixels. Les points suivent la mise à l’échelle de chaque écran ; les pouces et les centimètres utilisent sa taille physique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrato sotto i pixel. I punti seguono il ridimensionamento di ogni monitor; pollici e centimetri usano le sue dimensioni fisiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピクセルの下に表示されます。ポイントは各ディスプレイのスケーリングに従い、インチとセンチメートルは物理サイズを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "픽셀 아래에 표시됩니다. 포인트는 각 디스플레이의 배율을 따르며, 인치와 센티미터는 물리적 크기를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrado abaixo de pixels. Os pontos seguem a escala de cada monitor; polegadas e centímetros usam o tamanho físico dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показываются под пикселями. Точки зависят от масштабирования каждого дисплея; дюймы и сантиметры — от его физического размера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在像素下方。点数跟随每台显示器的缩放比例；英寸和厘米使用其物理尺寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示在像素下方。點會依照每台顯示器的縮放比例；英寸和公分則使用其實體尺寸。"
          }
        }
      }
    },
    "Shows or hides Command Palette": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Befehlspalette ein oder aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra u oculta la Paleta de comandos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
