    "Events, dots and meeting reminders need it. The calendar and world clocks work without it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ereignisse, Punkte und Erinnerungen an Besprechungen benötigen ihn. Kalender und Weltuhren funktionieren auch ohne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eventos, los puntos y los recordatorios de reuniones lo necesitan. El calendario y los relojes mundiales funcionan sin él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements, les points et les rappels de réunion en ont besoin. Le calendrier et les horloges mondiales fonctionnent sans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベント、ドット、ミーティングのリマインダーに必要です。カレンダーと世界時計は許可しなくても使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트, 점 표시 및 회의 알림에 필요합니다. 캘린더와 세계 시계는 권한 없이도 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos, pontos e lembretes de reuniões precisam dele. O calendário e os relógios mundiais funcionam sem ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он нужен для событий, точек и напоминаний о встречах. Календарь и мировые часы работают и без него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日程、圆点和会议提醒需要此权限。没有该权限时，日历和世界时钟仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行程、圓點和會議提醒需要此權限。日曆和世界時鐘不需要此權限也能使用。"
          }
        }
      }
    },
    "Every Mac disconnects until you enter the new key on them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Macs werden getrennt, bis der neue Schlüssel auf ihnen eingegeben wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los Mac se desconectan hasta que introduzcas en ellos la nueva clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les Mac se déconnectent jusqu’à ce que vous y saisissiez la nouvelle clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i Mac si disconnettono finché non vi inserisci la nuova chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいキーを入力するまで、すべてのMacの接続が解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Mac에 새로운 키를 입력할 때까지 연결이 끊깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os Macs se desconectam até que você digite a nova chave neles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все Mac будут отключены, пока вы не введете на них новый ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 Mac 都会断开连接，直到你在它们上面输入新密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每台 Mac 上輸入新的密鑰之前，所有 Mac 都會中斷連線。"
          }
        }
      }
    },
    "Every app is recorded.": {
      "comment": "Clipboard settings: the list of excluded apps is empty",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Apps werden aufgezeichnet."
          }
        },
        "es": {
