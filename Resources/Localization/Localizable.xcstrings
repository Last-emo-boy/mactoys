        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 막대나 얇은 테두리를 겨냥할 필요 없이 윈도우의 아무 곳이나 잡으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
