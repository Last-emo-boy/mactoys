    "Hold %@ and press %@ to hop between the windows of the app you're using": {
      "comment": "Window Hopper; the first %@ is the modifier keys (such as ⌥), the second the key (such as `)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Hold %1$@ and press %2$@ to hop between the windows of the app you're using"
