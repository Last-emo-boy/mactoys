    "Control brightness, resolution, color and arrangement of your displays from one flyout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helligkeit, Auflösung, Farbe und Anordnung der Displays über ein Flyout steuern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla el brillo, la resolución, el color y la disposición de tus pantallas desde un solo panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez la luminosité, la résolution, la couleur et la disposition de vos écrans depuis un seul panneau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイの明るさ、解像度、カラー、配置を1つのパネルから操作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 플라이아웃에서 디스플레이의 밝기, 해상도, 색상 및 배열을 제어합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle brilho, resolução, cor e disposição dos seus monitores em um só painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте яркостью, разрешением, цветом и расположением дисплеев из одной панели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过一个浮动面板控制显示器的亮度、分辨率、颜色和排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從同一個浮出視窗控制顯示器的亮度、解析度、色彩和排列方式。"
          }
        }
      }
    },
    "Control several Macs with one keyboard and mouse, and share the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Macs mit einer Tastatur und Maus steuern und die Zwischenablage teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla varios Mac con un solo teclado y ratón, y comparte el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez plusieurs Mac avec un seul clavier et une seule souris, et partagez le presse-papiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla più Mac con una tastiera e un mouse e condividi gli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1組のキーボードとマウスで複数のMacを操作し、クリップボードを共有します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 키보드와 마우스로 여러 Mac을 제어하고 클립보드를 공유합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
