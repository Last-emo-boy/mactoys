    "Workspaces set to launch at login run when MacToys starts as you log in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsbereiche, die beim Anmelden starten sollen, werden ausgeführt, wenn MacToys bei der Anmeldung startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los espacios de trabajo configurados para iniciarse al iniciar sesión se abren cuando MacToys arranca con la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les espaces de travail configurés pour se lancer à la connexion s’ouvrent au démarrage de MacToys lors de votre connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le aree di lavoro impostate per l'avvio al login si aprono quando MacToys si avvia al login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動するように設定したワークスペースは、ログイン時にMacToysが起動するときに実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시 실행하도록 설정된 작업 공간은 로그인할 때 MacToys가 시작되면 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaços de trabalho configurados para abrir ao iniciar a sessão são executados quando o MacToys inicia junto com a sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочие области, настроенные на запуск при входе, запускаются, когда MacToys открывается при входе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为登录时启动的工作区会在你登录、MacToys 启动时运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定為登入時啟動的工作區，會在你登入、MacToys 啟動時執行。"
          }
        }
      }
    },
