    "Pinned entries are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Einträge bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las entradas fijadas se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées épinglées sont conservées."
          }
        },
        "it": {
          "stringUnit": {
