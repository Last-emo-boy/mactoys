        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 이 핀보드의 칩으로 드래그하거나 ⌘K를 누르고 핀보드에 추가를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste itens para a etiqueta deste mural ou pressione ⌘K e escolha Adicionar ao Mural."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетяните объекты на метку этой доски или нажмите ⌘K и выберите «Добавить на доску»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将项目拖到此固定板的标签上，或按 ⌘K 并选取“添加到固定板”。"
