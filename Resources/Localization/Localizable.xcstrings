          }
        }
      }
    },
    "For sharing your screen: the window fills its display and a plain backdrop covers everything else there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Teilen des Bildschirms: Das Fenster füllt sein Display, und ein schlichter Hintergrund verdeckt dort alles andere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para compartir la pantalla: la ventana llena su pantalla y un fondo liso cubre todo lo demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour partager votre écran : la fenêtre remplit son écran et un fond uni recouvre tout le reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per condividere lo schermo: la finestra riempie il monitor e un fondale uniforme copre tutto il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面共有用: ウインドウがディスプレイいっぱいに表示され、ほかのすべてを無地の背景で覆います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 공유용: 윈도우가 디스플레이를 채우고 단색 배경이 나머지를 모두 가립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para compartilhar a tela: a janela preenche o monitor e um pano de fundo liso cobre todo o resto ali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для демонстрации экрана: окно занимает весь дисплей, а все остальное на нем закрывает однотонный фон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于共享屏幕：窗口填满其所在显示器，纯色背景遮住该显示器上的其他所有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於分享螢幕：視窗會填滿其顯示器，並以素色背景蓋住該處的其他所有內容。"
          }
        }
      }
    },
    "For text typed with T. Scroll or ↑ ↓ while typing to resize.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für mit T eingegebenen Text. Beim Tippen scrollen oder ↑ ↓ drücken, um die Größe zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el texto escrito con T. Desplázate o usa ↑ ↓ mientras escribes para cambiar el tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le texte saisi avec T. Faites défiler ou utilisez ↑ ↓ pendant la saisie pour redimensionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per il testo digitato con T. Scorri o usa ↑ ↓ mentre digiti per ridimensionarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tで入力するテキスト用。入力中にスクロールするか↑ ↓でサイズを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "T로 입력하는 텍스트용입니다. 입력 중에 스크롤하거나 ↑ ↓를 눌러 크기를 조절합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para texto digitado com T. Role ou use ↑ ↓ enquanto digita para redimensionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для текста, вводимого с T. Прокрутка или ↑ ↓ во время ввода меняют размер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于按 T 键入的文本。键入时滚动或按 ↑ ↓ 可调整大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於以 T 輸入的文字。輸入時捲動或按 ↑ ↓ 可調整大小。"
          }
        }
      }
    },
