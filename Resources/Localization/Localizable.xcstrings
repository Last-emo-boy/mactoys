    "Cards stack up in this corner of the screen you’re working on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten stapeln sich in dieser Ecke des Bildschirms, auf dem gerade gearbeitet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas se apilan en esta esquina de la pantalla en la que trabajas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes s’empilent dans ce coin de l’écran sur lequel vous travaillez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede si impilano in questo angolo dello schermo su cui stai lavorando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業中の画面のこの隅にカードが重なって表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중인 화면의 이 모서리에 카드가 쌓입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cartões se empilham neste canto da tela em que você está trabalhando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточки складываются стопкой в этом углу экрана, с которым вы работаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片会堆叠在你正在使用的屏幕的这个角落。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片會堆疊在你正在使用的螢幕的這個角落。"
          }
        }
      }
    },
    "Cards stay while the pointer is over them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten bleiben, solange der Zeiger darauf ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas permanecen mientras el puntero está sobre ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes restent affichées tant que le pointeur est dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede restano finché il puntatore è sopra di esse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタを重ねている間はカードが表示されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터를 올려 두는 동안에는 카드가 사라지지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cartões permanecem enquanto o ponteiro estiver sobre eles."
          }
        },
        "ru": {
