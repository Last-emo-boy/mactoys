    "No gestures on a window that fills its display, such as a game or a video": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Gesten bei einem Fenster, das sein Display füllt, etwa ein Spiel oder ein Video"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin gestos en una ventana que llena su pantalla, como un juego o un vídeo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun geste sur une fenêtre qui remplit son écran, comme un jeu ou une vidéo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun gesto su una finestra che riempie il monitor, come un gioco o un video"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームやビデオなど、ディスプレイ全体を占めるウインドウではジェスチャを使用しない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이나 비디오처럼 디스플레이를 채운 윈도우에서는 제스처 사용 안 함"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem gestos em uma janela que preenche o monitor, como um jogo ou um vídeo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без жестов в окне, которое занимает весь дисплей, например в игре или видео"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在填满显示器的窗口（如游戏或视频）上不使用手势"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填滿顯示器的視窗（例如遊戲或影片）不使用手勢"
          }
        }
      }
    },
