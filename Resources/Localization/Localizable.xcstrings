          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索と置換、正規表現、連番、取り消しを使って、ファイルの名前を一括変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 및 바꾸기, 정규 표현식, 번호 매기기, 실행 취소를 지원하는 파일 일괄 이름 변경."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomeie arquivos em lote com busca e substituição, expressões regulares, numeração e desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Массовое переименование файлов с поиском и заменой, регулярными выражениями, нумерацией и отменой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
