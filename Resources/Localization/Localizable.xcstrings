    "Originals are kept in the backups folder either way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originale werden in jedem Fall im Backup-Ordner aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los originales se conservan en la carpeta de copias de seguridad en cualquier caso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les originaux sont conservés dans le dossier des sauvegardes dans tous les cas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli originali vengono conservati comunque nella cartella backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらの場合も、オリジナルはバックアップフォルダに保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 쪽이든 원본은 백업 폴더에 보관됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os originais são mantidos na pasta de backups de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригиналы в любом случае хранятся в папке резервных копий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论哪种方式，原件都会保留在备份文件夹中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論如何，原始檔案都會保留在備份檔案夾中。"
          }
        }
      }
    },
    "Originals of optimized files can no longer be restored.": {
      "comment": "Optimizer: confirmation message",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originale optimierter Dateien können nicht mehr wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los originales de los archivos optimizados ya no se podrán restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les originaux des fichiers optimisés ne pourront plus être restaurés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli originali dei file ottimizzati non potranno più essere ripristinati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最適化したファイルのオリジナルは復元できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최적화된 파일의 원본을 더 이상 복원할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os originais dos arquivos otimizados não poderão mais ser restaurados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить оригиналы оптимизированных файлов будет невозможно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优化文件的原件将无法再恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最佳化檔案的原始檔案將無法再回復。"
          }
        }
      }
    },
