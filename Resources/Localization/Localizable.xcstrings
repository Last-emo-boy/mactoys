          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關鍵字只會執行該外掛程式：「%1$@」、「%2$@」。用於數學或路徑的字元（%3$@）可能與全域結果衝突。"
          }
        }
      }
    },
    "A link or another app asked to run this command. Continue only if you expected it.": {
      "localizations": {
        "zh-Hant": {
