        }
      }
    },
    "The window you leave darkens gradually instead of at once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das verlassene Fenster dunkelt allmählich ab statt sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana que dejas se oscurece poco a poco en lugar de hacerlo de golpe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre que vous quittez s’assombrit progressivement plutôt que d’un coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra che lasci si scurisce gradualmente anziché di colpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "離れたウインドウは、すぐにではなく徐々に暗くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "떠나는 윈도우가 한 번에 어두워지지 않고 서서히 어두워집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela que você deixa escurece aos poucos, em vez de imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно, которое вы покидаете, затемняется постепенно, а не сразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你离开的窗口会逐渐变暗，而不是立即变暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你離開的視窗會逐漸變暗，而不是立即變暗。"
          }
        }
      }
    },
