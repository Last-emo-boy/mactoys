          }
        }
      }
    },
    "Wrapped lines are joined and hyphenated words rejoined; paragraphs, lists and short lines stay apart.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbrochene Zeilen werden verbunden und getrennte Wörter wieder zusammengefügt; Absätze, Listen und kurze Zeilen bleiben getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas cortadas se unen y las palabras con guion se recomponen; los párrafos, las listas y las líneas cortas se mantienen separados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes coupées sont jointes et les mots coupés par un trait d’union reconstitués ; les paragraphes, les listes et les lignes courtes restent séparés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le righe a capo vengono unite e le parole sillabate ricomposte; paragrafi, elenchi e righe brevi restano separati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折り返された行は結合され、ハイフンで区切られた単語も元に戻ります。段落、リスト、短い行は分かれたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄바꿈된 줄은 합쳐지고 하이픈으로 나뉜 단어는 다시 연결되며, 문단, 목록, 짧은 줄은 분리된 상태로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linhas quebradas são unidas e palavras hifenizadas são reunidas; parágrafos, listas e linhas curtas permanecem separados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесенные строки объединяются, а слова с переносом соединяются; абзацы, списки и короткие строки остаются отдельными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并自动换行的行，并重新连接用连字符断开的单词；段落、列表和短行保持分开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動換行的行會合併，以連字號斷開的字詞會重新接合；段落、列表和短行則保持分開。"
          }
        }
      }
    },
    "Wrapping activation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Randsprung-Aktivierung"
          }
        },
