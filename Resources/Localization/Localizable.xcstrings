            "value": "macOS에서 MacToys가 이 앱의 사운드를 가져오도록 허용하지 않았습니다(오류 %lld)."
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O macOS não permitiu que o MacToys capturasse o som deste app (erro %lld)."
                }
