    "Hide the menu bar icons you rarely need and bring them back with a click, a hover or a shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selten benötigte Menüleistensymbole ausblenden und mit einem Klick, beim Darüberfahren oder per Kurzbefehl zurückholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los iconos de la barra de menús que apenas necesitas y recupéralos con un clic, al pasar el puntero o con un atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez les icônes de la barre des menus dont vous avez rarement besoin et faites-les revenir d’un clic, d’un survol ou d’un raccourci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi le icone della barra dei menu che usi di rado e richiamale con un clic, un passaggio del puntatore o un'abbreviazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あまり必要のないメニューバーアイコンを隠し、クリック、ポインタを合わせる操作、ショートカットで再表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거의 필요 없는 메뉴 막대 아이콘을 숨기고 클릭, 포인터 올리기 또는 단축키로 다시 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte os ícones da barra de menus que você raramente usa e traga-os de volta com um clique, passando o ponteiro ou com um atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывайте редко нужные значки строки меню и возвращайте их нажатием, наведением или сочетанием клавиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏不常用的菜单栏图标，并通过点按、悬停或快捷键让它们重新显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏你很少需要的選單列圖像，並透過按一下、指標停留或快速鍵讓它們重新出現。"
          }
        }
      }
    },
    "Hide the menu bar icons you rarely use": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selten verwendete Menüleistensymbole ausblenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los iconos de la barra de menús que apenas usas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les icônes de la barre des menus que vous utilisez rarement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi le icone della barra dei menu che usi di rado"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あまり使わないメニューバーアイコンを隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 사용하지 않는 메뉴 막대 아이콘 숨기기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte os ícones da barra de menus que você raramente usa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывайте редко используемые значки строки меню"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏不常用的菜单栏图标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏你很少使用的選單列圖像"
          }
        }
      }
    },
    "Hide them again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieder ausblenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a ocultarlos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les masquer de nouveau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondile di nuovo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 숨기기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultá-los novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова скрыть их"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次隐藏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次隱藏"
          }
        }
      }
    },
    "Hide this Mac’s pointer while controlling another": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiger dieses Macs ausblenden, während ein anderer gesteuert wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar el puntero de este Mac mientras se controla otro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer le pointeur de ce Mac pendant le contrôle d’un autre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi il puntatore di questo Mac mentre ne controlli un altro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのMacを操作している間はこのMacのポインタを隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Mac을 제어하는 동안 이 Mac의 포인터 숨기기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar o ponteiro deste Mac ao controlar outro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать указатель этого Mac при управлении другим"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制另一台 Mac 时隐藏此 Mac 的指针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制另一台 Mac 時隱藏此 Mac 的指標"
          }
        }
      }
    },
    "Hiding is paused so nothing gets lost. Click Arrange Items and drag the dividers back with ⌘, or reset them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ausblenden ist pausiert, damit nichts verloren geht. Auf „Objekte anordnen“ klicken und die Trennlinien mit ⌘ zurückziehen oder sie zurücksetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ocultación está en pausa para que no se pierda nada. Haz clic en Organizar ítems y arrastra los divisores de vuelta con ⌘, o restablécelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le masquage est en pause pour que rien ne se perde. Cliquez sur Organiser les éléments et faites glisser les séparateurs en arrière avec ⌘, ou réinitialisez-les."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'occultamento è in pausa per non perdere nulla. Fai clic su Disponi elementi e trascina indietro i divisori con ⌘, oppure reimpostali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目が見えなくならないように、非表示は一時停止しています。“項目を並べ替える”をクリックして⌘を押しながら区切り線をドラッグして戻すか、リセットしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목이 사라지지 않도록 숨기기가 일시 정지되었습니다. 항목 배치를 클릭하고 ⌘ 키를 누른 채 구분선을 다시 드래그하거나 재설정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ocultação está pausada para que nada se perca. Clique em Organizar Itens e arraste os divisores de volta com ⌘ ou redefina-os."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытие приостановлено, чтобы ничего не потерялось. Нажмите «Упорядочить объекты» и перетяните разделители обратно с ⌘ или сбросьте их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏已暂停，以免丢失任何内容。点按“排列项目”并按住 ⌘ 将分隔线拖回，或将其重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停隱藏，以免遺失任何項目。按一下「排列項目」並按住 ⌘ 將分隔線拖回原位，或將其重置。"
          }
        }
      }
    },
    "High": {
      "comment": "Shake sensitivity: a short, small shake is enough",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoch"
          }
        },
        "es": {
