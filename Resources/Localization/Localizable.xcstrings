          }
        }
      }
    },
    "A key can’t be remapped to itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Taste kann nicht auf sich selbst umbelegt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tecla no se puede reasignar a sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche ne peut pas être réaffectée à elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tasto non può essere rimappato su se stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをそのキー自体にリマップすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 자기 자신으로 재매핑할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tecla não pode ser remapeada para ela mesma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавишу нельзя переназначить на саму себя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键不能重映射到其自身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵無法重新對應至自身。"
          }
        }
      }
    },
    "A keyword runs only that plugin: “%@”, “%@”. Characters used in math or paths (%@) can clash with global results.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schlüsselwort führt nur dieses Plug-in aus: „%1$@“, „%2$@“. Zeichen aus Mathematik oder Pfaden (%3$@) können mit globalen Ergebnissen kollidieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A keyword runs only that plugin: “%1$@”, “%2$@”. Characters used in math or paths (%3$@) can clash with global results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palabra clave ejecuta solo ese complemento: “%1$@”, “%2$@”. Los caracteres usados en matemáticas o rutas (%3$@) pueden entrar en conflicto con los resultados globales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot-clé n’exécute que ce module : « %1$@ », « %2$@ ». Les caractères utilisés en maths ou dans les chemins (%3$@) peuvent entrer en conflit avec les résultats globaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parola chiave esegue solo quel plugin: “%1$@”, “%2$@”. I caratteri usati in matematica o nei percorsi (%3$@) possono entrare in conflitto con i risultati globali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーワードを使うと、そのプラグインだけが実行されます: “%1$@”、“%2$@”。計算式やパスで使われる文字（%3$@）は、グローバルな結果と競合することがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키워드를 입력하면 해당 플러그인만 실행됩니다: “%1$@”, “%2$@”. 수식이나 경로에 쓰이는 문자(%3$@)는 전역 결과와 충돌할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma palavra-chave executa apenas esse plug-in: “%1$@”, “%2$@”. Caracteres usados em matemática ou caminhos (%3$@) podem conflitar com resultados globais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключевое слово запускает только свой плагин: «%1$@», «%2$@». Символы, используемые в математике или путях (%3$@), могут конфликтовать с глобальными результатами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关键字只运行对应的插件：“%1$@”、“%2$@”。数学或路径中使用的字符（%3$@）可能与全局结果冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關鍵字只會執行該外掛程式：「%1$@」、「%2$@」。用於數學或路徑的字元（%3$@）可能與全域結果衝突。"
          }
        }
      }
    },
    "A link or another app asked to run this command. Continue only if you expected it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Link oder eine andere App möchte diesen Befehl ausführen. Nur fortfahren, wenn dies erwartet wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace u otra app ha pedido ejecutar este comando. Continúa solo si lo esperabas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien ou une autre app a demandé l’exécution de cette commande. Ne continuez que si vous vous y attendiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un link o un'altra app ha chiesto di eseguire questo comando. Continua solo se te lo aspettavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクまたはほかのAppが、このコマンドの実行を要求しました。心当たりがある場合のみ続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 또는 다른 앱이 이 명령의 실행을 요청했습니다. 예상한 요청인 경우에만 계속하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link ou outro app solicitou a execução deste comando. Continue apenas se você esperava por isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка или другое приложение запрашивает запуск этой команды. Продолжайте, только если вы этого ожидали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个链接或其他 App 请求运行此命令。仅在你预期如此时才继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有連結或其他 App 要求執行此指令。請只在你預期如此時才繼續。"
          }
        }
      }
    },
    "A magnified, live view you can keep working in. ⌃⌥= and ⌃⌥- change the level.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine vergrößerte Live-Ansicht, in der weitergearbeitet werden kann. ⌃⌥= und ⌃⌥- ändern die Stufe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vista ampliada y en directo en la que puedes seguir trabajando. ⌃⌥= y ⌃⌥- cambian el nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vue agrandie en direct, dans laquelle vous pouvez continuer à travailler. ⌃⌥= et ⌃⌥- changent le niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vista ingrandita in tempo reale in cui puoi continuare a lavorare. ⌃⌥= e ⌃⌥- cambiano il livello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大したまま作業を続けられるライブ表示。⌃⌥=と⌃⌥-で倍率を変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대된 실시간 화면에서 계속 작업할 수 있습니다. ⌃⌥=와 ⌃⌥-로 배율을 변경합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma visualização ampliada e ao vivo na qual você pode continuar trabalhando. ⌃⌥= e ⌃⌥- alteram o nível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличенное изображение в реальном времени, в котором можно продолжать работать. ⌃⌥= и ⌃⌥- меняют масштаб."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大的实时画面，你可以继续在其中操作。⌃⌥= 和 ⌃⌥- 可更改缩放级别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大的即時畫面，你可以繼續在其中工作。⌃⌥= 和 ⌃⌥- 可更改縮放程度。"
          }
        }
      }
    },
    "A page with the document's headings and text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Seite mit den Überschriften und dem Text des Dokuments"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página con los encabezados y el texto del documento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page avec les titres et le texte du document"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pagina con i titoli e il testo del documento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類の見出しとテキストを含むページ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서의 제목과 텍스트가 담긴 페이지"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma página com os títulos e o texto do documento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница с заголовками и текстом документа"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含文稿标题和文本的页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含文件標題與文字的頁面"
          }
        }
      }
    },
    "A preview of all displays: click to move the pointer there. 1–9 pick a display, ← → cycle, Home/End first/last, P primary.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vorschau aller Displays: Klicken bewegt den Zeiger dorthin. 1–9 wählt ein Display, ← → wechselt, Pos1/Ende erstes/letztes, P Hauptdisplay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vista previa de todas las pantallas: haz clic para mover el puntero allí. 1–9 eligen una pantalla, ← → las recorren, Inicio/Fin la primera/última, P la principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aperçu de tous les écrans : cliquez pour y déplacer le pointeur. 1–9 choisissent un écran, ← → les parcourent, Début/Fin le premier/dernier, P le principal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'anteprima di tutti i monitor: fai clic per spostarvi il puntatore. 1–9 scelgono un monitor, ← → li scorrono, Home/Fine primo/ultimo, P principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのディスプレイのプレビュー。クリックするとポインタがそこに移動します。1〜9でディスプレイを選択、← →で切り替え、Home/Endで最初/最後、Pでメインディスプレイ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 디스플레이 미리보기: 클릭하면 포인터가 그곳으로 이동합니다. 1–9로 디스플레이 선택, ← →로 순환, Home/End로 처음/마지막, P로 주 디스플레이."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma prévia de todos os monitores: clique para mover o ponteiro até lá. 1–9 escolhem um monitor, ← → alternam, Home/End primeiro/último, P principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превью всех дисплеев: нажмите, чтобы переместить туда указатель. 1–9 — выбор дисплея, ← → — перебор, Home/End — первый/последний, P — основной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有显示器的预览：点按即可将指针移到那里。1–9 选择显示器，← → 循环切换，Home/End 切换到第一个/最后一个，P 切换到主显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有顯示器的預覽：按一下即可將指標移到該處。1–9 選擇顯示器，← → 循環切換，Home/End 第一台/最後一台，P 主顯示器。"
          }
        }
      }
    },
    "A quick launcher with plugin keywords: = calculator, > shell, // URLs, < windows and more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schnellstarter mit Plug-in-Schlüsselwörtern: = Rechner, > Shell, // URLs, < Fenster und mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lanzador rápido con palabras clave de complementos: = calculadora, > shell, // URL, < ventanas y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lanceur rapide avec mots-clés de modules : = calculatrice, > shell, // URL, < fenêtres et plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'app di avvio rapido con parole chiave per i plugin: = calcolatrice, > shell, // URL, < finestre e altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインキーワードを使えるクイックランチャー: =で計算機、>でシェル、//でURL、<でウインドウなど。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인 키워드를 지원하는 빠른 실행기: = 계산기, > 셸, // URL, < 윈도우 등."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um iniciador rápido com palavras-chave de plug-ins: = calculadora, > shell, // URLs, < janelas e mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрый запуск с ключевыми словами плагинов: = калькулятор, > оболочка, // URL, < окна и другое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带插件关键字的快速启动器：= 计算器、> shell、// URL、< 窗口等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用外掛程式關鍵字的快速啟動器：= 計算機、> shell、// URL、< 視窗等。"
          }
        }
      }
    },
