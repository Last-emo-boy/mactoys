    "Location access is off for MacToys. Allow it in System Settings › Privacy & Security › Location Services, or enter coordinates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortzugriff ist für MacToys deaktiviert. In „Systemeinstellungen › Datenschutz & Sicherheit › Ortungsdienste“ erlauben oder Koordinaten eingeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la localización está desactivado para MacToys. Permítelo en Ajustes del Sistema › Privacidad y seguridad › Servicios de localización o introduce las coordenadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la position est désactivé pour MacToys. Autorisez-le dans Réglages Système › Confidentialité et sécurité › Service de localisation, ou saisissez des coordonnées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla posizione è disattivato per MacToys. Consentilo in Impostazioni di Sistema › Privacy e sicurezza › Servizi di localizzazione, oppure inserisci le coordinate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToysの位置情報へのアクセスがオフになっています。“システム設定” › “プライバシーとセキュリティ” › “位置情報サービス”で許可するか、座標を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys의 위치 접근이 꺼져 있습니다. 시스템 설정 › 개인정보 보호 및 보안 › 위치 서비스에서 허용하거나 좌표를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à localização está desativado para o MacToys. Permita-o em Ajustes do Sistema › Privacidade e Segurança › Serviços de Localização ou digite coordenadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к геопозиции для MacToys выключен. Разрешите его в Системных настройках › Конфиденциальность и безопасность › Службы геолокации или введите координаты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys 的位置访问权限已关闭。请在系统设置 › 隐私与安全性 › 定位服务中允许，或者输入坐标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys 的位置取用權限已關閉。請在「系統設定」›「隱私權與安全性」›「定位服務」中允許，或輸入座標。"
          }
        }
      }
    },
