    "Pick a control on the left, or add one with +.": {
      "comment": "Window Controls editor: what to do when nothing is selected",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links ein Steuerelement auswählen oder mit + eines hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un control a la izquierda o añade uno con +."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
