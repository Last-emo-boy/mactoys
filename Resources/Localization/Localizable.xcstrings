    "Never": {
      "comment": "Automatically delete hosts backups: never\nHand-off delay: never lock macOS too\nIdle timer: off\nOptimizer: hide result cards never\nQuick Access cards: don't close by themselves",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai"
          }
        },
        "ja": {
