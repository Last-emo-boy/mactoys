            "value": "macOS도 충전을 제한하고 있음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS também está limitando o carregamento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS тоже ограничивает зарядку"
          }
        },
