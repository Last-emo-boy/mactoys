        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解碼此二進位 G-code 檔案。"
          }
        }
      }
    },
    "This database has no tables.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此数据库没有表。"
          }
        },
        "zh-Hant": {
