    "The limit built into macOS: %@–%@, set in Battery settings. Nothing to install.": {
      "comment": "Placeholders are the range macOS offers",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das in macOS integrierte Limit: %1$@–%2$@, festgelegt in den Batterieeinstellungen. Keine Installation nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The limit built into macOS: %1$@–%2$@, set in Battery settings. Nothing to install."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite integrado en macOS: %1$@–%2$@, definido en los ajustes de Batería. No hay que instalar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite intégrée à macOS : %1$@–%2$@, définie dans les réglages Batterie. Rien à installer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
