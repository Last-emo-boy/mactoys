    "Fixes likely misreadings of words. Turn off for code, serial numbers and IDs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiert wahrscheinlich falsch erkannte Wörter. Für Code, Seriennummern und IDs ausschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige palabras que probablemente se hayan leído mal. Desactívalo para código, números de serie e identificadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige les mots probablement mal reconnus. Désactivez cette option pour le code, les numéros de série et les identifiants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregge le parole probabilmente lette in modo errato. Disattivalo per codice, numeri di serie e ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語の誤認識と思われる箇所を修正します。コード、シリアル番号、IDの場合はオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못 인식했을 가능성이 있는 단어를 수정합니다. 코드, 일련번호, ID에는 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige prováveis erros de leitura de palavras. Desative para código, números de série e IDs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправляет вероятные ошибки распознавания слов. Выключите для кода, серийных номеров и идентификаторов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修正可能识别错误的单词。识别代码、序列号和 ID 时请关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修正可能誤讀的字詞。用於程式碼、序號和 ID 時請關閉。"
          }
        }
      }
    },
