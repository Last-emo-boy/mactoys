          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O menor número de um tamanho se aplica ao lado menor de cada imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меньшее число размера применяется к меньшей стороне каждого изображения."
