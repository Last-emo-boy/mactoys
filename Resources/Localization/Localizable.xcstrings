        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "macOS не дает MacToys получить звук этого приложения (ошибка %lld)."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "macOS не дает MacToys получить звук этого приложения (ошибка %lld)."
                }
              },
              "one": {
