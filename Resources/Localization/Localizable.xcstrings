          }
        }
      }
    },
    "Drop files or folders here, or click + to add them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien oder Ordner hier ablegen oder zum Hinzufügen auf + klicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta archivos o carpetas aquí o haz clic en + para añadirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez des fichiers ou des dossiers ici, ou cliquez sur + pour les ajouter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia qui file o cartelle, oppure fai clic su + per aggiungerli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
