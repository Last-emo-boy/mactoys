        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero più piccolo di una dimensione si applica al lato più corto di ogni immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズの小さい方の数値が、各画像の短い辺に適用されます。"
