        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  （你打開過的 URL 的一部分）"
          }
        }
      }
    },
    "%@  (sorted by CPU)": {
      "comment": "Run help example: %@ is what to type, the parentheses explain it",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  （依 CPU 排序）"
          }
        }
      }
    },
    "%@ (%@)": {
      "comment": "Pen color tooltip: color name, then the letter key that selects it",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ (imported)": {
      "comment": "Name of an imported profile whose name is taken; %@ is its name",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（已輸入）"
          }
        }
      }
    },
    "%@ (minimized)": {
      "comment": "Window tile in the workspace layout; %@ is the app name",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（已最小化）"
          }
        }
      }
    },
    "%@ (not installed)": {
      "comment": "%@ is a terminal app such as iTerm2",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（未安裝）"
          }
        }
      }
    },
    "%@ (optional)": {
      "comment": "%@ is an argument placeholder",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（選用）"
          }
        }
      }
    },
    "%@ (⌘%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (⌘%2$lld)"
          }
        }
      }
    },
    "%@ +%lld": {
      "comment": "Remap scope: the first app name, then how many more apps",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ +%2$lld"
          }
        }
      }
    },
    "%@ Keyboard Profile": {
      "comment": "Suggested file name for an exported profile; %@ is the profile name",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 鍵盤設定檔"
          }
        }
      }
    },
    "%@ Settings": {
      "comment": "Action: open a utility's settings; %@ is a utility such as Color Picker",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 設定"
          }
        }
      }
    },
    "%@ access required": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要「%@」權限"
          }
        }
      }
    },
    "%@ ahead": {
      "comment": "Time zone difference; %@ is a duration such as “8 hours”",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快 %@"
          }
        }
      }
    },
    "%@ and %lld more": {
      "comment": "File Locksmith: first scanned path, then how many more items",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ and %2$lld more"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 及其他 %2$lld 個項目"
          }
        }
      }
    },
    "%@ at %@": {
      "comment": "Date and time in a default file name, e.g. 2026-10-25 at 14.03.12; the first %@ is the date, the second the time",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ at %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ behind": {
      "comment": "Time zone difference; %@ is a duration such as “8 hours”",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢 %@"
          }
        }
      }
    },
    "%@ connected": {
      "comment": "Status message; %@ is the other Mac's name",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已連線"
          }
        }
      }
    },
    "%@ copied from %@": {
      "comment": "Status message: a file from another Mac's clipboard; the file name, then the Mac's name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ copied from %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已從 %2$@ 拷貝 %1$@"
          }
        }
      }
    },
    "%@ copy": {
      "comment": "Name of a duplicated layout: the original's name\nName of a duplicated profile; %@ is the original name\nName of a duplicated profile; the placeholder is the original name\nName of a duplicated workspace; %@ is the original name",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拷貝"
          }
        }
      }
    },
    "%@ disconnected": {
      "comment": "Status message; %@ is the other Mac's name",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已中斷連線"
          }
        }
      }
    },
    "%@ done": {
      "comment": "HUD: a silent script finished without output; %@ is its title",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已完成"
          }
        }
      }
    },
    "%@ failed: %@": {
      "comment": "%1$@ is a command-line tool (ffmpeg, lame, afconvert), %2$@ the error it printed",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ failed: %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 失敗：%2$@"
          }
        }
      }
    },
    "%@ for %@ is already used by another app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ for %2$@ is already used by another app"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 的 %1$@ 已被另一個 App 使用"
          }
        }
      }
    },
    "%@ in %@": {
      "comment": "World clock: “10:41 PM in London”; %1$@ is a time, %2$@ a place",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ in %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@"
          }
        }
      }
    },
    "%@ is also mapped by another active entry": {
      "comment": "Hosts entry problem; the placeholder is a host name",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 也由另一個啟用中的項目對應"
          }
        }
      }
    },
    "%@ is bound to both %@ and %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is bound to both %2$@ and %3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 同時指定給 %2$@ 和 %3$@"
          }
        }
      }
    },
    "%@ is excluded from Always On Top": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已排除在「永遠在最上層」之外"
          }
        }
      }
    },
    "%@ is larger than %@.": {
      "comment": "First a file name, then a size such as '64 MB'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is larger than %2$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 大於 %2$@。"
          }
        }
      }
    },
    "%@ is managed by the system": {
      "comment": "Environment variable name problem; the placeholder is the name",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 由系統管理"
          }
        }
      }
    },
    "%@ is not defined for this value": {
      "comment": "Calculator error; %@ is a function or operator such as sqrt",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未針對此值定義"
          }
        }
      }
    },
    "%@ is replaced by the query": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會替換為查詢內容"
          }
        }
      }
    },
    "%@ isn’t connected": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未連線"
          }
        }
      }
    },
    "%@ left · %@": {
      "comment": "Awake status: first the time left, e.g. '1 hr, 12 min', then the screen state",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ left · %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剩餘 %1$@ · %2$@"
          }
        }
      }
    },
    "%@ links run commands after you confirm. ⌘K › Copy Command Link creates one.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 連結會在你確認後執行指令。使用 ⌘K › 「拷貝指令連結」即可建立。"
          }
        }
      }
    },
    "%@ needs an image on the clipboard.": {
      "comment": "%@ is an Advanced Paste action, e.g. .png file",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」需要剪貼板上有影像。"
          }
        }
      }
    },
    "%@ needs one audio or video file on the clipboard.": {
      "comment": "%@ is an Advanced Paste action, e.g. Transcode to .mp3",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」需要剪貼板上有一個音訊或影片檔案。"
          }
        }
      }
    },
    "%@ needs one video file on the clipboard.": {
      "comment": "%@ is an Advanced Paste action, e.g. Transcode to .mp4",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」需要剪貼板上有一個影片檔案。"
          }
        }
      }
    },
    "%@ needs text on the clipboard.": {
      "comment": "%@ is an Advanced Paste action, e.g. Markdown",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」需要剪貼板上有文字。"
          }
        }
      }
    },
    "%@ on %@": {
      "comment": "FancyZones: a layout name, then the name of the display that uses it",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ on %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上的 %1$@"
          }
        }
      }
    },
    "%@ on this display": {
      "comment": "FancyZones: a layout name",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此顯示器上的 %@"
          }
        }
      }
    },
    "%@ reads its preferences when it starts.": {
      "comment": "The placeholder is an app such as Dock or Finder",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會在啟動時讀取偏好設定。"
          }
        }
      }
    },
    "%@ source": {
      "comment": "File type, e.g. “Swift source”: %@ is a programming language name",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 原始碼"
          }
        }
      }
    },
    "%@ takes %@": {
      "comment": "Calculator error; first %@ is a function name, second how many arguments it takes, e.g. “2 arguments”",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ takes %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 需要 %2$@"
          }
        }
      }
    },
    "%@ timed out": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 逾時"
          }
        }
      }
    },
    "%@ took over": {
      "comment": "Status message: the other Mac (%@) took back control",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已接管"
          }
        }
      }
    },
    "%@ when held": {
      "comment": "Remap note: the key acts as this modifier (such as ⌃) while held",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住時為 %@"
          }
        }
      }
    },
    "%@ · %lld rows": {
      "comment": "Clipboard preview: %1$@ is CSV or TSV, %2$lld the number of data rows",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$lld rows"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld 列"
          }
        }
      }
    },
    "%@ · %lld windows": {
      "comment": "Window Hopper header; %@ is the app name, %lld the number of its windows",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$lld windows"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld 個視窗"
          }
        }
      }
    },
    "%@ · ISO 8601 week, %lld": {
      "comment": "%1$@ is a date, %2$lld the ISO week-numbering year",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · ISO 8601 week, %2$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · ISO 8601 週，%2$lld 年"
          }
        }
      }
    },
    "%@ · drag over the area to keep · esc cancels": {
      "comment": "Crop selection hint; %@ is the crop mode (Thumbnail, Interactive or Screenshot), esc is the key",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 拖移選取要保留的區域 · 按 esc 取消"
          }
        }
      }
    },
    "%@ · e.g. %@": {
      "comment": "Run help: %1$@ describes a plugin, %2$@ is an example query",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · e.g. %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 例如 %2$@"
          }
        }
      }
    },
    "%@ · installed %@": {
      "comment": "%1$@ is Formula or Cask, %2$@ the installed version",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · installed %2$@"
