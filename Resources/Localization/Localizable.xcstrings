          }
        }
      }
    },
    "A window or lamp behind you darkens your face. Turn toward the light.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fenster oder eine Lampe im Hintergrund verdunkelt das Gesicht. Zum Licht drehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ventana o una lámpara detrás de ti oscurece tu cara. Gírate hacia la luz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fenêtre ou une lampe derrière vous assombrit votre visage. Tournez-vous vers la lumière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背後の窓や照明で顔が暗くなっています。光のほうを向いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤에 있는 창문이나 조명 때문에 얼굴이 어두워집니다. 빛을 향해 돌아앉으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma janela ou luminária atrás de você escurece seu rosto. Vire-se para a luz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно или лампа позади вас затемняют лицо. Повернитесь к свету."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你身后的窗户或灯光会让你的脸显得较暗。请转向光源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你身後的窗戶或燈光會讓你的臉變暗。請轉向光源。"
          }
        }
      }
    },
    "A window with the Window Controls palette open under its green button": {
      "comment": "Accessibility: the hero illustration",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fenster mit geöffneter Palette der Fenstersteuerung unter seiner grünen Taste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ventana con la paleta de Controles de ventana abierta bajo su botón verde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fenêtre avec la palette Commandes de fenêtre ouverte sous son bouton vert"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una finestra con la tavolozza di Controlli finestra aperta sotto il pulsante verde"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑のボタンの下にウインドウコントロールのパレットを開いたウインドウ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초록색 버튼 아래에 윈도우 제어 팔레트가 열려 있는 윈도우"
          }
        },
        "pt-BR": {
