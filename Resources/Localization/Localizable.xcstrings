    "Press Space while dragging and speak. Transcribed on this Mac; the text is pasted with the image.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ziehen die Leertaste drücken und sprechen. Die Transkription erfolgt auf diesem Mac; der Text wird mit dem Bild eingesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa la barra espaciadora mientras arrastras y habla. Se transcribe en este Mac; el texto se pega con la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Espace pendant le glissement et parlez. Transcrit sur ce Mac ; le texte est collé avec l’image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi la barra spaziatrice durante il trascinamento e parla. La trascrizione avviene su questo Mac; il testo viene incollato con l'immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中にスペースバーを押して話します。このMac上で文字起こしされ、テキストは画像と一緒にペーストされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안 스페이스 바를 누르고 말하세요. 이 Mac에서 텍스트로 변환되며, 텍스트가 이미지와 함께 붙여넣어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione a barra de espaço enquanto arrasta e fale. Transcrito neste Mac; o texto é colado com a imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите пробел во время перетягивания и говорите. Речь расшифровывается на этом Mac; текст вставляется вместе с изображением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移时按空格键并说话。在此 Mac 上转写；文本会与图像一起粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移時按空白鍵並說話。會在此 Mac 上轉寫，文字會與影像一起貼上。"
          }
        }
      }
    },
    "Press a second key after the shortcut, like ⌃⇧V then U.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Kurzbefehl eine zweite Taste drücken, z. B. ⌃⇧V und dann U."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa una segunda tecla después del atajo, como ⌃⇧V y luego U."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur une seconde touche après le raccourci, comme ⌃⇧V puis U."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi un secondo tasto dopo l'abbreviazione, ad esempio ⌃⇧V e poi U."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットのあとに2つ目のキーを押します（例: ⌃⇧V、続けてU）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키 다음에 두 번째 키를 누르세요(예: ⌃⇧V 다음에 U)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione uma segunda tecla após o atalho, como ⌃⇧V e depois U."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите вторую клавишу после сочетания, например ⌃⇧V, затем U."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在快捷键之后再按第二个键，例如 ⌃⇧V 然后按 U。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在快速鍵之後按下第二個按鍵，例如 ⌃⇧V 再按 U。"
          }
        }
      }
    },
    "Press again or esc to close.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Schließen erneut drücken oder esc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa de nuevo o esc para cerrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez à nouveau ou sur Échap pour fermer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi di nuovo o esc per chiudere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度押すかescで閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 누르거나 esc를 누르면 닫힙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione novamente ou esc para fechar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите еще раз или esc, чтобы закрыть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一次或按 esc 关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一次或按 esc 即可關閉。"
          }
        }
      }
    },
    "Press again to hide or show it while it keeps running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut drücken, um es aus- oder einzublenden, während es weiterläuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa de nuevo para ocultarlo o mostrarlo mientras sigue en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez à nouveau pour le masquer ou l’afficher pendant qu’il continue."
          }
        },
        "it": {
