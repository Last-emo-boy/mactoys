        }
      }
    },
    "Keep pressing the key to move on, add ⇧ to go back, use the arrow keys or point at a window. Release to switch; esc closes without switching. It doesn't open when the app has fewer than two windows.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持續按該按鍵即可往下切換，加按 ⇧ 可返回，也可使用方向鍵或指向視窗。放開即可切換；按 esc 關閉而不切換。App 的視窗少於兩個時不會打開。"
          }
        }
      }
    },
    "Keep screen on": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持螢幕開啟"
          }
