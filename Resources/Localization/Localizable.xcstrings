            "state": "translated",
            "value": "La fenêtre sous le pointeur passe au premier plan après une courte pause"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra sotto il puntatore passa in primo piano dopo una breve pausa"
          }
        },
        "ja": {
