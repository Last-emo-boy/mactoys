            "state": "translated",
            "value": "无法启动麦克风"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動麥克風"
          }
        }
      }
    },
    "The mirror opens": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spiegel öffnet sich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espejo se abre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le miroir s’ouvre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミラーを開く位置"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미러 열리는 위치"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espelho abre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где открывается зеркало"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜像打开时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鏡像打開位置"
          }
        }
      }
    },
    "The model couldn't be rendered.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell konnte nicht gerendert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido renderizar el modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’afficher le modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile visualizzare il modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルをレンダリングできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 렌더링할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível renderizar o modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отрисовать модель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法渲染模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法轉譯模型。"
          }
        }
      }
    },
    "The monitor mirrors the virtual display: for HiDPI on a monitor that doesn't offer it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Monitor spiegelt das virtuelle Display: für HiDPI auf einem Monitor, der es nicht anbietet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El monitor duplica la pantalla virtual: para tener HiDPI en un monitor que no lo ofrece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moniteur recopie l’écran virtuel : pour du HiDPI sur un moniteur qui n’en propose pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モニタに仮想ディスプレイをミラーリングします: HiDPIに対応していないモニタでHiDPIを使うためのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모니터가 가상 디스플레이를 미러링합니다. HiDPI를 지원하지 않는 모니터에서 HiDPI를 사용하기 위한 기능입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O monitor espelha o monitor virtual: para ter HiDPI em um monitor que não o oferece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Монитор повторяет виртуальный дисплей — для HiDPI на мониторе, который его не поддерживает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器镜像该虚拟显示器：可在不支持 HiDPI 的显示器上使用 HiDPI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示器會鏡像輸出虛擬顯示器：讓不支援 HiDPI 的顯示器也能使用 HiDPI。"
          }
        }
      }
    },
    "The name is empty": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name ist leer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre está vacío"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom est vide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome è vuoto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前が空です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 비어 있음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome está vazio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя пустое"
          }
        },
