    "Used by displays you haven't picked a layout for": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird von Displays verwendet, für die kein Layout gewählt wurde"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo usan las pantallas para las que no has elegido una distribución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisée par les écrans pour lesquels vous n’avez pas choisi de disposition"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato dai monitor per cui non hai scelto un layout"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトを選択していないディスプレイで使用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃을 선택하지 않은 디스플레이에 사용됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado por monitores para os quais você não escolheu um layout"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для дисплеев, для которых вы не выбрали макет"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于你尚未选取布局的显示器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於你尚未選擇佈局的顯示器"
          }
        }
      }
    },
    "Used when a picked color is copied.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, wenn eine aufgenommene Farbe kopiert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa al copiar un color seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé quand une couleur choisie est copiée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato quando un colore selezionato viene copiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色をコピーするときに使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 색상을 복사할 때 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado quando uma cor escolhida é copiada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется при копировании выбранного цвета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝选取的颜色时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝選取的顏色時使用。"
          }
        }
      }
    },
    "Used when a picture’s own format can’t be written (RAW, PDF, ICNS…). Not a converter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, wenn das eigene Format eines Bildes nicht geschrieben werden kann (RAW, PDF, ICNS …). Kein Konverter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa cuando no se puede escribir el formato propio de una imagen (RAW, PDF, ICNS…). No es un conversor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé quand le format d’origine d’une image ne peut pas être écrit (RAW, PDF, ICNS…). Ce n’est pas un convertisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato quando il formato originale di un'immagine non può essere scritto (RAW, PDF, ICNS…). Non è un convertitore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の元の形式で書き込めない場合（RAW、PDF、ICNS…）に使用されます。変換ツールではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 자체의 형식으로 기록할 수 없을 때(RAW, PDF, ICNS…) 사용됩니다. 변환기가 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado quando o formato original de uma imagem não pode ser gravado (RAW, PDF, ICNS…). Não é um conversor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется, когда собственный формат изображения нельзя записать (RAW, PDF, ICNS…). Это не конвертер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当无法写入图片自身的格式（RAW、PDF、ICNS…）时使用。并非格式转换器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在無法寫入圖片原本的格式時使用（RAW、PDF、ICNS⋯）。並非轉換工具。"
          }
        }
      }
    },
    "Used when connecting by address (default 15101). Bonjour finds Macs on any port.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Verbinden über eine Adresse verwendet (Standard 15101). Bonjour findet Macs an jedem Port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa al conectar por dirección (por omisión, 15101). Bonjour encuentra los Mac en cualquier puerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé lors d’une connexion par adresse (15101 par défaut). Bonjour trouve les Mac sur n’importe quel port."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usata per la connessione tramite indirizzo (predefinita 15101). Bonjour trova i Mac su qualsiasi porta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスで接続するときに使用されます（デフォルトは15101）。BonjourはどのポートのMacも検出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소로 연결할 때 사용됩니다(기본값 15101). Bonjour는 모든 포트에서 Mac을 찾습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usada ao conectar pelo endereço (padrão 15101). O Bonjour encontra Macs em qualquer porta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется при подключении по адресу (по умолчанию 15101). Bonjour находит Mac на любом порту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过地址连接时使用（默认为 15101）。Bonjour 可以在任意端口上找到 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依位址連線時使用（預設為 15101）。Bonjour 可在任何埠上找到 Mac。"
          }
        }
      }
    },
