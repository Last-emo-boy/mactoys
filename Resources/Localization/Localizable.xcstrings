            "state": "translated",
            "value": "Un nombre ou un calcul"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un numero o un calcolo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値または計算式"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
