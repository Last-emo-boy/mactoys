    "Press R in the overlay to switch it for one capture.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "R im Overlay drücken, um dies für eine Aufnahme umzuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa R en la superposición para cambiarlo en una sola captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur R dans la superposition pour inverser ce réglage le temps d’une capture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi R nella sovrimpressione per cambiarlo per una sola acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーバーレイでRを押すと、そのキャプチャだけ切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 캡처에 대해 전환하려면 오버레이에서 R을 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione R na sobreposição para alternar em uma captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите R в наложении, чтобы переключить это для одного снимка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在叠加层中按 R 可对单次截取切换此设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在疊加畫面中按 R，即可僅在此次擷取中切換。"
          }
        }
      }
    },
