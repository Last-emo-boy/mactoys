{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "$1, $&, $` and $' in replacements; backslashes are literal.": {
      "comment": "PowerRename: keep the $… tokens as they are",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代內容中可使用 $1、$&、$` 和 $'；反斜線會依字面處理。"
          }
        }
      }
    },
    "$YYYY-$MM-$DD Notes by %USERNAME%.md": {
      "comment": "New+ sample template name; keep $YYYY, $MM, $DD, %USERNAME% and .md as they are",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "$YYYY-$MM-$DD %USERNAME% 的筆記.md"
          }
        }
      }
    },
    "${}, ${start=1}, ${increment=2}, ${padding=3} or combined: ${start=10,increment=2,padding=4}": {
      "comment": "PowerRename tooltip: keep the ${…} variables as they are",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "${}、${start=1}、${increment=2}、${padding=3}，或組合使用：${start=10,increment=2,padding=4}"
          }
        }
      }
    },
    "%@  (acronyms)": {
      "comment": "Run help example: %@ is what to type, the parentheses explain it",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  （首字母縮寫）"
          }
