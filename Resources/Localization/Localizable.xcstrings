    "Higher opens a shelf with a shorter, smaller shake.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher öffnet eine Ablage schon bei kürzerem, kleinerem Schütteln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un valor más alto, una sacudida más corta y pequeña abre una bandeja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus élevée, une secousse plus courte et plus petite ouvre une étagère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valore più alto apre uno scaffale con uno scuotimento più breve e lieve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高くするほど、短く小さなシェイクでシェルフが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높을수록 더 짧고 작게 흔들어도 선반이 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores mais altos abrem uma prateleira com uma sacudida mais curta e menor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем выше, тем более короткое и слабое встряхивание открывает полку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越高，摇晃幅度越小、时间越短就能打开文件架。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數值越高，只需較短、較小的搖晃即可打開檔案架。"
          }
        }
      }
    },
    "Higher quality": {
      "comment": "Optimizer: video quality level",
      "localizations": {
