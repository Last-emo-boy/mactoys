    "Remap a key (⇪ → esc, Right ⌘ → F18) or a shortcut (⌥⇧K → ⌘⇧K in Xcode, ⌃⌥E → your email address).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimappa un tasto (⇪ → esc, ⌘ destro → F18) o un'abbreviazione (⌥⇧K → ⌘⇧K in Xcode, ⌃⌥E → il tuo indirizzo email)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키(⇪ → esc, 오른쪽 ⌘ → F18) 또는 단축키(Xcode에서 ⌥⇧K → ⌘⇧K, ⌃⌥E → 이메일 주소)를 재매핑합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remapeie uma tecla (⇪ → esc, ⌘ direita → F18) ou um atalho (⌥⇧K → ⌘⇧K no Xcode, ⌃⌥E → seu endereço de e-mail)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重映射按键（⇪ → esc，右 ⌘ → F18）或快捷键（在 Xcode 中 ⌥⇧K → ⌘⇧K，⌃⌥E → 你的电子邮件地址）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新對應按鍵（⇪ → esc、右側 ⌘ → F18）或快速鍵（在 Xcode 中 ⌥⇧K → ⌘⇧K、⌃⌥E → 你的電子郵件地址）。"
          }
        }
