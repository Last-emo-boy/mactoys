    "No folders yet. Add the folder your screenshots go to, or Downloads.": {
      "comment": "Optimizer: empty watch folder list",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Ordner. Den Ordner für Bildschirmfotos oder „Downloads“ hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay carpetas. Añade la carpeta donde se guardan tus capturas de pantalla o Descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier pour l’instant. Ajoutez le dossier où vont vos captures d’écran, ou Téléchargements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna cartella. Aggiungi la cartella in cui vanno le istantanee, o Download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダはまだありません。スクリーンショットの保存先フォルダや“ダウンロード”フォルダを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 폴더가 없습니다. 스크린샷이 저장되는 폴더나 다운로드 폴더를 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma pasta ainda. Adicione a pasta onde suas capturas de tela são salvas ou Transferências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папок пока нет. Добавьте папку, куда сохраняются снимки экрана, или папку «Загрузки»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无文件夹。可添加截屏的存储文件夹或“下载”文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無檔案夾。請加入截圖的存放檔案夾，或「下載項目」。"
          }
        }
      }
    },
