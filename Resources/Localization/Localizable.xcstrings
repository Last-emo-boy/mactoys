        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストと画像はすべてのMacに送られます。コピーしたファイルは移動先のMacに送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트와 이미지는 모든 Mac으로 전송되며, 복사한 파일은 이동한 Mac으로 전송됩니다."
          }
        },
        "pt-BR": {
