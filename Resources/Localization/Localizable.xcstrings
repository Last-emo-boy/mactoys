    "Preview files in a quick, keyboard-driven window without opening an app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien in einem schnellen, tastaturgesteuerten Fenster ansehen, ohne eine App zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualiza archivos en una ventana rápida controlada con el teclado, sin abrir ninguna app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévisualisez des fichiers dans une fenêtre rapide pilotée au clavier, sans ouvrir d’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizza i file in anteprima in una finestra rapida, controllabile da tastiera, senza aprire un'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appを開かずに、キーボードで操作できるウインドウでファイルをすばやくプレビューします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열지 않고 키보드로 빠르게 조작하는 윈도우에서 파일을 미리 봅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualize arquivos em uma janela rápida, controlada pelo teclado, sem abrir um app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте файлы в быстром окне с управлением с клавиатуры, не открывая приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在快速的、键盘驱动的窗口中预览文件，无需打开 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在由鍵盤操作的快速視窗中預覽檔案，無須打開 App。"
          }
        }
      }
    },
