            "value": "Se reconoce en este Mac. También cambia cuando eliges un idioma en la superposición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnu sur ce Mac. Change aussi quand vous choisissez une langue dans la superposition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconosciuto su questo Mac. Cambia anche quando scegli una lingua nella sovrapposizione."
