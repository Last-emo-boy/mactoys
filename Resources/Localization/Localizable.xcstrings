          }
        }
      }
    },
    "Hold ⇧ while dragging to move the selection, click a single word to copy just that word, press esc to cancel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ziehen ⇧ halten, um die Auswahl zu bewegen; auf ein einzelnes Wort klicken, um nur dieses zu kopieren; esc zum Abbrechen drücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⇧ mientras arrastras para mover la selección, haz clic en una palabra para copiar solo esa palabra o pulsa esc para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⇧ en faisant glisser pour déplacer la sélection, cliquez sur un seul mot pour ne copier que ce mot, appuyez sur Échap pour annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⇧ durante il trascinamento per spostare la selezione, fai clic su una singola parola per copiare solo quella, premi esc per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧を押したままドラッグすると選択範囲を移動、単語をクリックするとその単語だけをコピー、escでキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안 ⇧를 누르면 선택 영역이 이동하고, 단어 하나를 클릭하면 해당 단어만 복사되며, esc를 누르면 취소됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⇧ pressionada ao arrastar para mover a seleção, clique em uma única palavra para copiar apenas ela, pressione esc para cancelar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⇧ при перетягивании, чтобы переместить выделение; нажмите на одно слово, чтобы скопировать только его; esc — отмена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移时按住 ⇧ 可移动所选区域，点按单个单词可只拷贝该单词，按 esc 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移時按住 ⇧ 可移動選取範圍，按一下單一單字可只拷貝該單字，按 esc 取消。"
          }
        }
      }
    },
