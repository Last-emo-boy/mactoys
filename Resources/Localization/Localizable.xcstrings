    },
    "One packet per address, one second timeout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Paket pro Adresse, eine Sekunde Zeitlimit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paquete por dirección, tiempo de espera de un segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paquet par adresse, délai d’une seconde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pacchetto per indirizzo, timeout di un secondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスごとに1パケット、タイムアウトは1秒。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
