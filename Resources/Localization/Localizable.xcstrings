        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma amostra da sobreposição até o local desejado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетяните образец наложения в нужное место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将叠加层示例拖到你想要的位置。"
          }
        },
