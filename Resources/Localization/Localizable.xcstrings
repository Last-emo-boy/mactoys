    "Saves energy. Changing it asks for your administrator password.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spart Energie. Zum Ändern ist das Administratorpasswort erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahorra energía. Para cambiarlo se pide tu contraseña de administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Économise de l’énergie. Le modifier demande votre mot de passe d’administrateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エネルギーを節約します。変更するには管理者パスワードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에너지를 절약합니다. 변경하려면 관리자 암호가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Economiza energia. Alterá-lo pede sua senha de administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экономит энергию. Для изменения запрашивается пароль администратора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节省电量。更改时需要输入管理员密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "節省電力。更改時會要求輸入管理者密碼。"
          }
        }
      }
    },
