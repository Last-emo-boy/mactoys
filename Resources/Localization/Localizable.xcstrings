        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표준 방식으로 찾지 못하는 모니터를 더 넓은 범위에서 더 느리게 검색합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
