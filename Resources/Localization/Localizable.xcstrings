            "state": "translated",
            "value": "コマンドパレットを表示/非表示にします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 팔레트를 보거나 숨깁니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
