    "The image could not be read.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取影像。"
          }
        }
      }
    },
    "The index is up to date (%lld formulae).": {
      "comment": "Homebrew database; formulae are Homebrew packages",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The index is up to date (%lld formula)."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The index is up to date (%lld formulae)."
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "索引已是最新狀態（%lld 個 formula）。"
          }
        }
      }
    },
    "The key does nothing.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此按鍵不會執行任何動作。"
          }
        }
      }
    },
    "The lines before the first entry. Lines that aren't comments are kept as they are; new entries go below these when placement is Top.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一個項目之前的行。非註解的行會保持原樣；位置設為「頂部」時，新項目會加在這些行下方。"
          }
        }
      }
    },
    "The managed blocks in ~/.zshenv and ~/.zprofile, env.zsh and the login agent are removed, and launchd variables are restored. Your profiles stay saved in MacToys.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會移除 ~/.zshenv 和 ~/.zprofile 中的受管理區塊、env.zsh 和登入代理程式，並回復 launchd 變數。你的設定檔會繼續保留在 MacToys 中。"
          }
        }
      }
    },
    "The microphone couldn’t be started": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動麥克風"
          }
        }
      }
    },
    "The model couldn't be rendered.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法轉譯模型。"
          }
        }
      }
    },
    "The name is empty": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱是空白的"
          }
        }
      }
    },
    "The name is longer than 255 bytes": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱超過 255 個位元組"
          }
        }
      }
    },
    "The other modes are in the actions menu (⌘K)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他模式位於動作選單中（⌘K）"
          }
        }
      }
    },
    "The profile was written by a newer version of MacToys (format %lld).": {
      "comment": "%lld is the file format version",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此設定檔是由較新版本的 MacToys 寫入的（格式 %lld）。"
          }
        }
      }
    },
    "The recording couldn’t be saved": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存錄製內容"
          }
        }
      }
    },
    "The recording couldn’t be written: %@": {
      "comment": "%@ is the reason, e.g. “the encoder stopped”",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法寫入錄製內容：%@"
          }
        }
      }
    },
    "The regular expression is not valid.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正規表示式無效。"
          }
        }
      }
    },
    "The resized image could not be saved": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存調整大小後的影像"
          }
        }
      }
    },
    "The result is too large": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果太大"
          }
        }
      }
    },
    "The screen couldn't be captured": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法擷取螢幕"
          }
        }
      }
    },
    "The slicer's embedded image when there is one, otherwise the toolpath": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有切片軟體內嵌影像時使用該影像，否則使用刀具路徑"
          }
        }
      }
    },
    "The slow sweep for fine positioning.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於精細定位的慢速掃描。"
          }
        }
      }
    },
    "The smaller number of a size applies to the smaller side of each picture.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大小中較小的數字會套用到每張圖片較短的一邊。"
          }
        }
      }
    },
    "The template “%@” no longer exists": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範本「%@」已不存在"
          }
        }
      }
    },
    "The templates folder is empty.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範本檔案夾是空的。"
          }
        }
      }
    },
    "The tool that's selected when the toolbar opens.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開工具列時選取的工具。"
          }
        }
      }
    },
    "The toolbar opens after you hold the letter alone; the letter is replaced only if you choose a character.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單獨按住字母後工具列就會打開；只有在你選擇字元時才會取代該字母。"
          }
        }
      }
    },
    "The window under the pointer.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指標下方的視窗。"
          }
        }
      }
    },
    "The zone a window will drop into": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗將放入的區域"
          }
        }
      }
    },
    "Their servers can tell when you preview a document": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影像的伺服器可以得知你何時預覽文件"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題"
          }
        }
      }
    },
    "There is no preview for this kind of file.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此類檔案沒有預覽。"
          }
        }
      }
    },
    "There's no shortcut: open the editor from the MacToys menu, Settings or `open mactoys://hosts`. The file is saved as UTF-8 without a byte order mark, as macOS expects.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有快速鍵：請從 MacToys 選單、「設定」或 `open mactoys://hosts` 打開編輯器。檔案會依 macOS 的要求儲存為不含位元組順序記號的 UTF-8。"
          }
        }
      }
    },
    "They only read their preferences at launch, so a written domain shows after a relaunch.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些 App 只會在啟動時讀取偏好設定，因此寫入的網域要在重新啟動後才會顯示。"
          }
        }
      }
    },
    "They stay with you like Picture in Picture, also over full-screen apps": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們會像子母畫面一樣跟著你，也能顯示在全螢幕 App 上方"
          }
        }
      }
    },
    "Thickness": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "粗細"
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac"
          }
        }
      }
    },
    "This binary G-code file couldn't be decoded.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解碼此二進位 G-code 檔案。"
          }
        }
      }
    },
    "This database has no tables.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料庫沒有表格。"
          }
        }
      }
    },
    "This document": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件"
          }
        }
      }
    },
    "This document has dates or data, which JSON can't hold.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件包含日期或資料，而 JSON 無法儲存這些內容。"
          }
        }
      }
    },
    "This document hasn't been saved yet.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件尚未儲存。"
          }
        }
      }
    },
    "This group’s key": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此群組的密鑰"
          }
        }
      }
    },
    "This ignores your monitors' capability strings and probes every control directly, with slower timing. Only use it if a monitor is missing.\n\n• The screen may briefly go black or lose signal.\n• The monitor may change brightness, contrast or input unexpectedly.\n• The monitor may stop answering DDC/CI until it's power-cycled.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會忽略顯示器的功能字串，並以較慢的時序直接探測每個控制項。請只在有顯示器未被偵測到時使用。\n\n• 螢幕可能會短暫變黑或失去訊號。\n• 顯示器可能會意外更改亮度、對比或輸入。\n• 顯示器可能會停止回應 DDC/CI，直到重新開關電源為止。"
          }
        }
      }
    },
    "This isn't a property list (XML, binary or OpenStep) or JSON file.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是屬性列表（XML、二進位或 OpenStep）或 JSON 檔案。"
          }
        }
      }
    },
    "This isn't a valid STL file.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是有效的 STL 檔案。"
          }
        }
      }
    },
    "This media file can't be exported (it may be protected).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法輸出此媒體檔案（可能受到保護）。"
          }
        }
      }
    },
    "This monitor didn't report a capabilities string; its controls were found by probing.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此顯示器未回報功能字串；其控制項是透過探測找到的。"
          }
        }
      }
    },
    "This replaces every setting of the domain with this document (defaults import). Apps using it may need to be relaunched.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會以此文件取代該網域的所有設定（defaults import）。使用該網域的 App 可能需要重新啟動。"
          }
        }
      }
    },
    "This window can't be pinned": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法釘選此視窗"
          }
        }
      }
    },
    "Thumbnail": {
      "comment": "Crop And Lock mode: a live, read-only view of the area",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮覽圖"
          }
        }
      }
    },
    "Thumbnail crop of %@": {
      "comment": "Window title; %@ is the cropped window's title or app name",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的縮覽圖裁切"
          }
        }
      }
    },
    "Thumbnail shortcut": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮覽圖快速鍵"
          }
        }
      }
    },
    "Thumbnails": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮覽圖"
          }
        }
      }
    },
    "Thumbnails are cached. After changing these settings MacToys resets the cache; use Reset Quick Look Cache if Finder still shows old icons.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮覽圖會被快取。更改這些設定後，MacToys 會重置快取；若 Finder 仍顯示舊的圖像，請使用「重置快速查看快取」。"
          }
        }
      }
