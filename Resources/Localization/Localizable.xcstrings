    "Select an area of the focused window and keep a live view of it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Bereich des aktiven Fensters auswählen und eine Live-Ansicht davon behalten"
          }
        },
        "es": {
