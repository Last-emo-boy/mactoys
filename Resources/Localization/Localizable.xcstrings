    "Charging stops here. Between %@ and %@ is gentlest for the battery.": {
      "comment": "Placeholders are percentages",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier stoppt das Laden. Zwischen %1$@ und %2$@ ist es am schonendsten für die Batterie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Charging stops here. Between %1$@ and %2$@ is gentlest for the battery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga se detiene aquí. Entre el %1$@ y el %2$@ es lo más suave para la batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge s’arrête ici. Entre %1$@ et %2$@, la batterie est le plus ménagée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La carica si ferma qui. Tra %1$@ e %2$@ è l'intervallo più delicato per la batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで充電が停止します。バッテリーには%1$@〜%2$@が最もやさしい設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 충전이 중지됩니다. %1$@에서 %2$@ 사이가 배터리에 가장 무리가 적습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O carregamento para aqui. Entre %1$@ e %2$@ é o mais suave para a bateria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь зарядка останавливается. Бережнее всего для аккумулятора — от %1$@ до %2$@."
