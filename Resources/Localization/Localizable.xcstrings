          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez dans tout ce que vous avez copié, gardez vos favoris sur des tableaux et collez-les de nouveau depuis le clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca tutto ciò che hai copiato, tieni i preferiti sulle bacheche e incollali di nuovo dalla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたものをすべて検索し、お気に入りをピンボードに保存して、キーボードから再びペーストできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 모든 항목을 검색하고, 즐겨 찾는 항목을 핀보드에 보관하며, 키보드로 다시 붙여넣습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque tudo o que você copiou, mantenha favoritos em murais e cole de novo pelo teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите все, что копировали, держите избранное на досках и вставляйте с клавиатуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
