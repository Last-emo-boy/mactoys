          "stringUnit": {
            "state": "translated",
            "value": "在竖放的显示器上旋转网格"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在直向顯示器上旋轉網格"
          }
        }
      }
    },
    "Turn the input volume of the current microphone to zero, and back to where it was.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingangslautstärke des aktuellen Mikrofons auf null stellen und wieder zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja a cero el volumen de entrada del micrófono actual y vuelve a dejarlo como estaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire à zéro le volume d’entrée du micro actuel, puis le rétablir à son niveau précédent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のマイクの入力音量をゼロにし、元の音量に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 마이크의 입력 음량을 0으로 했다가 원래대로 되돌립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Zera o volume de entrada do microfone atual e depois o devolve ao nível anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирает громкость входа текущего микрофона до нуля и возвращает прежнюю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将当前麦克风的输入音量调为零，然后恢复原来的音量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將目前麥克風的輸入音量調到零，再調回原本的音量。"
          }
        }
      }
    },
    "Turn them back on here or from the MacToys menu bar flyout.": {
      "localizations": {
        "de": {
