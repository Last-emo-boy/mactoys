    "Save the apps and windows you use together, then bring them all back with one click.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva le app e le finestre che usi insieme, poi riaprile tutte con un clic."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께 사용하는 앱과 윈도우를 저장한 다음 클릭 한 번으로 모두 다시 불러옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
