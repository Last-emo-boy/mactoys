    },
    "The adapter powers your Mac while the battery rests.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Netzteil versorgt den Mac, während die Batterie ruht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El adaptador alimenta tu Mac mientras la batería descansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adaptateur secteur alimente votre Mac pendant que la batterie se repose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alimentatore alimenta il Mac mentre la batteria riposa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーを休ませている間は、電源アダプタがMacに電力を供給します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리가 쉬는 동안 어댑터가 Mac에 전원을 공급합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O adaptador alimenta o Mac enquanto a bateria descansa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac питается от адаптера, а аккумулятор отдыхает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池暂停使用期间，由电源适配器为 Mac 供电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電池休息時，由電源轉接器為 Mac 供電。"
          }
        }
      }
    },
    "The alpha sets how dark the rest of the screen gets.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Alphawert bestimmt, wie dunkel der restliche Bildschirm wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor alfa define cuánto se oscurece el resto de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alpha définit l’assombrissement du reste de l’écran."
