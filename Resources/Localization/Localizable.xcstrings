          "stringUnit": {
            "state": "translated",
            "value": "Cerca del cursor de texto pasa a arriba en el centro en las apps que no lo indican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Près du curseur de texte » revient à En haut au centre dans les apps qui ne l’indiquent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vicino al cursore di testo diventa In alto al centro nelle app che non lo comunicano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“テキストカーソルの近く”は、カーソル位置を報告しないAppでは上部中央になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 커서 근처는 커서 위치를 알려 주지 않는 앱에서는 상단 중앙으로 대체됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perto do cursor de texto volta para o centro superior em apps que não o informam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Рядом с текстовым курсором» заменяется на «Вверху по центру» в приложениях, которые не сообщают его положение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在不报告文本光标位置的 App 中，“文本光标附近”会改为顶部居中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在不回報文字游標的 App 中，「文字游標附近」會改用頂部中央。"
          }
        }
      }
    },
    "Needed for sunrise and sunset. Enter coordinates or use Location Services.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Sonnenauf- und -untergang erforderlich. Koordinaten eingeben oder Ortungsdienste verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para el amanecer y el atardecer. Introduce las coordenadas o usa los Servicios de localización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour le lever et le coucher du soleil. Saisissez des coordonnées ou utilisez le Service de localisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessario per alba e tramonto. Inserisci le coordinate o usa i Servizi di localizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日の出と日没に必要です。座標を入力するか、位置情報サービスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일출 및 일몰 시간에 필요합니다. 좌표를 입력하거나 위치 서비스를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para o nascer e o pôr do sol. Digite coordenadas ou use os Serviços de Localização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно для восхода и заката. Введите координаты или используйте службы геолокации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于计算日出和日落时间。请输入坐标或使用定位服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算日出和日落時需要。請輸入座標或使用定位服務。"
          }
        }
      }
    },
    "Needed to switch charging; macOS asks for your password once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Umschalten des Ladens erforderlich; macOS fragt einmal nach dem Passwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario para controlar la carga; macOS pide tu contraseña una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour activer et désactiver la charge ; macOS demande votre mot de passe une fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessario per gestire la carica; macOS chiede la password una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電の切り替えに必要です。macOSがパスワードを一度だけ求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전을 전환하는 데 필요하며, macOS가 암호를 한 번 요청합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para controlar o carregamento; o macOS pede sua senha uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужна для переключения зарядки; macOS один раз запросит пароль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换充电时需要；macOS 会要求你输入一次密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換充電時需要；macOS 只會要求輸入一次密碼。"
          }
        }
      }
    },
    "Needs Accessibility access": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt Zugriff auf Bedienungshilfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita acceso de Accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite l’accès Accessibilité"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede l'accesso Accessibilità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティへのアクセスが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한 필요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer acesso de Acessibilidade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение «Универсальный доступ»"
          }
        },
