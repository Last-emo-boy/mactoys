    "Remap a key (⇪ → esc, Right ⌘ → F18) or a shortcut (⌥⇧K → ⌘⇧K in Xcode, ⌃⌥E → your email address).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Taste (⇪ → esc, Rechts ⌘ → F18) oder einen Kurzbefehl (⌥⇧K → ⌘⇧K in Xcode, ⌃⌥E → eigene E-Mail-Adresse) neu belegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasigna una tecla (⇪ → esc, ⌘ derecha → F18) o un atajo (⌥⇧K → ⌘⇧K en Xcode, ⌃⌥E → tu dirección de correo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réaffectez une touche (⇪ → Échap, ⌘ droite → F18) ou un raccourci (⌥⇧K → ⌘⇧K dans Xcode, ⌃⌥E → votre adresse e-mail)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimappa un tasto (⇪ → esc, ⌘ destro → F18) o un'abbreviazione (⌥⇧K → ⌘⇧K in Xcode, ⌃⌥E → il tuo indirizzo email)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー（⇪ → esc、右⌘ → F18）またはショートカット（Xcodeで⌥⇧K → ⌘⇧K、⌃⌥E → 自分のメールアドレス）をリマップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키(⇪ → esc, 오른쪽 ⌘ → F18) 또는 단축키(Xcode에서 ⌥⇧K → ⌘⇧K, ⌃⌥E → 이메일 주소)를 재매핑합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remapeie uma tecla (⇪ → esc, ⌘ direita → F18) ou um atalho (⌥⇧K → ⌘⇧K no Xcode, ⌃⌥E → seu endereço de e-mail)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переназначьте клавишу (⇪ → esc, правый ⌘ → F18) или сочетание клавиш (⌥⇧K → ⌘⇧K в Xcode, ⌃⌥E → ваш адрес электронной почты)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重映射按键（⇪ → esc，右 ⌘ → F18）或快捷键（在 Xcode 中 ⌥⇧K → ⌘⇧K，⌃⌥E → 你的电子邮件地址）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新對應按鍵（⇪ → esc、右側 ⌘ → F18）或快速鍵（在 Xcode 中 ⌥⇧K → ⌘⇧K、⌃⌥E → 你的電子郵件地址）。"
          }
        }
      }
    },
