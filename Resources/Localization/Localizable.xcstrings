            "state": "translated",
            "value": "バッテリーが温かいため充電を一時停止中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 온도가 높아 충전 일시 정지됨"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
