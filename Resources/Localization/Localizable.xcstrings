            "state": "translated",
            "value": "Haz clic en la muesca para abrir el espejo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur l’encoche pour ouvrir le miroir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチをクリックしてミラーを開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
