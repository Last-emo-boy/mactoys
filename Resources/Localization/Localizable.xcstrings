    "Declined and canceled events are left out. New calendars are shown until you turn them off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgelehnte und abgesagte Ereignisse werden ausgelassen. Neue Kalender werden angezeigt, bis sie ausgeschaltet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omiten los eventos rechazados y cancelados. Los calendarios nuevos se muestran hasta que los desactives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements refusés et annulés sont omis. Les nouveaux calendriers sont affichés jusqu’à ce que vous les désactiviez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞退したイベントとキャンセルされたイベントは除外されます。新しいカレンダーは、オフにするまで表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거절하거나 취소된 이벤트는 제외됩니다. 새 캘린더는 끌 때까지 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos recusados e cancelados ficam de fora. Novos calendários são mostrados até você desativá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклоненные и отмененные события не показываются. Новые календари показываются, пока вы их не выключите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝和已取消的日程不会显示。新日历会一直显示，直到你将其关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒絕和已取消的行程不會顯示。新的行事曆會顯示，直到你將其關閉。"
          }
        }
      }
    },
