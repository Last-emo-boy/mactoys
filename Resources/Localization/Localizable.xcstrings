    "Tile every window automatically as it opens, with a layout for each display.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Fenster beim Öffnen automatisch kacheln, mit einem Layout für jedes Display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon en mosaico cada ventana automáticamente al abrirse, con una distribución para cada pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez chaque fenêtre en mosaïque automatiquement dès son ouverture, avec une disposition pour chaque écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affianca automaticamente ogni finestra appena si apre, con un layout per ogni monitor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いたウインドウをすべて自動的にタイル表示します。レイアウトはディスプレイごとに設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 열릴 때마다 디스플레이별 레이아웃으로 자동 타일링합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize cada janela automaticamente assim que ela abre, com um layout para cada monitor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически размещайте каждое открываемое окно мозаикой, со своим макетом для каждого дисплея."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口打开时自动平铺，每台显示器各有一个布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每個視窗打開時自動並排，每台顯示器各有一個佈局。"
          }
        }
      }
    },
