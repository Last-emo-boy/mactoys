    "Keep your Mac awake on demand, without touching Energy settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Mac bei Bedarf wach halten, ohne die Energieeinstellungen zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu Mac activo cuando quieras, sin tocar los ajustes de Energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez votre Mac éveillé à la demande, sans toucher aux réglages d’énergie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni attivo il Mac quando vuoi, senza toccare le impostazioni Energia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "省エネルギー設定を変更せずに、必要なときにMacをスリープさせないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에너지 설정을 건드리지 않고 필요할 때 Mac을 깨어 있게 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha seu Mac ativo quando quiser, sem mexer nos ajustes de Energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давайте Mac засыпать, когда нужно, не меняя настройки энергосбережения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按需让你的 Mac 保持唤醒，无需更改“节能”设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨需讓你的 Mac 保持喚醒，不會更動「能源」設定。"
          }
        }
      }
    },
    "Keep your MacBook's battery between limits you choose to slow its aging.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Batterie des MacBook zwischen selbst gewählten Grenzen halten, um ihre Alterung zu verlangsamen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la batería de tu MacBook entre los límites que elijas para ralentizar su envejecimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la batterie de votre MacBook entre les limites de votre choix pour ralentir son vieillissement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni la batteria del MacBook tra limiti a tua scelta per rallentarne l'invecchiamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBookのバッテリーを選択した範囲内に保ち、劣化を遅らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBook 배터리를 원하는 한도 사이로 유지하여 노화를 늦춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a bateria do MacBook entre limites que você escolhe para retardar o envelhecimento dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживайте заряд аккумулятора MacBook в выбранных пределах, чтобы замедлить его износ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 MacBook 电池电量保持在你选择的范围内，以减缓电池老化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 MacBook 的電池維持在你選擇的範圍內，以減緩老化。"
          }
        }
      }
    },
    "Keeping this Mac awake": {
      "localizations": {
        "de": {
          "stringUnit": {
