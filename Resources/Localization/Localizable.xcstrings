    "One app name or bundle identifier per line.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一個 App 名稱或 Bundle 識別碼。"
          }
        }
      }
    },
    "One click both brings the window forward and presses what you clicked": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下即可將視窗移到前面，同時按下你所點按的項目"
          }
