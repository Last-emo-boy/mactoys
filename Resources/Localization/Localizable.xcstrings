    "Top puts them after the header comments; bottom at the end of the file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Oben“ platziert sie nach den Kopfkommentaren, „Unten“ am Ende der Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba las coloca tras los comentarios de cabecera; Abajo, al final del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En haut les place après les commentaires d’en-tête ; En bas, à la fin du fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In alto le inserisce dopo i commenti di intestazione; in basso alla fine del file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“上”ではヘッダコメントのあとに、“下”ではファイルの末尾に追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단은 헤더 주석 다음에, 하단은 파일 끝에 배치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em cima as coloca após os comentários de cabeçalho; Embaixo, no fim do arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Вверху» — после комментариев заголовка; «Внизу» — в конце файла."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“顶部”会将它们放在头部注释之后；“底部”会放在文件末尾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「頂部」會將其放在標頭註解之後；「底部」則放在檔案結尾。"
          }
        }
      }
    },
