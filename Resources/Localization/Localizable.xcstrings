    "Apps appear here while they play sound. Pin an app to keep it listed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps erscheinen hier, während sie Ton wiedergeben. Eine App anheften, damit sie in der Liste bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps aparecen aquí mientras reproducen sonido. Fija una app para que siga en la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps apparaissent ici lorsqu’elles émettent du son. Épinglez une app pour la garder dans la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app compaiono qui mentre riproducono audio. Fissa un'app per mantenerla nell'elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウンドを再生中のAppがここに表示されます。Appをピン留めすると表示されたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사운드를 재생하는 동안 앱이 여기에 표시됩니다. 앱을 고정하면 목록에 계속 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps aparecem aqui enquanto reproduzem som. Fixe um app para mantê-lo na lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения появляются здесь, пока воспроизводят звук. Закрепите приложение, чтобы оно оставалось в списке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 播放声音时会显示在这里。固定某个 App 可使其保留在列表中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 播放聲音時會顯示在這裡。釘選 App 即可讓它保留在列表中。"
          }
        }
      }
    },
