    "Quick Accent has nothing to offer until you choose at least one set.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnellakzent hat nichts anzubieten, solange nicht mindestens ein Satz ausgewählt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acento rápido no tiene nada que ofrecer hasta que elijas al menos un conjunto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accent rapide n’a rien à proposer tant que vous n’avez pas choisi au moins un jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accento rapido non ha nulla da proporre finché non scegli almeno un set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイックアクセントでは、セットを1つ以上選択するまで候補が表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
