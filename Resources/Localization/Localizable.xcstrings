          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSに組み込まれた上限: %1$@〜%2$@。“バッテリー”設定で設定します。インストールは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에 내장된 한도: %1$@–%2$@, 배터리 설정에서 설정합니다. 설치할 것이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite integrado ao macOS: %1$@–%2$@, definido nos ajustes de Bateria. Nada para instalar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенное в macOS ограничение: %1$@–%2$@, задается в настройках аккумулятора. Ничего устанавливать не нужно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
