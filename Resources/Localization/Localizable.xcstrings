    "Apps keep running behind it and windows never move. No permissions needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps laufen dahinter weiter, und Fenster bewegen sich nie. Keine Berechtigungen erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps siguen funcionando detrás y las ventanas no se mueven. No necesita permisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps continuent de fonctionner derrière et les fenêtres ne bougent jamais. Aucune autorisation requise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app continuano a funzionare dietro e le finestre non si spostano mai. Non servono autorizzazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背後でAppは実行されたままで、ウインドウも移動しません。アクセス許可は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 뒤에서 앱은 계속 실행되며 윈도우는 움직이지 않습니다. 권한이 필요하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps continuam em execução por trás e as janelas nunca se movem. Nenhuma permissão necessária."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения продолжают работать за ним, окна не перемещаются. Разрешения не требуются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 在其后方继续运行，窗口也不会移动。无需任何权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 會在其背後繼續執行，視窗也不會移動。不需要任何權限。"
          }
        }
      }
    },
