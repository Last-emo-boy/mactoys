    "Hold files, text and links on a floating shelf while you switch apps, then drag them out together.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, Text und Links in einer schwebenden Ablage sammeln, während die App gewechselt wird, und dann gemeinsam herausziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda archivos, texto y enlaces en una bandeja flotante mientras cambias de app y luego arrástralos todos juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez des fichiers, du texte et des liens sur une étagère flottante pendant que vous changez d’app, puis faites-les glisser ensemble vers l’extérieur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni file, testo e link su uno scaffale mobile mentre cambi app, poi trascinali fuori insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appを切り替える間、ファイル、テキスト、リンクをフローティングシェルフに置いておき、まとめてドラッグして取り出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 전환하는 동안 파일, 텍스트, 링크를 떠 있는 선반에 보관했다가 한꺼번에 드래그하여 꺼냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde arquivos, texto e links em uma prateleira flutuante enquanto alterna entre apps e depois arraste-os juntos para fora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите файлы, текст и ссылки на плавающей полке, пока переключаетесь между приложениями, а затем перетяните их все вместе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换 App 时将文件、文本和链接暂存在浮动的文件架上，然后一起拖出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換 App 時將檔案、文字和連結暫放在浮動的檔案架上，然後一起拖出。"
          }
        }
      }
    },
