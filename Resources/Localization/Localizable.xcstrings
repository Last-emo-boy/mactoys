    "Text and images go to every Mac; a copied file goes to the Mac you move to.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text und Bilder gehen an alle Macs; eine kopierte Datei geht an den Mac, zu dem gewechselt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto y las imágenes van a todos los Mac; un archivo copiado va al Mac al que te mueves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte et les images vont sur tous les Mac ; un fichier copié va sur le Mac vers lequel vous vous déplacez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo e immagini vanno a tutti i Mac; un file copiato va al Mac su cui ti sposti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストと画像はすべてのMacに送られます。コピーしたファイルは移動先のMacに送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트와 이미지는 모든 Mac으로 전송되며, 복사한 파일은 이동한 Mac으로 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Textos e imagens vão para todos os Macs; um arquivo copiado vai para o Mac para o qual você se move."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст и изображения передаются на все Mac; скопированный файл — на тот Mac, на который вы переходите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本和图像会发送到所有 Mac；拷贝的文件会发送到你移入的 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
