    "Higher rates are smoother and use more energy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhere Frequenzen wirken flüssiger und verbrauchen mehr Energie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las frecuencias más altas son más fluidas y consumen más energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fréquences plus élevées sont plus fluides et consomment plus d’énergie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レートを高くすると滑らかになりますが、消費電力が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생률이 높을수록 더 부드럽지만 에너지를 더 많이 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxas mais altas são mais suaves e usam mais energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем выше частота, тем плавнее изображение и выше энергопотребление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新率越高越流畅，但耗电更多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新頻率越高越流暢，但會耗用更多電力。"
          }
        }
      }
    },
    "Higher rates look smoother and use more energy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhere Raten wirken flüssiger und verbrauchen mehr Energie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las frecuencias más altas se ven más fluidas y consumen más energía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fréquence plus élevée est plus fluide et consomme plus d’énergie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequenze più alte appaiono più fluide e consumano più energia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レートを上げると動きが滑らかになりますが、消費電力が増えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도가 높을수록 부드러워 보이지만 에너지를 더 많이 사용합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxas maiores ficam mais suaves e usam mais energia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем выше частота, тем плавнее движение и тем больше расход энергии"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新率越高越流畅，耗电也越多"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "速率越高看起來越流暢，但會耗用更多電力"
          }
        }
      }
    },
    "Higher reacts to shorter swipes and smaller pinches": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher reagiert auf kürzeres Wischen und kleineres Zusammenziehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un valor más alto, reacciona a deslizamientos más cortos y pellizcos más pequeños"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus élevée, réagit à des balayages plus courts et à des pincements plus petits"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valore più alto reagisce a scorrimenti più brevi e pizzichi più piccoli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高くするほど、短いスワイプや小さなピンチに反応します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높을수록 더 짧게 쓸어넘기거나 더 작게 오므려도 반응함"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores mais altos reagem a deslizes mais curtos e movimentos de pinça menores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем выше, тем на более короткие смахивания и слабые сведения пальцев реагирует жест"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越高，对更短的轻扫和更小的捏合越敏感"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數值越高，對較短的滑動和較小的捏合越靈敏"
          }
        }
      }
    },
    "Higher values forgive gradients and shadows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhere Werte tolerieren Verläufe und Schatten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores más altos toleran degradados y sombras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des valeurs plus élevées tolèrent mieux les dégradés et les ombres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori più alti tollerano sfumature e ombre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値を大きくすると、グラデーションや影を許容します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값이 클수록 그라디언트와 그림자를 더 많이 허용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores maiores toleram degradês e sombras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более высокие значения терпимее к градиентам и теням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "值越高，对渐变和阴影的容忍度越高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數值越高，越能容許漸層和陰影。"
          }
        }
      }
    },
