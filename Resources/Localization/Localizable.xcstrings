    "Download %@ and %@ in Language & Region › Translation Languages to translate on this Mac.": {
      "comment": "Both %@ are language names",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und %2$@ unter „Sprache & Region › Übersetzungssprachen“ laden, um auf diesem Mac zu übersetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Download %1$@ and %2$@ in Language & Region › Translation Languages to translate on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga %1$@ y %2$@ en Idioma y región › Idiomas de traducción para traducir en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez les langues %1$@ et %2$@ dans Langue et région › Langues de traduction pour traduire sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica %1$@ e %2$@ in Lingua e zona › Lingue di traduzione per tradurre su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacで翻訳するには、“言語と地域” › “翻訳言語”で%1$@と%2$@をダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 번역하려면 언어 및 지역 › 번역 언어에서 %1$@ 및 %2$@을(를) 다운로드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe %1$@ e %2$@ em Idioma e Região › Idiomas de Tradução para traduzir neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы переводить на этом Mac, загрузите языки в разделе «Язык и регион» › «Языки перевода»: %1$@ и %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在语言与地区 › 翻译语言中下载 %1$@ 和 %2$@，以便在此 Mac 上翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「語言與地區」›「翻譯語言」中下載 %1$@ 和 %2$@，即可在此 Mac 上翻譯。"
          }
        }
      }
    },
