    "Copies aren’t recorded until you resume.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zum Fortsetzen werden keine Kopien aufgezeichnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que copies no se registra hasta que reanudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies ne sont pas enregistrées tant que vous ne reprenez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie non vengono registrate finché non riprendi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開するまでコピーは記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재개할 때까지 복사한 내용이 기록되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias não são registradas até você retomar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирования не записываются, пока вы не возобновите запись."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复前不会记录拷贝的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你繼續之前，不會記錄拷貝的內容。"
          }
        }
      }
    },
    "Copies go to ~/Library/Application Support/MacToys/Hosts.": {
      "localizations": {
