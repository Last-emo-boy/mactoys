        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToysが、充電のオン/オフを切り替える充電ヘルパーをインストールしようとしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys에서 충전을 켜고 끄는 충전 도우미를 설치하려고 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
