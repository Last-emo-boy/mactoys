    "Scroll or ↑ ↓ to change the level; click to draw; Esc or right-click to leave.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri o usa ↑ ↓ per cambiare il livello; fai clic per disegnare; Esc o clic destro per uscire."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤하거나 ↑ ↓로 배율을 변경하고, 클릭하여 그리고, Esc 또는 오른쪽 클릭으로 나갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role ou use ↑ ↓ para alterar o nível; clique para desenhar; Esc ou clique com o botão direito para sair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动或按 ↑ ↓ 可更改缩放级别；点按可绘图；按 Esc 或右键点按可离开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捲動或按 ↑ ↓ 可更改縮放程度；按一下即可繪圖；按 Esc 或按一下右鍵即可離開。"
          }
        }
      }
    },
    "Scroll over the icon to change brightness.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri sull'icona per cambiare la luminosità."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 위에서 스크롤하여 밝기를 변경합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role sobre o ícone para alterar o brilho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图标上滚动可更改亮度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在圖像上捲動即可更改亮度。"
          }
        }
      }
    },
    "Scroll to zoom the loupe, use the arrow keys to move one pixel, press Esc to cancel.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per ingrandire la lente, usa i tasti freccia per spostarti di un pixel, premi Esc per annullare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤하여 돋보기를 확대/축소하고, 화살표 키로 1픽셀씩 이동하며, Esc를 눌러 취소합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role para ampliar a lupa, use as teclas de seta para mover um pixel, pressione Esc para cancelar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动可缩放放大镜，使用方向键移动一个像素，按 Esc 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捲動以縮放放大鏡，使用方向鍵一次移動一個像素，按 Esc 取消。"
          }
        }
      }
    },
