    "Shortcuts must end with a non-modifier key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle müssen mit einer Taste enden, die keine Sondertaste ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos deben terminar con una tecla que no sea modificadora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis doivent se terminer par une touche autre qu’un modificateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le abbreviazioni devono terminare con un tasto non modificatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットは修飾キー以外のキーで終わる必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키는 보조 키가 아닌 키로 끝나야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos devem terminar com uma tecla não modificadora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание клавиш должно заканчиваться клавишей, которая не является модификатором."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键必须以非修饰键结尾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵必須以非修飾鍵結尾。"
          }
        }
      }
    },
    "Shortcuts must include at least one modifier (⌃ ⌥ ⇧ ⌘ fn).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle müssen mindestens eine Sondertaste enthalten (⌃ ⌥ ⇧ ⌘ fn)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos deben incluir al menos una tecla modificadora (⌃ ⌥ ⇧ ⌘ fn)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis doivent inclure au moins un modificateur (⌃ ⌥ ⇧ ⌘ fn)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le abbreviazioni devono includere almeno un modificatore (⌃ ⌥ ⇧ ⌘ fn)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットには1つ以上の修飾キー（⌃ ⌥ ⇧ ⌘ fn）が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키에는 보조 키(⌃ ⌥ ⇧ ⌘ fn)가 하나 이상 포함되어야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos devem incluir pelo menos um modificador (⌃ ⌥ ⇧ ⌘ fn)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание клавиш должно включать хотя бы один модификатор (⌃ ⌥ ⇧ ⌘ fn)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键必须至少包含一个修饰键（⌃ ⌥ ⇧ ⌘ fn）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵必須至少包含一個修飾鍵（⌃ ⌥ ⇧ ⌘ fn）。"
          }
        }
      }
    },
