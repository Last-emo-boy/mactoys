            "value": "点按太阳图标即可打开浮动面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下太陽即可打開浮出視窗。"
          }
        }
      }
    },
    "Click to cancel": {
      "comment": "Self-timer countdown before a screenshot",
      "localizations": {
