          }
        }
      }
    },
    "Allow MacToys in System Settings › Privacy & Security › Screen & System Audio Recording, under System Audio Recording Only. Until then, apps play as usual.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys in „Systemeinstellungen › Datenschutz & Sicherheit › Bildschirm- & Systemaudioaufnahme“ unter „Nur Systemaudioaufnahme“ erlauben. Bis dahin spielen Apps wie gewohnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite MacToys en Ajustes del Sistema › Privacidad y seguridad › Grabación de pantalla y audio del sistema, en “Solo grabación de audio del sistema”. Hasta entonces, las apps suenan como siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacToys dans Réglages Système › Confidentialité et sécurité › Enregistrement de l’écran et de l’audio système, sous Enregistrement de l’audio système uniquement. D’ici là, le son des apps reste inchangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti MacToys in Impostazioni di Sistema › Privacy e sicurezza › Registrazione schermo e audio di sistema, sotto Solo registrazione audio di sistema. Fino ad allora, l'audio delle app non cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“システム設定” › “プライバシーとセキュリティ” › “画面収録とシステムオーディオ録音”の“システムオーディオ録音のみ”でMacToysを許可してください。許可されるまで、Appは通常どおり再生されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 › 개인정보 보호 및 보안 › 화면 및 시스템 오디오 기록의 ‘시스템 오디오 기록 전용’에서 MacToys를 허용하세요. 그 전까지는 앱이 평소처럼 재생됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o MacToys em Ajustes do Sistema › Privacidade e Segurança › Gravação de Tela e Áudio do Sistema, em Somente Gravação de Áudio do Sistema. Até lá, os apps reproduzem som normalmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите MacToys в Системных настройках › Конфиденциальность и безопасность › Запись экрана и системного аудио, в разделе «Только запись системного аудио». До этого приложения звучат как обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 › 隐私与安全性 › 录屏与系统录音的“仅系统录音”下允许 MacToys。在此之前，App 会照常播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定」›「隱私權與安全性」›「螢幕與系統音訊錄製」的「僅限系統音訊錄製」下允許 MacToys。在此之前，App 會照常播放。"
          }
        }
      }
    },
    "Allow MacToys in System Settings › Privacy & Security › Screen & System Audio Recording. Until then, apps play as usual.": {
      "localizations": {
