    "Zoom in, draw, time breaks, record and snip — each with its own shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzoomen, zeichnen, Pausen timen, aufnehmen und Ausschnitte erstellen – jeweils mit eigenem Kurzbefehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplía, dibuja, cronometra descansos, graba y recorta — cada función con su propio atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomez, dessinez, chronométrez les pauses, enregistrez et capturez — chacun avec son propre raccourci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrandisci, disegna, cronometra le pause, registra e ritaglia, ognuno con la propria abbreviazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズームイン、描画、休憩タイマー、収録、切り取り — それぞれに専用のショートカットがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대, 그리기, 휴식 타이머, 기록 및 캡처 — 각각 고유한 단축키가 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplie, desenhe, cronometre pausas, grave e recorte — cada um com seu próprio atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличение, рисование, таймер перерывов, запись и снимки — у каждой функции свое сочетание клавиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大、绘图、休息计时、录制和截图 — 各有其快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大、繪圖、休息計時、錄製和截取 — 每項功能都有自己的快速鍵。"
          }
        }
      }
    },
