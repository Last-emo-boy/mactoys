    },
    "The toolbar opens after you hold the letter alone; the letter is replaced only if you choose a character.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Symbolleiste erscheint, wenn der Buchstabe allein gehalten wird; der Buchstabe wird nur ersetzt, wenn ein Zeichen gewählt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de herramientas se abre cuando mantienes pulsada solo la letra; la letra solo se sustituye si eliges un carácter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d’outils s’ouvre quand vous maintenez la lettre seule ; la lettre n’est remplacée que si vous choisissez un caractère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra strumenti si apre dopo aver tenuto premuta la sola lettera; la lettera viene sostituita solo se scegli un carattere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字キーを単独で押したままにするとツールバーが開きます。文字は、別の文字を選択した場合にのみ置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자만 길게 누르면 도구 막대가 열리며, 문자를 선택한 경우에만 글자가 대체됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de ferramentas abre depois que você segura a letra sozinha; a letra só é substituída se você escolher um caractere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель открывается, если удерживать одну букву; буква заменяется, только если вы выберете символ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独按住字母后工具栏才会打开；只有选取字符时才会替换该字母。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單獨按住字母後工具列就會打開；只有在你選擇字元時才會取代該字母。"
          }
        }
      }
    },
