    "No display with a camera notch is connected. These settings apply when one is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Display mit Kamera-Notch angeschlossen. Diese Einstellungen gelten, sobald eines angeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay conectada ninguna pantalla con muesca para la cámara. Estos ajustes se aplicarán cuando haya una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun écran avec encoche pour caméra n’est connecté. Ces réglages s’appliquent lorsqu’il y en a un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è collegato nessun monitor con la tacca della fotocamera. Queste impostazioni si applicano quando ce n'è uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラのノッチがあるディスプレイが接続されていません。これらの設定は接続時に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 노치가 있는 디스플레이가 연결되어 있지 않습니다. 이 설정은 연결되었을 때 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum monitor com entalhe da câmera está conectado. Estes ajustes valem quando houver um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дисплей с вырезом для камеры не подключен. Эти настройки применяются, когда он подключен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接带摄像头刘海的显示器。连接后这些设置才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未連接具有相機瀏海的顯示器。連接後才會套用這些設定。"
          }
        }
      }
    },
