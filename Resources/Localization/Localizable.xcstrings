    "Hover a shortcut in the guide and click the pin to keep it at the top for that app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Übersicht auf einen Kurzbefehl zeigen und auf die Stecknadel klicken, um ihn für diese App oben zu halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el puntero sobre un atajo de la guía y haz clic en la chincheta para mantenerlo arriba en esa app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survolez un raccourci dans le guide et cliquez sur l’épingle pour le garder en haut pour cette app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa sopra un'abbreviazione nella guida e fai clic sulla puntina per tenerla in cima per quell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイドでショートカットにポインタを合わせてピンをクリックすると、そのAppで常に先頭に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드에서 단축키 위에 포인터를 올리고 핀을 클릭하면 해당 앱에서 맨 위에 고정됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o ponteiro sobre um atalho no guia e clique no alfinete para mantê-lo no topo para esse app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите указатель на сочетание клавиш в руководстве и нажмите булавку, чтобы закрепить его вверху для этого приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针悬停在指南中的快捷键上，然后点按图钉，即可将其固定在该 App 的顶部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在指南中將指標停留在快速鍵上，然後按一下圖釘，即可將其保留在該 App 的最上方。"
          }
        }
      }
    },
