          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma janela sobre outra para trocá-las"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетяните окно на другое, чтобы поменять их местами"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将一个窗口拖到另一个窗口上即可交换位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將視窗拖移到另一個視窗上即可交換位置"
          }
        }
      }
    },
    "Drag a window to a screen edge to tile it": {
      "comment": "Menu bar switch detail for FancyZones edge snap",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fenster an einen Bildschirmrand ziehen, um es zu kacheln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una ventana a un borde de la pantalla para ponerla en mosaico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une fenêtre vers un bord de l’écran pour la placer en mosaïque"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina una finestra su un bordo dello schermo per affiancarla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを画面の端にドラッグしてタイル表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 화면 가장자리로 드래그하여 타일링"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma janela até uma borda da tela para organizá-la"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетяните окно к краю экрана, чтобы разместить его"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将窗口拖到屏幕边缘以平铺"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將視窗拖移到螢幕邊緣即可並排"
          }
        }
      }
    },
    "Drag across cells to place the window over them": {
      "comment": "Accessibility: how to use the Window Controls grid",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Zellen ziehen, um das Fenster darauf zu platzieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra sobre las celdas para colocar la ventana encima"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser sur des cellules pour y placer la fenêtre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina sulle celle per posizionarvi sopra la finestra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セルをまたいでドラッグすると、ウインドウをそのセルに配置します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셀을 가로질러 드래그하면 윈도우가 해당 셀에 배치됨"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste pelas células para posicionar a janela sobre elas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по ячейкам, чтобы разместить окно поверх них"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在单元格上拖移，将窗口放置在这些单元格上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移跨越格子，即可將視窗放在這些格子上"
          }
        }
      }
    },
    "Drag across empty space to draw a zone · drag zones to move · ⌘ turns snapping off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über leere Fläche ziehen, um eine Zone zu zeichnen · Zonen zum Bewegen ziehen · ⌘ schaltet das Einrasten aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra en un espacio vacío para dibujar una zona · arrastra las zonas para moverlas · ⌘ desactiva el ajuste"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser dans un espace vide pour tracer une zone · faites glisser les zones pour les déplacer · ⌘ désactive l’ancrage"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina nello spazio vuoto per disegnare una zona · trascina le zone per spostarle · ⌘ disattiva l'aggancio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空いている場所をドラッグしてゾーンを描画 · ゾーンをドラッグして移動 · ⌘でスナップをオフ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 공간을 드래그하여 영역 그리기 · 영역을 드래그하여 이동 · ⌘ 키로 스냅 끄기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste em um espaço vazio para desenhar uma zona · arraste as zonas para movê-las · ⌘ desativa o encaixe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по пустому месту, чтобы нарисовать зону · перетягивайте зоны, чтобы переместить · ⌘ отключает привязку"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在空白处拖移以绘制区域 · 拖移区域以移动 · ⌘ 关闭吸附"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在空白處拖移以繪製區域 · 拖移區域以移動 · ⌘ 關閉貼齊"
          }
        }
      }
    },
    "Drag across the grid to size the window to those cells, or pick a half, a third or a custom size. Keyboard mode does the same with arrows and number keys.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über das Raster ziehen, um das Fenster an diese Zellen anzupassen, oder eine Hälfte, ein Drittel oder eine eigene Größe wählen. Der Tastaturmodus macht dasselbe mit Pfeil- und Zifferntasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra sobre la cuadrícula para ajustar la ventana a esas celdas o elige una mitad, un tercio o un tamaño personalizado. El modo teclado hace lo mismo con las flechas y las teclas numéricas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser sur la grille pour donner à la fenêtre la taille de ces cellules, ou choisissez une moitié, un tiers ou une taille personnalisée. Le mode clavier fait de même avec les flèches et les touches numériques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina sulla griglia per adattare la finestra a quelle celle, oppure scegli una metà, un terzo o una dimensione personalizzata. La modalità tastiera fa lo stesso con le frecce e i tasti numerici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッドをドラッグしてウインドウをそのセルのサイズにするか、1/2、1/3、またはカスタムサイズを選択します。キーボードモードでは矢印キーと数字キーで同じ操作ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "격자를 가로질러 드래그하여 윈도우를 해당 셀 크기로 조절하거나 절반, 1/3 또는 사용자 설정 크기를 선택하세요. 키보드 모드에서는 화살표와 숫자 키로 같은 작업을 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste pela grade para dimensionar a janela a essas células ou escolha uma metade, um terço ou um tamanho personalizado. O modo teclado faz o mesmo com as setas e as teclas numéricas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по сетке, чтобы подогнать окно под эти ячейки, или выберите половину, треть или свой размер. В режиме клавиатуры то же самое делается стрелками и цифровыми клавишами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在网格上拖移可将窗口调整为这些单元格的大小，也可以选取二分之一、三分之一或自定大小。键盘模式下可用方向键和数字键完成相同操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在網格上拖移即可將視窗調整為這些格子的大小，或選擇二分之一、三分之一或自訂大小。鍵盤模式則使用方向鍵和數字鍵達到相同效果。"
          }
        }
      }
    },
    "Drag across the grid, or pick a size": {
      "comment": "Window Controls palette hint",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über das Raster ziehen oder eine Größe wählen"
          }
        },
        "es": {
          "stringUnit": {
