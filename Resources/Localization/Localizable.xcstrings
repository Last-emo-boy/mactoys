    "MacToys isn't allowed to control System Events. Turn it on in System Settings › Privacy & Security › Automation › MacToys.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys darf System Events nicht steuern. In „Systemeinstellungen › Datenschutz & Sicherheit › Automation › MacToys“ aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys no tiene permiso para controlar System Events. Actívalo en Ajustes del Sistema › Privacidad y seguridad › Automatización › MacToys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys n’est pas autorisé à contrôler System Events. Activez-le dans Réglages Système › Confidentialité et sécurité › Automatisation › MacToys."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys non ha il permesso di controllare System Events. Attivalo in Impostazioni di Sistema › Privacy e sicurezza › Automazione › MacToys."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToysにSystem Eventsの制御が許可されていません。“システム設定” › “プライバシーとセキュリティ” › “オートメーション” › “MacToys”でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys가 System Events를 제어하도록 허용되지 않았습니다. 시스템 설정 › 개인정보 보호 및 보안 › 자동화 › MacToys에서 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MacToys não tem permissão para controlar o System Events. Ative em Ajustes do Sistema › Privacidade e Segurança › Automação › MacToys."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys не разрешено управлять System Events. Включите это в Системных настройках › Конфиденциальность и безопасность › Автоматизация › MacToys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys 不被允许控制 System Events。请在系统设置 › 隐私与安全性 › 自动化 › MacToys 中将其打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys 未獲准控制 System Events。請在「系統設定」›「隱私權與安全性」›「自動化」› MacToys 中開啟。"
          }
        }
      }
    },
