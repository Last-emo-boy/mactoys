    "Tap again to move through the characters (⇧Space or ← goes back), release the letter to type the selection. Esc cancels.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi di nuovo per scorrere i caratteri (⇧Spazio o ← torna indietro), rilascia la lettera per digitare la selezione. Esc annulla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 탭하면 문자 사이를 이동하고(⇧스페이스 바 또는 ←로 뒤로), 글자에서 손을 떼면 선택한 문자가 입력됩니다. Esc를 누르면 취소됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque novamente para percorrer os caracteres (⇧Espaço ou ← volta), solte a letra para digitar a seleção. Esc cancela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次轻按可在字符间移动（⇧空格键或 ← 返回），松开字母即可输入所选字符。按 Esc 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次點按即可在字元間移動（⇧空白鍵或 ← 返回），放開字母即可輸入所選字元。按 Esc 取消。"
          }
        }
      }
    },
    "Tap-alone keys that aren’t modifiers need a modifier to act as when held.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai tasti a pressione singola che non sono modificatori serve un modificatore da usare se tenuti premuti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 키가 아닌 단독 탭 키는 길게 누를 때 작동할 보조 키를 지정해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas tocadas sozinhas que não são modificadoras precisam de um modificador para atuar quando seguradas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独轻按的非修饰键需要指定按住时充当的修饰键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非修飾鍵的單獨點按鍵需要指定按住時作為哪個修飾鍵。"
          }
        }
      }
    },
    "Tap-alone timeout": {
