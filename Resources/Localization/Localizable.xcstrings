    "Variables here apply to every zsh and, with launchd on, to apps you open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Variablen hier gelten für jede zsh und, wenn launchd aktiviert ist, für geöffnete Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las variables de aquí se aplican a todos los zsh y, con launchd activado, a las apps que abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les variables définies ici s’appliquent à chaque zsh et, si launchd est activé, aux apps que vous ouvrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le variabili qui si applicano a ogni zsh e, con launchd attivo, alle app che apri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここの変数はすべてのzshに適用され、launchdがオンの場合は開いたAppにも適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기의 변수는 모든 zsh에 적용되며, launchd를 켜면 사용자가 여는 앱에도 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As variáveis aqui se aplicam a todo zsh e, com o launchd ativado, aos apps que você abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переменные здесь применяются ко всем оболочкам zsh и, если launchd включен, к открываемым приложениям."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处的变量适用于所有 zsh，打开 launchd 后也适用于你打开的 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處的變數會套用到每個 zsh，若開啟 launchd，也會套用到你打開的 App。"
          }
        }
      }
