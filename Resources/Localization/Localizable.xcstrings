    "This copy of MacToys can’t use Bluetooth. Connect devices from Control Center.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von MacToys kann Bluetooth nicht verwenden. Geräte über das Kontrollzentrum verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de MacToys no puede usar Bluetooth. Conecta los dispositivos desde el Centro de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie de MacToys ne peut pas utiliser le Bluetooth. Connectez les appareils depuis le Centre de contrôle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacToysではBluetoothを使用できません。コントロールセンターからデバイスを接続してください。"
