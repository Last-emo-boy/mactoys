    "These apps stay blurred wherever they show, unless they're in front.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Apps bleiben überall weichgezeichnet, wo sie erscheinen, außer sie sind vorne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas apps siguen desenfocadas dondequiera que aparezcan, salvo cuando están en primer plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces apps restent floutées partout où elles s’affichent, sauf lorsqu’elles sont au premier plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste app restano sfocate ovunque compaiano, a meno che non siano in primo piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのAppは、前面にある場合を除き、どこに表示されてもぼかされたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱들은 맨 앞에 있지 않으면 어디에 표시되든 흐리게 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes apps ficam desfocados onde quer que apareçam, a menos que estejam em primeiro plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти приложения размыты везде, где видны, если они не на переднем плане."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 App 无论显示在何处都会保持模糊，除非位于最前面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論在哪裡顯示，這些 App 都會保持模糊，除非位於最前方。"
          }
        }
      }
    },
