        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此時間後也鎖定 macOS"
          }
        }
      }
    },
    "Also mapped elsewhere: %@": {
      "comment": "The placeholder lists host names",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch anderswo zugeordnet: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También asignado en otro lugar: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aussi défini ailleurs : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Associato anche altrove: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかでも設定済み: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 곳에도 매핑됨: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também mapeado em outro lugar: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также указано в другом месте: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他位置也映射了：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也在其他位置對應：%@"
          }
        }
      }
    },
    "Also match file contents": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Dateiinhalte durchsuchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar también en el contenido de los archivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher aussi dans le contenu des fichiers"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca anche nei contenuti dei file"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの内容も照合"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 내용도 검색"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também buscar no conteúdo dos arquivos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также искать в содержимом файлов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时匹配文件内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也比對檔案內容"
          }
        }
      }
    },
    "Also offers each size at half its pixels per side, drawn twice as sharp.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bietet jede Größe auch mit halber Pixelzahl pro Seite an, doppelt so scharf dargestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También ofrece cada tamaño con la mitad de píxeles por lado, dibujado el doble de nítido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Propose aussi chaque taille avec deux fois moins de pixels par côté, affichée deux fois plus nette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各サイズについて、縦横のピクセル数を半分にして2倍の鮮明さで描画するモードも表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 크기를 변마다 픽셀을 절반으로 줄여 두 배 선명하게 그리는 모드도 제공합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também oferece cada tamanho com metade dos pixels por lado, desenhado com o dobro da nitidez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также предлагает каждый размер с вдвое меньшим числом пикселей по каждой стороне и вдвое более четкой отрисовкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时以每边一半的像素提供每种尺寸，显示清晰度提高一倍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每種大小也會提供每邊像素減半的版本，以兩倍清晰度繪製。"
          }
        }
      }
    },
    "Also starts drawing while zoomed or in Live Zoom.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet das Zeichnen auch beim Zoomen oder im Live-Zoom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También empieza a dibujar durante el zoom o en Zoom en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance aussi le dessin pendant un zoom ou en Zoom en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a disegnare anche durante lo zoom o con Live Zoom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズーム中やライブズーム中にも描画を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대 중이거나 라이브 확대 중에도 그리기를 시작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também começa a desenhar durante o zoom ou no Zoom ao Vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также начинает рисование при увеличении или в режиме Live Zoom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在缩放或实时缩放时也可开始绘图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮放中或使用即時縮放時也會開始繪圖。"
          }
        }
      }
    },
    "Also tells you once when shown hidden items don't all fit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet sich auch einmal, wenn eingeblendete Objekte nicht alle Platz finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También te avisa una vez cuando los ítems ocultos que se muestran no caben todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous prévient aussi une fois lorsque les éléments masqués affichés ne tiennent pas tous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisa anche una volta quando gli elementi nascosti mostrati non entrano tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示した非表示項目がすべて収まらない場合にも一度通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시한 숨겨진 항목이 모두 들어가지 않으면 한 번 알려 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também avisa uma vez quando os itens ocultos exibidos não cabem todos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также один раз сообщает, если показанные скрытые объекты не помещаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示的隐藏项目放不下时，也会提示你一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示的隱藏項目放不下時，也會告知你一次。"
          }
        }
      }
    },
    "Also used by another shortcut": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auch von einem anderen Kurzbefehl verwendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También lo usa otro atajo"
          }
        },
