    "Usually 80–95% smaller. The video is saved next to the GIF.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meist 80–95 % kleiner. Das Video wird neben dem GIF gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suele reducir un 80–95 % su tamaño. El vídeo se guarda junto al GIF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Généralement 80 à 95 % plus légère. La vidéo est enregistrée à côté du GIF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito riduce le dimensioni dell'80–95% senza toccare la GIF: il video viene salvato accanto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常は80〜95 %小さくなります。ビデオはGIFの横に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보통 80–95 % 더 작습니다. 비디오는 GIF 옆에 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Geralmente reduz em 80–95% seu tamanho. O vídeo é salvo ao lado do GIF."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно на 80–95 % меньше. Видео сохраняется рядом с GIF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常会缩小 80–95 %。视频存储在 GIF 旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通常會小 80–95 %。影片會儲存在 GIF 旁邊。"
          }
        }
      }
    },
