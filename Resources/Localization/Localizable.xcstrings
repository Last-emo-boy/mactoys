          }
        }
      }
    },
    "A page with the document's headings and text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Seite mit den Überschriften und dem Text des Dokuments"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página con los encabezados y el texto del documento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page avec les titres et le texte du document"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pagina con i titoli e il testo del documento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類の見出しとテキストを含むページ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서의 제목과 텍스트가 담긴 페이지"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma página com os títulos e o texto do documento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница с заголовками и текстом документа"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含文稿标题和文本的页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含文件標題與文字的頁面"
          }
        }
      }
    },
    "A preview of all displays: click to move the pointer there. 1–9 pick a display, ← → cycle, Home/End first/last, P primary.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vorschau aller Displays: Klicken bewegt den Zeiger dorthin. 1–9 wählt ein Display, ← → wechselt, Pos1/Ende erstes/letztes, P Hauptdisplay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vista previa de todas las pantallas: haz clic para mover el puntero allí. 1–9 eligen una pantalla, ← → las recorren, Inicio/Fin la primera/última, P la principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aperçu de tous les écrans : cliquez pour y déplacer le pointeur. 1–9 choisissent un écran, ← → les parcourent, Début/Fin le premier/dernier, P le principal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'anteprima di tutti i monitor: fai clic per spostarvi il puntatore. 1–9 scelgono un monitor, ← → li scorrono, Home/Fine primo/ultimo, P principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのディスプレイのプレビュー。クリックするとポインタがそこに移動します。1〜9でディスプレイを選択、← →で切り替え、Home/Endで最初/最後、Pでメインディスプレイ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 디스플레이 미리보기: 클릭하면 포인터가 그곳으로 이동합니다. 1–9로 디스플레이 선택, ← →로 순환, Home/End로 처음/마지막, P로 주 디스플레이."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma prévia de todos os monitores: clique para mover o ponteiro até lá. 1–9 escolhem um monitor, ← → alternam, Home/End primeiro/último, P principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превью всех дисплеев: нажмите, чтобы переместить туда указатель. 1–9 — выбор дисплея, ← → — перебор, Home/End — первый/последний, P — основной."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有显示器的预览：点按即可将指针移到那里。1–9 选择显示器，← → 循环切换，Home/End 切换到第一个/最后一个，P 切换到主显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有顯示器的預覽：按一下即可將指標移到該處。1–9 選擇顯示器，← → 循環切換，Home/End 第一台/最後一台，P 主顯示器。"
          }
        }
      }
    },
    "A quick launcher with plugin keywords: = calculator, > shell, // URLs, < windows and more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schnellstarter mit Plug-in-Schlüsselwörtern: = Rechner, > Shell, // URLs, < Fenster und mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lanzador rápido con palabras clave de complementos: = calculadora, > shell, // URL, < ventanas y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lanceur rapide avec mots-clés de modules : = calculatrice, > shell, // URL, < fenêtres et plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'app di avvio rapido con parole chiave per i plugin: = calcolatrice, > shell, // URL, < finestre e altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインキーワードを使えるクイックランチャー: =で計算機、>でシェル、//でURL、<でウインドウなど。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인 키워드를 지원하는 빠른 실행기: = 계산기, > 셸, // URL, < 윈도우 등."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um iniciador rápido com palavras-chave de plug-ins: = calculadora, > shell, // URLs, < janelas e mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрый запуск с ключевыми словами плагинов: = калькулятор, > оболочка, // URL, < окна и другое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带插件关键字的快速启动器：= 计算器、> shell、// URL、< 窗口等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用外掛程式關鍵字的快速啟動器：= 計算機、> shell、// URL、< 視窗等。"
          }
        }
      }
    },
    "A reminder with a Join button, so you’re never late to a call.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung mit einer Taste zum Beitreten, damit kein Anruf verpasst wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio con un botón Unirse, para que nunca llegues tarde a una llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel avec un bouton Rejoindre, pour ne jamais être en retard à un appel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“参加”ボタン付きのリマインダーで、通話に遅れることがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참여 버튼이 있는 알림으로 통화에 늦지 않도록 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete com um botão Entrar, para você nunca se atrasar para uma chamada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание с кнопкой «Присоединиться», чтобы не опаздывать на звонки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带“加入”按钮的提醒，让你参加通话永不迟到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附有「加入」按鈕的提醒，讓你參加通話絕不遲到。"
          }
        }
      }
    },
    "A ring fills while you hold; lift early to keep the window": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Halten füllt sich ein Ring; früher loslassen, um das Fenster zu behalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anillo se llena mientras mantienes los dedos; levántalos antes para conservar la ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anneau se remplit pendant le maintien ; relâchez avant pour garder la fenêtre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anello si riempie mentre tieni premuto; solleva prima per mantenere la finestra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押さえている間にリングが満ちます。途中で指を離すとウインドウはそのままです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누르고 있는 동안 링이 채워지며, 그 전에 손을 떼면 윈도우가 유지됨"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um anel se preenche enquanto você segura; solte antes para manter a janela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы удерживаете, заполняется кольцо; отпустите раньше, чтобы оставить окно"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住时圆环会逐渐填满；提早抬起手指可保留窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住時圓環會逐漸填滿；提早抬起即可保留視窗"
          }
        }
      }
    },
    "A second divider, ‖. Icons to its left only appear when you ⌥-click the chevron, open the separate bar with ⌥ or search for them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine zweite Trennlinie, ‖. Symbole links davon erscheinen nur bei ⌥-Klick auf den Chevron, beim Öffnen der separaten Leiste mit ⌥ oder bei der Suche danach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un segundo divisor, ‖. Los iconos a su izquierda solo aparecen si haces clic con ⌥ en la flecha, abres la barra independiente con ⌥ o los buscas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un second séparateur, ‖. Les icônes à sa gauche n’apparaissent que si vous cliquez sur le chevron en maintenant ⌥, ouvrez la barre séparée avec ⌥ ou les recherchez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un secondo divisore, ‖. Le icone alla sua sinistra compaiono solo quando fai ⌥-clic sulla freccia, apri la barra separata con ⌥ o le cerchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2本目の区切り線“‖”。その左側のアイコンは、シェブロンを⌥クリックするか、⌥で別バーを開くか、検索した場合にのみ表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번째 구분선(‖)입니다. 그 왼쪽에 있는 아이콘은 꺾쇠 아이콘을 ⌥-클릭하거나, ⌥ 키로 별도 막대를 열거나, 검색할 때만 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um segundo divisor, ‖. Os ícones à esquerda dele só aparecem quando você clica no chevron com ⌥, abre a barra separada com ⌥ ou os busca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Второй разделитель, ‖. Значки слева от него появляются, только если нажать шеврон с ⌥, открыть отдельную строку с ⌥ или найти их поиском."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第二条分隔线 ‖。其左侧的图标只有在你按住 ⌥ 点按 V 形符号、按住 ⌥ 打开独立栏或搜索它们时才会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第二條分隔線「‖」。其左側的圖像只會在你按住 ⌥ 並按一下箭頭、按住 ⌥ 打開獨立列或搜尋這些圖像時出現。"
          }
        }
      }
    },
    "A shortcut": {
      "comment": "Remap kind: remap a shortcut",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kurzbefehl"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un raccourci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'abbreviazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um atalho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание клавиш"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵"
          }
        }
      }
    },
    "A small helper that runs as root switches charging on and off. macOS asks for your password once; you can remove it here at any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleines Hilfsprogramm mit Root-Rechten schaltet das Laden ein und aus. macOS fragt einmal nach dem Passwort; es lässt sich hier jederzeit entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pequeño asistente que se ejecuta como root activa y desactiva la carga. macOS pide tu contraseña una vez; puedes eliminarlo aquí cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit outil d’assistance exécuté en tant que root active et désactive la charge. macOS demande votre mot de passe une fois ; vous pouvez le supprimer ici à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piccolo helper eseguito come root attiva e disattiva la carica. macOS chiede la password una volta; puoi rimuoverlo qui in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "rootとして実行される小さなヘルパーが充電のオン/オフを切り替えます。macOSがパスワードを一度だけ求めます。ヘルパーはここでいつでも削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "root로 실행되는 작은 도우미가 충전을 켜고 끕니다. macOS가 암호를 한 번 요청하며, 언제든지 여기에서 도우미를 제거할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pequeno auxiliar executado como root ativa e desativa o carregamento. O macOS pede sua senha uma vez; você pode removê-lo aqui a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарядку включает и выключает небольшая вспомогательная программа, работающая от имени root. macOS один раз запросит пароль; удалить программу можно здесь в любое время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个以 root 身份运行的小型辅助程序负责打开和关闭充电。macOS 会要求你输入一次密码；你可以随时在此处将其移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個以 root 身分執行的小型輔助程式會開啟和關閉充電。macOS 只會要求輸入一次密碼；你可以隨時在這裡移除它。"
          }
        }
      }
    },
    "A small window lists each app as it launches and moves into place": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleines Fenster listet jede App auf, während sie startet und an ihren Platz rückt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pequeña ventana muestra cada app a medida que se abre y se coloca en su sitio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite fenêtre affiche chaque app à mesure qu’elle s’ouvre et se met en place"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una piccola finestra elenca ogni app mentre si avvia e si sposta in posizione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動して配置される各Appが小さなウインドウに一覧表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 실행되어 제자리로 이동할 때마다 작은 윈도우에 표시됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pequena janela lista cada app à medida que ele é aberto e posicionado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В небольшом окне показывается каждое приложение по мере запуска и перемещения на место"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个小窗口会列出每个正在启动并移到位的 App"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小視窗會列出正在啟動並移到定位的每個 App"
          }
        }
      }
    },
    "A spotlight closes in on the pointer. Click or press a key to dismiss.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Lichtkegel zieht sich um den Zeiger zusammen. Zum Schließen klicken oder eine Taste drücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un foco se cierra sobre el puntero. Haz clic o pulsa una tecla para descartarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un projecteur se resserre sur le pointeur. Cliquez ou appuyez sur une touche pour le fermer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un riflettore si stringe sul puntatore. Fai clic o premi un tasto per chiuderlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スポットライトがポインタに向かって狭まります。クリックするかキーを押すと閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원형 조명이 포인터를 향해 좁혀집니다. 클릭하거나 키를 누르면 닫힙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um holofote se fecha em torno do ponteiro. Clique ou pressione uma tecla para fechar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Луч прожектора сужается к указателю. Щелкните или нажмите клавишу, чтобы закрыть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聚光灯向指针收拢。点按或按任意键即可关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聚光燈會向指標收攏。按一下或按任意鍵即可關閉。"
          }
        }
      }
    },
    "A switcher that shows each display's layout, with minimized windows below. Hold the modifiers, press the key to move on, let go to switch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Umschalter, der das Layout jedes Displays zeigt, mit minimierten Fenstern darunter. Sondertasten halten, mit der Taste weiterschalten, zum Wechseln loslassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un selector que muestra la distribución de cada pantalla, con las ventanas minimizadas debajo. Mantén pulsadas las teclas modificadoras, pulsa la tecla para avanzar y suelta para cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sélecteur qui montre la disposition de chaque écran, avec les fenêtres réduites en dessous. Maintenez les modificateurs, appuyez sur la touche pour avancer, relâchez pour basculer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un selettore che mostra il layout di ogni monitor, con le finestre contratte sotto. Tieni premuti i modificatori, premi il tasto per andare avanti, rilascia per passare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ディスプレイのレイアウトと、その下にしまったウインドウを表示するスイッチャー。修飾キーを押したまま、キーを押して次に進み、離すと切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 디스플레이의 레이아웃과 그 아래에 최소화된 윈도우를 보여 주는 전환기입니다. 보조 키를 누른 채 키를 눌러 이동하고, 손을 떼면 전환됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um alternador que mostra o layout de cada monitor, com as janelas minimizadas embaixo. Segure os modificadores, pressione a tecla para avançar e solte para alternar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключатель, показывающий макет каждого дисплея, а под ним — свернутые окна. Удерживайте модификаторы, нажимайте клавишу для перехода и отпустите, чтобы переключиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个显示每台显示器布局的切换器，下方列出已最小化的窗口。按住修饰键，按该键继续移动，松开即可切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示每台顯示器佈局的切換器，最小化的視窗顯示在下方。按住修飾鍵，按該按鍵往下切換，放開即可切換。"
          }
        }
      }
    },
    "A tap on a Force Touch trackpad when the target changes or the close ring fills": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein spürbares Tippen auf einem Force Touch-Trackpad, wenn sich das Ziel ändert oder der Schließring voll ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque en un trackpad Force Touch cuando cambia el destino o se llena el anillo de cierre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un retour haptique sur un trackpad Force Touch quand la cible change ou que l’anneau de fermeture se remplit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco aptico sul trackpad Force Touch quando cambia la destinazione o si riempie l'anello di chiusura"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動先が変わったときや閉じるリングが満ちたときに、感圧タッチトラックパッドで触覚フィードバックを返します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상이 바뀌거나 닫기 링이 채워질 때 Force Touch 트랙패드에 짧은 진동"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque tátil no trackpad Force Touch quando o destino muda ou o anel de fechamento se preenche"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклик трекпада Force Touch при смене цели или заполнении кольца закрытия"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标改变或关闭圆环填满时，Force Touch 触控板会提供一次触感反馈"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標改變或關閉圓環填滿時，在 Force Touch 觸控式軌跡板上產生一次輕觸回饋"
          }
        }
      }
    },
    "A tiled window gets its old size back": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gekacheltes Fenster erhält seine alte Größe zurück"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ventana en mosaico recupera su tamaño anterior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fenêtre en mosaïque retrouve sa taille d’origine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una finestra affiancata riprende le dimensioni precedenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイル表示されたウインドウが元のサイズに戻ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일링된 윈도우가 이전 크기로 돌아감"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma janela organizada volta ao tamanho anterior"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно из мозаики возвращает прежний размер"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平铺的窗口会恢复原来的大小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "並排的視窗會恢復原本的大小"
          }
        }
      }
    },
    "A virtual display is a screen that exists only in software. Mirror a monitor without HiDPI onto a HiDPI virtual display for sharper text, or give apps a screen to stream or record. Virtual displays exist while MacToys runs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein virtuelles Display ist ein Bildschirm, der nur in Software existiert. Einen Monitor ohne HiDPI auf ein virtuelles HiDPI-Display spiegeln, um Text schärfer darzustellen, oder Apps einen Bildschirm zum Streamen oder Aufnehmen geben. Virtuelle Displays bestehen, solange MacToys läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pantalla virtual es una pantalla que solo existe en software. Duplica un monitor sin HiDPI en una pantalla virtual HiDPI para obtener un texto más nítido, o da a las apps una pantalla que transmitir o grabar. Las pantallas virtuales existen mientras MacToys está abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écran virtuel est un écran qui n’existe que sous forme logicielle. Faites afficher un écran virtuel HiDPI par un moniteur sans HiDPI pour un texte plus net, ou donnez aux apps un écran à diffuser ou à enregistrer. Les écrans virtuels existent tant que MacToys est ouvert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想ディスプレイは、ソフトウェア上にのみ存在する画面です。HiDPIに対応していないモニタをHiDPIの仮想ディスプレイにミラーリングしてテキストをより鮮明にしたり、Appにストリーミングや収録用の画面を用意したりできます。仮想ディスプレイはMacToysの実行中のみ存在します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 디스플레이는 소프트웨어에만 존재하는 화면입니다. HiDPI를 지원하지 않는 모니터를 HiDPI 가상 디스플레이로 미러링하여 텍스트를 더 선명하게 하거나, 앱에 스트리밍 또는 녹화용 화면을 제공합니다. 가상 디스플레이는 MacToys가 실행 중인 동안에만 존재합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um monitor virtual é uma tela que existe apenas em software. Espelhe um monitor sem HiDPI em um monitor virtual HiDPI para ter texto mais nítido ou ofereça aos apps uma tela para transmitir ou gravar. Os monitores virtuais existem enquanto o MacToys está em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виртуальный дисплей — это экран, который существует только программно. Включите на мониторе без HiDPI видеоповтор виртуального дисплея HiDPI, чтобы текст был четче, или дайте приложениям экран для трансляции или записи. Виртуальные дисплеи существуют, пока работает MacToys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟显示器是仅存在于软件中的屏幕。将不支持 HiDPI 的显示器镜像到 HiDPI 虚拟显示器上可获得更清晰的文字，也可以为 App 提供一个用于串流或录制的屏幕。虚拟显示器仅在 MacToys 运行期间存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "虛擬顯示器是只存在於軟體中的螢幕。將不支援 HiDPI 的顯示器鏡像輸出到 HiDPI 虛擬顯示器，即可獲得更清晰的文字，或為 App 提供一個可串流或錄製的螢幕。虛擬顯示器只在 MacToys 執行期間存在。"
          }
        }
      }
    },
    "A volume slider for every app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Lautstärkeregler für jede App"
