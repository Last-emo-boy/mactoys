    "Names show in the list and are searched first. Leave empty to show the content again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen erscheinen in der Liste und werden zuerst durchsucht. Leer lassen, um wieder den Inhalt anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres se muestran en la lista y se buscan primero. Déjalo vacío para volver a mostrar el contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms s’affichent dans la liste et sont recherchés en premier. Laissez vide pour afficher de nouveau le contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi compaiono nell'elenco e vengono cercati per primi. Lascia vuoto per mostrare di nuovo il contenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前はリストに表示され、最初に検索されます。空にすると内容が再び表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 목록에 표시되며 먼저 검색됩니다. 내용을 다시 표시하려면 비워 두세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes aparecem na lista e são buscados primeiro. Deixe em branco para mostrar o conteúdo novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Названия показываются в списке, и поиск идет сначала по ним. Оставьте поле пустым, чтобы снова показывать содержимое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称会显示在列表中并优先搜索。留空可重新显示内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱會顯示在列表中並優先搜尋。留白即可再次顯示內容。"
          }
        }
      }
    },
