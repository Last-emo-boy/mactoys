    "Keys pressed with ⌘, ⌃ or ⌥. What you type stays private.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit ⌘, ⌃ oder ⌥ gedrückte Tasten. Eingegebener Text bleibt privat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas pulsadas con ⌘, ⌃ o ⌥. Lo que escribes sigue siendo privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touches pressées avec ⌘, ⌃ ou ⌥. Ce que vous tapez reste privé."
          }
        },
        "it": {
          "stringUnit": {
