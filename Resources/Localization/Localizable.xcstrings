    "← also starts at the first character instead of the last.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "← beginnt außerdem beim ersten statt beim letzten Zeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "← también empieza por el primer carácter en lugar del último."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "← commence aussi au premier caractère au lieu du dernier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "← inizia inoltre dal primo carattere invece che dall'ultimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "←でも、最後の文字ではなく最初の文字から開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "←를 눌러도 마지막 문자 대신 첫 번째 문자부터 시작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "← também começa no primeiro caractere em vez do último."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "← также начинает с первого символа, а не с последнего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "← 也会从第一个字符而非最后一个字符开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "← 也會從第一個字元開始，而不是最後一個。"
          }
        }
      }
    },
    "← and → step through zone numbers; ↑ and ↓ stay with the app": {
