    "Charge normally until you resume.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zum Fortsetzen normal laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargar con normalidad hasta que reanudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charger normalement jusqu’à la reprise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica normalmente finché non riprendi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開するまで通常どおり充電します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재개할 때까지 정상적으로 충전합니다."
          }
        },
        "pt-BR": {
