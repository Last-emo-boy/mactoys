        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez Même raccourci si le vôtre active et désactive la concentration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットが集中モードを切り替える場合は、“同じショートカット”のままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어가 집중 모드를 켜고 끄는 방식이면 동일한 단축어로 두세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em Mesmo atalho se o seu alterna o Foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте «Та же быстрая команда», если ваша команда переключает фокусирование."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的快捷指令可切换专注模式，请保留“相同快捷指令”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若你的捷徑會切換專注模式，請保持為「相同的捷徑」。"
          }
        }
      }
    },
    "Leave out 1× modes when the same desktop size exists in HiDPI.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1×-Modi auslassen, wenn dieselbe Schreibtischgröße in HiDPI existiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitir los modos 1× cuando existe el mismo tamaño de escritorio en HiDPI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omettre les modes 1× lorsque la même taille de bureau existe en HiDPI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じデスクトップサイズのHiDPIモードがある場合は、1×モードを表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HiDPI에 같은 데스크탑 크기가 있으면 1× 모드를 제외합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitir modos 1× quando o mesmo tamanho de mesa existir em HiDPI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не показывать режимы 1×, если тот же размер рабочего стола есть в HiDPI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 HiDPI 中存在相同的桌面尺寸时，略去 1× 模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相同桌面大小已有 HiDPI 版本時，略過 1× 模式。"
          }
        }
      }
    },
    "Leave them undimmed": {
      "comment": "Focus Dimmer: other displays are not dimmed at all",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht abdunkeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No atenuarlas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas les atténuer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non attenuarli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗くしない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어둡게 하지 않음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não escurecê-los"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не затемнять их"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不调暗"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不調暗"
          }
        }
      }
    },
    "Leaves the desktop alone while the active window is the only one on screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt den Schreibtisch unverändert, solange das aktive Fenster das einzige auf dem Bildschirm ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No toca el escritorio mientras la ventana activa sea la única en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne touche pas au bureau tant que la fenêtre active est la seule à l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non interviene sulla scrivania quando la finestra attiva è l'unica sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上のウインドウがアクティブなウインドウだけのときは、デスクトップを暗くしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 활성 윈도우만 있을 때는 데스크탑을 어둡게 하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não altera a mesa enquanto a janela ativa for a única na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не затемняет рабочий стол, пока активное окно — единственное на экране."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前窗口是屏幕上唯一的窗口时，不调暗桌面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中的視窗是螢幕上唯一的視窗時，不會調暗桌面。"
          }
        }
      }
    },
