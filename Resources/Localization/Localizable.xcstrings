        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra u oculta Run"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ou masque Run"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nasconde Run"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Runを表示/非表示にします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Run을 보거나 숨깁니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra ou oculta o Run"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает или скрывает Run"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示或隐藏 Run"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示或隱藏 Run"
          }
        }
      }
    },
    "Shows or hides the toolbar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Symbolleiste ein oder aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra u oculta la barra de herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ou masque la barre d’outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nasconde la barra strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーを表示/非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 막대를 보거나 숨깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra ou oculta a barra de ferramentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает или скрывает панель инструментов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示或隐藏工具栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示或隱藏工具列。"
          }
        }
      }
    },
    "Shows the layout name as you switch. Cycles layouts with a quick key, else custom layouts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt beim Wechseln den Layoutnamen. Wechselt Layouts mit einer Schnelltaste, sonst eigene Layouts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el nombre de la distribución al cambiarla. Recorre las distribuciones con una tecla rápida o, si no, las personalizadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le nom de la disposition au changement. Parcourt les dispositions ayant une touche rapide, sinon les dispositions personnalisées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il nome del layout quando cambi. Scorre i layout con un tasto rapido, altrimenti i layout personalizzati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替え時にレイアウト名を表示します。クイックキーのあるレイアウトを順に切り替え、それ以外の場合はカスタムレイアウトを切り替えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환할 때 레이아웃 이름을 표시합니다. 빠른 적용 키가 있는 레이아웃을 순환하며, 없으면 사용자 설정 레이아웃을 순환합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nome do layout ao trocar. Alterna layouts com uma tecla rápida, ou então os layouts personalizados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает имя макета при переключении. Перебирает макеты с клавишей быстрого применения, а если их нет — свои макеты"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换时显示布局名称。使用快速键循环切换布局，否则循环切换自定布局"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換時顯示佈局名稱。使用快速鍵循環切換佈局，否則循環切換自訂佈局"
          }
        }
      }
    },
    "Shows them for a few seconds when a hidden icon changes size — timers, counters, badges — or a new app adds an icon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt sie einige Sekunden lang, wenn ein ausgeblendetes Symbol seine Größe ändert – Timer, Zähler, Kennzeichen – oder eine neue App ein Symbol hinzufügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los muestra unos segundos cuando un icono oculto cambia de tamaño — temporizadores, contadores, globos — o cuando una app nueva añade un icono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les affiche quelques secondes lorsqu’une icône masquée change de taille (minuteurs, compteurs, pastilles) ou qu’une nouvelle app ajoute une icône."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mostra per qualche secondo quando un'icona nascosta cambia dimensione — timer, contatori, badge — o una nuova app aggiunge un'icona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示のアイコンのサイズが変わったとき（タイマー、カウンタ、バッジなど）や、新しいAppがアイコンを追加したときに、数秒間表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨겨진 아이콘의 크기가 바뀌거나(타이머, 카운터, 배지) 새 앱이 아이콘을 추가하면 몇 초 동안 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra-os por alguns segundos quando um ícone oculto muda de tamanho — timers, contadores, indicadores — ou quando um novo app adiciona um ícone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает их на несколько секунд, когда скрытый значок меняет размер — таймеры, счетчики, наклейки — или новое приложение добавляет значок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当隐藏的图标改变大小（如计时器、计数器、标记）或新的 App 添加了图标时，会将它们显示几秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當隱藏的圖像改變大小（計時器、計數器、標記）或有新 App 加入圖像時，顯示幾秒鐘。"
          }
        }
      }
    },
    "Shows what’s on each display. Without Screen Recording permission the desktop pictures are used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, was auf jedem Display ist. Ohne die Berechtigung „Bildschirmaufnahme“ werden die Hintergrundbilder verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra lo que hay en cada pantalla. Sin el permiso de Grabación de pantalla se usan los fondos de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre ce qui est affiché sur chaque écran. Sans l’autorisation Enregistrement de l’écran, les fonds d’écran sont utilisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il contenuto di ogni monitor. Senza l'autorizzazione Registrazione schermo vengono usate le immagini della scrivania."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ディスプレイに表示されている内容を表示します。画面収録の許可がない場合は壁紙が使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 디스플레이의 내용을 보여 줍니다. 화면 기록 권한이 없으면 배경화면이 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o que há em cada monitor. Sem a permissão de Gravação de Tela, são usados os papéis de parede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает содержимое каждого дисплея. Без разрешения «Запись экрана» используются обои."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示每台显示器上的内容。没有屏幕录制权限时会使用墙纸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示每台顯示器上的內容。若沒有螢幕錄製權限，則會使用桌面圖片。"
          }
        }
      }
    },
    "Shows your clicks. Turn it on with the shortcut or from the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Klicks an. Mit dem Kurzbefehl oder über die Menüleiste einschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus clics. Actívalo con el atajo o desde la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre vos clics. Activez-le avec le raccourci ou depuis la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i tuoi clic. Attivalo con l'abbreviazione o dalla barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックを表示します。ショートカットまたはメニューバーからオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭을 표시합니다. 단축키나 메뉴 막대에서 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra seus cliques. Ative com o atalho ou pela barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает ваши щелчки. Включите сочетанием клавиш или в строке меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示你的点按操作。使用快捷键或从菜单栏将其打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示你的點按。可使用快速鍵或從選單列開啟。"
          }
        }
      }
    },
    "Shrink images, videos and PDFs as you copy, drop or save them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder, Videos und PDFs beim Kopieren, Ablegen oder Sichern verkleinern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce imágenes, vídeos y PDF al copiarlos, soltarlos o guardarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allégez les images, les vidéos et les PDF lorsque vous les copiez, les déposez ou les enregistrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci immagini, video e PDF mentre li copi, rilasci o salvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像、ビデオ、PDFを、コピー、ドロップ、保存するときに縮小します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지, 비디오, PDF를 복사하거나 놓거나 저장할 때 크기를 줄입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza imagens, vídeos e PDFs ao copiá-los, soltá-los ou salvá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уменьшайте изображения, видео и PDF при копировании, перетягивании или сохранении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在拷贝、拖放或存储时缩小图像、视频和 PDF。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你拷貝、放置或儲存影像、影片和 PDF 時縮小其檔案大小。"
          }
        }
      }
    },
