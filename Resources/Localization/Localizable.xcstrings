    "Hold ⇧ while dragging a window to snap it into zones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ziehen eines Fensters ⇧ halten, um es in Zonen einrasten zu lassen."
          }
        },
