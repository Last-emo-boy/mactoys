    "Arrows pick the nearest zone in that direction; ⌃⌥⇧ arrows extend over several zones": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfeiltasten wählen die nächste Zone in dieser Richtung; ⌃⌥⇧ und Pfeiltasten erweitern über mehrere Zonen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flechas eligen la zona más cercana en esa dirección; ⌃⌥⇧ y las flechas amplían sobre varias zonas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flèches choisissent la zone la plus proche dans cette direction ; ⌃⌥⇧ + flèches s’étendent sur plusieurs zones"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le frecce scelgono la zona più vicina in quella direzione; ⌃⌥⇧ + frecce estendono la selezione su più zone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印キーでその方向の最も近いゾーンを選択。⌃⌥⇧と矢印キーで複数のゾーンに広げます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표 키로 해당 방향의 가장 가까운 영역 선택, ⌃⌥⇧ 화살표 키로 여러 영역에 걸쳐 확장"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As setas escolhem a zona mais próxima naquela direção; ⌃⌥⇧ + setas estendem por várias zonas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрелки выбирают ближайшую зону в этом направлении; ⌃⌥⇧ со стрелками расширяют выбор на несколько зон"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向键选择该方向上最近的区域；⌃⌥⇧ 加方向键可扩展到多个区域"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方向鍵會選擇該方向最近的區域；⌃⌥⇧ 加方向鍵可延伸至多個區域"
          }
        }
      }
    },
