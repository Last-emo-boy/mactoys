    "When I press the shortcut": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當我按下快速鍵時"
          }
        }
      }
    },
    "When held": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住時"
          }
        }
      }
    },
    "When hidden, open MacToys again from Finder or Spotlight to reach Settings.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏時，請從 Finder 或 Spotlight 再次打開 MacToys 以進入「設定」。"
          }
        }
      }
    },
    "When multiple zones overlap": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多個區域重疊時"
          }
        }
      }
    },
    "When tapped alone": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單獨點按時"
          }
        }
      }
    },
    "Where": {
      "comment": "Detail row: the folder that contains the item, like Finder's Get Info\nRemap sheet section: the apps the remap applies in",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置"
          }
        }
      }
    },
    "Which previewer macOS uses": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 使用的預覽程式"
          }
        }
      }
    },
    "While Auto Hide Cursor has hidden it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「自動隱藏游標」將其隱藏期間。"
          }
        }
      }
    },
    "While an app in the second list is in front, the modifier and clicks reach it as usual — useful for games and apps with their own modifier-drag gestures.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當第二個列表中的 App 位於最前方時，修飾鍵和點按會照常傳給該 App — 適用於遊戲和具有自己修飾鍵拖移手勢的 App。"
          }
        }
      }
    },
    "While another window is in front, a pinned window shows a live mirror of itself. Point at it or click it to use the real window.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當其他視窗位於前方時，釘選的視窗會顯示其本身的即時鏡像。指向或按一下即可使用真正的視窗。"
          }
        }
      }
    },
    "While dragging (mouse wheel) or with a quick layout key": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移時（滑鼠滾輪）或使用快速佈局鍵"
          }
        }
      }
    },
    "While holding ⇧": {
      "comment": "Activation: only while the Shift key is held",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⇧ 時"
          }
        }
      }
    },
    "While holding ⌃": {
      "comment": "Activation: only while the Control key is held",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌃ 時"
          }
        }
      }
    },
    "While process %lld runs · %@": {
      "comment": "Awake status: first a process id, then the screen state, e.g. 'screen stays on'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "While process %1$lld runs · %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "程序 %1$lld 執行期間 · %2$@"
          }
        }
      }
    },
    "While the screen is locked only the Mac is kept awake; the displays follow your Lock Screen settings. Turning the screen back on resumes on unlock.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕鎖定期間只會讓 Mac 保持喚醒；顯示器則依照你的「鎖定畫面」設定。重新開啟螢幕會在解鎖時恢復。"
          }
        }
      }
    },
    "While you use any Mac of the group.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你使用群組中的任何 Mac 時。"
          }
        }
      }
    },
    "White": {
      "comment": "Color name\nPreview background",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白色"
          }
        }
      }
    },
    "Whiteboard (W)": {
      "comment": "Toolbar tooltip; W is the letter key",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白板（W）"
          }
        }
      }
    },
    "Whole computer": {
