    "Reload to see it; your unsaved edits will be lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Anzeigen neu laden; nicht gesicherte Änderungen gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a cargar para verlo; se perderán los cambios no guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechargez pour le voir ; vos modifications non enregistrées seront perdues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica per vederlo; le modifiche non salvate andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示するには再読み込みしてください。保存していない編集内容は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인하려면 다시 로드하세요. 저장하지 않은 편집 내용은 손실됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarregue para vê-lo; suas edições não salvas serão perdidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезагрузите, чтобы увидеть его; несохраненные изменения будут потеряны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新载入即可看到；你未存储的编辑将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新載入即可查看；你未儲存的編輯將會遺失。"
          }
        }
      }
    },
