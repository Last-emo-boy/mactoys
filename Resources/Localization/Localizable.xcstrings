    "Only single files can be sent (zip folders first).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur einzelne Dateien können gesendet werden (Ordner vorher komprimieren)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
