    "Away from the screen edge to show it, toward the edge to put it away": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Bildschirmrand weg zum Anzeigen, zum Rand hin zum Wegräumen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacia fuera del borde de la pantalla para mostrarla, hacia el borde para ocultarla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loin du bord de l’écran pour l’afficher, vers le bord pour la ranger"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lontano dal bordo dello schermo per mostrarlo, verso il bordo per riporlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の端から離れる方向で表示、端に向かう方向でしまう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 가장자리에서 멀어지는 쪽이면 표시, 가장자리 쪽이면 치우기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Afaste da borda da tela para mostrar, aproxime da borda para guardar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От края экрана — показать, к краю — убрать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朝远离屏幕边缘的方向轻扫可显示，朝边缘方向轻扫可收起"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "往遠離螢幕邊緣的方向即可顯示，朝邊緣方向即可收起"
          }
        }
      }
    },
