          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При 80 % почти любое фото выглядит как оригинал."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对几乎所有照片而言，80 % 看起来都与原图无异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對幾乎所有照片來說，80 % 看起來都與原圖相同。"
          }
        }
      }
    },
