      }
    },
    "Measures live content instead of one snapshot. Uses more power.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Misst Live-Inhalte statt eines einzelnen Schnappschusses. Verbraucht mehr Energie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide el contenido en directo en lugar de una sola instantánea. Consume más energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure le contenu en direct au lieu d’un seul instantané. Consomme plus d’énergie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura il contenuto in tempo reale invece di un'unica istantanea. Consuma più energia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1枚のスナップショットではなく、ライブのコンテンツを計測します。消費電力が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스냅샷 하나 대신 실시간 콘텐츠를 측정합니다. 전력을 더 많이 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mede o conteúdo ao vivo em vez de uma única captura. Usa mais energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряет живое содержимое, а не один снимок. Расходует больше энергии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量实时内容而非单张快照。耗电更多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測量即時內容而非單一快照。會耗用更多電力。"
          }
        }
      }
    },
