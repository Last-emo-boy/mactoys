    "Adds ${name}, $+{name}, backslash escapes and \\U \\L \\E \\u \\l case conversion.": {
      "comment": "PowerRename: keep the ${…} tokens and the backslash sequences as they are",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt ${name}, $+{name}, Backslash-Escapes und \\U \\L \\E \\u \\l zur Umwandlung der Groß-/Kleinschreibung hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade ${name}, $+{name}, secuencias de escape con barra invertida y conversión de mayúsculas y minúsculas con \\U \\L \\E \\u \\l."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ${name}, $+{name}, les échappements par barre oblique inversée et la conversion de casse \\U \\L \\E \\u \\l."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge ${name}, $+{name}, sequenze di escape con barra rovesciata e la conversione di maiuscole/minuscole \\U \\L \\E \\u \\l."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "${name}、$+{name}、バックスラッシュエスケープ、\\U \\L \\E \\u \\lによる大文字/小文字変換が使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "${name}, $+{name}, 백슬래시 이스케이프, \\U \\L \\E \\u \\l 대소문자 변환을 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona ${name}, $+{name}, escapes com barra invertida e conversão de maiúsculas/minúsculas \\U \\L \\E \\u \\l."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет ${name}, $+{name}, экранирование обратной косой чертой и смену регистра \\U \\L \\E \\u \\l."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 ${name}、$+{name}、反斜杠转义以及 \\U \\L \\E \\u \\l 大小写转换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 ${name}、$+{name}、反斜線跳脫字元，以及 \\U \\L \\E \\u \\l 大小寫轉換。"
          }
        }
      }
    },
    "Adds `mactoys` to %@ for scripting utilities from Terminal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt `mactoys` zu %@ hinzu, um Werkzeuge über das Terminal per Skript zu steuern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade `mactoys` a %@ para controlar las utilidades con scripts desde Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute `mactoys` à %@ pour piloter les utilitaires par script depuis Terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge `mactoys` a %@ per usare le utility tramite script dal Terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルからユーティリティをスクリプトで操作するための`mactoys`を%@に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에서 유틸리티를 스크립트로 제어할 수 있도록 %@에 `mactoys`를 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona `mactoys` a %@ para usar os utilitários em scripts no Terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет `mactoys` в %@ для управления утилитами из Терминала с помощью скриптов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 `mactoys` 添加到 %@，以便从终端以脚本控制各个工具。"
          }
