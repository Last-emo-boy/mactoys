    "1280 × 800": {
      "comment": "Window Controls preset: a window size in points"
    },
    "150 dpi is sharp on screen; choose 300 dpi for printing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "150 dpi sind auf dem Bildschirm scharf; für den Druck 300 dpi wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "150 ppp se ve nítido en pantalla; elige 300 ppp para imprimir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "150 ppp est net à l’écran ; choisissez 300 ppp pour l’impression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A 150 dpi il risultato è nitido sullo schermo; per la stampa scegli 300 dpi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "150 dpiは画面上で鮮明です。印刷用には300 dpiを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "150 dpi는 화면에서 선명하며, 인쇄용으로는 300 dpi를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "150 dpi fica nítido na tela; escolha 300 dpi para impressão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "150 dpi — четко на экране; для печати выберите 300 dpi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "150 dpi 在屏幕上已足够清晰；用于打印请选取 300 dpi。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "150 dpi 在螢幕上已很清晰；若要列印，請選擇 300 dpi。"
          }
        }
      }
    },
