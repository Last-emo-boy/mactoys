          }
        }
      }
    },
    "Only the first nine numbered controls get a key": {
      "comment": "Window Controls editor",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die ersten neun nummerierten Steuerelemente erhalten eine Taste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los nueve primeros controles numerados tienen tecla"
          }
        },
