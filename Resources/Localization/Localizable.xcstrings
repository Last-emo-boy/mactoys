          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横、続けて上または下"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆으로, 그다음 위나 아래로"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o lado, depois para cima ou para baixo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сторону, затем вверх или вниз"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先横向，再向上或向下"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先往側邊，再往上或往下"
          }
        }
      }
    },
    "Sideways, then up or down. Swipe the same way again for a sixth.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitwärts, dann nach oben oder unten. Erneut in dieselbe Richtung wischen für ein Sechstel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacia un lado y luego hacia arriba o abajo. Vuelve a deslizar en la misma dirección para un sexto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le côté, puis vers le haut ou le bas. Balayez de nouveau dans le même sens pour un sixième."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di lato, poi in alto o in basso. Scorri di nuovo nello stesso modo per un sesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横、続けて上または下にスワイプします。同じ方向にもう一度スワイプすると1/6になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆으로, 그다음 위나 아래로. 같은 방향으로 다시 쓸어넘기면 1/6이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o lado, depois para cima ou para baixo. Deslize de novo na mesma direção para um sexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сторону, затем вверх или вниз. Смахните так же еще раз — в шестой части."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先横向，再向上或向下。朝同一方向再次轻扫可得到六分之一。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先往側邊，再往上或往下。再以相同方向滑動一次可改為六分之一。"
          }
        }
      }
    },
