    "Save the apps and windows you use together, then bring them all back with one click.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsam genutzte Apps und Fenster sichern und alle mit einem Klick zurückholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las apps y ventanas que usas juntas y recupéralas todas con un solo clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les apps et fenêtres que vous utilisez ensemble, puis rouvrez-les toutes en un clic."
          }
        },
        "it": {
          "stringUnit": {
