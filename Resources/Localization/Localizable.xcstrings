            "state": "translated",
            "value": "システム終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 종료"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
