                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld utilitários avançados para macOS: todos os utilitários do Microsoft PowerToys e mais. Tudo funciona a partir da barra de menus; cada utilitário pode ser ativado ou desativado nos Ajustes."
                }
