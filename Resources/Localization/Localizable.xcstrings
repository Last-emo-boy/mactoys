    "1× halves the pixels on a Retina display: smaller files, softer text.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1× halbiert die Pixel auf einem Retina-Display: kleinere Dateien, weicherer Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1× reduce a la mitad los píxeles en una pantalla Retina: archivos más pequeños, texto más suave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1× divise par deux les pixels sur un écran Retina : fichiers plus légers, texte moins net."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1× dimezza i pixel su un monitor Retina: file più piccoli, testo meno nitido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1×ではRetinaディスプレイのピクセル数が半分になります。ファイルは小さくなりますが、テキストの鮮明さは下がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1×는 Retina 디스플레이에서 픽셀을 절반으로 줄입니다. 파일은 작아지고 텍스트는 덜 선명해집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1× reduz os pixels pela metade em uma tela Retina: arquivos menores, texto menos nítido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1× вдвое уменьшает число пикселей на дисплее Retina: файлы меньше, текст мягче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1× 会使视网膜显示屏上的像素减半：文件更小，但文字稍显模糊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1× 會將 Retina 顯示器上的像素減半：檔案較小，文字較不銳利。"
          }
        }
      }
    },
