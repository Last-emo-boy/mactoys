    "One click both brings the window forward and presses what you clicked": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Klick holt das Fenster nach vorne und betätigt zugleich das Angeklickte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo clic trae la ventana al frente y activa lo que has pulsado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul clic met la fenêtre au premier plan et active ce sur quoi vous avez cliqué"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo clic porta la finestra in primo piano e preme ciò su cui hai fatto clic"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回のクリックでウインドウを前面に出し、クリックした項目も押します"
