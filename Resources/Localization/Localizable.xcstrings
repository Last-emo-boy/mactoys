    "Search everything you copied, keep favorites on pinboards and paste it back from the keyboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles Kopierte durchsuchen, Favoriten auf Pinnwänden behalten und per Tastatur wieder einsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
