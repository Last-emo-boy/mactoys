    "No command hotkeys. Press ⌘K on a result and choose Assign Hotkey, or add one here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kurzbefehle für Befehle. ⌘K bei einem Ergebnis drücken und „Kurzbefehl zuweisen“ wählen oder hier einen hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
