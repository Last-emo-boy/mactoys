    "Password managers and concealed copies are never recorded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwortmanager und verborgene Kopien werden nie aufgezeichnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gestores de contraseñas y las copias ocultas nunca se registran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gestionnaires de mots de passe et les copies masquées ne sont jamais enregistrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I gestori di password e le copie nascoste non vengono mai registrati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードマネージャや非表示のコピーは記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 관리자와 숨겨진 복사 항목은 기록되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerenciadores de senhas e cópias ocultas nunca são registrados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Менеджеры паролей и скрытые копии никогда не записываются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从不记录密码管理器和隐藏的拷贝内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不會記錄密碼管理程式和隱藏的拷貝內容。"
          }
        }
      }
    },
