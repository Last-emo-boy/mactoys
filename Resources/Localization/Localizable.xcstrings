    "⌥ Space finds apps, files, windows and commands.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ Leertaste findet Apps, Dateien, Fenster und Befehle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ Espacio busca apps, archivos, ventanas y comandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ Espace trouve apps, fichiers, fenêtres et commandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ Spazio trova app, file, finestre e comandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ スペースバーでApp、ファイル、ウインドウ、コマンドを検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ 스페이스 바로 앱, 파일, 윈도우 및 명령을 찾습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ Espaço encontra apps, arquivos, janelas e comandos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ пробел находит приложения, файлы, окна и команды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ 空格键可查找 App、文件、窗口和命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ 空白鍵可尋找 App、檔案、視窗和指令。"
          }
        }
      }
    },
