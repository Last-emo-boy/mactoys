    "Where the capture sits when the shape adds room.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo die Aufnahme liegt, wenn die Form Platz hinzufügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde se coloca la captura cuando la forma añade espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Position de la capture lorsque la forme ajoute de l’espace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove si trova l'acquisizione quando la forma aggiunge spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形状によって余白が加わる場合のキャプチャの位置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모양이 공간을 추가할 때 캡처가 놓이는 위치입니다."
          }
        },
        "pt-BR": {
