    "Applies the frame below right away; you can still turn it off while annotating.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet den Rahmen unten sofort an; er lässt sich beim Anmerken noch ausschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica enseguida el marco de abajo; puedes desactivarlo mientras anotas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applique tout de suite le cadre ci-dessous ; vous pouvez encore le désactiver pendant l’annotation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica subito la cornice qui sotto; puoi comunque disattivarla mentre annoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のフレームをすぐに適用します。注釈中でもオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 프레임을 바로 적용하며, 주석을 다는 동안에도 끌 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica a moldura abaixo imediatamente; você ainda pode desativá-la ao fazer anotações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу применяет рамку ниже; ее можно выключить во время разметки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即应用下方的背景框；标注时仍可将其关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即套用下方的外框；加上註解時仍可將其關閉。"
          }
        }
      }
    },
    "Applies to every optimized image. Cards can downscale one image further.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für jedes optimierte Bild. Karten können ein Bild zusätzlich verkleinern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a todas las imágenes optimizadas. Las tarjetas pueden reducir más una imagen concreta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à chaque image optimisée. Les cartes permettent de réduire davantage une image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica a ogni immagine ottimizzata. Le schede possono ridurre ulteriormente una singola immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最適化されたすべての画像に適用されます。カードで個々の画像をさらに縮小できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최적화된 모든 이미지에 적용됩니다. 카드에서 이미지 하나를 더 축소할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale para todas as imagens otimizadas. Os cartões podem reduzir ainda mais uma imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется к каждому оптимизированному изображению. В карточке можно дополнительно уменьшить отдельное изображение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用于每张优化的图像。卡片可以进一步缩小单张图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用到每張最佳化的影像。卡片可將單張影像再進一步縮小尺寸。"
          }
        }
      }
    },
