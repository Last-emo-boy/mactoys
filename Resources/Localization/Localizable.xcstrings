    "80% looks the same as the original for nearly every photo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei 80 % ist fast jedes Foto nicht vom Original zu unterscheiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 80 % logra un aspecto idéntico al original en casi todas las fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "80 % donne le même rendu que l’original pour presque toutes les photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All'80% lo scarto dall'originale è invisibile in quasi ogni foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほぼすべての写真で、80 %ならオリジナルと同じように見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "80 %면 거의 모든 사진이 원본과 똑같아 보입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
