    "JSON can't hold dates, data or non-finite numbers. Save as XML or binary instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON kann keine Datumsangaben, Daten oder nicht endlichen Zahlen speichern. Stattdessen als XML oder binär sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON no admite fechas, datos ni números no finitos. Guarda como XML o binario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le JSON ne peut pas contenir de dates, de données ni de nombres non finis. Enregistrez plutôt en XML ou en binaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
