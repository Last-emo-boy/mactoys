    "Switch to, close or minimize open windows of any app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geöffnete Fenster beliebiger Apps wechseln, schließen oder minimieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a ventanas abiertas de cualquier app, ciérralas o minimízalas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculer vers les fenêtres ouvertes de n’importe quelle app, les fermer ou les placer dans le Dock"
