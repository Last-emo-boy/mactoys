        }
      }
    },
    "While Auto Hide Cursor has hidden it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während „Zeiger automatisch ausblenden“ ihn ausgeblendet hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras Ocultar cursor automáticamente lo tenga oculto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant que Masquer automatiquement le curseur l’a masqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre Nascondi cursore in automatico lo ha nascosto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“ポインタを自動的に隠す”で非表示になっている間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서 자동 숨기기가 커서를 숨긴 동안."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto o Ocultar Cursor Automaticamente o tiver ocultado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока «Автоскрытие курсора» скрывает его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在自动隐藏指针将其隐藏期间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「自動隱藏游標」將其隱藏期間。"
          }
        }
      }
    },
    "While an app in the second list is in front, the modifier and clicks reach it as usual — useful for games and apps with their own modifier-drag gestures.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange eine App aus der zweiten Liste vorne ist, erreichen Sondertaste und Klicks sie wie gewohnt – nützlich für Spiele und Apps mit eigenen Sondertasten-Ziehgesten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras una app de la segunda lista está en primer plano, la tecla modificadora y los clics le llegan como de costumbre — útil para juegos y apps con sus propios gestos de arrastre con tecla modificadora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une app de la deuxième liste est au premier plan, le modificateur et les clics lui parviennent normalement — utile pour les jeux et les apps ayant leurs propres gestes modificateur-glissement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un'app del secondo elenco è in primo piano, il modificatore e i clic le arrivano come di consueto: utile per giochi e app con propri gesti di trascinamento con modificatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2番目のリストにあるAppが前面にある間は、修飾キーとクリックが通常どおりそのAppに届きます — 独自の修飾キー＋ドラッグ操作を持つゲームやAppに便利です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번째 목록에 있는 앱이 맨 앞에 있는 동안에는 보조 키와 클릭이 평소처럼 해당 앱에 전달됩니다. 자체 보조 키-드래그 제스처가 있는 게임이나 앱에 유용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto um app da segunda lista estiver em primeiro plano, o modificador e os cliques chegam a ele normalmente — útil para jogos e apps com seus próprios gestos de modificador + arrasto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока впереди приложение из второго списка, модификатор и щелчки доходят до него как обычно — это удобно для игр и приложений со своими жестами перетягивания с модификатором."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当第二个列表中的 App 位于前台时，修饰键和点按会照常传递给它 — 适用于游戏和自带修饰键拖移手势的 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當第二個列表中的 App 位於最前方時，修飾鍵和點按會照常傳給該 App — 適用於遊戲和具有自己修飾鍵拖移手勢的 App。"
          }
        }
      }
    },
    "While another window is in front, a pinned window shows a live mirror of itself. Point at it or click it to use the real window.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während ein anderes Fenster vorne ist, zeigt ein angeheftetes Fenster eine Live-Spiegelung von sich. Darauf zeigen oder klicken, um das echte Fenster zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras otra ventana está delante, una ventana fijada muestra una réplica en directo de sí misma. Apunta a ella o haz clic para usar la ventana real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une autre fenêtre est au premier plan, une fenêtre épinglée affiche un miroir en direct d’elle-même. Pointez-le ou cliquez dessus pour utiliser la vraie fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un'altra finestra è in primo piano, una finestra fissata mostra una copia speculare in tempo reale di se stessa. Puntala o fai clic su di essa per usare la finestra reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのウインドウが前面にある間、ピン留めしたウインドウは自身のライブミラーを表示します。ポイントするかクリックすると、実際のウインドウを使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 윈도우가 앞에 있는 동안 고정된 윈도우는 자신의 실시간 미러를 표시합니다. 미러를 가리키거나 클릭하면 실제 윈도우를 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto outra janela estiver em primeiro plano, uma janela fixada mostra um espelho ao vivo de si mesma. Aponte para ele ou clique nele para usar a janela real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока впереди другое окно, закрепленное окно показывает свое живое зеркало. Наведите на него указатель или щелкните, чтобы работать с настоящим окном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当其他窗口位于前面时，置顶窗口会显示其自身的实时镜像。指向或点按它即可使用真实窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當其他視窗位於前方時，釘選的視窗會顯示其本身的即時鏡像。指向或按一下即可使用真正的視窗。"
          }
        }
      }
    },
    "While dragging (mouse wheel) or with a quick layout key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ziehen (Mausrad) oder mit einer Schnelltaste für Layouts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al arrastrar (rueda del ratón) o con una tecla rápida de distribución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le glissement (molette) ou avec une touche de disposition rapide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante il trascinamento (rotella del mouse) o con un tasto layout rapido"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中（マウスホイール）、またはクイックレイアウトキーで"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안(마우스 휠) 또는 빠른 레이아웃 키로"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao arrastar (roda do mouse) ou com uma tecla rápida de layout"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При перетягивании (колесо мыши) или с клавишей быстрого макета"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移时（鼠标滚轮）或使用快速布局键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移時（滑鼠滾輪）或使用快速佈局鍵"
          }
        }
      }
    },
    "While holding ⇧": {
      "comment": "Activation: only while the Shift key is held",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Halten von ⇧"
          }
        },
        "es": {
          "stringUnit": {
