          }
        }
      }
    },
    "Zooms the focused window to fill its display. Turn it off and the layout comes back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomt das aktive Fenster, bis es sein Display füllt. Beim Ausschalten kehrt das Layout zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplía la ventana activa para que llene su pantalla. Desactívalo y vuelve la distribución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrandit la fenêtre active pour qu’elle remplisse son écran. Désactivez-le et la disposition revient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrandisce la finestra attiva fino a riempire il monitor. Disattivalo e il layout torna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスのあるウインドウをディスプレイいっぱいに拡大します。オフにするとレイアウトが元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 윈도우를 확대하여 디스플레이를 채웁니다. 끄면 레이아웃이 원래대로 돌아옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplia a janela em foco para preencher o monitor. Desative e o layout volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разворачивает активное окно на весь дисплей. Выключите режим, и макет вернется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将当前窗口放大以填满其显示器。关闭后布局会恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將使用中的視窗放大以填滿其顯示器。關閉後佈局會恢復。"
          }
        }
      }
    },
