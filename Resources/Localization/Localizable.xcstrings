          "stringUnit": {
            "state": "translated",
            "value": "每個 App 都有自己的音量滑桿"
          }
        }
      }
    },
    "A wide center between narrow tool columns.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine breite Mitte zwischen schmalen Werkzeugspalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un centro ancho entre columnas estrechas de herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un large centre entre d’étroites colonnes d’outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'ampia area centrale tra strette colonne di strumenti."
          }
        },
        "ja": {
