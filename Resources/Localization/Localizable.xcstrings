    },
    "When hidden, open MacToys again from Finder or Spotlight to reach Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏后，请从访达或聚焦再次打开 MacToys 以访问设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏時，請從 Finder 或 Spotlight 再次打開 MacToys 以進入「設定」。"
          }
        }
      }
    },
    "When multiple zones overlap": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当多个区域重叠时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多個區域重疊時"
          }
        }
      }
    },
    "When tapped alone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独轻按时"
          }
        },
        "zh-Hant": {
