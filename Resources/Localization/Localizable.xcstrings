    "Zoom in to fill the mirror with your face, then drag the frame where your face is. Saved for every mirror and photo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrößern, bis das Gesicht den Spiegel füllt, dann den Rahmen auf das Gesicht ziehen. Gilt für jeden Spiegel und jedes Foto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplía para que tu cara llene el espejo y luego arrastra el encuadre hasta donde está tu cara. Se guarda para todos los espejos y fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomez pour que votre visage remplisse le miroir, puis faites glisser le cadre sur votre visage. Enregistré pour chaque miroir et chaque photo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズームインして顔がミラー全体に映るようにしてから、顔の位置に合わせて枠をドラッグします。この設定はすべてのミラーと写真に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대하여 미러를 얼굴로 채운 다음 얼굴이 있는 곳으로 프레임을 드래그하세요. 모든 미러와 사진에 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplie para preencher o espelho com seu rosto e depois arraste o enquadramento até onde está seu rosto. Salvo para todos os espelhos e fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличьте масштаб, чтобы лицо заполнило зеркало, затем перетяните рамку туда, где находится лицо. Сохраняется для всех зеркал и фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大以让你的脸填满镜像，然后将取景框拖到你的脸所在的位置。适用于所有镜像和照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大讓臉部填滿鏡像，然後將取景框拖移到臉部所在位置。此設定會套用到每個鏡像和照片。"
          }
        }
      }
    },
    "Zoom in, draw, time breaks, record and snip — each with its own shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzoomen, zeichnen, Pausen timen, aufnehmen und Ausschnitte erstellen – jeweils mit eigenem Kurzbefehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplía, dibuja, cronometra descansos, graba y recorta — cada función con su propio atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomez, dessinez, chronométrez les pauses, enregistrez et capturez — chacun avec son propre raccourci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrandisci, disegna, cronometra le pause, registra e ritaglia, ognuno con la propria abbreviazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズームイン、描画、休憩タイマー、収録、切り取り — それぞれに専用のショートカットがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대, 그리기, 휴식 타이머, 기록 및 캡처 — 각각 고유한 단축키가 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplie, desenhe, cronometre pausas, grave e recorte — cada um com seu próprio atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличение, рисование, таймер перерывов, запись и снимки — у каждой функции свое сочетание клавиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大、绘图、休息计时、录制和截图 — 各有其快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大、繪圖、休息計時、錄製和截取 — 每項功能都有自己的快速鍵。"
          }
        }
      }
    },
