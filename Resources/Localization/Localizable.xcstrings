    "Waits while the pointer is over a card. Swipe a card toward the edge to close it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet, solange der Zeiger über einer Karte ist. Eine Karte zum Rand wischen, um sie zu schließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera mientras el puntero está sobre una tarjeta. Desliza una tarjeta hacia el borde para cerrarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attend tant que le pointeur est sur une carte. Balayez une carte vers le bord pour la fermer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attende mentre il puntatore è su una scheda. Scorri una scheda verso il bordo per chiuderla."
          }
        },
        "ja": {
