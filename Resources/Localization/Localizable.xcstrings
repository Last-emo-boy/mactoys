          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les détails de l’appareil photo, la localisation et l’historique de retouche. L’orientation et le profil colorimétrique sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
