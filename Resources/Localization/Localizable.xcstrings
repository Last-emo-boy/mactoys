            "state": "translated",
            "value": "Ventanas por pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtres par écran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finestre per monitor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイごとのウインドウ数"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이당 윈도우 수"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janelas por monitor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окон на дисплей"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台显示器的窗口数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每台顯示器的視窗數"
          }
        }
      }
    },
    "Windows stay where they are": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster bleiben, wo sie sind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas se quedan donde están"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres restent où elles sont"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre restano dove sono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウはそのままの位置にとどまります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 현재 위치에 그대로 있음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas ficam onde estão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна остаются на местах"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口保持原位"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗會保持在原處"
          }
        }
      }
    },
    "Windows stay where they are until you resume": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster bleiben bis zum Fortsetzen, wo sie sind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas se quedan donde están hasta que reanudes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres restent où elles sont jusqu’à la reprise"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre restano dove sono finché non riprendi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開するまで、ウインドウはそのままの位置にとどまります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재개할 때까지 윈도우가 현재 위치에 그대로 있음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas ficam onde estão até você retomar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна остаются на местах, пока вы не возобновите"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复前窗口保持原位"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你繼續之前，視窗會保持在原處"
          }
        }
      }
    },
    "Windows stay where they are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster bleiben, wo sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas se quedan donde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres restent où elles sont."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウはそのままの位置にとどまります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 현재 위치에 그대로 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas ficam onde estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна остаются на местах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口保持原位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗會保持在原處。"
          }
        }
      }
    },
    "Wipe away. Keys, media keys and clicks on this screen do nothing until the time is up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfach abwischen. Tasten, Medientasten und Klicks auf diesem Bildschirm bewirken nichts, bis die Zeit abgelaufen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límpialo. Las teclas, las teclas multimedia y los clics en esta pantalla no hacen nada hasta que se acabe el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyez. Les touches, les touches multimédias et les clics sur cet écran sont sans effet jusqu’à la fin du délai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拭いてください。時間になるまで、キー、メディアキー、この画面上のクリックは機能しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닦으세요. 시간이 다 될 때까지 키, 미디어 키 및 이 화면에서의 클릭이 작동하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode limpar. Teclas, teclas de mídia e cliques nesta tela não fazem nada até o tempo acabar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Протирайте. Клавиши, клавиши мультимедиа и нажатия на этом экране ничего не делают, пока не истечет время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽管擦拭。在时间结束前，此屏幕上的按键、媒体键和点按都不起作用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "盡情擦拭吧。在時間結束前，按鍵、媒體鍵和在此畫面上的點按都不會有任何作用。"
          }
        }
      }
    },
    "With Accessibility access, Focus Dimmer reads the focused window directly, so sheets and dialogs stay bright and switching windows inside an app takes effect at once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Zugriff auf Bedienungshilfen liest die Fokusabdunklung das aktive Fenster direkt, sodass Dialoge hell bleiben und ein Fensterwechsel innerhalb einer App sofort wirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con acceso de Accesibilidad, Atenuador de fondo lee directamente la ventana activa, así que las hojas y los cuadros de diálogo no se atenúan y el cambio de ventana dentro de una app surte efecto al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec l’accès Accessibilité, Atténuateur d’arrière-plan lit directement la fenêtre active : les feuilles et les boîtes de dialogue restent lumineuses et le changement de fenêtre au sein d’une app prend effet immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l'accesso Accessibilità, Attenuazione sfondo legge direttamente la finestra attiva, così fogli e finestre di dialogo restano luminosi e il cambio di finestra all'interno di un'app ha effetto immediato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティへのアクセスを許可すると、フォーカス減光がフォーカスのあるウインドウを直接読み取るため、シートやダイアログは明るいままになり、App内でのウインドウの切り替えもすぐに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 접근 권한이 있으면 포커스 디머가 포커스된 윈도우를 직접 읽으므로 시트와 대화상자가 밝게 유지되고 앱 내에서 윈도우를 전환하면 즉시 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o acesso de Acessibilidade, o Escurecimento de Foco lê diretamente a janela em foco, para que painéis e caixas de diálogo continuem iluminados e a troca de janelas dentro de um app tenha efeito imediato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С разрешением «Универсальный доступ» «Фокус на окне» определяет активное окно напрямую, поэтому листы и диалоговые окна не затемняются, а переключение окон внутри приложения срабатывает сразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获得辅助功能权限后，聚焦调暗会直接读取当前窗口，因此表单和对话框保持明亮，在 App 内切换窗口也会立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有了輔助使用取用權限，焦點調暗會直接讀取使用中的視窗，因此表單和對話框會保持明亮，在 App 內切換視窗也會立即生效。"
          }
        }
      }
    },
    "With Reduce Transparency the colors are drawn solid; with Increase Contrast the edge is stronger.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Transparenz reduzieren“ werden die Farben deckend gezeichnet; mit „Kontrast erhöhen“ ist der Rand stärker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Reducir transparencia, los colores se dibujan sólidos; con Aumentar contraste, el borde es más marcado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Réduire la transparence, les couleurs sont opaques ; avec Augmenter le contraste, le bord est plus marqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Riduci trasparenza i colori sono disegnati pieni; con Aumenta contrasto il bordo è più marcato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“透明度を下げる”がオンの場合は色が不透明で描画され、“コントラストを上げる”がオンの場合は縁が強調されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투명도 줄이기를 사용하면 색상이 불투명하게 그려지고, 대비 증가를 사용하면 가장자리가 더 뚜렷해집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com Reduzir transparência, as cores são desenhadas sólidas; com Aumentar contraste, a borda fica mais forte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С параметром «Уменьшить прозрачность» цвета рисуются сплошными, с параметром «Увеличить контраст» край становится четче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“降低透明度”时颜色以纯色绘制；打开“增强对比度”时边缘更明显。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「減少透明度」時顏色會以實色繪製；開啟「增加對比」時邊緣會更明顯。"
          }
        }
      }
    },
    "With one file selected in Finder, ← and → move through the other items of its folder. With several selected, Peek moves between those.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist im Finder eine Datei ausgewählt, bewegen ← und → durch die anderen Objekte ihres Ordners. Sind mehrere ausgewählt, wechselt Peek zwischen diesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un archivo seleccionado en el Finder, ← y → recorren los demás ítems de su carpeta. Con varios seleccionados, Peek se mueve entre ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un seul fichier sélectionné dans le Finder, ← et → parcourent les autres éléments de son dossier. Avec plusieurs, Peek passe de l’un à l’autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un solo file selezionato nel Finder, ← e → scorrono gli altri elementi della sua cartella. Con più file selezionati, Peek si sposta tra quelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderで1つのファイルを選択している場合、←と→でそのフォルダ内のほかの項目に移動します。複数選択している場合、Peekはそれらの間を移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 파일 하나를 선택한 경우 ←와 →로 해당 폴더의 다른 항목 사이를 이동합니다. 여러 개를 선택한 경우 Peek은 선택한 항목 사이를 이동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um arquivo selecionado no Finder, ← e → percorrem os outros itens da pasta dele. Com vários selecionados, o Peek alterna entre eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если в Finder выбран один файл, ← и → переходят по другим объектам его папки. Если выбрано несколько, Peek переходит между ними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中选中一个文件时，← 和 → 可在其文件夹中的其他项目之间移动。选中多个文件时，Peek 会在所选项目之间移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中選取一個檔案時，← 和 → 可在其檔案夾中的其他項目間移動。選取多個檔案時，Peek 會在這些檔案之間移動。"
          }
        }
      }
    },
    "With the output": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Ausgabe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la salida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec la sortie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l'uscita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力と一緒に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출력과 함께"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a saída"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе с выходом"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输出处理方式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸出的處理方式"
          }
        }
      }
    },
    "With the time difference and whether it’s day or night there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Zeitunterschied und ob dort Tag oder Nacht ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la diferencia horaria y si allí es de día o de noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le décalage horaire et s’il y fait jour ou nuit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時差と、現地が昼か夜かも表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시차와 그곳이 낮인지 밤인지 함께 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a diferença de horário e se é dia ou noite lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С разницей во времени и указанием, день там или ночь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附带时差以及当地是白天还是夜晚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附上時差，以及當地是白天還是夜晚。"
          }
        }
      }
    },
    "Without $PATH this replaces the PATH zsh and apps inherit; add $PATH to keep the system folders.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne $PATH ersetzt dies den PATH, den zsh und Apps erben; $PATH hinzufügen, um die Systemordner zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin $PATH, esto sustituye el PATH que heredan zsh y las apps; añade $PATH para conservar las carpetas del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans $PATH, ceci remplace le PATH hérité par zsh et les apps ; ajoutez $PATH pour conserver les dossiers système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza $PATH sostituisce il PATH ereditato da zsh e dalle app; aggiungi $PATH per mantenere le cartelle di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "$PATHを含めない場合、zshとAppが継承するPATHが置き換えられます。システムフォルダを残すには$PATHを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "$PATH 변수를 포함하지 않으면 zsh와 앱이 상속하는 PATH가 대체됩니다. 시스템 폴더를 유지하려면 $PATH 변수를 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem $PATH, isto substitui o PATH que o zsh e os apps herdam; adicione $PATH para manter as pastas do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без $PATH это заменяет PATH, наследуемый zsh и приложениями; добавьте $PATH, чтобы сохранить системные папки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不包含 $PATH，这会替换 zsh 和 App 继承的 PATH；添加 $PATH 可保留系统文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若不含 $PATH，這會取代 zsh 和 App 繼承的 PATH；加入 $PATH 即可保留系統檔案夾。"
          }
        }
      }
    },
    "Without Accessibility, MacToys can't see where the app's menus end, so only the free space next to your icons counts (right of the notch on displays that have one).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Bedienungshilfen kann MacToys nicht erkennen, wo die Menüs der App enden, daher zählt nur der freie Platz neben den Symbolen (rechts der Notch auf Displays mit Notch)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Accesibilidad, MacToys no puede ver dónde terminan los menús de la app, así que solo cuenta el espacio libre junto a tus iconos (a la derecha de la muesca en las pantallas que la tienen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans Accessibilité, MacToys ne peut pas voir où se terminent les menus de l’app : seul l’espace libre à côté de vos icônes compte (à droite de l’encoche sur les écrans qui en ont une)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza Accessibilità, MacToys non vede dove finiscono i menu dell'app, quindi conta solo lo spazio libero accanto alle tue icone (a destra della tacca sui monitor che ne hanno una)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティがないと、MacToysはAppのメニューの終わりを認識できないため、アイコンの横の空き領域だけが対象になります（ノッチがあるディスプレイではノッチの右側）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한이 없으면 MacToys가 앱 메뉴가 끝나는 위치를 알 수 없으므로 아이콘 옆의 빈 공간만 계산됩니다(노치가 있는 디스플레이에서는 노치 오른쪽)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem Acessibilidade, o MacToys não consegue ver onde terminam os menus do app, então só conta o espaço livre ao lado dos seus ícones (à direita do entalhe nos monitores que têm um)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без универсального доступа MacToys не видит, где заканчиваются меню приложения, поэтому учитывается только свободное место рядом с вашими значками (справа от выреза на дисплеях с вырезом)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有辅助功能权限时，MacToys 无法看到 App 菜单的结束位置，因此只计算你的图标旁边的空余空间（在带刘海的显示器上为刘海右侧）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有「輔助使用」時，MacToys 無法得知 App 選單的結束位置，因此只會計算你的圖像旁的可用空間（在有瀏海的顯示器上為瀏海右側）。"
          }
        }
      }
    },
    "Without it, clicking an item in the bar shows it in the menu bar for you to click.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne sie zeigt ein Klick auf ein Objekt in der Leiste dieses in der Menüleiste an, wo es angeklickt werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin ella, al hacer clic en un ítem de la barra, se muestra en la barra de menús para que hagas clic en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans cet accès, cliquer sur un élément de la barre l’affiche dans la barre des menus pour que vous cliquiez dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza di essa, facendo clic su un elemento nella barra, questo viene mostrato nella barra dei menu affinché tu possa farci clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可しない場合、バーの項目をクリックするとメニューバーに表示されるので、そこでクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 없으면 막대에서 항목을 클릭할 때 메뉴 막대에 표시되므로 거기서 클릭해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ela, clicar em um item da barra o mostra na barra de menus para você clicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без него нажатие на объект в строке показывает его в строке меню, где на него можно нажать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有该权限时，点按栏中的项目会将其显示在菜单栏中，供你点按。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若沒有此權限，按一下列中的項目會將其顯示在選單列中，讓你按一下。"
          }
        }
      }
    },
    "Without it, search lists apps instead of their items, and opening one shows it in the menu bar for you to click.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne sie listet die Suche Apps statt ihrer Objekte, und beim Öffnen wird eines in der Menüleiste angezeigt, wo es angeklickt werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin ella, la búsqueda muestra las apps en lugar de sus ítems, y al abrir uno se muestra en la barra de menús para que hagas clic en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans cet accès, la recherche liste les apps au lieu de leurs éléments, et en ouvrir une l’affiche dans la barre des menus pour que vous cliquiez dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza di essa, la ricerca elenca le app invece dei loro elementi e, aprendone uno, viene mostrato nella barra dei menu affinché tu possa farci clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可しない場合、検索では項目ではなくAppが一覧表示され、開くとメニューバーに表示されるので、そこでクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 없으면 검색 시 항목 대신 앱이 나열되며, 항목을 열면 메뉴 막대에 표시되므로 거기서 클릭해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ela, a busca lista apps em vez dos itens deles, e abrir um o mostra na barra de menus para você clicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без него поиск показывает приложения вместо их объектов, а открытие объекта показывает его в строке меню, где на него можно нажать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有该权限时，搜索会列出 App 而非其项目，打开某个 App 会将其显示在菜单栏中，供你点按。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若沒有此權限，搜尋會列出 App 而非其項目，打開其中一個時會將其顯示在選單列中，讓你按一下。"
          }
        }
      }
    },
    "Without it, search lists apps, and opening one shows it in the menu bar for you to click.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne sie listet die Suche Apps, und beim Öffnen wird eines in der Menüleiste angezeigt, wo es angeklickt werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin ella, la búsqueda muestra las apps, y al abrir una se muestra en la barra de menús para que hagas clic en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans cet accès, la recherche liste les apps, et en ouvrir une l’affiche dans la barre des menus pour que vous cliquiez dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza di essa, la ricerca elenca le app e, aprendone una, viene mostrata nella barra dei menu affinché tu possa farci clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可しない場合、検索ではAppが一覧表示され、開くとメニューバーに表示されるので、そこでクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 없으면 검색 시 앱이 나열되며, 항목을 열면 메뉴 막대에 표시되므로 거기서 클릭해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ela, a busca lista apps, e abrir um o mostra na barra de menus para você clicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без него поиск показывает приложения, а открытие объекта показывает его в строке меню, где на него можно нажать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有该权限时，搜索会列出 App，打开某个 App 会将其显示在菜单栏中，供你点按。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若沒有此權限，搜尋會列出 App，打開其中一個時會將其顯示在選單列中，讓你按一下。"
          }
        }
      }
    },
    "Without this the displays may still turn off while the Mac stays awake.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne diese Option können sich die Displays ausschalten, während der Mac wach bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin esto, las pantallas pueden apagarse aunque el Mac siga activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans cela, les écrans peuvent quand même s’éteindre pendant que le Mac reste éveillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza questa opzione i monitor potrebbero spegnersi anche se il Mac resta attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これがない場合、Macがスリープしなくてもディスプレイがオフになることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션이 없으면 Mac이 깨어 있는 동안에도 디스플레이가 꺼질 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem isto, os monitores ainda podem se desligar enquanto o Mac fica ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без этого дисплеи могут выключаться, даже когда Mac не засыпает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不打开此项，Mac 保持唤醒时显示器仍可能关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若未開啟此選項，Mac 保持喚醒時顯示器仍可能會關閉。"
          }
        }
      }
    },
