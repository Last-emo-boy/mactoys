          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안 스크롤하여 레이아웃 순환"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role ao arrastar para alternar entre layouts"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутка при перетягивании перебирает макеты"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移时滚动可循环切换布局"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移時捲動以循環切換佈局"
          }
        }
      }
    },
    "Scroll while picking to change it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Auswählen scrollen, um es zu ändern."
          }
        },
        "es": {
