    "Measure pixels on screen with edge detection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pixel auf dem Bildschirm mit Kantenerkennung messen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide píxeles en la pantalla con detección de bordes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez des pixels à l’écran avec la détection des bords."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura i pixel sullo schermo con il rilevamento dei bordi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジ検出を使って画面上のピクセルを計測します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장자리 감지 기능으로 화면의 픽셀을 측정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
