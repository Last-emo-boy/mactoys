            "state": "translated",
            "value": "充電至 %@"
          }
        }
      }
    },
    "Charges normally until you press it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt normal, bis erneut gedrückt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga con normalidad hasta que lo vuelvas a pulsar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge normalement jusqu’à ce que vous appuyiez de nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica normalmente finché non lo premi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度押すまで通常どおり充電します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 누를 때까지 정상적으로 충전합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega normalmente até você pressionar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряжает в обычном режиме, пока вы не нажмете снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次按下前会正常充电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一次前會正常充電。"
          }
        }
      }
    },
    "Charges to full once, before a trip. The limit returns when you unplug.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt einmal vollständig, etwa vor einer Reise. Das Limit gilt wieder, sobald das Netzteil getrennt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga al máximo una vez, antes de un viaje. El límite vuelve al desconectar el adaptador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge complètement une fois, avant un voyage. La limite revient lorsque vous débranchez le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica completamente una volta, prima di un viaggio. Il limite torna quando scolleghi l'alimentatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外出前などに一度だけフル充電します。電源を外すと上限が元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 전에 한 번 완전히 충전합니다. 전원을 분리하면 한도가 다시 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega por completo uma vez, antes de uma viagem. O limite volta quando você desconecta o carregador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз заряжает полностью, например перед поездкой. Ограничение вернется после отключения питания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充满一次，适合出行前使用。拔下电源后恢复上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在出門前充飽一次電。拔除電源後會恢復上限。"
          }
        }
      }
    },
    "Charges to full once; the limit returns when you unplug.": {
