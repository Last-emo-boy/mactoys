    "Hold ⇧ when you release to save instead.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⇧ al rilascio per salvare invece."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 저장하려면 손을 뗄 때 ⇧를 누르고 있으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⇧ pressionada ao soltar para salvar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开时按住 ⇧ 则改为存储。"
          }
