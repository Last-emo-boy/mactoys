    "Use / to save into subfolders, e.g. %2/%1. Characters that can’t be in a file name become _.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit / in Unterordnern sichern, z. B. %2/%1. Zeichen, die in Dateinamen nicht erlaubt sind, werden zu _."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa / para guardar en subcarpetas, p. ej., %2/%1. Los caracteres que no pueden ir en un nombre de archivo se convierten en _."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez / pour enregistrer dans des sous-dossiers, p. ex. %2/%1. Les caractères interdits dans un nom de fichier deviennent _."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa / per salvare in sottocartelle, ad es. %2/%1. I caratteri non ammessi in un nome file diventano _."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/を使うとサブフォルダに保存できます（例: %2/%1）。ファイル名に使用できない文字は_になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 폴더에 저장하려면 /를 사용하세요(예: %2/%1). 파일 이름에 사용할 수 없는 문자는 _로 바뀝니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use / para salvar em subpastas, ex.: %2/%1. Caracteres que não podem estar em um nome de arquivo viram _."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте /, чтобы сохранять во вложенные папки, например %2/%1. Символы, недопустимые в имени файла, заменяются на _."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 / 可存储到子文件夹中，例如 %2/%1。文件名中不能包含的字符会变为 _。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 / 即可儲存到子檔案夾，例如 %2/%1。不能用於檔案名稱的字元會變成 _。"
          }
        }
      }
    },
