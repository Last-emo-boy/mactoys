    "Touch the sensor to unlock.": {
      "comment": "VoiceOver hint on the unlock island",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Entsperren den Sensor berühren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el sensor para desbloquear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le capteur pour déverrouiller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il sensore per sbloccare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "センサーに触れてロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금을 해제하려면 센서를 터치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no sensor para desbloquear."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь датчика, чтобы разблокировать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触摸传感器以解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸碰感應器以解鎖。"
          }
        }
      }
    },
    "Toward the same edge: ⅓, ⅔, then ½ again. The other way slides a third to the center.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum selben Rand: ⅓, ⅔, dann wieder ½. In die andere Richtung schiebt sich ein Drittel zur Mitte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacia el mismo borde: ⅓, ⅔ y luego ½ otra vez. En sentido contrario desplaza un tercio hacia el centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers le même bord : ⅓, ⅔, puis de nouveau ½. Dans l’autre sens, un tiers glisse vers le centre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verso lo stesso bordo: ⅓, ⅔, poi di nuovo ½. Nell'altra direzione sposta un terzo al centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ端に向かって: ⅓、⅔、そして再び½。反対方向では1/3ずつ中央へスライドします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 가장자리 쪽으로: ⅓, ⅔, 그다음 다시 ½. 반대 방향으로 하면 1/3이 중앙으로 이동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em direção à mesma borda: ⅓, ⅔ e depois ½ de novo. Na direção oposta, desliza um terço para o centro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К тому же краю: ⅓, ⅔, затем снова ½. В другую сторону — треть сдвигается к центру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朝同一边缘：⅓、⅔，然后再回到 ½。朝另一方向则将三分之一平移到中间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朝同一邊緣：⅓、⅔，然後再回到 ½。往另一個方向則會將三分之一滑向中央。"
          }
        }
      }
    },
