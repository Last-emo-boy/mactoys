    "Light and dark at the same times every day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hell und dunkel jeden Tag zu denselben Zeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro y oscuro a las mismas horas todos los días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clair et sombre aux mêmes heures chaque jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiaro e scuro agli stessi orari ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日同じ時刻にライトとダークを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 같은 시간에 라이트와 다크로 전환합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro e escuro nos mesmos horários todos os dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светлое и темное оформление в одно и то же время каждый день."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天在相同时间切换浅色和深色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天在相同時間切換淺色和深色。"
          }
        }
      }
    },
    "Light and dark start at the same time": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hell und dunkel beginnen zur selben Zeit"
          }
