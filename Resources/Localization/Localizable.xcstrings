    "Allow access to your calendars": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf Kalender erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a tus calendarios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’accès à vos calendriers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスを許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근 허용"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso aos seus calendários"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к календарям"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问你的日历"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許取用你的行事曆"
          }
        }
      }
    },
    "Allow access to your calendars to show events and remind you of meetings. The calendar and world clocks work without it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf die Kalender erlauben, um Ereignisse anzuzeigen und an Besprechungen zu erinnern. Kalender und Weltuhren funktionieren auch ohne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a tus calendarios para mostrar los eventos y recordarte las reuniones. El calendario y los relojes mundiales funcionan sin él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à vos calendriers pour afficher les événements et vous rappeler les réunions. Le calendrier et les horloges mondiales fonctionnent sans cet accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントを表示してミーティングを通知するには、カレンダーへのアクセスを許可してください。カレンダーと世界時計は許可しなくても使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트를 표시하고 회의를 알려 주려면 캘린더 접근을 허용하세요. 캘린더와 세계 시계는 권한 없이도 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso aos seus calendários para mostrar eventos e lembrar você das reuniões. O calendário e os relógios mundiais funcionam sem ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к календарям, чтобы видеть события и получать напоминания о встречах. Календарь и мировые часы работают и без него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问你的日历以显示日程并提醒你参加会议。没有该权限时，日历和世界时钟仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許取用你的行事曆，即可顯示行程並提醒你會議。日曆和世界時鐘不需要此權限也能使用。"
          }
        }
      }
    },
