    "This Mac can't switch its adapter off. Unplug it to bring the battery down to the limit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac kann sein Netzteil nicht ausschalten. Das Netzteil trennen, um die Batterie auf das Limit zu entladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no puede apagar su adaptador. Desconéctalo para bajar la batería hasta el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne peut pas couper son adaptateur secteur. Débranchez-le pour faire descendre la batterie jusqu’à la limite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non può disattivare l'alimentatore. Scollegalo per far scendere la batteria fino al limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでは電源アダプタをオフにできません。バッテリーを上限まで下げるには、電源を外してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 어댑터를 끌 수 없습니다. 배터리를 한도까지 낮추려면 전원을 분리하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não consegue desligar o adaptador. Desconecte-o para descarregar a bateria até o limite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не может отключить адаптер. Отсоедините его, чтобы разрядить аккумулятор до ограничения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 无法关闭电源适配器。请拔下电源，让电池电量降到上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 無法關閉電源轉接器。請拔除電源，讓電池電量降至上限。"
          }
        }
      }
    },
    "This Mac can’t write %@ images": {
      "comment": "Optimizer error; the value is an image format such as WebP",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac kann keine %@-Bilder schreiben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no puede escribir imágenes %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne peut pas écrire d’images %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non può scrivere immagini %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでは%@画像を書き出せません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서는 %@ 이미지를 기록할 수 없음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não consegue gravar imagens %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не может записывать изображения %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 无法写入 %@ 图像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 無法寫入 %@ 影像"
          }
        }
      }
    },
    "This Mac has no Touch ID or paired Apple Watch available right now; your password always works.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac sind gerade weder Touch ID noch eine gekoppelte Apple Watch verfügbar; das Passwort funktioniert immer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene Touch ID ni un Apple Watch enlazado disponible ahora; tu contraseña siempre funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun Touch ID ni Apple Watch jumelée n’est disponible sur ce Mac pour le moment ; votre mot de passe fonctionne toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento questo Mac non ha Touch ID o un Apple Watch abbinato disponibile; la password funziona sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでは現在、Touch IDやペアリングされたApple Watchを使用できません。パスワードはいつでも使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 이 Mac에서 사용할 수 있는 Touch ID나 페어링된 Apple Watch가 없습니다. 암호는 항상 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não tem Touch ID nem um Apple Watch emparelhado disponível agora; sua senha sempre funciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас на этом Mac недоступны Touch ID и объединенные в пару Apple Watch; пароль работает всегда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 目前没有可用的触控 ID 或已配对的 Apple Watch；始终可以使用密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 目前沒有可用的 Touch ID 或配對的 Apple Watch；你的密碼一律可用。"
          }
        }
      }
    },
    "This Mac has no battery.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat keine Batterie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’a pas de batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non ha una batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacにはバッテリーがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에는 배터리가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não tem bateria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого Mac нет аккумулятора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 没有电池。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 沒有電池。"
          }
        }
      }
    },
    "This Mac keeps its limit in firmware and can't pause charging below it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac speichert sein Limit in der Firmware und kann das Laden darunter nicht pausieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac guarda su límite en el firmware y no puede pausar la carga por debajo de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac conserve sa limite dans son firmware et ne peut pas suspendre la charge en dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac mantiene il suo limite nel firmware e non può sospendere la carica al di sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacは上限をファームウェアに保持しているため、上限未満で充電を一時停止できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 한도를 펌웨어에 저장하므로 그 아래에서는 충전을 일시 정지할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac mantém o limite no firmware e não consegue pausar o carregamento abaixo dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac хранит ограничение в прошивке и не может приостановить зарядку ниже него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 将上限保存在固件中，无法在低于上限时暂停充电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 將上限保存在韌體中，無法在低於上限時暫停充電。"
          }
        }
      }
    },
    "This Mac runs on mains power only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac läuft nur mit Netzstrom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac solo funciona conectado a la corriente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac fonctionne uniquement sur secteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac funziona solo con l'alimentazione di rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはコンセントからの電源のみで動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 전원 콘센트로만 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac funciona apenas ligado à tomada."
          }
        },
