            "value": "⌃ ⌥ C nimmt ein beliebiges Pixel auf dem Bildschirm auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ C selecciona cualquier píxel de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ C choisit n’importe quel pixel à l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ C seleziona qualsiasi pixel sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ Cで画面上の任意のピクセルの色を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ C로 화면의 모든 픽셀을 선택할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ C escolhe qualquer pixel na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ C выбирает любой пиксель на экране."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ ⌥ C 可选取屏幕上的任意像素。"
          }
