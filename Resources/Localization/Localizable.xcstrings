          }
        }
      }
    },
    "Only single files can be sent (zip folders first).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur einzelne Dateien können gesendet werden (Ordner vorher komprimieren)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden enviar archivos sueltos (comprime las carpetas primero)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls des fichiers individuels peuvent être envoyés (compressez d’abord les dossiers en zip)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si possono inviare solo singoli file (comprimi prima le cartelle in zip)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信できるのは単一のファイルのみです（フォルダは先にzip圧縮してください）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단일 파일만 보낼 수 있습니다(폴더는 먼저 압축하세요)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente arquivos individuais podem ser enviados (compacte as pastas antes)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлять можно только отдельные файлы (папки сначала заархивируйте в zip)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能发送单个文件（请先压缩文件夹）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能傳送單一檔案（請先將檔案夾壓縮）。"
          }
        }
      }
    },
    "Only the shortcut switches the appearance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Kurzbefehl wechselt das Erscheinungsbild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el atajo cambia el aspecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le raccourci change l’apparence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo l'abbreviazione cambia l'aspetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットでのみ外観を切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키로만 화면 모드를 전환합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o atalho alterna a aparência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформление переключается только сочетанием клавиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有快捷键会切换外观。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有快速鍵可以切換外觀。"
          }
        }
      }
    },
    "Only when no other modifiers are held. Otherwise extra modifiers carry over to the output.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn keine anderen Sondertasten gehalten werden. Andernfalls werden zusätzliche Sondertasten an die Ausgabe weitergegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuando no se mantienen otras teclas modificadoras. De lo contrario, las teclas modificadoras adicionales se transmiten a la salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement si aucun autre modificateur n’est maintenu. Sinon, les modificateurs supplémentaires sont transmis à la sortie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quando non sono premuti altri modificatori. Altrimenti i modificatori aggiuntivi passano all'output."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの修飾キーが押されていない場合のみ。それ以外の場合は、追加の修飾キーが出力に引き継がれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 보조 키를 누르지 않은 경우에만 적용됩니다. 그 외에는 추가 보조 키가 출력에 그대로 전달됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente quando nenhum outro modificador estiver pressionado. Caso contrário, os modificadores extras são repassados para a saída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
