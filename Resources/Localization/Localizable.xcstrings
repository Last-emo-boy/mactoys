    "Switch between light and dark appearance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen hellem und dunklem Erscheinungsbild wechseln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar entre aspecto claro y oscuro"
          }
        },
        "fr": {
