          }
        }
      }
    },
    "Click the sun to open the flyout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Sonne klicken, um das Flyout zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el sol para abrir el panel."
          }
        },
        "fr": {
