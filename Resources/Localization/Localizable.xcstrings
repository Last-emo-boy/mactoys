    "Passwords are never recorded": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwörter werden nie aufgezeichnet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contraseñas nunca se registran"
          }
        },
