    "Some folders couldn't be read — counts are incomplete": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Ordner konnten nicht gelesen werden – Anzahlen sind unvollständig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido leer algunas carpetas — los recuentos están incompletos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains dossiers n’ont pas pu être lus — les nombres sont incomplets"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune cartelle non sono leggibili; i conteggi sono incompleti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のフォルダを読み込めませんでした — 数は不完全です"
