          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В домен defaults можно записать только словарь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有字典可以写入 defaults 域。"
