    "Remapping": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimappatura"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재매핑"
          }
        },
        "pt-BR": {
