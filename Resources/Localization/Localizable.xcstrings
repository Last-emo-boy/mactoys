    "Grab a window anywhere — no need to aim for the title bar or a thin border.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Afferra una finestra in qualsiasi punto, senza dover mirare alla barra del titolo o a un bordo sottile."
          }
