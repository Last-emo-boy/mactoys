        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此顯示器未回報功能字串；其控制項是透過探測找到的。"
          }
        }
      }
    },
    "This replaces every setting of the domain with this document (defaults import). Apps using it may need to be relaunched.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisce tutte le impostazioni del dominio con questo documento (defaults import). Le app che lo usano potrebbero dover essere riavviate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도메인의 모든 설정이 이 문서로 대체됩니다(defaults import). 이 도메인을 사용하는 앱은 다시 실행해야 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto substitui todos os ajustes do domínio por este documento (defaults import). Apps que o usam talvez precisem ser reabertos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会用此文稿替换该域的所有设置（defaults import）。使用该域的 App 可能需要重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會以此文件取代該網域的所有設定（defaults import）。使用該網域的 App 可能需要重新啟動。"
          }
        }
      }
    },
