          "stringUnit": {
            "state": "translated",
            "value": "写真はミラーのズームとフレーミングを保ったまま、カメラのフル解像度で保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 카메라의 최대 해상도로 미러의 확대 및 구도를 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos mantêm o zoom e o enquadramento do espelho, na resolução total da câmera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото сохраняют масштаб и кадрирование зеркала в полном разрешении камеры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片会保留镜像的缩放和取景，并采用相机的全分辨率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片會保留鏡像的縮放和取景，並以相機的完整解析度拍攝。"
          }
        }
      }
    },
    "Photos saved as PNG shrink much more as JPEG or HEIC. The file’s extension changes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als PNG gesicherte Fotos werden als JPEG oder HEIC deutlich kleiner. Die Dateiendung ändert sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos guardadas como PNG se reducen mucho más como JPEG o HEIC. La extensión del archivo cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos enregistrées en PNG deviennent bien plus légères en JPEG ou HEIC. L’extension du fichier change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto salvate come PNG si riducono molto di più come JPEG o HEIC. L'estensione del file cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PNGで保存された写真は、JPEGやHEICにするとはるかに小さくなります。ファイルの拡張子が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG로 저장된 사진은 JPEG나 HEIC로 바꾸면 훨씬 더 작아집니다. 파일 확장자가 바뀝니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos salvas como PNG ficam muito menores como JPEG ou HEIC. A extensão do arquivo muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото, сохраненные в PNG, сжимаются гораздо сильнее в JPEG или HEIC. Расширение файла меняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储为 PNG 的照片转为 JPEG 或 HEIC 后会小得多。文件扩展名会随之改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以 PNG 儲存的照片轉為 JPEG 或 HEIC 後會小得多。檔案的副檔名會改變。"
          }
        }
      }
    },
