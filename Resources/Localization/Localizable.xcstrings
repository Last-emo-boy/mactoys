        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili di Power Display vengono applicati ogni volta che Cambio aspetto modifica l'aspetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトスイッチが外観を変更するたびに、Power Displayのプロファイルが適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 모드 전환이 화면 모드를 변경할 때마다 Power Display 프로필이 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis do Power Display são aplicados sempre que o Alternador de Aparência altera a aparência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили Power Display применяются при каждой смене оформления «Переключателем темы»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每当明暗切换更改外观时，都会应用 Power Display 配置文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每當外觀切換更改外觀時，都會套用 Power Display 設定檔。"
          }
        }
      }
    },
