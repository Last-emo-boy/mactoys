          "stringUnit": {
            "state": "translated",
            "value": "Fino ad allora l'alimentatore resta disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それまで電源アダプタはオフになります。"
          }
