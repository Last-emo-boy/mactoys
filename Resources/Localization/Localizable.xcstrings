    "Push the pointer past an outer edge of the desktop and it comes in on the opposite side.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Zeiger über einen äußeren Rand des Schreibtischs hinausschieben, und er erscheint auf der gegenüberliegenden Seite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja el puntero más allá de un borde exterior del escritorio y aparecerá por el lado opuesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poussez le pointeur au-delà d’un bord extérieur du bureau et il réapparaît du côté opposé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spingi il puntatore oltre un bordo esterno della scrivania e ricompare dal lato opposto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップの外側の端を越えてポインタを押し出すと、反対側から現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터를 데스크탑 바깥 가장자리 너머로 밀면 반대편에서 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurre o ponteiro além de uma borda externa da mesa e ele entra pelo lado oposto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведите указатель за внешний край рабочего стола, и он появится с противоположной стороны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针推过桌面的外边缘，它会从对侧进入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將指標推過桌面的外側邊緣，它就會從另一側出現。"
          }
        }
      }
    },
    "Put back what you had copied before the stack started.": {
      "localizations": {
        "de": {
