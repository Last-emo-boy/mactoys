            "value": "%@  （檔名遮罩）"
          }
        }
      }
    },
    "%@  (open the browser)": {
      "comment": "Run help example: %@ is what to type, the parentheses explain it",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  （打開瀏覽器）"
          }
        }
