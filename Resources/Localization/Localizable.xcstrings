    "Drop files, text, images or links on it, switch apps, then drag everything out at once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, Text, Bilder oder Links darauf ablegen, die App wechseln und dann alles auf einmal herausziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta en ella archivos, texto, imágenes o enlaces, cambia de app y arrastra todo fuera de una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez-y des fichiers, du texte, des images ou des liens, changez d’app, puis faites tout glisser vers l’extérieur d’un coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia sopra file, testo, immagini o link, cambia app, poi trascina fuori tutto insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル、テキスト、画像、リンクをドロップしてAppを切り替え、すべてをまとめてドラッグして取り出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일, 텍스트, 이미지 또는 링크를 놓고 앱을 전환한 다음 모든 항목을 한 번에 드래그하여 꺼냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte arquivos, texto, imagens ou links nela, alterne de app e depois arraste tudo para fora de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бросьте на нее файлы, текст, изображения или ссылки, переключитесь в другое приложение и перетяните все сразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件、文本、图像或链接拖放到上面，切换 App，然后一次性全部拖出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將檔案、文字、影像或連結放到上面，切換 App，然後一次全部拖出。"
          }
        }
      }
    },
