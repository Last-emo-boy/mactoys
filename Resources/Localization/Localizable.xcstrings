          }
        }
      }
    },
    "Copies made while one of these apps is in front are skipped. Password managers are listed from the start.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien, die entstehen, während eine dieser Apps vorne ist, werden übersprungen. Passwortmanager sind von Anfang an aufgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omite lo que se copie mientras una de estas apps esté en primer plano. Los gestores de contraseñas figuran en la lista desde el principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies effectuées lorsqu’une de ces apps est au premier plan sont ignorées. Les gestionnaires de mots de passe sont inclus dès le départ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie fatte mentre una di queste app è in primo piano vengono ignorate. I gestori di password sono elencati fin dall'inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのAppが前面にあるときのコピーは記録されません。パスワードマネージャは最初からリストに含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱 중 하나가 맨 앞에 있는 동안 복사한 내용은 건너뜁니다. 암호 관리자는 처음부터 목록에 포함되어 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias feitas enquanto um destes apps está em primeiro plano são ignoradas. Os gerenciadores de senhas já vêm na lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирования, сделанные, пока одно из этих приложений активно, пропускаются. Менеджеры паролей добавлены в список изначально."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 App 位于前台时拷贝的内容会被跳过。密码管理器默认已在列表中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些 App 位於最前方時拷貝的內容會被略過。密碼管理程式預設就已列出。"
          }
        }
      }
    },
    "Copies marked concealed or transient — passwords, one-time codes, generated content — are skipped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als verborgen oder flüchtig markierte Kopien – Passwörter, Einmalcodes, generierte Inhalte – werden übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omite lo copiado que esté marcado como oculto o transitorio — contraseñas, códigos de un solo uso, contenido generado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies marquées comme masquées ou temporaires (mots de passe, codes à usage unique, contenu généré) sont ignorées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie contrassegnate come nascoste o temporanee — password, codici monouso, contenuti generati — vengono ignorate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示または一時的とマークされたコピー（パスワード、ワンタイムコード、生成されたコンテンツ）は記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨김 또는 임시로 표시된 복사 항목(암호, 일회용 코드, 생성된 콘텐츠)은 건너뜁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias marcadas como ocultas ou temporárias — senhas, códigos de uso único, conteúdo gerado — são ignoradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирования, помеченные как скрытые или временные, — пароли, одноразовые коды, сгенерированное содержимое — пропускаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记为隐藏或临时的拷贝内容（密码、一次性验证码、生成的内容）会被跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標示為隱藏或暫時性的拷貝內容（密碼、一次性代碼、產生的內容）會被略過。"
          }
        }
      }
    },
