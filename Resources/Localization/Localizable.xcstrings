            "value": "Le fichier lui-même n’est jamais modifié"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non viene mai modificato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル自体は変更されません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 자체는 변경되지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo em si nunca é alterado"
          }
        },
