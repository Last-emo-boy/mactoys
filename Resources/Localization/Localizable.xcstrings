    "Removes camera details, location and editing history. Orientation and the color profile are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Kameradetails, Standort und Bearbeitungsverlauf. Ausrichtung und Farbprofil bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
