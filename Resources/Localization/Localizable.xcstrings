          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponi la finestra attiva con le frecce, la barra spaziatrice, A capo e i tasti numerici"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
