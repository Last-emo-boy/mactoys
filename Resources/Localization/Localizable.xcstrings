    "Changing the interval while a timed session runs restarts its timer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird das Intervall während einer zeitgesteuerten Sitzung geändert, startet deren Timer neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el intervalo durante una sesión temporizada reinicia su temporizador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier l’intervalle pendant une session minutée redémarre son minuteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificare l'intervallo durante una sessione a tempo ne riavvia il timer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーセッションの実行中に間隔を変更すると、タイマーが最初からやり直しになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 지정 세션이 실행되는 동안 간격을 변경하면 타이머가 다시 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o intervalo durante uma sessão temporizada reinicia o timer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение интервала во время сеанса с таймером перезапускает таймер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在定时会话运行时更改间隔会重新开始计时。"
