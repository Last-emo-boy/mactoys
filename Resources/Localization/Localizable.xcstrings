        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上限已暫停。可隨時繼續。"
          }
        }
      }
    },
    "The limit keeps working when MacToys is closed. Turning Charge Limit off gives charging back to macOS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit wirkt weiter, wenn MacToys geschlossen ist. Wird Ladelimit ausgeschaltet, übernimmt macOS wieder das Laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite sigue funcionando con MacToys cerrado. Al desactivar Límite de carga, el control de la carga vuelve a macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite continue de fonctionner lorsque MacToys est fermé. Désactiver Limite de charge rend la gestion de la charge à macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite continua a funzionare quando MacToys è chiuso. Disattivando Limite di carica, la gestione della carica torna a macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限はMacToysを閉じても機能し続けます。充電上限をオフにすると、充電の制御がmacOSに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys를 닫아도 한도는 계속 작동합니다. 충전 한도를 끄면 충전 제어가 macOS로 돌아갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite continua funcionando com o MacToys fechado. Desativar o Limite de Carga devolve o controle do carregamento ao macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничение продолжает работать, когда MacToys закрыт. Выключение «Ограничения заряда» возвращает управление зарядкой macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys 关闭后上限仍会生效。关闭充电上限会将充电交还给 macOS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacToys 關閉時上限仍會繼續運作。關閉充電上限會將充電交還給 macOS。"
          }
        }
      }
    },
    "The limit returns when you unplug.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit gilt wieder, sobald das Netzteil getrennt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite vuelve al desconectar el adaptador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite revient lorsque vous débranchez le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite torna quando scolleghi l'alimentatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源を外すと上限が元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원을 분리하면 한도가 다시 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite volta quando você desconecta o carregador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничение вернется после отключения питания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拔下电源后恢复上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拔除電源後會恢復上限。"
          }
        }
      }
    },
    "The lines before the first entry. Lines that aren't comments are kept as they are; new entries go below these when placement is Top.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeilen vor dem ersten Eintrag. Zeilen, die keine Kommentare sind, bleiben unverändert; neue Einträge kommen darunter, wenn die Platzierung „Oben“ ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas anteriores a la primera entrada. Las líneas que no son comentarios se mantienen tal cual; las entradas nuevas van debajo de ellas cuando la ubicación es Arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes avant la première entrée. Les lignes qui ne sont pas des commentaires sont conservées telles quelles ; les nouvelles entrées sont placées en dessous quand l’emplacement est En haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le righe prima della prima voce. Le righe che non sono commenti restano invariate; le nuove voci vanno sotto queste quando la posizione è In alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のエントリより前の行。コメント以外の行はそのまま保持されます。配置場所が“上”の場合、新しいエントリはこれらの下に追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 항목 앞의 줄입니다. 주석이 아닌 줄은 그대로 유지되며, 배치 위치가 상단이면 새로운 항목이 이 줄들 아래에 추가됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas antes da primeira entrada. Linhas que não são comentários são mantidas como estão; novas entradas ficam abaixo delas quando a posição é Em cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строки перед первой записью. Строки, не являющиеся комментариями, сохраняются как есть; новые записи добавляются под ними, если выбрано размещение «Вверху»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一个条目之前的行。非注释行会保持原样；当位置为“顶部”时，新条目会放在这些行下方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一個項目之前的行。非註解的行會保持原樣；位置設為「頂部」時，新項目會加在這些行下方。"
          }
        }
      }
    },
    "The macOS clock stays in the menu bar; turn it to analog or hide the date in Control Center settings if you like.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die macOS-Uhr bleibt in der Menüleiste; bei Bedarf in den Einstellungen des Kontrollzentrums auf analog umstellen oder das Datum ausblenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj de macOS se queda en la barra de menús; si quieres, cámbialo a analógico u oculta la fecha en los ajustes de Centro de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge de macOS reste dans la barre des menus ; passez-la en analogique ou masquez la date dans les réglages du Centre de contrôle si vous le souhaitez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSの時計はメニューバーに残ります。必要に応じて、“コントロールセンター”設定でアナログ表示にするか、日付を非表示にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 시계는 메뉴 막대에 그대로 남습니다. 원하면 제어 센터 설정에서 아날로그로 바꾸거나 날짜를 가리세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio do macOS continua na barra de menus; se quiser, deixe-o analógico ou oculte a data nos ajustes da Central de Controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы macOS остаются в строке меню; при желании сделайте их аналоговыми или скройте дату в настройках Пункта управления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 时钟仍保留在菜单栏中；如有需要，可在“控制中心”设置中将其改为模拟时钟或隐藏日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 時鐘會保留在選單列中；如果你願意，可在「控制中心」設定中將其改為類比時鐘或隱藏日期。"
          }
        }
      }
    },
    "The managed blocks in ~/.zshenv and ~/.zprofile, env.zsh and the login agent are removed, and launchd variables are restored. Your profiles stay saved in MacToys.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verwalteten Blöcke in ~/.zshenv und ~/.zprofile, env.zsh und der Anmelde-Agent werden entfernt, und launchd-Variablen werden wiederhergestellt. Die Profile bleiben in MacToys gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan los bloques gestionados de ~/.zshenv y ~/.zprofile, env.zsh y el agente de inicio de sesión, y se restauran las variables de launchd. Tus perfiles siguen guardados en MacToys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les blocs gérés dans ~/.zshenv et ~/.zprofile, env.zsh et l’agent d’ouverture de session sont supprimés, et les variables launchd sont restaurées. Vos profils restent enregistrés dans MacToys."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I blocchi gestiti in ~/.zshenv e ~/.zprofile, env.zsh e l'agente di login vengono rimossi e le variabili di launchd vengono ripristinate. I profili restano salvati in MacToys."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.zshenvと~/.zprofileの管理ブロック、env.zsh、ログインエージェントが削除され、launchdの変数が復元されます。プロファイルはMacToysに保存されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.zshenv 및 ~/.zprofile의 관리 블록, env.zsh, 로그인 에이전트가 제거되고 launchd 변수가 복원됩니다. 프로필은 MacToys에 저장된 상태로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os blocos gerenciados em ~/.zshenv e ~/.zprofile, o env.zsh e o agente de início de sessão são removidos, e as variáveis do launchd são restauradas. Seus perfis continuam salvos no MacToys."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляемые блоки в ~/.zshenv и ~/.zprofile, env.zsh и агент входа удаляются, а переменные launchd восстанавливаются. Ваши профили остаются сохраненными в MacToys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.zshenv 和 ~/.zprofile 中的托管区块、env.zsh 以及登录代理会被移除，launchd 变量会被恢复。你的配置文件仍会存储在 MacToys 中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會移除 ~/.zshenv 和 ~/.zprofile 中的受管理區塊、env.zsh 和登入代理程式，並回復 launchd 變數。你的設定檔會繼續保留在 MacToys 中。"
          }
        }
      }
    },
    "The menu bar appears when you move the pointer to the top of the screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Menüleiste erscheint, wenn der Zeiger an den oberen Bildschirmrand bewegt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de menús aparece al llevar el puntero a la parte superior de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre des menus apparaît lorsque vous placez le pointeur en haut de l’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタを画面の上端に移動すると、メニューバーが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터를 화면 상단으로 이동하면 메뉴 막대가 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de menus aparece quando você move o ponteiro até o topo da tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка меню появляется, когда вы подводите указатель к верхнему краю экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针移到屏幕顶部时，菜单栏会出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將指標移到螢幕頂部時，選單列就會出現。"
          }
        }
      }
    },
    "The microphone couldn’t be started": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon konnte nicht gestartet werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido iniciar el micrófono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le micro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare il microfono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを開始できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 시작할 수 없음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o microfone"
          }
        },
        "ru": {
