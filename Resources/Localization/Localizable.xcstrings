        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé affiche des pixels nets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato mostra pixel nitidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするとピクセルがくっきり表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 선명한 픽셀로 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado mostra pixels nítidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, пиксели остаются четкими."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时显示清晰的像素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時會顯示清晰的像素。"
          }
        }
      }
    },
