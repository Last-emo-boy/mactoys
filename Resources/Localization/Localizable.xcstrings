    "Files on the desktop stay out of screen and area shots.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien auf dem Schreibtisch bleiben aus Bildschirm- und Bereichsaufnahmen heraus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos del escritorio no aparecen en las capturas de pantalla ni de área."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers du bureau n’apparaissent pas dans les captures d’écran et de zone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file sulla scrivania restano fuori dalle istantanee dello schermo e delle aree."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップ上のファイルは、画面と範囲のキャプチャに写りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 및 영역 캡처에 데스크탑의 파일이 나타나지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos da mesa ficam fora das capturas de tela e de área."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы на рабочем столе не попадают в снимки экрана и областей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面上的文件不会出现在屏幕截图和区域截图中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面上的檔案不會出現在螢幕和區域截圖中。"
          }
        }
      }
    },
    "Files optimized in place stay where they were in date-sorted folders.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt optimierte Dateien bleiben in nach Datum sortierten Ordnern an ihrer Stelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos optimizados en su sitio conservan su posición en las carpetas ordenadas por fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers optimisés sur place restent à leur emplacement, dans des dossiers triés par date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file ottimizzati sul posto mantengono la loro posizione nelle cartelle ordinate per data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場で最適化したファイルが、日付順に並べたフォルダ内で元の位置に表示されたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 자리에서 최적화한 파일이 날짜순으로 정렬된 폴더에서 원래 위치에 그대로 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos otimizados no local ficam onde estavam, em pastas ordenadas por data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы, оптимизированные на месте, остаются на прежних позициях в папках с сортировкой по дате."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原位优化的文件在按日期排序的文件夹中会保持原来的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "就地最佳化的檔案在依日期排序的檔案夾中會保持原本的位置。"
          }
        }
      }
    },
