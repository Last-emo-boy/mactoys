{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "$1, $&, $` and $' in replacements; backslashes are literal.": {
      "comment": "PowerRename: keep the $… tokens as they are",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "$1, $&, $` und $' in Ersetzungen; Backslashes werden wörtlich übernommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "$1, $&, $` y $' en los reemplazos; las barras invertidas son literales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "$1, $&, $` et $' dans les remplacements ; les barres obliques inversées sont prises littéralement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "$1, $&, $` e $' nelle sostituzioni; le barre rovesciate sono letterali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置換文字列では$1、$&、$`、$'が使えます。バックスラッシュは文字どおりに扱われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체 문자열에서 $1, $&, $`, $'를 사용할 수 있으며, 백슬래시는 문자 그대로 처리됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "$1, $&, $` e $' nas substituições; barras invertidas são literais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "$1, $&, $` и $' в замене; обратная косая черта — обычный символ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换内容中可使用 $1、$&、$` 和 $'；反斜杠按字面处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代內容中可使用 $1、$&、$` 和 $'；反斜線會依字面處理。"
          }
        }
      }
    },
    "$YYYY-$MM-$DD Notes by %USERNAME%.md": {
