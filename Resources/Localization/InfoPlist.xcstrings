          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Permission prompt shown by macOS",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt nimmt bei Bildschirmaufnahmen Ton auf und schreibt das Diktat für Ausschnitte mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt records audio with screen recordings and transcribes snip dictation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt graba audio con las grabaciones de pantalla y transcribe el dictado de los recortes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt enregistre l’audio avec les enregistrements d’écran et transcrit la dictée des captures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt registra l’audio insieme alle registrazioni dello schermo e trascrive la dettatura dei ritagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomItは、画面収録と一緒に音声を録音し、切り取りの音声入力を文字に起こします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt은 화면 기록과 함께 오디오를 녹음하고 캡처 받아쓰기를 텍스트로 변환합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ZoomIt grava áudio nas gravações de tela e transcreve o ditado dos recortes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt записывает звук вместе с записью экрана и расшифровывает диктовку для снимков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt 会在录屏时录制音频，并转写截图听写内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt 會在螢幕錄製時錄製音訊，並轉寫截取聽寫內容。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Permission prompt shown by macOS",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt schreibt das Diktat für Ausschnitte auf diesem Mac mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt transcribes snip dictation on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt transcribe el dictado de los recortes en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt transcrit la dictée des captures sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt trascrive la dettatura dei ritagli su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomItは、切り取りの音声入力をこのMac上で文字に起こします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt은 이 Mac에서 캡처 받아쓰기를 텍스트로 변환합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ZoomIt transcreve o ditado dos recortes neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt расшифровывает диктовку для снимков на этом Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt 会在这台 Mac 上转写截图听写内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ZoomIt 會在這台 Mac 上轉寫截取聽寫內容。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
