            "value": "選單列行事曆會顯示你的行程，並提醒你即將到來的會議。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Permission prompt shown by macOS",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraspiegel zeigt Ihr Kamerabild, damit Sie vor einem Anruf prüfen können, wie Sie aussehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Mirror shows your camera so you can check how you look before a call."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espejo de cámara muestra tu cámara para que puedas comprobar tu aspecto antes de una llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miroir de caméra affiche votre caméra pour que vous puissiez vérifier votre apparence avant un appel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Specchio fotocamera mostra la fotocamera per permetterti di controllare il tuo aspetto prima di una chiamata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラミラーは、通話の前に自分の映り具合を確認できるように、カメラの映像を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 미러는 통화 전에 모습을 확인할 수 있도록 카메라 화면을 보여 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Espelho da Câmera mostra sua câmera para que você confira sua aparência antes de uma chamada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Зеркало камеры» показывает изображение с камеры, чтобы вы могли проверить, как выглядите перед звонком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机镜像会显示你的相机画面，方便你在通话前查看自己的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機鏡像會顯示你的相機畫面，讓你在通話前查看自己的樣子。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Permission prompt shown by macOS",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maus ohne Grenzen sucht Ihre anderen Macs im lokalen Netzwerk und verbindet sich mit ihnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse Without Borders finds and connects to your other Macs on the local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse Without Borders busca tus otros Mac en la red local y se conecta a ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse Without Borders recherche vos autres Mac sur le réseau local et s’y connecte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse senza confini trova i tuoi altri Mac sulla rete locale e si connette a essi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse Without Bordersは、ローカルネットワーク上のほかのMacを見つけて接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경계 없는 마우스는 로컬 네트워크에서 다른 Mac을 찾아 연결합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mouse Without Borders encontra e se conecta aos seus outros Macs na rede local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мышь без границ находит другие ваши Mac в локальной сети и подключается к ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无界鼠标会在本地网络上查找并连接你的其他 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無邊界滑鼠會在區域網路上尋找並連接你的其他 Mac。"
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "comment": "Permission prompt shown by macOS",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichtschalter verwendet Ihren Standort, um Sonnenaufgang und Sonnenuntergang zu berechnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light Switch uses your location to compute sunrise and sunset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio de aspecto usa tu ubicación para calcular el amanecer y el atardecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bascule d’apparence utilise votre position pour calculer le lever et le coucher du soleil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio aspetto usa la tua posizione per calcolare l’alba e il tramonto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトスイッチは、日の出と日の入りの時刻を計算するために位置情報を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 모드 전환은 일출 및 일몰 시간을 계산하기 위해 사용자의 위치를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alternador de Aparência usa a sua localização para calcular o nascer e o pôr do sol."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключатель темы использует вашу геопозицию, чтобы рассчитать время восхода и заката."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明暗切换使用你的位置来计算日出和日落时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外觀切換會使用你的位置來計算日出和日落時間。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Permission prompt shown by macOS",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichtschalter verwendet Ihren Standort, um Sonnenaufgang und Sonnenuntergang zu berechnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light Switch uses your location to compute sunrise and sunset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio de aspecto usa tu ubicación para calcular el amanecer y el atardecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bascule d’apparence utilise votre position pour calculer le lever et le coucher du soleil."
          }
        },
        "it": {
          "stringUnit": {
